@prefix care: <https://w3id.org/care/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:checklistCommunityEngagement
  a skos:ConceptScheme ;
  skos:prefLabel "Community Engagement."@en ;
  dct:title "Community Engagement"@en ;
  skos:definition "Checklist for documentation and evidence on community engagement"@en ;
  dct:created "2026-05-07"^^xsd:date ;
  dct:modified "2026-05-07"^^xsd:date ;
  skos:hasTopConcept trsp:typeBenefit ,
                     trsp:typeResponsible ,
                     trsp:typeInclusivity ,
                     trsp:typeUserNeeds ;
  owl:versionInfo "0.1" .

#----------------------------------------------------------
# Community Benefits
#----------------------------------------------------------
trsp:typeBenefit
  a skos:Concept ;
  skos:prefLabel "Community Benefit"@en ;
  skos:definition "Active measures to ensure community benefit, aligned with CARE."@en ;
  skos:inScheme trsp:typeBenefit .

trsp:typeBenefitCapability
  a skos:Concept ;
  skos:prefLabel "Expand Capability and Capacity"@en ;
  skos:relatedMatch care:collectiveBenefit ;
  skos:inScheme trsp:typeBenefit .

trsp:typeBenefitEquitable
  a skos:Concept ;
  skos:prefLabel "Engagement is Equitable"@en ;
  skos:relatedMatch care:collectiveBenefit, care:C3 ;
  skos:inScheme trsp:typeBenefit .

#----------------------------------------------------------
# Respect and Responsibility
#----------------------------------------------------------
trsp:typeResponsible
  a skos:Concept ;
  skos:prefLabel "Community Benefit"@en ;
  skos:definition "Active measures to ensure community benefit, aligned with CARE."@en ;
  skos:inScheme trsp:typeBenefit .

trsp:typeBenefitRespect
  a skos:Concept ;
  skos:prefLabel "Positive Respectful Relations"@en ;
  skos:relatedMatch care:responsibility, care:R1 ;
  skos:inScheme trsp:typeResponsible .

#----------------------------------------------------------
# Inclusivity
#----------------------------------------------------------
