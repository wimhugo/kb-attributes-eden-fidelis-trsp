    a edenkb:ProfileProperty, skos:Concept ;
    edenkb:profile <https://eden-fidelis.eu/network-member> ;
    skos:prefLabel "Purpose" ;
    skos:definition "Brief Description of Purpose" ;
    skos:closeMatch trsp:att.035ACCB10D .

