@prefix r3d: <https://schema.re3data.org/4-0/re3dataV4-0.xsd> . ## to be updated
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

r3d:dataUploadRestrictions a skos:ConceptScheme ;
    skos:prefLabel "data upload restrictions"@en ;
    skos:hasTopConcept <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/feeRequired> ;
    skos:narrower <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/feeRequired>, <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/institutionalMembership>, <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/registration>, <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/storageLimit> .

<https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/feeRequired> a skos:Concept ;
    skos:inScheme r3d:dataUploadRestrictions ;
    skos:prefLabel "fee required"@en ;
    skos:definition "feeRequired"@en ;
    skos:broader r3d:dataUploadRestrictions ;
    skos:related <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/institutionalMembership> ;
    skos:related <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/registration> ;
    skos:related <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/storageLimit> .

<https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/institutionalMembership> a skos:Concept ;
    skos:inScheme r3d:dataUploadRestrictions ;
    skos:prefLabel "institutional membership"@en ;
    skos:definition "institutionalMembership"@en ;
    skos:broader r3d:dataUploadRestrictions ;
    skos:related <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/feeRequired> ;
    skos:related <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/registration> ;
    skos:related <https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/storageLimit> .

<https://schema.re3data.org/4-0/re3dataV4-0.xsddataUploadRestrictions/registration> a skos:Concept ;
    skos:inScheme r3d:dataUploadRestrictions ;
    skos:prefLabel "registration"@en ;
