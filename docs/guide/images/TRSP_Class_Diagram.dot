digraph G { graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.8]; node [fontname="Arial"]; edge [fontname="Arial",fontsize=9];
"APIService" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>APIService</B></TD></TR></TABLE>>];
"Attribute" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>Attribute</B></TD></TR><TR><TD ALIGN="LEFT">correspondingProperty : rdf:Property</TD></TR></TABLE>>];
"Checklist" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>Checklist</B></TD></TR><TR><TD ALIGN="LEFT">checkItem : ChecklistItem</TD></TR><TR><TD ALIGN="LEFT">checklistSource : skos:ConceptScheme</TD></TR></TABLE>>];
"ChecklistItem" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>ChecklistItem</B></TD></TR><TR><TD ALIGN="LEFT">checklistIRI : skos:Concept</TD></TR></TABLE>>];
"ClassMapping" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>ClassMapping</B></TD></TR><TR><TD ALIGN="LEFT">sourceClass : rdfs:Class</TD></TR><TR><TD ALIGN="LEFT">targetClass : rdfs:Class</TD></TR></TABLE>>];
"CommunityProfile" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>CommunityProfile</B></TD></TR></TABLE>>];
"Constraint" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>Constraint</B></TD></TR><TR><TD ALIGN="LEFT">aggregationType : skos:Concept</TD></TR><TR><TD ALIGN="LEFT">concept : skos:Concept</TD></TR><TR><TD ALIGN="LEFT">conceptScheme : skos:ConceptScheme</TD></TR><TR><TD ALIGN="LEFT">constraintType : skos:Concept</TD></TR><TR><TD ALIGN="LEFT">datatype : rdfs:Datatype</TD></TR><TR><TD ALIGN="LEFT">nodeKind : sh:NodeKind</TD></TR><TR><TD ALIGN="LEFT">sourceAttribute : Attribute</TD></TR><TR><TD ALIGN="LEFT">valueClass : rdfs:Class</TD></TR></TABLE>>];
"Evidence" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>Evidence</B></TD></TR><TR><TD ALIGN="LEFT">evidenceIRI : rdfs:Resource</TD></TR><TR><TD ALIGN="LEFT">evidenceType : skos:Concept</TD></TR><TR><TD ALIGN="LEFT">machineActionable : xsd:boolean</TD></TR></TABLE>>];
"MappingQualifier" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>MappingQualifier</B></TD></TR><TR><TD ALIGN="LEFT">qualifierProperty : rdf:Property</TD></TR><TR><TD ALIGN="LEFT">qualifierValue : value</TD></TR></TABLE>>];
"Profile" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>Profile</B></TD></TR><TR><TD ALIGN="LEFT">hasProperty : ProfileProperty</TD></TR></TABLE>>];
"ProfileMapping" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>ProfileMapping</B></TD></TR><TR><TD ALIGN="LEFT">hasClassMapping : ClassMapping</TD></TR><TR><TD ALIGN="LEFT">sourceProfile : Profile</TD></TR><TR><TD ALIGN="LEFT">targetProfile : Profile</TD></TR></TABLE>>];
"ProfileProperty" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>ProfileProperty</B></TD></TR><TR><TD ALIGN="LEFT">hasAttribute : Attribute</TD></TR><TR><TD ALIGN="LEFT">property : rdf:Property</TD></TR><TR><TD ALIGN="LEFT">propertyPath : value</TD></TR></TABLE>>];
"PropertyMapping" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>PropertyMapping</B></TD></TR><TR><TD ALIGN="LEFT">mappedAttribute : Attribute</TD></TR><TR><TD ALIGN="LEFT">sourceProfileProperty : ProfileProperty</TD></TR><TR><TD ALIGN="LEFT">targetProfileProperty : ProfileProperty</TD></TR></TABLE>>];
"Repository" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>Repository</B></TD></TR></TABLE>>];
"RepositoryProfile" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>RepositoryProfile</B></TD></TR></TABLE>>];
"Service" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>Service</B></TD></TR></TABLE>>];
"ServiceProfile" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>ServiceProfile</B></TD></TR></TABLE>>];
"SourceProfile" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>SourceProfile</B></TD></TR></TABLE>>];
"StandardProfile" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>StandardProfile</B></TD></TR></TABLE>>];
"ValueMapping" [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="lightgrey"><B>ValueMapping</B></TD></TR><TR><TD ALIGN="LEFT">sourceValue : value</TD></TR><TR><TD ALIGN="LEFT">targetValue : value</TD></TR></TABLE>>];
"schema:Service" [shape=box,style="dashed",label="schema:Service"];
"skos:Concept" [shape=box,style="dashed",label="skos:Concept"];
"Reusable properties
(no RDFS domain)" [shape=note,label="Reusable properties (no RDFS domain)\nhasConstraint · hasProfile · hasPropertyMapping\nhasValueMapping · hasQualifier · hasBenchmark\nhasCardinalityType · hasMeasurementType\nmappingType · mappingAlgorithm\nsourceConceptScheme · targetConceptScheme"];
"APIService" -> "Service" [arrowhead=empty,label="subclass"];
"ChecklistItem" -> "Evidence" [arrowhead=empty,label="subclass"];
"CommunityProfile" -> "Profile" [arrowhead=empty,label="subclass"];
"RepositoryProfile" -> "Profile" [arrowhead=empty,label="subclass"];
"ServiceProfile" -> "Profile" [arrowhead=empty,label="subclass"];
"SourceProfile" -> "Profile" [arrowhead=empty,label="subclass"];
"StandardProfile" -> "Profile" [arrowhead=empty,label="subclass"];
"Checklist" -> "ChecklistItem" [label="checkItem"];
"ProfileProperty" -> "Attribute" [label="hasAttribute"];
"ProfileMapping" -> "ClassMapping" [label="hasClassMapping"];
"Profile" -> "ProfileProperty" [label="hasProperty"];
"PropertyMapping" -> "Attribute" [label="mappedAttribute"];
"Constraint" -> "Attribute" [label="sourceAttribute"];
"ProfileMapping" -> "Profile" [label="sourceProfile"];
"PropertyMapping" -> "ProfileProperty" [label="sourceProfileProperty"];
"ProfileMapping" -> "Profile" [label="targetProfile"];
"PropertyMapping" -> "ProfileProperty" [label="targetProfileProperty"];
"Service" -> "schema:Service" [arrowhead=empty,label="subclass",style=dashed];
"Attribute" -> "skos:Concept" [arrowhead=empty,label="subclass",style=dashed];
}