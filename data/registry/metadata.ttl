msc:t1 a msct:t ;
    mscp:description "<p>A service to facilitate the publication of metadata in the AGRIS Repository; it conforms to the the AGRIS Application Profile, which draws from the Dublin Core&#160;and&#160;AgMES&#160;standards.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/1/locations/1> ;
    mscp:slug "agrimetamaker" ;
    mscp:sourceId "1" ;
    mscp:sourceSection "t" ;
    mscp:title "AgriMetamaker" .

msc:t10 a msct:t ;
    mscp:description "<p>The CIM Questionnaire generates a customizable web-based questionnaire based on the <a href=\"http://rd-alliance.github.io/metadata-directory/standards/cim-common-information-model.html\">CIM</a> schema.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/10/locations/1> ;
    mscp:slug "cim-questionnaire-generator" ;
    mscp:sourceId "10" ;
    mscp:sourceSection "t" ;
    mscp:title "CIM Questionnaire Generator" .

msc:t11 a msct:t ;
    mscp:description "<p>The CIM Viewer is a light-weight JavaScript platform independent API that other software stacks can use to display CIM metadata.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/11/locations/1> ;
    mscp:slug "cim-viewer-tool" ;
    mscp:sourceId "11" ;
    mscp:sourceSection "t" ;
    mscp:title "CIM Viewer Tool" .

msc:t12 a msct:t ;
    mscp:description "<p>Tool which utilizes the DCAT standard. CKAN is a powerful data management system that makes data accessible &#8211; by providing tools to streamline publishing, sharing, finding and using data.</p><p>CKAN is aimed at data publishers (national and regional governments, companies and organizations) wanting to make their data open and available. Portals that use CKAN include <a href=\"http://data.gov.uk\">http://data.gov.uk</a> and <a href=\"http://open-data.europa.eu\">http://open-data.europa.eu</a>. The United States <a href=\"http://data.gov\">http://data.gov</a> uses a version of CKAN wrapped up as the <a href=\"https://github.com/opengovplatform/opengovplatform-beta\">Open Government Platform</a>.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/12/locations/1> ;
    mscp:slug "ckan" ;
    mscp:sourceId "12" ;
    mscp:sourceSection "t" ;
    mscp:title "CKAN" .

msc:t13 a msct:t ;
    mscp:description "<p>A set of C-based functions, with bindings to both Python and FORTRAN 90, that can be used to produce CF-compliant netCDF files.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/13/locations/1> ;
    mscp:slug "cmor-climate-model-output-rewriter" ;
    mscp:sourceId "13" ;
    mscp:sourceSection "t" ;
    mscp:title "CMOR (Climate Model Output Rewriter)" .

msc:t14 a msct:t ;
    mscp:description "<p>A web application that offers data publishers wishing to serve to the GBIF network an easy interface for describing data elements as basic text files, composing an appropriate XML Darwin Core descriptor file to accompany them.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/14/locations/1> ;
    mscp:slug "darwin-core-archive-assistant" ;
    mscp:sourceId "14" ;
    mscp:sourceSection "t" ;
    mscp:title "Darwin Core Archive Assistant" .

msc:t15 a msct:t ;
    mscp:description "<p>A tool to validate XML metadata against the Darwin Core Text Guidelines.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/15/locations/1> ;
    mscp:slug "darwin-core-archive-validator" ;
    mscp:sourceId "15" ;
    mscp:sourceSection "t" ;
    mscp:title "Darwin Core Archive Validator" .

msc:t16 a msct:t ;
    mscp:description "<p>A collection of libraries for working with Data Packages in various programming languages, and scripts for importing them into databases.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/16/locations/1> ;
    mscp:slug "data-package-libraries" ;
    mscp:sourceId "16" ;
    mscp:sourceSection "t" ;
    mscp:title "Data Package libraries" .

msc:t17 a msct:t ;
    mscp:description "<p>The Data Package Validator takes the URL of a Data Package and checks whether it conforms to the Data Package specification.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/17/locations/1> ;
    mscp:slug "data-package-validator" ;
    mscp:sourceId "17" ;
    mscp:sourceSection "t" ;
    mscp:title "Data Package Validator" .

msc:t18 a msct:t ;
    mscp:description "<p>The Data Package Viewer takes the URL of a Data Package and provides a human-friendly view of it.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/18/locations/1> ;
    mscp:slug "data-package-viewer" ;
    mscp:sourceId "18" ;
    mscp:sourceSection "t" ;
    mscp:title "Data Package Viewer" .

msc:t19 a msct:t ;
    mscp:description "<p>The Data Packagist is a Web-based tool for writing a Data Package descriptor file (datapackage.json).</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/19/locations/1> ;
    mscp:slug "data-packagist" ;
    mscp:sourceId "19" ;
    mscp:sourceSection "t" ;
    mscp:title "Data Packagist" .

msc:t2 a msct:t ;
    mscp:description "<p>A GeoNetwork web application for metadata management and searching, with profiles available for two extensions of ISO 19115: ANZLIC and the Marine Community Profile. This application was managed by the Australian Ocean Data Network, and has been superseded by a GeoNework catalogue utilising ISO 19115.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/2/locations/1> ;
    mscp:slug "anz-mest-metadata-entry-and-search-tool" ;
    mscp:sourceId "2" ;
    mscp:sourceSection "t" ;
    mscp:title "ANZ-MEST (Metadata Entry and Search Tool)" .

msc:t20 a msct:t ;
    mscp:description "<p>RESTFUL API for registering datasets with the DataCite organization. The interface uses the DataCite Metadata Schema.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/20/locations/1> ;
    mscp:slug "datacite-metadata-store-api" ;
    mscp:sourceId "20" ;
    mscp:sourceSection "t" ;
    mscp:title "DataCite Metadata Store API" .

msc:t21 a msct:t ;
    mscp:description "<p>The DCMI Tools Community list of tools and software implementing Dublin Core.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/21/locations/1> ;
    mscp:slug "dcmi-tools-and-software" ;
    mscp:sourceId "21" ;
    mscp:sourceSection "t" ;
    mscp:title "DCMI Tools and Software" .

msc:t22 a msct:t ;
    mscp:description "<p>The Data Documentaion Initiative website's list of tools to implement the DDI standard.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/22/locations/1> ;
    mscp:slug "ddi-tools" ;
    mscp:sourceId "22" ;
    mscp:sourceSection "t" ;
    mscp:title "DDI Tools" .

msc:t23 a msct:t ;
    mscp:description "<p>DdiEditor is a DDI-Lifecycle Editing Framework developed by the DDA - Danish Data Archive.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/23/locations/1> ;
    mscp:slug "ddieditor" ;
    mscp:sourceId "23" ;
    mscp:sourceSection "t" ;
    mscp:title "DdiEditor" ;
    mscp:types "graphical (cross-platform)" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/t/23/versions/1> .

msc:t24 a msct:t ;
    mscp:description "<p>Server-side software for building a data portal, with a particular focus on survey datasets. It uses DDI to provide access to the data at the level of concepts and variables. For an example of it in use, see the <a href=\"https://paneldata.org/\">SOEPinfo data portal</a>.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/24/locations/1> ;
    mscp:slug "ddionrails" ;
    mscp:sourceId "24" ;
    mscp:sourceSection "t" ;
    mscp:title "DDI on Rails" .

msc:t25 a msct:t ;
    mscp:description "<p>Current research information system developed by Elsevier that implements the CERIF standard.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/25/locations/1> ;
    mscp:slug "elsevier-pure" ;
    mscp:sourceId "25" ;
    mscp:sourceSection "t" ;
    mscp:title "Pure" .

msc:t26 a msct:t ;
    mscp:description "<p>The FGDC website's list of tools to implement the CSDGM standard.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/26/locations/1> ;
    mscp:slug "fgdccdsgm-tools" ;
    mscp:sourceId "26" ;
    mscp:sourceSection "t" ;
    mscp:title "FGDC/CDSGM Tools" .

msc:t27 a msct:t ;
    mscp:description "<p><a href=\"http://fiji.sc/Fiji\">Fiji</a> is an image processing package that supports the <a href=\"http://www.openmicroscopy.org/site/support/ome-model/\">OME data model</a> for images </p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/27/locations/1> ;
    mscp:slug "fiji" ;
    mscp:sourceId "27" ;
    mscp:sourceSection "t" ;
    mscp:title "Fiji" .

msc:t28 a msct:t ;
    mscp:description "<p>A suite of tools using the MIDAS Heritage metadata standard to facilitate the process of moving information between the wide variety of information systems used to record the historic environment.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/28/locations/1> ;
    mscp:slug "fish-interoperability-toolkit" ;
    mscp:sourceId "28" ;
    mscp:sourceSection "t" ;
    mscp:title "FISH Interoperability Toolkit" .

msc:t29 a msct:t ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/29/locations/1> ;
    mscp:slug "fits-image-software-packages" ;
    mscp:sourceId "29" ;
    mscp:sourceSection "t" ;
    mscp:title "FITS Image Software Packages" .

msc:t3 a msct:t ;
    mscp:description "<p>Current research information system implementing the CERIF standard. Originally developed by Avedas but now a product of Thomson Reuters.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/3/locations/1> ;
    mscp:slug "avedas-converis" ;
    mscp:sourceId "3" ;
    mscp:sourceSection "t" ;
    mscp:title "Converis" .

msc:t30 a msct:t ;
    mscp:description "<p>The software that underlies the German Astrophysical Virtual Observatory (GAVO), packaged so that it can be used to set up other Virtual Observatory-compliant data centres.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/30/locations/1> ;
    mscp:slug "gavo-dachs-data-center-helper-suite" ;
    mscp:sourceId "30" ;
    mscp:sourceSection "t" ;
    mscp:title "GAVO DaCHS - Data Center Helper Suite" .

msc:t31 a msct:t ;
    mscp:description "<p>The Geodoc metadata editor tool allows users to create, validate, edit and export geospatial metadata records. It also supports the creation and export of metadata records as XML output files compliant with a number of standards, including <a href=\"http://www.gogeo.ac.uk/gogeo/metadata/agmap.htm\">UK AGMAP 2.1</a>, ISO 19115, FGDC, DDI, and Dublin Core.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/31/locations/1> ;
    mscp:slug "geodoc-metadata-editor" ;
    mscp:sourceId "31" ;
    mscp:sourceSection "t" ;
    mscp:title "Geodoc Metadata Editor" .

msc:t32 a msct:t ;
    mscp:description "<p>Geoportal Server is a standards-based, open source product that enables discovery and use of geospatial resources including data and services.</p>" ;
