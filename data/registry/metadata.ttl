    mscp:sourceId "4" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/4/versions/1> .

msc:c5 a msct:c ;
    mscp:description "<p>This document maps the elements of version 4.4 of the DataCite Metadata Schema to the equivalent elements in the DCMI (Dublin Core Metadata Initiative) Metadata Terms namespace. The specification document for the DataCite Metadata Schema includes a suggested mapping of the DataCite controlled vocabulary terms for general resource types to the DCMI Type Vocabulary.</p>" ;
    mscp:identifiers <https://rdamsc.bath.ac.uk/msc/node/c/5/identifiers/1> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/5/locations/1> ;
    mscp:name "DataCite to Dublin Core Mapping 4.4" ;
    mscp:slug "datacite-metadata-schema_TO_dublin-core" ;
    mscp:sourceId "5" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/5/versions/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/5/versions/2> .

msc:c6 a msct:c ;
    mscp:description "<p>An appendix to the documentation of the DataCite Metadata Schema v2.x matches elements in the DataCite schema to corresponding elements in the IDF (International DOI Foundation) Metadata Kernel. It is mainly provided for DataCite’s own administrative purposes.</p>" ;
    mscp:identifiers <https://rdamsc.bath.ac.uk/msc/node/c/6/identifiers/1> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/6/locations/1> ;
    mscp:slug "datacite-metadata-schema_TO_idf-international-doi" ;
