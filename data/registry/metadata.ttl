msc:c20 a msct:c ;
    mscp:description "<p>This document provides a mapping from UK AGMAP and ISO 19115 to DDI v2.x Codebook.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/20/locations/1> ;
    mscp:slug "iso-19115_TO_ddi-data-documentation" ;
    mscp:sourceId "20" ;
    mscp:sourceSection "c" .

msc:c21 a msct:c ;
    mscp:description "<p>This document provides a crosswalk from core MARC 21 bibliographic data elements, specifically those considered useful for broad cross-domain resource discovery, to simple and qualified elements in the Dublin Core Element Set. It includes a mapping from Leader/06 and Leader/07 codes to the DMCI Type Vocabulary.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/21/locations/1> ;
    mscp:slug "marc-machine-readable_TO_dublin-core" ;
    mscp:sourceId "21" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/21/versions/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/21/versions/2> .

msc:c22 a msct:c ;
    mscp:description "<p>This document provides a mapping from the NetCDF Attribute Convention for Dataset Discovery to ISO 19115. The most up-to-date version is available as an XML Stylesheet transformation from the Unidata threddsISO Code Repository.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/22/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/22/locations/2> ;
    mscp:slug "netcdf-attribute-convention_TO_iso-19115" ;
    mscp:sourceId "22" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/22/versions/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/22/versions/2>,
        <https://rdamsc.bath.ac.uk/msc/node/c/22/versions/3>,
        <https://rdamsc.bath.ac.uk/msc/node/c/22/versions/4>,
        <https://rdamsc.bath.ac.uk/msc/node/c/22/versions/5>,
        <https://rdamsc.bath.ac.uk/msc/node/c/22/versions/6> .

msc:c23 a msct:c ;
    mscp:creators <https://rdamsc.bath.ac.uk/msc/node/c/23/creators/1> ;
    mscp:description "<p>This document describes how to convert metadata conforming with the OECD Minimum Data Set (MSD) for describing BRCS and the domain of Microbes into ABCD v1.3.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/23/locations/1> ;
    mscp:slug "oecd-minimum-data_TO_abcd-access-biological" ;
    mscp:sourceId "23" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/23/versions/1> .

msc:c24 a msct:c ;
    mscp:description "<p>This XML Stylesheet transformation provides a simple mapping from the SPASE Data Model to the OAI-PMH profile of Dublin Core. A textual description of the mapping is available from the Internet Archive Wayback Machine.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/24/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/24/locations/2> ;
    mscp:slug "spase-data-model_TO_dublin-core" ;
    mscp:sourceId "24" ;
    mscp:sourceSection "c" .

msc:c26 a msct:c ;
    mscp:description "This document maps from the elements in the Metadata Object Description Schema (MODS) to those in the Dublin Core Metadata Element Set, version 1.1. One application of the mapping might be to expose MODS records for OAI harvesting in Dublin Core syntax." ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/26/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/26/locations/2> ;
    mscp:slug "dublin-core_TO_mods-metadata-object" ;
    mscp:sourceId "26" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/26/versions/1> .

msc:c27 a msct:c ;
    mscp:description "This document gives equivalencies between the elements in the Metadata Object Description Schema (MODS) and the Dublin Core Metadata Element Set, version 1.1. One application of the mapping might be to expose MODS records for OAI harvesting in Dublin Core syntax." ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/27/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/27/locations/2> ;
    mscp:slug "mods-metadata-object_TO_dublin-core" ;
    mscp:sourceId "27" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/27/versions/1> .

msc:c28 a msct:c ;
    mscp:description "This document is intended for use in converting MARC 21 bibliographic records to MODS. Where multiple subfields are specified or implied in MARC, data will be concatenated with a space substituted for the subfield delimiter and subfield code. Where multiple MARC fields correspond to a single MODS element, each will be mapped to a separate instance of the element (with subfields concatenated). Because of this, it is not generally possible to perform a round-trip conversion without loss of specificity." ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/28/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/28/locations/2> ;
    mscp:slug "marc-machine-readable_TO_mods-metadata-object" ;
    mscp:sourceId "28" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/28/versions/1> .

msc:c29 a msct:c ;
    mscp:description "This document is intended for use in first converting a MODS record to MARCXML and then to a MARC 21 (ISO 2709) record. MARC 21 includes many more data elements than MODS, so although this mapping suggests a single MARC 21 equivalent for each MODS element, there may be other equivalents that are more appropriate for particular pieces of information. Additionally, MARC 21 is more granular than MODS so some data may map to inappropriate MARC 21 fields or subfields. Consequently, some conversions will result in some loss of data identification." ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/29/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/29/locations/2> ;
    mscp:slug "mods-metadata-object_TO_marc-machine-readable" ;
    mscp:sourceId "29" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/29/versions/1> .

msc:c3 a msct:c ;
    mscp:description "<p>This document lists the elements in Darwin Core (DwC) v1.2, the OBIS extension to DwC 1.2, DwC 1.21, DwC 1.4 (draft), DwC 1.4 Curatorial Extension, DwC 1.4 Geospatial Extension, DwC 1.4 Paleontology Extension, and Standard DwC, and recommends equivalent elements in ABCD v2.06.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/3/locations/1> ;
    mscp:slug "darwin-core_TO_abcd-access-biological" ;
    mscp:sourceId "3" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/3/versions/1> .

