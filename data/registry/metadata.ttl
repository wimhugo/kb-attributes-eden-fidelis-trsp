msc:c4 a msct:c ;
    mscp:description "<p>An appendix to the documentation of the DataCite Metadata Schema v2.x maps elements in the DataCite schema to corresponding elements in the DDI v3.1 set of schemas.</p>" ;
    mscp:identifiers <https://rdamsc.bath.ac.uk/msc/node/c/4/identifiers/1> ;
