        <https://rdamsc.bath.ac.uk/msc/node/t/79/locations/2> ;
    mscp:slug "skohub-vocabs" ;
    mscp:sourceId "79" ;
    mscp:sourceSection "t" ;
    mscp:title "SkoHub Vocabs" ;
    mscp:types "web service" .

msc:t80 a msct:t ;
    mscp:description """Cocoda is a web application to manage and create mappings between knowledge organization systems, such as classifications, authority files, and thesauri. The Cocoda manual gives a short introduction.\r
\r
 It provides a technical infrastructure to manage KOS and KOS mappings in order to facilitate a seamless access and use.""" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/80/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/t/80/locations/2> ;
    mscp:slug "cocoda-knowledge-organization-systems-management" ;
    mscp:sourceId "80" ;
    mscp:sourceSection "t" ;
    mscp:title "Cocoda (Knowledge organization systems management)" ;
    mscp:types "web application" .

msc:c1 a msct:c ;
    mscp:creators <https://rdamsc.bath.ac.uk/msc/node/c/1/creators/1> ;
    mscp:description "<p>This document matches comparable elements between ABCD v2.06b and Darwin Core (DwC) v1.4, DwC v1.4 Geospatial Extension, DwC v1.4 Curatorial Extension, and the OBIS Schema v1.1 extension to DwC 1.2. It also notes any issues with mapping in either direction.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/1/locations/1> ;
    mscp:slug "abcd-access-biological_TO_darwin-core" ;
    mscp:sourceId "1" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/1/versions/1> .

msc:c10 a msct:c ;
    mscp:description "<p>This document provides a detailed mapping from DIF to ISO 19115.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/10/locations/1> ;
    mscp:slug "dif-directory-interchange_TO_iso-19115" ;
    mscp:sourceId "10" ;
    mscp:sourceSection "c" .

msc:c11 a msct:c ;
    mscp:description "<p>This document provides a crosswalk from Dublin Core elements and Dublin Core terms to MARC 21 bibliographic data elements. It includes a mapping from the DMCI Type Vocabulary to Leader/06 codes.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/11/locations/1> ;
    mscp:slug "dublin-core_TO_marc-machine-readable" ;
    mscp:sourceId "11" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/11/versions/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/11/versions/2>,
        <https://rdamsc.bath.ac.uk/msc/node/c/11/versions/3> .

msc:c12 a msct:c ;
    mscp:description "<p>This document describes a detailed crosswalk from Dublin Core terms to the PROV-O OWL2 ontology. The associated <a href=\"http://www.w3.org/ns/prov-dc-directmappings.ttl\">direct mappings</a> and <a href=\"http://www.w3.org/ns/prov-dc-refinements.ttl\">PROV-O refinemements for Dublin Core</a> are available as Turtle (Terse RDF Triple Language) files." ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/12/locations/1> ;
    mscp:slug "dublin-core_TO_prov" ;
    mscp:sourceId "12" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/12/versions/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/12/versions/2>,
        <https://rdamsc.bath.ac.uk/msc/node/c/12/versions/3> .

msc:c13 a msct:c ;
    mscp:description "<p>An XML Stylesheet for transforming EML XML files into ISO 19139 XML files, compliant with the ISO 19115 metadata standard.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/13/locations/1> ;
    mscp:slug "eml-ecological-metadata_TO_iso-19115" ;
    mscp:sourceId "13" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/13/versions/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/13/versions/2> .

msc:c14 a msct:c ;
    mscp:creators <https://rdamsc.bath.ac.uk/msc/node/c/14/creators/1> ;
    mscp:description "<p>This document describes how to map from the EURISCO Descriptors to ABCD v2.06, and is aimed at data originating in the ECPGR (European Co-operative Programme for Plant Genetic Resources) EURISCO National Inventories.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/14/locations/1> ;
    mscp:slug "eurisco-descriptors_TO_abcd-access-biological" ;
    mscp:sourceId "14" ;
    mscp:sourceSection "c" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/c/14/versions/1> .

msc:c15 a msct:c ;
    mscp:description "<p>This crosswalk indicates how to transform FGDC CSDGM Biological Data Profile metadata to ISO 19115. It provides comments for suggested best practices and incorporates feature catalogs (ISO 19110) and coordinate reference systems (ISO 19111). An XML Stylesheet is provided for implementing the transformation. This is one of a set of <a href=\"http://www.ncddc.noaa.gov/metadata-standards/metadata-xml/\">FGDC XML transformations</a> produced by NOAA (National Oceanic and Atmospheric Administration).</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/15/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/15/locations/2> ;
    mscp:slug "fgdccsdgm-biological-data_TO_iso-19115" ;
    mscp:sourceId "15" ;
    mscp:sourceSection "c" .

msc:c16 a msct:c ;
    mscp:description "<p>This document describes how to map from FGDC/CSDGM to DIF, including a comparison of their respective mandatory fields.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/16/locations/1> ;
    mscp:slug "fgdccsdgm-federal-geographic_TO_dif-directory-interchange" ;
    mscp:sourceId "16" ;
    mscp:sourceSection "c" .

msc:c17 a msct:c ;
    mscp:description "<p>This crosswalk indicates how to transform FGDC CSDGM to ISO 19115. It provides comments for suggested best practices and incorporates feature catalogs (ISO 19110) and coordinate reference systems (ISO 19111). An XML Stylesheet is provided for implementing the transformation. This is one of a set of <a href=\"http://www.ncddc.noaa.gov/metadata-standards/metadata-xml/\">FGDC XML transformations</a> produced by NOAA (National Oceanic and Atmospheric Administration).</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/17/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/c/17/locations/2> ;
    mscp:slug "fgdccsdgm-federal-geographic_TO_iso-19115" ;
    mscp:sourceId "17" ;
    mscp:sourceSection "c" .

msc:c18 a msct:c ;
    mscp:creators <https://rdamsc.bath.ac.uk/msc/node/c/18/creators/1> ;
    mscp:description "<p>This document describes how to convert a HISPID3 metatadata file into an ABCD 1.49d XML file.</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/18/locations/1> ;
    mscp:slug "hispid-herbarium-information_TO_abcd-access-biological" ;
