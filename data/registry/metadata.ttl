    mscp:slug "text-encoding-initiative" ;
    mscp:sourceId "120" ;
    mscp:sourceSection "g" ;
    mscp:types "standards body" .

msc:g123 a msct:g ;
    mscp:description "Research Object is a community effort to develop mechanisms to capture, describe and publish the aggregation of digital research outputs as a structured artifact in its own right, using existing Linked Data standards." ;
