    mscp:slug "isa-tab_TO_mage-tab" ;
    mscp:sourceId "19" ;
    mscp:sourceSection "c" .

msc:c2 a msct:c ;
    mscp:description "<p>This XML Stylesheet transforms FGDC CSDGM Extensions for Remote Sensing metadata to ISO 19115. This is one of a set of <a href=\"http://www.ncddc.noaa.gov/metadata-standards/metadata-xml/\">FGDC XML transformations</a> produced by NOAA (National Oceanic and Atmospheric Administration).</p>" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/c/2/locations/1> ;
    mscp:slug "csdgm-extensions-for_TO_iso-19115" ;
    mscp:sourceId "2" ;
