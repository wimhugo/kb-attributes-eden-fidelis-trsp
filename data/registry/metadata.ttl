        <https://rdamsc.bath.ac.uk/msc/node/m/1/locations/3> ;
    mscp:slug "abcd-access-biological-collection-data" ;
    mscp:sourceId "1" ;
    mscp:sourceSection "m" ;
    mscp:title "ABCD (Access to Biological Collection Data)" ;
