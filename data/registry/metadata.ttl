    mscp:sourceSection "t" ;
    mscp:title "X3ML Mapping Tool" ;
    mscp:types "graphical (cross-platform)",
        "terminal (cross-platform)",
        "web application" .

msc:t76 a msct:t ;
    mscp:description "FastCat is a Web-based system designed for historians and other researchers who need to manually digitize structured and semi structured archival documents in a fast and accurate way to create their research dataset." ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/t/76/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/t/76/locations/2> ;
    mscp:slug "fastcat" ;
    mscp:sourceId "76" ;
    mscp:sourceSection "t" ;
    mscp:title "FastCat" ;
    mscp:types "web application" .

msc:t77 a msct:t ;
    mscp:creators <https://rdamsc.bath.ac.uk/msc/node/t/77/creators/1>,
        <https://rdamsc.bath.ac.uk/msc/node/t/77/creators/2> ;
    mscp:description "Viewer of DCAT-AP metadata" ;
