    mscp:slug "snrnasm-isa-tab" ;
    mscp:sourceId "76" ;
    mscp:sourceSection "m" ;
    mscp:title "SNRNASM ISA-Tab" .

msc:m77 a msct:m ;
    mscp:description "<p>A profile of the Data Package specification, intended for exchanging tabular data in CSV (comma-separated values) format.</p>" ;
