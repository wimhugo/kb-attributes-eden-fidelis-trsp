msc:g142 a msct:g ;
    mscp:description """<p>The National Gallery houses the national collection of paintings in the Western European tradition from the 13th to the 19th centuries.</p>\r
\r
<p>"Research is a constant and fundamental activity at the National Gallery, helping to underpin many areas of our work" <a href="https://www.nationalgallery.org.uk/research/about-research">https://www.nationalgallery.org.uk/research/about-research</a></p>""" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/g/142/locations/1> ;
