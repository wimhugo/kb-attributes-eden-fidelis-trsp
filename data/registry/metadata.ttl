msc:m73 a msct:m ;
    mscp:description "<p>A specification of how to embed OME-XML metadata within a <a href=\"http://partners.adobe.com/public/developer/tiff/\">TIFF</a> or <a href=\"http://bigtiff.org/\">BigTIFF</a> image file.</p>" ;
    mscp:keywords <http://vocabularies.unesco.org/thesaurus/concept221>,
        <http://vocabularies.unesco.org/thesaurus/concept227>,
        <http://vocabularies.unesco.org/thesaurus/concept235>,
        <http://vocabularies.unesco.org/thesaurus/concept2396>,
        <http://vocabularies.unesco.org/thesaurus/concept4260>,
        <http://vocabularies.unesco.org/thesaurus/concept4262> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/73/locations/1> ;
    mscp:slug "ome-tiff-open-microscopy-environment-tiff" ;
    mscp:sourceId "73" ;
    mscp:sourceSection "m" ;
    mscp:title "OME-TIFF (Open Microscopy Environment TIFF)" .

msc:m74 a msct:m ;
    mscp:description "<p>Defines metadata terms and concepts necessary for discovery and use of astronomical data collections and services.</p><p>The extension is based on Dublin Core, but with astronomy-specific extensions.  Resource Metadata are collected in resource \"registries\" that are populated and synchronized using the OAI-PMH (Protocol for Metadata Handling). Version 1.12, March 2007. Developed and maintained by IVOA Resource Registry Working Group and NVO Metadata Working Group</p>" ;
    mscp:keywords <http://vocabularies.unesco.org/thesaurus/concept152> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/74/locations/1> ;
    mscp:slug "resource-metadata-virtual-observatory" ;
    mscp:sourceId "74" ;
    mscp:sourceSection "m" ;
    mscp:title "Resource Metadata for the Virtual Observatory" .

msc:m75 a msct:m ;
    mscp:description "<p>Providing the format and content for describing data sets related to shoreline and other coastal data sets, this profile complies with the FGDC/CSDGM standard.</p>" ;
    mscp:keywords <http://rdamsc.bath.ac.uk/thesaurus/subdomain250>,
        <http://vocabularies.unesco.org/thesaurus/concept175> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/75/locations/1> ;
    mscp:slug "shoreline-metadata-profile" ;
    mscp:sourceId "75" ;
    mscp:sourceSection "m" ;
    mscp:title "Shoreline Metadata Profile" .

msc:m76 a msct:m ;
    mscp:description "<p>An ISA-Tab-based standard for reporting the results of single nucleotide resolution nucleic acid structure mapping experiments.</p>" ;
    mscp:keywords <http://vocabularies.unesco.org/thesaurus/concept218>,
