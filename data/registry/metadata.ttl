msc:c25 a msct:c ;
    mscp:sourceId "25" ;
    mscp:sourceSection "c" .

msc:g102 a msct:g ;
    mscp:description """The Insight Centre for Data Analytics was formed in 2013 as a collaboration between Dublin City University; the National University of Ireland, Galway; University College Cork; University College Dublin; and other partner institutions. It merged several existing research centres, including the Digital Enterprise Research Institute (<a href="https://web.archive.org/web/20190618125531/http://www.deri.ie/">DERI</a>), part of NUI Galway and a centre of expertise in linked data and the Semantic Web.\r
""" ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/g/102/locations/1> ;
    mscp:name "Insight Centre for Data Analytics" ;
    mscp:slug "deri" ;
    mscp:sourceId "102" ;
    mscp:sourceSection "g" ;
    mscp:types "professional group" .

msc:g117 a msct:g ;
    mscp:description "The MODS Implementation Registry contains descriptions of MODS projects planned, in progress, and fully implemented. The registry is maintained by the Library of Congress Network Development and MARC Standards Office and contains around 40 examples of repositories, institutions, and tools that use MODS-encoded metadata." ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/g/117/locations/1> ;
    mscp:name "MODS Implementation Registry" ;
    mscp:slug "mods-implementation-registry" ;
    mscp:sourceId "117" ;
    mscp:sourceSection "g" ;
    mscp:types "coordination group" .

msc:g150 a msct:g ;
    mscp:description "The National Library of Technology (NTK) is the largest and the oldest library of science and technology literature in the Czech Republic, with a collection of almost 1 million volumes. Its primary function is to provide specialized information resources and services to students, teachers, and researchers in the fields of engineering and applied sciences, as well as to educate members of the general public interested in STEM information. NTK aims to be a top centre of information, providing academic and business services and thus support research, education and innovation on national and international levels." ;
    mscp:identifiers <https://rdamsc.bath.ac.uk/msc/node/g/150/identifiers/1> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/g/150/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/g/150/locations/2> ;
    mscp:name "National Library of Technology" ;
    mscp:slug "national-library-of-technology" ;
    mscp:sourceId "150" ;
    mscp:sourceSection "g" ;
    mscp:types "archive" .

msc:m104 a msct:m ;
    mscp:dataTypes msc:datatype2 ;
    mscp:description "RDA: Resource Description and Access is a package of data elements, guidelines, and instructions for creating library and cultural heritage resource metadata that are well-formed according to international models for user-focused linked data applications." ;
    mscp:keywords <http://vocabularies.unesco.org/thesaurus/concept515> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/104/locations/1> ;
    mscp:slug "rda-resource-description-access" ;
    mscp:sourceId "104" ;
    mscp:sourceSection "m" ;
    mscp:title "RDA (Resource Description Access)" .

msc:m105 a msct:m ;
    mscp:dataTypes msc:datatype2 ;
    mscp:description "Plasma-MDS is used to provide structured disciplinary metadata to data sets in the field of plasma science and technology. Its main aim is to facilitate the discovery and exchange of research data in this field." ;
    mscp:identifiers <https://rdamsc.bath.ac.uk/msc/node/m/105/identifiers/1> ;
    mscp:keywords <http://rdamsc.bath.ac.uk/thesaurus/subdomain220>,
        <http://vocabularies.unesco.org/thesaurus/concept10932>,
        <http://vocabularies.unesco.org/thesaurus/concept132> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/105/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/m/105/locations/2>,
        <https://rdamsc.bath.ac.uk/msc/node/m/105/locations/3> ;
    mscp:slug "plasma-mds-plasma-metadata-schema" ;
    mscp:sourceId "105" ;
    mscp:sourceSection "m" ;
    mscp:title "Plasma-MDS (Plasma Metadata Schema)" .

msc:m107 a msct:m ;
    mscp:description "<p>OpenPMD provides naming and attribute conventions that allow the exchange of particle and mesh based data from scientific simulations and experiments. The primary goal is to define a minimal set/kernel of meta information that enables the sharing and exchange of data to achieve</p><ul><li>portability between various applications and differing algorithms;</li><li>a unified open-access description for scientific data (publishing and archiving);</li><li>a unified description for post-processing, visualization and analysis.</li></ul><p>OpenPMD suits any kind of hierarchical, self-describing data format, such as, but not limited to ADIOS1 (BP3), ADIOS2 (BP4), HDF5, JSON, and XML.</p>" ;
    mscp:identifiers <https://rdamsc.bath.ac.uk/msc/node/m/107/identifiers/1> ;
    mscp:keywords <http://rdamsc.bath.ac.uk/thesaurus/subdomain230>,
        <http://vocabularies.unesco.org/thesaurus/concept123>,
        <http://vocabularies.unesco.org/thesaurus/concept127>,
        <http://vocabularies.unesco.org/thesaurus/concept128>,
        <http://vocabularies.unesco.org/thesaurus/concept144> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/107/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/m/107/locations/2> ;
    mscp:slug "openpmd-open-standard-for-particle-mesh-data" ;
    mscp:sourceId "107" ;
    mscp:sourceSection "m" ;
    mscp:title "openPMD (Open Standard for Particle-Mesh Data)" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/m/107/versions/1>,
        <https://rdamsc.bath.ac.uk/msc/node/m/107/versions/2>,
        <https://rdamsc.bath.ac.uk/msc/node/m/107/versions/3> .

msc:m108 a msct:m ;
    mscp:dataTypes msc:datatype2 ;
    mscp:description "<p>MIxS is a superset of metadata elements that can be used to compile minimum information checklists for reporting sequencing data. It was developed by the Genomic Standards Consortium (GSC) as an overarching framework that could act as a single entry point for all their minimum information checklists (as reported in Nature Biotechnology).</p><p>MIxS includes the technology-specific checklists from the previous MIGS and MIMS standards (for genomes and metagenomes respectively), provides a way of introducing additional checklists such as MIMARKS (for marker sequences), and also allows annotation of sample data using environmental packages.</p>" ;
    mscp:keywords <http://rdamsc.bath.ac.uk/thesaurus/subdomain255>,
        <http://rdamsc.bath.ac.uk/thesaurus/subdomain270>,
        <http://vocabularies.unesco.org/thesaurus/concept16998> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/108/locations/1> ;
    mscp:namespaces <https://rdamsc.bath.ac.uk/msc/node/m/108/namespaces/1> ;
    mscp:slug "minimum-information-about-any-x-sequence-mixs" ;
    mscp:sourceId "108" ;
    mscp:sourceSection "m" ;
    mscp:title "MIxS (Minimum Information about Any Sequence)" ;
    mscp:versions <https://rdamsc.bath.ac.uk/msc/node/m/108/versions/1>,
        <https://rdamsc.bath.ac.uk/msc/node/m/108/versions/2>,
        <https://rdamsc.bath.ac.uk/msc/node/m/108/versions/3>,
        <https://rdamsc.bath.ac.uk/msc/node/m/108/versions/4> .

msc:m112 a msct:m ;
    mscp:dataTypes msc:datatype2 ;
    mscp:description "Recommended Metadata for Biological Images (REMBI) provides guidelines for metadata for biological images to enable the FAIR sharing of scientific data. REMBI is the result of the bioimaging community coming together to develop metadata standards that describe the imaging data itself, together with supporting metadata such as those describing the biological study and sample." ;
    mscp:keywords <http://rdamsc.bath.ac.uk/thesaurus/subdomain270> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/112/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/m/112/locations/2> ;
    mscp:slug "rembi-recommended-metadata-for-biological-images" ;
    mscp:sourceId "112" ;
    mscp:sourceSection "m" ;
    mscp:title "REMBI (Recommended Metadata for Biological Images)" .

msc:m113 a msct:m ;
    mscp:dataTypes msc:datatype2 ;
    mscp:description "A simple and intuitive way to organize and describe your neuroimaging and behavioral data." ;
    mscp:keywords <http://vocabularies.unesco.org/thesaurus/concept4041>,
        <http://vocabularies.unesco.org/thesaurus/concept4295>,
        <http://vocabularies.unesco.org/thesaurus/concept4304> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/113/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/m/113/locations/2> ;
    mscp:slug "brain-imaging-data-structure-bids" ;
    mscp:sourceId "113" ;
    mscp:sourceSection "m" ;
    mscp:title "Brain Imaging Data Structure (BIDS)" .

msc:m122 a msct:m ;
    mscp:dataTypes msc:datatype2 ;
    mscp:description "The Component Metadata Infrastructure provides a framework to create and use self-defined metadata formats. It relies on a modular model of so-called metadata components, which can be assembled together, to improve reuse, interoperability and cooperation among metadata modelers. The model is standardised in ISO 24622-1 and ISO 24622-2. The serialization is typically in XML. Metadata in this format are often distributed via OAI-PMH. The definition of data categories is provided externally, for example by linking to schema.org or the Clarin Concept Registry. " ;
    mscp:keywords <http://rdamsc.bath.ac.uk/thesaurus/domain3>,
        <http://rdamsc.bath.ac.uk/thesaurus/subdomain330>,
        <http://vocabularies.unesco.org/thesaurus/concept11044>,
        <http://vocabularies.unesco.org/thesaurus/concept11870>,
        <http://vocabularies.unesco.org/thesaurus/concept17010>,
        <http://vocabularies.unesco.org/thesaurus/concept17107>,
        <http://vocabularies.unesco.org/thesaurus/concept3052>,
        <http://vocabularies.unesco.org/thesaurus/concept308>,
        <http://vocabularies.unesco.org/thesaurus/concept7442>,
        <http://vocabularies.unesco.org/thesaurus/concept8030>,
        <http://vocabularies.unesco.org/thesaurus/concept8129> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/122/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/m/122/locations/2>,
        <https://rdamsc.bath.ac.uk/msc/node/m/122/locations/3>,
        <https://rdamsc.bath.ac.uk/msc/node/m/122/locations/4> ;
    mscp:namespaces <https://rdamsc.bath.ac.uk/msc/node/m/122/namespaces/1> ;
    mscp:slug "cmdi-component-metadata-infrastructure" ;
    mscp:sourceId "122" ;
    mscp:sourceSection "m" ;
    mscp:title "CMDI (Component Metadata Infrastructure)" .

msc:m132 a msct:m ;
    mscp:dataTypes msc:datatype2 ;
    mscp:description "The geocore format is a standardless format that is able to store various metadata fields. It is based on the geoJSON format where the properties field of the geoJSON file stores the metadata for each record." ;
    mscp:keywords <http://vocabularies.unesco.org/thesaurus/concept17000> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/132/locations/1> ;
    mscp:slug "geocore" ;
    mscp:sourceId "132" ;
    mscp:sourceSection "m" ;
    mscp:title "geocore" .

msc:m134 a msct:m ;
    mscp:dataTypes msc:datatype2 ;
    mscp:description "Achieving FAIRness and Openness of (marine) image data requires structured and standardised metadata on the image data itself and the visual and semantic image data content. This metadata shall be provided in the form of FAIR digital objects (FDOs). " ;
    mscp:keywords <http://vocabularies.unesco.org/thesaurus/concept2634> ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/m/134/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/m/134/locations/2> ;
    mscp:slug "ifdo-image-fair-digital-object" ;
    mscp:sourceId "134" ;
    mscp:sourceSection "m" ;
    mscp:title "iFDO - image FAIR Digital Object" .

