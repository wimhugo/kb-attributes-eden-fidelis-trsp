msc:m94 a msct:m ;
    mscp:dataTypes msc:datatype1 ;
    mscp:description "Describes the format of the generic metadata artifacts—the templates, elements, and instances—that make up the CEDAR metadata framework and allow for exchange of the metadata artifacts with external systems." ;
