    mscp:sourceSection "m" ;
    mscp:title "MEDIN discovery metadata standard" .

msc:m125 a msct:m ;
    mscp:dataTypes msc:datatype2 ;
    mscp:description "CSV on the Web is a W3C Recommendation for describing CSV files on the Web, ensuring their proper description, including mapping to JSON and RDF formats." ;
    mscp:keywords <http://rdamsc.bath.ac.uk/thesaurus/domain0> ;
