        "professional group" .

msc:g144 a msct:g ;
    mscp:description "MEDIN is a partnership of UK organisations committed to improving access to UK marine data. Sponsored by a consortium of 15 sponsors and partnered with over 50 organisations, MEDIN is open to all with an interest in marine data and information. " ;
    mscp:locations <https://rdamsc.bath.ac.uk/msc/node/g/144/locations/1>,
        <https://rdamsc.bath.ac.uk/msc/node/g/144/locations/2> ;
