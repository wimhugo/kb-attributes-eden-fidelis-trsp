@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

trsp:standardsRegistry a skos:ConceptScheme ;
    skos:prefLabel "RDMI Standards Registry — Starter Exemplar"@en ;
    dct:description "Curated placeholder registry for unambiguous references to web, repository, research-data, preservation, security and interoperability standards and specifications."@en .

# Properties and classes

trsp:Standard a rdfs:Class ;
    rdfs:label "Standard"@en .
    trsp:authority a rdf:Property .
    trsp:identifierScheme a rdf:Property .
    trsp:version a rdf:Property .
    trsp:resourceType a rdf:Property .
    trsp:status a rdf:Property .
    trsp:canonicalURL a rdf:Property .
    trsp:standardFamily a rdf:Property .
    trsp:canonicalReferenceQuality a rdf:Property .

trsp:w3c-rdf11-concepts a skos:Concept ;
