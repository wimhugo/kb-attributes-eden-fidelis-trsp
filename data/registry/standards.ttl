    trsp:version "1.1" ;
    trsp:resourceType "Web Standard" ;
    trsp:status "Current Recommendation" ;
    trsp:canonicalURL <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/> ;
    trsp:standardFamily "RDF" ;
    trsp:canonicalReferenceQuality "A — authoritative persistent identifier/registry" ;
    skos:note "Core RDF data model."@en .

