@prefix trsp: <https://w3id.org/openrel/> .

# ==================================================================================================================
# SECTION 1: PROVENANCE AND METADATA
# Describes the dataset itself — who generated it, when, and how.
# ==================================================================================================================

trsp:provenanceGraph {
    <<27996357+wimhugo@users.noreply.github.com>> a prov:Activity ;
        prov:startedAtTime "2026-09-15T16:34:00.027Z"^^xsd:dateTime ;
        rdfs:label "Automated graph curation" .
}

