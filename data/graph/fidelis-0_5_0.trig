        fidelis:keyStakeholders "ESRF (intergovernmental organisation of 22 countries); national member/associate country governments; ~6,500 visiting scientists annually; PaNOSC and LEAPS partner facilities" ;
        fidelis:licence "CC-BY" ;
        fidelis:memberships "PaNOSC (Photon and Neutron Open Science Cloud); LEAPS (League of European Accelerator-based Photon Sources); EOSC; ExPaNDS; OpenAIRE; Calipsoplus; FAIRsFAIR" ;
        fidelis:persistentIdentifierSystem "DOI" ;
        fidelis:preservationPolicy "Metadata preserved forever; raw data preserved minimum 10 years; high-value datasets preserved longer; CoreTrustSeal certified for data management standards" ;
        fidelis:primaryResearchDomains "Physical Sciences" ;
        fidelis:purpose "Data repository for photon science experiments conducted at the ESRF synchrotron. Stores and archives raw experimental data, processed data, and associated metadata from X-ray science experiments at the ESRF beamlines. Implements the ESRF Open Data Policy (2016). Data released publicly after embargo (maximum 3 years). First synchrotron repository to receive CoreTrustSeal certification." ;
        fidelis:repositoryName "ESRF Data Portal" ;
        fidelis:typeOfRepository "Disciplinary" ;
        fidelis:url <https://data.esrf.fr/> ;
        fidelis:vocabulariesUsed "NeXus/HDF5 standard; ICAT metadata catalogue schema; DataCite Metadata Schema; PaN ontologies; Phenix/CCP4 crystallographic standards" ;
        fidelis:yearEstablished "2016" .

