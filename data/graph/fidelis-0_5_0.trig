    fidelis:graph.000BEFE6 fidelis:apisAvailable "REST API" ;
        fidelis:certifications "None" ;
        fidelis:comments "DOME recommendations published in Nature Methods 2021; DOME Registry paper published GigaScience 2024 (arXiv 2408.07721); GigaScience and other journals adopting DOME workflow; integrates with ORCID and APICURON for credit attribution" ;
