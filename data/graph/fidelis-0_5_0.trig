    fidelis:graph.001E7677 fidelis:apisAvailable "REST API" ;
        fidelis:certifications "CoreTrustSeal (certified 2023–2026)" ;
        fidelis:comments "ESRF data policy adopted 2016; first data portal released 2018; CoreTrustSeal certified 2023 (first PaNOSC facility); coordinated PaNOSC project; DRAC (Data Repository for Advancing Open Science) system; ~2,839 public + 6,398 embargoed collections" ;
        fidelis:coretrustsealCertificationStatus "Certified" ;
        fidelis:countryRegion "France / European (intergovernmental)" ;
        fidelis:dataAccessPolicy "Data embargoed for up to 3 years after experiment; released publicly after embargo expires; proposers access their own data immediately; metadata always open" ;
        fidelis:dataRetentionPolicy "Metadata: forever; raw data: minimum 10 years" ;
        fidelis:dataTypesAccepted "Raw and processed X-ray experimental data; photon science data; macromolecular crystallography data; tomography data; spectroscopy data; scattering data; metadata from ICAT system" ;
        fidelis:depositPolicy "ESRF users (scientists who conducted experiments at ESRF beamlines); data embargo system; open access after embargo; DOIs assigned to all datasets" ;
        fidelis:endorsedTrustPrinciples "Yes" ;
        fidelis:eoscNodeParticipation "Yes – ESRF is active participant in EOSC via PaNOSC and ExPaNDS projects; ESRF data portal accessible through EOSC marketplace; coordinated PaNOSC project implementing open science cloud for photon and neutron facilities" ;
        fidelis:fileFormats "HDF5 (NeXus format), EDF (ESRF Data Format), TIFF/CBFLIB for crystallography, CBF, HDF5/Nexus files; format depends on beamline technique" ;
        fidelis:fundingModel "Institutional support" ;
        fidelis:governanceModel "Institutional" ;
        fidelis:governanceStructure "Institutional – operated by ESRF staff; governed by ESRF Council of 22 member countries; ESRF is an intergovernmental organisation" ;
