    # Example: reusable SPARQL lookup template for service types.
    trsp:lookupServiceType
        a trsp:LookupMapping ;
        trsp:sparqlQuery trsp:queryServiceType .

    trsp:queryServiceType
        a sp:Select ;
        sp:text """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

            SELECT DISTINCT ?inputValue ?concept
            WHERE {
                VALUES ?inputValue {
                    {{INPUT_VALUES}}
                }

                ?concept a skos:Concept ;
                         skos:inScheme {{CONCEPT_SCHEME}} ;
                         (skos:prefLabel|skos:altLabel) ?label .

                FILTER(
                    LCASE(STR(?label)) =
                    LCASE(STR(?inputValue))
                )
            }
        """ .
