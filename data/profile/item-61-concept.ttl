# FIDELIS provisional concept schemes; each scheme is followed by its concepts.

# typeApisAvailable
fidelisconcept:typeApisAvailable a skos:ConceptScheme ;
    skos:prefLabel "apisAvailable types"@en ;
    skos:definition "Distinct values observed in the FIDELIS raw data for fidelis:apisAvailable. Provisional extraction; not yet normalised or mapped."@en .

fidelisconcept:typeApisAvailable-NoApisAvailable a skos:Concept ;
    skos:prefLabel "No APIs available"@en ;
    skos:inScheme fidelisconcept:typeApisAvailable .

fidelisconcept:typeApisAvailable-OaiPmh a skos:Concept ;
    skos:prefLabel "OAI-PMH"@en ;
    skos:inScheme fidelisconcept:typeApisAvailable .

fidelisconcept:typeApisAvailable-RestApi a skos:Concept ;
    skos:prefLabel "REST API"@en ;
    skos:inScheme fidelisconcept:typeApisAvailable .

fidelisconcept:typeApisAvailable-RestApiOaiPmh a skos:Concept ;
    skos:prefLabel "REST API, OAI-PMH"@en ;
    skos:inScheme fidelisconcept:typeApisAvailable .

fidelisconcept:typeApisAvailable-SparqlEndpoint a skos:Concept ;
    skos:prefLabel "SPARQL endpoint"@en ;
    skos:inScheme fidelisconcept:typeApisAvailable .


