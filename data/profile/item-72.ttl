trsp:profile.2F48DA2962 a trsp:Profile ;
    dct:title "HARVESTER" @en ;
    dct:description "The profile for the EDEN Harvester" @en ;
    dct:identifier "eden://harvester/"  ;
    dcat:endpointURL <https://github.com/EOSC-EDEN/wp2-repo-harvester>  ;
    trsp:hasProfileType "trsp:profile-type-community"  .

foaf:name a trsp:Property ;
    rdf:label "Repository name" ;
    skos:definition "The name or title of the repository or service" ;
    trsp:linkedProperty trsp:repositoryName ;
    skos:exactMatch trsp:att.64DA341B5F ;
    trsp:hasProfile trsp:profile.3C2D6C1C37 ;
    rdfs:domain foaf:Agent ;
    trsp:hasCardinalityType trsp:cardinality1_1 ;
    trsp:hasMeasurementType trsp:measurementTypeFormat ;
    trsp:hasBenchmark "^^xsd:string" ;
    owl:version "0.4.1" .

