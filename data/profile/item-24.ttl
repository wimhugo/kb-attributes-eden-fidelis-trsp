cpp:CCP-001-01 a trsp:Property ;
    rdf:label "Checksum Generation and Recording" ;
    skos:definition "The TDA (Trustworthy Digital Archive) records checksums for every File." ;
    schema:category "Responsibility|Stewardship|Integrity and Authenticity" ;
    trsp:linkedProperty trsp:checkedForChecksum ;
    skos:exactMatch trsp:att.4B8DBC2795 ;
    dcat:keyword "CPP" ;
    trsp:hasCardinalityType trsp:cardinality0_1 ;
    trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
    owl:version "0.4.1" .

