trsp:missionMandate a trsp:Property ;
    skos:prefLabel "Mission and Mandate" ;
    skos:definition "The organisation is mandated to perform the services it offers, and this is clearly stated in publicly available documentation. The organisation is focused on the mission and does not divert resources to other focus areas. The mission is mandated and approved at an appropriate level (e.g. board level)." ;
