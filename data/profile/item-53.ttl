trsp:profile.61E7538E10 a trsp:Profile ;
    dct:title "EDEN" @en ;
    dct:description "The EOSC EDEN project seeks to understand the current digital preservation landscape", "identify common standards and practices", "and provide new solutions and approaches that help institutions select and preserve high-quality FAIR research outputs." @en ;
    dct:identifier <https://eden-fidelis.eu/>  ;
    dcat:endpointURL <https://eden-fidelis.eu/>  ;
    trsp:hasProfileType "trsp:profile-type-community"  .

