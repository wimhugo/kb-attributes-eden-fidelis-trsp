<https://hypothes.is/a/_WK3gKGYEe-QK3N254EDcQ>
    a oa:Annotation ;
    dct:subject "TRSP", "CARE", "Responsibility", "Postitive Relations" ;
    oa:hasBody [
        a oa:TextualBody ;
        rdf:value
            "TRSP Desirable Characteristics \nIndigenous data use is unviable unless linked to relationships built on respect, reciprocity, trust, and mutual understanding, as defined by the Indigenous Peoples to whom those data relate. Those working with Indigenous data are responsible for ensuring that the creation, interpretation, and use of those data uphold, or are respectful of, the dignity of Indigenous nations and communities."
    ] ;

    oa:hasTarget [
        a oa:SpecificResource ;

        oa:hasSource
            <https://www.gida-global.org/care> ;

        oa:hasSelector [
