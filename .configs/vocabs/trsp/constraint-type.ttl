############################################################################################################################
#  Constraint types
#  Limitations on the type of benchmark values
############################################################################################################################

@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

trsp:typeConstraint a skos:ConceptScheme ;
  dct:created "2026-04-29T00:00:00+00:00"^^xsd:datetime;
  dct:creator <https://orcid.org/0000-0002-0255-5101>;
  dct:contributor <https://orcid.org/0000-0003-1106-8441>;
  dct:description "Constraint Types determine the type of value applicable to a benchmark"@en;
  dct:modified "2026-04-29T00:00:00+00:00"^^xsd:datetime;
  dct:rights <https://spdx.org/licenses/CC0-1.0>;
  dct:title "TRSP Constraint Types"@en;
  skos:prefLabel "TRSP Constraint Types"@en;
  owl:versionInfo "0.0.1"@en;
  foaf:homepage  <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:iriConstraint
    a skos:Concept ;
    skos:inScheme trsp:typeConstraint ;
    skos:prefLabel "IRI Constraint"@en ;
    skos:definition "Benchmark evidence can be any local or external URI or URL"@en ;
    .

trsp:datatypeConstraint
    a skos:Concept ;
    skos:inScheme trsp:typeConstraint ;
    skos:prefLabel  "Data Type constraint"@en ;
    skos:definition "Benchmark evidence can be any local or external URI or URL"@en ;
    .

trsp:vocabularyConstraint
    a skos:Concept ;
    skos:inScheme trsp:typeConstraint ;
    skos:prefLabel  "Vocabulary constraint"@en ;
    .

trsp:classConstraint
    a skos:Concept ;
    skos:inScheme trsp:typeConstraint ;
    skos:prefLabel  "Class constraint"@en ;
    .
