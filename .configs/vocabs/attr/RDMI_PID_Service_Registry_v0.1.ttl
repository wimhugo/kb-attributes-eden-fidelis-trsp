    dct:source pidreg:uploadedInventory .

pid_graph:9C827E94
    a pidreg:PIDService ;
    skos:prefLabel "OpenURL"@en ;
    skos:definition "An OpenURL is similar to a web address, but instead of referring to a physical website, it refers to an article, book, patent, or other resource within a website"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:F12AD34E
    a pidreg:PIDService ;
    skos:prefLabel "URI"@en ;
    skos:definition "String of characters used to identify a name of a resource on a network such as the internet"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:5CEA29B9
    a pidreg:PIDService ;
    skos:prefLabel "GRID"@en ;
    skos:definition "International coverage of the world's leading research organisations, indexing 92% of funding allocated globally."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:998B7874
    a pidreg:PIDService ;
    skos:prefLabel "DCO-ID"@en ;
    skos:definition "Digital object registration includes DCO-ID generation based on the global Handle System infrastructure and metadata collection using VIVO."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:3E6F3EE6
    a pidreg:PIDService ;
    skos:prefLabel "DOI"@en ;
