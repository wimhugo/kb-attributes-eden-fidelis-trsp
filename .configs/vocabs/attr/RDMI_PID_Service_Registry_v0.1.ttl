    dct:source pidreg:uploadedInventory .

pid_graph:4EA08A5A
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:IT"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:83FC72F3
    a pidreg:PIDService ;
    skos:prefLabel "IMDb company ID"@en ;
