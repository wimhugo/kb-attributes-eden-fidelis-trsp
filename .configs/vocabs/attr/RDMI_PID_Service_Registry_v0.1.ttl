    dct:source pidreg:uploadedInventory .

pid_graph:DDB8E5B0
    a pidreg:PIDService ;
    skos:prefLabel "IMDb name ID"@en ;
    skos:definition "ID that characterize a person on Internet Movie Database"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:9D46195A
    a pidreg:PIDService ;
    skos:prefLabel "IMDb title ID"@en ;
    skos:definition "ID that characterize a movie on Internet Movie Database"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:7EBD4614
    a pidreg:PIDService ;
    skos:prefLabel "URN:ISRC"@en ;
    skos:definition "international standard code for uniquely identifying sound recordings and music video recordings"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:52EBCE9D
    a pidreg:PIDService ;
    skos:prefLabel "URN:ISBN"@en ;
    skos:definition "The International Standard Book Number (ISBN) is for identifying printed books."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:C2989F23
    a pidreg:PIDService ;
    skos:prefLabel "URN:OID"@en ;
    skos:definition "OIDs provide a persistent identification of objects based on a hierarchical structure of Registration Authorities (RA), where each parent has an object identifier and allocates object identifiers to child nodes."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:8A464A0E
    a pidreg:PIDService ;
    skos:prefLabel "ISLRN"@en ;
    skos:definition "The International Standard Language Resource Number (ISLRN) is a new, unique and universal identification schema for Language Resources which provides Language Resources with unique names using a standardized nomenclature. It also ensures Language Resources are identified, and consequently recognized with proper references in activities within Human Language Technologies, as well as in documents and scientific papers."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:D75629BE
    a pidreg:PIDService ;
    skos:prefLabel "PURL"@en ;
    skos:definition "A PURL is a Persistent Uniform Resource Locator"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:D1BA9B24
    a pidreg:PIDService ;
    skos:prefLabel "dPID"@en ;
    skos:definition "DIDs (dPIDs) are a new type of identifier that enables verifiable, self-sovereign digital identity using blockchain and DLT. DIDs are an effort by the W3C Credentials Community Group and the wider Internet identity community to define identifiers that can be registered, updated, resolved, and revoked without any dependency on a central authority or intermediary."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:DE9F6BF4
    a pidreg:PIDService ;
    skos:prefLabel "URN:ISAN"@en ;
    skos:definition "International Standard Audiovisual Number (ISAN) is a unique identifier for audiovisual works and related versions, similar to ISBN for books"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:710BC55E
    a pidreg:PIDService ;
    skos:prefLabel "URN:ISNI"@en ;
    skos:definition "16-digit identifier for people and organisations ISNI is the ISO certified global standard number for identifying the millions of contributors to creative works and those active in their distribution, including researchers, inventors, writers, artists, visual creators, performers, producers, publishers, aggregators, and more. It is part of a family of international standard identifiers that includes identifiers of works, recordings, products and right holders in all repertoires, e.g. DOI, ISAN, ISBN, ISRC, ISSN, ISTC, and ISWC. The mission of the ISNI International Authority (ISNI-IA) is to assign to the public name(s) of a researcher, inventor, writer, artist, performer, publisher, etc. a persistent unique identifying number in order to resolve the problem of name ambiguity in search and discovery; and diffuse each assigned ISNI across all repertoires in the global supply chain so that every published work can be unambiguously attributed to its creator wherever that work is described."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:986D97DF
    a pidreg:PIDService ;
    skos:prefLabel "SBN/ ICCU"@en ;
    skos:definition "identifier issued by National Library Service (SBN) of Italy"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:6FA60579
    a pidreg:PIDService ;
    skos:prefLabel "InChI"@en ;
    skos:definition "The IUPAC International Chemical Identifier (InChI) is a non-proprietary identifier for chemical substances that can be used in printed and electronic data sources. It is derived solely from a structural representation of that substance, such that a single compound always yields the same identifier."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:D2BC44A7
    a pidreg:PIDService ;
    skos:prefLabel "InChiKey"@en ;
    skos:definition "The IUPAC International Chemical Identifier (InChI, see MIR:00000383) is an identifier for chemical substances, and is derived solely from a structural representation of that substance. Since these can be quite unwieldly, particularly for web use, the InChIKey was developed. These are of a fixed length (25 character) and were created as a condensed, more web friendly, digital representation of the InChI."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:7D3DC0E1
    a pidreg:PIDService ;
    skos:prefLabel "VIAF"@en ;
    skos:definition "Identifier for the Virtual International Authority File database [format: up to 22 digits]"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:03A715EA1
    a pidreg:PIDService ;
    skos:prefLabel "BibCode"@en ;
    skos:definition "Bibliographic reference code for a journal, maintained by Harvard"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:C8042C4B
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:HR"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:E20D377D
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:SI"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:7380A573
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:SK"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:7E709E593
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:FI"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:E1F68A70
    a pidreg:PIDService ;
    skos:prefLabel "Korean national author ID"@en ;
    skos:definition "The Korean National Author ID system is an identifier used in South Korea to uniquely identify authors, particularly those involved in academic and scholarly publishing."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:8EB6C97D
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:NO"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:882397A9
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:SE"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:369FA36F
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:CZ"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:487BCE7F
    a pidreg:PIDService ;
    skos:prefLabel "Korean national research ID"@en ;
    skos:definition ""@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:56ADD30B
    a pidreg:PIDService ;
    skos:prefLabel "Korean research funding ID"@en ;
    skos:definition ""@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:9A92E859
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:HU"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:075D8338
    a pidreg:PIDService ;
    skos:prefLabel "AID"@en ;
    skos:definition "PubChem BioAssay contains small-molecule and RNAi screening data along with associated annotation information from contributing organizations. BioAssay contains a collection of bioactivity and toxicity data that has greatly supported research in fields such as medicinal chemistry, drug discovery, pharmaceutical genomics and informatics research. As a primary archive, the provenance of all records belongs to the submitter."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:27D128A4
    a pidreg:PIDService ;
    skos:prefLabel "CID"@en ;
    skos:definition "PubChem Compound records are derived summaries that give users access to a rich set of related content. Compound records contain unique chemical structures extracted from contributed Substance records through a process called ‘standardization’. Each Compound record points to at least one Substance record."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:52A9C539
    a pidreg:PIDService ;
    skos:prefLabel "dbGaP ID"@en ;
    skos:definition "The database of Genotypes and Phenotypes (dbGaP) was developed to archive and distribute the data and results from studies that have investigated the interaction of genotype and phenotype in Humans."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:CB69320B
    a pidreg:PIDService ;
    skos:prefLabel "dbVar ID"@en ;
    skos:definition "dbVar is NCBI's database of human genomic Structural Variation — large variants >50 bp including insertions, deletions, duplications, inversions, mobile elements, translocations, and complex variants"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:10C00601
    a pidreg:PIDService ;
    skos:prefLabel "GDS ID"@en ;
    skos:definition "This database stores curated gene expression DataSets, as well as original Series and Platform records in the Gene Expression Omnibus (GEO) repository. Enter search terms to locate experiments of interest. DataSet records contain additional resources including cluster tools and differential expression queries."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:B9A4AB49
    a pidreg:PIDService ;
    skos:prefLabel "Gene ID"@en ;
    skos:definition "Gene integrates information from a wide range of species. A record may include nomenclature, Reference Sequences (RefSeqs), maps, pathways, variations, phenotypes, and links to genome-, phenotype-, and locus-specific resources worldwide."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:D800044E
    a pidreg:PIDService ;
    skos:prefLabel "Genome ID"@en ;
    skos:definition "This resource organizes information on genomes including sequences, maps, chromosomes, assemblies, and annotations."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:B0DD2B6E
    a pidreg:PIDService ;
    skos:prefLabel "GEO ID"@en ;
    skos:definition "This database stores individual gene expression profiles from curated DataSets in the Gene Expression Omnibus (GEO) repository. Search for specific profiles of interest based on gene annotation or pre-computed profile characteristics."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:B36773C9
    a pidreg:PIDService ;
    skos:prefLabel "MeSH ID"@en ;
    skos:definition "MeSH (Medical Subject Headings) is the NLM controlled vocabulary thesaurus used for indexing articles for PubMed."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:FE96C149
    a pidreg:PIDService ;
    skos:prefLabel "MMDB-ID"@en ;
    skos:definition "The Conserved Domain Database (CDD) brings together several collections of multiple sequence alignments representing conserved domains, in addition to NCBI-curated domains that use 3D-structure information explicitly to define domain boundaries and provide insights into sequence/structure/function relationships."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:50E7B5FE
    a pidreg:PIDService ;
    skos:prefLabel "NLM Catalog ID"@en ;
    skos:definition "The NLM Catalog provides access to NLM bibliographic data for journals, books, audiovisuals, computer software, electronic resources and other materials. Links to the library's holdings in LocatorPlus, NLM's online public access catalog, are also provided."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:D8E9EA2D
    a pidreg:PIDService ;
    skos:prefLabel "PMCID"@en ;
    skos:definition "PubMed Central® (PMC) is a free full-text archive of biomedical and life sciences journal literature at the U.S. National Institutes of Health's National Library of Medicine (NIH/NLM)"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:08629E50
    a pidreg:PIDService ;
    skos:prefLabel "PMID"@en ;
    skos:definition "A PMID (PubMed identifier or PubMed unique identifier) is a unique integer value, starting at 1, assigned to each PubMed record."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:AE530285
    a pidreg:PIDService ;
    skos:prefLabel "PopSet ID"@en ;
    skos:definition "The PopSet database is a collection of related DNA sequences derived from population, phylogenetic, mutation and ecosystem studies that have been submitted to GenBank."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:D0FEC2B9
    a pidreg:PIDService ;
    skos:prefLabel "Probe ID"@en ;
    skos:definition "The NCBI Probe Database is a public registry of nucleic acid reagents designed for use in a wide variety of biomedical research applications, together with information on reagent distributors, probe effectiveness, and computed sequence similarities."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:A2F84B54
    a pidreg:PIDService ;
    skos:prefLabel "Protein Cluster ID"@en ;
    skos:definition "This collection of related protein sequences (clusters) consists of proteins derived from the annotations of whole genomes, organelles and plasmids. It currently limited to Archaea, Bacteria, Plants, Fungi, Protozoans, and Viruses"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:4A58E440
    a pidreg:PIDService ;
    skos:prefLabel "Protein GI number"@en ;
    skos:definition "The Protein database is a collection of sequences from several sources, including translations from annotated coding regions in GenBank, RefSeq and TPA, as well as records from SwissProt, PIR, PRF, and PDB. Protein sequences are the fundamental determinants of biological structure and function."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:187B413B
    a pidreg:PIDService ;
    skos:prefLabel "PSSM-ID"@en ;
    skos:definition "CDD is a protein annotation resource that consists of a collection of well-annotated multiple sequence alignment models for ancient domains and full-length proteins."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:D9D0AD30
    a pidreg:PIDService ;
    skos:prefLabel "rs number"@en ;
    skos:definition "dbSNP contains human single nucleotide variations, microsatellites, and small-scale insertions and deletions along with publication, population frequency, molecular consequence, and genomic and RefSeq mapping information for both common variations and clinical mutations."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:8930C278
    a pidreg:PIDService ;
    skos:prefLabel "SID"@en ;
    skos:definition "PubChem Substance is the primary archive for community-provided information about chemical entities."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:22104FE0
    a pidreg:PIDService ;
    skos:prefLabel "SRA ID"@en ;
    skos:definition "Sequence Read Archive (SRA) data, available through multiple cloud providers and NCBI servers, is the largest publicly available repository of high throughput sequencing data. The archive accepts data from all branches of life as well as metagenomic and environmental surveys. SRA stores raw sequencing data and alignment information to enhance reproducibility and facilitate new discoveries through data analysis."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:1D9178F5
    a pidreg:PIDService ;
    skos:prefLabel "TaxID"@en ;
    skos:definition "The Taxonomy Database is a curated classification and nomenclature for all of the organisms in the public sequence databases. This currently represents about 10% of the described species of life on the planet."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:C454BB2B
    a pidreg:PIDService ;
    skos:prefLabel "Toolkit ID"@en ;
    skos:definition "The NCBI C++ Toolkit is a public-domain collection of portable libraries, consisting of a cross-platform application framework and a set of utilities and supporting classes to work with biological data."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:F8110591
    a pidreg:PIDService ;
    skos:prefLabel "NZBN"@en ;
    skos:definition "The NZBN (New Zealand Business Number) is a unique identifier assigned to businesses and other organisations in New Zealand."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:88E37094
    a pidreg:PIDService ;
    skos:prefLabel "BusinessID"@en ;
    skos:definition "In Finland, a code given to businesses and organizations"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:3DA72078
    a pidreg:PIDService ;
    skos:prefLabel "VAT number"@en ;
    skos:definition "Identifier of person or company, used for value added tax purposes"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:C7CE618B
    a pidreg:PIDService ;
    skos:prefLabel "XRI"@en ;
    skos:definition "An Extensible Resource Identifier (abbreviated XRI) is a scheme and resolution protocol for abstract identifiers compatible with Uniform Resource Identifiers and Internationalized Resource Identifiers, developed by the XRI Technical Committee at OASIS"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:AB1807F6
    a pidreg:PIDService ;
    skos:prefLabel "OCLC Control Number"@en ;
    skos:definition "OCLC assigns a unique number to each bibliographic record input into WorldCat."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:6AE88038
    a pidreg:PIDService ;
    skos:prefLabel "OpenCitations Corpus"@en ;
    skos:definition "The OpenCitations Corpus is open repository of scholarly citation data made available under a Creative Commons public domain dedication (CC0), which provides accurate bibliographic references harvested from the scholarly literature that others may freely build upon, enhance and reuse for any purpose, without restriction under copyright or database law."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:152D5274
    a pidreg:PIDService ;
    skos:prefLabel "ORCID"@en ;
    skos:definition "ORCID (Open Researcher and Contributor ID) is an open, non-profit, community-based effort to create and maintain a registry of unique identifiers for individual researchers. ORCID records hold non-sensitive information such as name, email, organization name, and research activities."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:1F0B6419
    a pidreg:PIDService ;
    skos:prefLabel "RIN"@en ;
    skos:definition "A commercial protocol sharing tool, which allows scientists to check in protocols the way that computer scientists check in code"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:59B443C3
    a pidreg:PIDService ;
    skos:prefLabel "JuFo-id"@en ;
    skos:definition "Identifier in the Julkaisufoorumi (Finnish Publication Forum)"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:42740FD8
    a pidreg:PIDService ;
    skos:prefLabel "Ringgold ID"@en ;
    skos:definition "Identifier for organisations in the publishing industry supply chain"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:109F4044
    a pidreg:PIDService ;
    skos:prefLabel "ScopusAuthorID"@en ;
    skos:definition "Identifier for an author assigned in Scopus bibliographic database"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:8A580D4C
    a pidreg:PIDService ;
    skos:prefLabel "SWHID"@en ;
    skos:definition "Persistent identifier of a software source code artifact as archived in the Software Heritage Archive"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:7E709E591
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:CH"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:E775ECFD
    a pidreg:PIDService ;
    skos:prefLabel "URN"@en ;
    skos:definition "Uniform Resource Identifier (URI) that uses the urn scheme"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:7725DE2B
    a pidreg:PIDService ;
    skos:prefLabel "W3ID"@en ;
    skos:definition "Secure, permanent URLs for your Web application that will stand the test of time."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:335BCBF1
    a pidreg:PIDService ;
    skos:prefLabel "QID"@en ;
    skos:definition "Unique identifier (UID) used in Wikidata"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:52184C71
    a pidreg:PIDService ;
    skos:prefLabel "QID / WDQID"@en ;
    skos:definition "Wikidata is a collaboratively edited knowledge base operated by the Wikimedia Foundation. It is intended to provide a common source of certain types of data which can be used by Wikimedia projects such as Wikipedia. Wikidata functions as a document-oriented database, centred on individual items. Items represent topics, for which basic information is stored that identifies each topic."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:BE0AA447
    a pidreg:PIDService ;
    skos:prefLabel "Wikipedia"@en ;
    skos:definition "Wikipedia is a multilingual, web-based, free-content encyclopedia project based on an openly editable model. It is written collaboratively by largely anonymous Internet volunteers who write without pay."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:962AFA12
    a pidreg:PIDService ;
    skos:prefLabel "ICD"@en ;
    skos:definition "The International Classification of Diseases is the international standard diagnostic classification for all general epidemiological and many health management purposes."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:BDE0B4B7
    a pidreg:PIDService ;
    skos:prefLabel "CrossRef Funders"@en ;
    skos:definition "The Funder Registry is an open registry of persistent identifiers for grant-giving organizations around the world."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:BDE0B4B71
    a pidreg:PIDService ;
    skos:prefLabel "CrossRef Grant"@en ;
    skos:definition "The Crossref Grant Linking System (GLS) is a service for research funders to contribute to open science infrastructure. As members of Crossref, funders create unique links and open metadata about their support of all kinds, from financial grants to prizes to use of facilities."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:5AB84DF2
    a pidreg:PIDService ;
    skos:prefLabel "eISSN"@en ;
    skos:definition "ISSN for an electronic publication"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:016841FF
    a pidreg:PIDService ;
    skos:prefLabel "LCCN"@en ;
    skos:definition "Library of Congress name authority (persons, families, corporate bodies, events, places, works and expressions) and subject authority identifier"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:8FDADD4C
    a pidreg:PIDService ;
    skos:prefLabel "re3data"@en ;
    skos:definition "Re3data is a global registry of research data repositories that covers research data repositories from different academic disciplines."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:6AAA1ABD
    a pidreg:PIDService ;
    skos:prefLabel "ROR"@en ;
    skos:definition "ROR (Research Organization Registry) is a global, community-led registry of open persistent identifiers for research organizations. ROR is jointly operated by California Digital Library, Crossref, and Datacite."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:9FF848E5
    a pidreg:PIDService ;
    skos:prefLabel "URN:ISSN"@en ;
    skos:definition "The International Standard Serial Number (ISSN) is a unique eight-digit number used to identify a print or electronic periodical publication, rather than individual articles or books."@en ;
    dct:source pidreg:uploadedInventory .

pidreg:uploadedInventory
    a dct:Dataset ;
    dct:title "Uploaded comprehensive PID inventory"@en ;
    dct:description "Primary source for the starter RDMI PID Service Registry."@en .
