@prefix pidreg: <https://example.org/pid-registry/> .
@prefix pid_graph: <https://example.org/pid-graph/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Core registry model
#################################################################

pidreg:PIDService
    a owl:Class ;
    rdfs:label "Persistent identifier service"@en ;
    rdfs:comment "An identifiable PID system, service, registry, identifier family, or provider-oriented PID implementation that defines, assigns, maintains, resolves, or otherwise supports persistent identifiers."@en .

pidreg:ResolutionCapability
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "PID resolution capability"@en .

pidreg:resolutionCapabilityScheme
    a skos:ConceptScheme ;
    skos:prefLabel "PID resolution capabilities"@en .

pidreg:hasResolutionCapability
    a owl:ObjectProperty ;
    rdfs:domain pidreg:PIDService ;
    rdfs:range pidreg:ResolutionCapability ;
    rdfs:label "has resolution capability"@en .

pidreg:pidmrSupported
    a owl:DatatypeProperty ;
    rdfs:domain pidreg:PIDService ;
    rdfs:range xsd:boolean ;
    rdfs:label "PIDMR supported"@en .

pidreg:registeredIn
    a owl:ObjectProperty ;
    rdfs:domain pidreg:PIDService ;
    rdfs:label "registered in"@en .

pidreg:authority
    a owl:ObjectProperty ;
    rdfs:domain pidreg:PIDService ;
    rdfs:label "authority"@en .

pidreg:provider
    a owl:ObjectProperty ;
    rdfs:domain pidreg:PIDService ;
    rdfs:label "provider"@en .

pidreg:conformsToStandard
    a owl:ObjectProperty ;
    rdfs:domain pidreg:PIDService ;
    rdfs:label "conforms to standard"@en .

pidreg:resolverEndpoint
    a owl:DatatypeProperty ;
    rdfs:domain pidreg:PIDService ;
    rdfs:range xsd:anyURI ;
    rdfs:label "resolver endpoint"@en .

pidreg:apiEndpoint
    a owl:DatatypeProperty ;
    rdfs:domain pidreg:PIDService ;
    rdfs:range xsd:anyURI ;
    rdfs:label "API endpoint"@en .

pidreg:identifiesEntityType
    a owl:ObjectProperty ;
    rdfs:domain pidreg:PIDService ;
    rdfs:label "identifies entity type"@en .

#################################################################
# Standardized PIDMR resolution capabilities
#################################################################

pidreg:landing-page
    a pidreg:ResolutionCapability, skos:Concept ;
    skos:inScheme pidreg:resolutionCapabilityScheme ;
    skos:prefLabel "Landing page resolution"@en ;
    skos:definition "Resolution of a PID to a human-oriented landing page describing or representing the identified resource."@en ;
    dct:source <https://faircore4eosc.eu/eosc-core-components/eosc-pid-meta-resolver-pidmr> .

pidreg:metadata
    a pidreg:ResolutionCapability, skos:Concept ;
    skos:inScheme pidreg:resolutionCapabilityScheme ;
    skos:prefLabel "Machine-readable metadata resolution"@en ;
    skos:definition "Resolution of a PID to structured metadata describing the identified resource, where supported by the PID system or provider."@en ;
    dct:source <https://faircore4eosc.eu/eosc-core-components/eosc-pid-meta-resolver-pidmr> .

pidreg:resource
    a pidreg:ResolutionCapability, skos:Concept ;
    skos:inScheme pidreg:resolutionCapabilityScheme ;
    skos:prefLabel "Digital object / resource resolution"@en ;
    skos:definition "Resolution of a PID directly to the referenced digital object or resource, where supported by the PID system or provider."@en ;
    dct:source <https://faircore4eosc.eu/eosc-core-components/eosc-pid-meta-resolver-pidmr> .

#################################################################
# PIDMR as a resolver service
#################################################################

pidreg:PIDMR
    a pidreg:PIDService ;
    skos:prefLabel "EOSC PID Meta Resolver"@en ;
    skos:altLabel "PIDMR"@en ;
    dct:source <https://pidmr.argo.grnet.gr/supported-pids> ;
    pidreg:hasResolutionCapability
        pidreg:landing-page,
        pidreg:metadata,
        pidreg:resource ;
    pidreg:apiEndpoint "https://pidmr.argo.grnet.gr/"^^xsd:anyURI .

#################################################################
# Registry instances from the uploaded inventory
#################################################################

pid_graph:7E709E59
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:8C3CC433
    a pidreg:PIDService ;
    skos:prefLabel "EU PIC"@en ;
    skos:definition "A Participant Identification Code (PIC) is a 9-digit number that serves as a unique identifier for legal entities participating in European funding programmes. A PIC number has no expiry date."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:7C278907
    a pidreg:PIDService ;
    skos:prefLabel "Virta-id"@en ;
    skos:definition "The Virta-ID is associated with the VIRTA Higher Education Achievement Register (VIRTA-opintotietopalvelu) in Finland. This service was built as part of the Raketti project during 2012 and 2013 and officially launched in 2014. It serves as a national data repository for Finnish higher education institutions, aiming to improve student admissions and facilitate various administrative and academic processes."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:92768060
    a pidreg:PIDService ;
    skos:prefLabel "URN:ISTC"@en ;
    skos:definition "Unique identifier for text-based works"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:4502C312
    a pidreg:PIDService ;
    skos:prefLabel "URN:ISMN"@en ;
    skos:definition "identifier for printed music (not in book form) developed by ISO."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:60F6C8F3
    a pidreg:PIDService ;
    skos:prefLabel "HomoloGene ID"@en ;
    skos:definition "HomoloGene, a tool of the United States National Center for Biotechnology Information (NCBI), is a system for automated detection of homologs."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:AF81E099
    a pidreg:PIDService ;
    skos:prefLabel "Nucleotide GI number"@en ;
    skos:definition "The Nucleotide database is a collection of sequences from several sources, including GenBank, RefSeq, TPA and PDB. Genome, gene and transcript sequence data provide the foundation for biomedical research and discovery."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:774111F8
    a pidreg:PIDService ;
    skos:prefLabel "URN:LSID"@en ;
    skos:definition "Life Science Identifiers are a way to name and locate pieces of information on the web. Essentially, an LSID is a unique identifier for some data, and the LSID protocol specifies a standard way to locate the data (as well as a standard way of describing that data)"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:335BCBF11
    a pidreg:PIDService ;
    skos:prefLabel "RAI ID"@en ;
    skos:definition "Research Analysis Identifier (RAI) of experiments will become a new Persistent Identifier (PID) that can be used in addition to existing PIDs. This identifier combines the result with the dataset and algorithm employed by a researcher to process the dataset."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:C9B802B5
    a pidreg:PIDService ;
    skos:prefLabel "SF-edu-ID"@en ;
    skos:definition "The Register of educational institutions is a chargeable product of Statistics Finland containing the addresses of all educational institutions in Finland. The Register is updated yearly in the spring. The Register contains data collected 2023."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:7D9E4E44
    a pidreg:PIDService ;
    skos:prefLabel "Magnet"@en ;
    skos:definition "Magnet is a URI scheme that defines the format of magnet links, a de facto standard for identifying files (URN) by their content, via cryptographic hash value rather than by their location."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:A514F388
    a pidreg:PIDService ;
    skos:prefLabel "CONFIDENT"@en ;
    skos:definition "ConfIDent makes conferences and other formats of scientific events persistently accessible in high quality."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:2EAAEA03
    a pidreg:PIDService ;
    skos:prefLabel "IdRef ID/SUDOC"@en ;
    skos:definition "Identifier for authority control in the French collaborative library catalog (see also P1025). Format: 8 digits followed by a digit or \"X\""@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:15BEDB40
    a pidreg:PIDService ;
    skos:prefLabel "ARK"@en ;
    skos:definition "Multi-purpose persistent identifier for information objects of any type. Archival Resource Keys (ARKs) serve as persistent identifiers, or stable, trusted references for information objects. Among other things, they aim to be web addresses (URLs) that don’t return 404 Page Not Found errors. The ARK Alliance is an open global community supporting the ARK infrastructure on behalf of research and scholarship. End users, especially researchers, rely on ARKs for long term access to the global scientific and cultural record. Since 2001 some 8.2 billion ARKs have been created by over 1000 organizations — libraries, data centers, archives, museums, publishers, government agencies, and vendors. They identify anything digital, physical, or abstract. ARKs are open, mainstream, non-paywalled, decentralized persistent identifiers that can be created by an organization as soon as it is registered with a NAAN (Name Assigning Authority Number). Once registered, an ARK organization can create unlimited numbers of ARKs and publicize them via the n2t.net global resolver or via their own local resolver."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:03A715EA
    a pidreg:PIDService ;
    skos:prefLabel "arXiv"@en ;
    skos:definition "Article identifier scheme used by arXiv. arXiv is an e-print service in the fields of physics, mathematics, non-linear science, computer science, and quantitative biology."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:68ADD24A
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:AT"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:F00A6677
    a pidreg:PIDService ;
    skos:prefLabel "Bitbucket"@en ;
    skos:definition "Bitbucket is a Git-based source code repository hosting service owned by Atlassian."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:208E9775
    a pidreg:PIDService ;
    skos:prefLabel "URL"@en ;
    skos:definition "A uniform resource locator (URL), colloquially known as an address on the Web, is a reference to a resource that specifies its location on a computer network and a mechanism for retrieving it"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:F12AD34E1
    a pidreg:PIDService ;
    skos:prefLabel "CURIE"@en ;
    skos:definition "A data type whose purpose is specifically to allow for the definition of scoped names that map to URIs"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:B7EB7BAA
    a pidreg:PIDService ;
    skos:prefLabel "COL"@en ;
    skos:definition "Identifier of a taxon or synonym in the Catalogue of Life"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:C6B514CF
    a pidreg:PIDService ;
    skos:prefLabel "HAL article ID"@en ;
    skos:definition "identifier for an article in the HAL (Hyper Articles en Ligne) open access repository"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:47118C40
    a pidreg:PIDService ;
    skos:prefLabel "ResearcherID"@en ;
    skos:definition "ResearcherID is an identifying system for scientific authors. The system was introduced in January 2008 by Thomson Reuters Corporation."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:AC2CDAA9
    a pidreg:PIDService ;
    skos:prefLabel "WOS"@en ;
    skos:definition "Unique academic work identifier assigned in Web of Science bibliographic database (Web of Science Core Collection only and do not include WOS: prefix)"@en ;
