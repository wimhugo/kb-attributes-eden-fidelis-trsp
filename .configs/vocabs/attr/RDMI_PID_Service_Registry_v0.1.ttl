    dct:source pidreg:uploadedInventory .

pid_graph:0E85921A
    a pidreg:PIDService ;
    skos:prefLabel "IGSN"@en ;
    skos:definition "IGSN is a globally unique and persistent identifier for material samples and specimens. IGSNs are obtained from IGSN e.V. Agents."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:152D52742
    a pidreg:PIDService ;
    skos:prefLabel "PIDINST"@en ;
    skos:definition "PIDINST is a persistent identifier scheme designed to uniquely and permanently identify scientific instruments, such as sensors, spectrometers, microscopes, and data collection platforms. It enables instruments to be referenced in datasets, publications, and metadata to support transparency, reproducibility, and provenance tracking in research."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:0D27745F
    a pidreg:PIDService ;
    skos:prefLabel "RAID"@en ;
    skos:definition "A unique and persistent identifier for research projects"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:BDE0B4B72
    a pidreg:PIDService ;
    skos:prefLabel "DAI"@en ;
