    dct:source pidreg:uploadedInventory .

pid_graph:7E709E594
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:NL"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:6081C2D5
    a pidreg:PIDService ;
    skos:prefLabel "EIDR"@en ;
    skos:definition "Identifier for a film or television work, edit or manifestation, in the Entertainment Identifier Registry"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:08EE6DB9
    a pidreg:PIDService ;
    skos:prefLabel "OMID"@en ;
    skos:definition "Every entity in OpenCitations Meta (https://opencitations.net/meta) is assigned persistent internal identifier called OpenCitations Meta Identifier (OMID). The OMID has structure [[entity_type_abbreviation]]/[[supplier_prefix]][[sequential_number]]. For example, the first journal article ever processed has OMID br/0601 (the full URI is https://w3id.org/oc/meta/br/0601), where br is the abbreviation of bibliographic resource, and 060 corresponds to the supplier prefix, helpful in recognising at a glance the index it belongs to (i.e., OpenCitations Meta). Finally, 1 indicates that this is the index's first bibliographic resource ever minted."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:152D52741
    a pidreg:PIDService ;
    skos:prefLabel "PIC"@en ;
    skos:definition "The PIC is a unique identifier for your organisation that is used to track and manage participants in EU-funded programs, projects, and initiatives"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:C2BEAE03
    a pidreg:PIDService ;
    skos:prefLabel "GeoNames ID"@en ;
    skos:definition "Identifier in the GeoNames geographical database."@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:7E709E592
    a pidreg:PIDService ;
    skos:prefLabel "URN:NBN:DE"@en ;
    skos:definition "National Bibliography Number (NBN) is a group of publication identifier systems used by national libraries in countries such as Germany, Italy, Finland, Norway, The Netherlands and Sweden"@en ;
    dct:source pidreg:uploadedInventory .

pid_graph:C2BEAE031
