trsp:att.3B8FD2CB5F
  a skos:Concept ;
  skos:prefLabel "File Format Guidance"@en ;
  schema:category Performance|Deposit Properties|File and Dataset Properties|File Format Guidance ;
  skos:definition The trusted digital archive (TDA) identifies file formats to an appropriate level of precision using established registries such as IANA MIME types or PRONOM. Guidance is provided for high-quality format conversions to ensure deposited files meet preservation standards. This supports the acceptance of digital objects from depositors by verifying that submissions conform to established criteria. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.696B580E35 ;
