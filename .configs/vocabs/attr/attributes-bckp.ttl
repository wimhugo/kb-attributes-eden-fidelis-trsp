  a skos:Concept ;
  skos:prefLabel "Accessibility Measures"@en ;
  schema:category Technology|Accessible|Accessibility Measures ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.570534F4B8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeFormat ;
  trsp:hasBenchmark "Float" ;
