trsp:att.0e0c905d2a
  a skos:Concept ;
  skos:prefLabel "Data is free"@en ;
  skos:description "Identified primarily as a requirement for public infrastructure services by POSI, this criterion ensures that the data gathered by services is available without cost to the community, and serves as insurance should the service no longer be available."@en ;
