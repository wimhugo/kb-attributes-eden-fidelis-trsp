  schema:category Technology|Accessible|Accessibility Measures|Accessibility Rating ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6E790E641F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.70DECA9F26
  a skos:Concept ;
  skos:prefLabel "Multi-Language Support"@en ;
  schema:category Technology|Accessible|Multi-Language Support ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.78A504B99F
  a skos:Concept ;
  skos:prefLabel "Language Support Scope and Documentation"@en ;
  schema:category Technology|Accessible|Multi-Language Support|Language Support Scope and Documentation ;
  skos:definition This concept identifies which languages are supported per vocabulary within a repository's scope of services, providing reference information about the boundaries of linguistic coverage for which the organization retains responsibility. It documents multi-language support scope, including crosswalks and conversions, ensuring transparency about accessible language capabilities and any partner or outsourced involvement in delivering those functions. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.42A3D7A518
  a skos:Concept ;
  skos:prefLabel "Metadata"@en ;
  schema:category Technology|Accessible|Multi-Language Support|Metadata ;
  skos:definition A system capability that enables metadata and controlled vocabularies to be provided in multiple languages through the use of language tags. This supports consistent interpretation of metadata by users from diverse linguistic backgrounds, thereby broadening accessibility across different communities. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.70C4C7B218 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.211F98FA33
  a skos:Concept ;
  skos:prefLabel "Vocabularies and Thesauri"@en ;
  schema:category Technology|Accessible|Multi-Language Support|Vocabularies and Thesauri ;
  skos:definition A system capability that enables the use or exposure of controlled vocabularies—such as multilingual thesauri—across multiple languages. This allows users from different linguistic backgrounds to interpret, search, and reuse metadata consistently across domains, for example by providing translated titles, abstracts, or subject terms. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5FBAF6DC9F ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.60F7491B6A
  a skos:Concept ;
  skos:prefLabel "Websites and Services"@en ;
  schema:category Technology|Accessible|Multi-Language Support|Websites and Services ;
  skos:definition A feature of websites and services that enables users to browse or search content in their preferred language, with clear indication of which languages are supported. This accessibility capability ensures that digital services can be used effectively by speakers of different languages, promoting inclusivity across diverse user communities. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.21F3C82F8B
  a skos:Concept ;
  skos:prefLabel "Legal"@en ;
  schema:category Technology|Legal ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7592D43F0B ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

