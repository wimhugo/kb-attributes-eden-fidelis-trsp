trsp:att.714EC2AA27
  a skos:Concept ;
  skos:prefLabel "Data API"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Access to Metadata and Data|Data API ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7298144E24
  a skos:Concept ;
  skos:prefLabel "Metadata (Harvesting) API"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Access to Metadata and Data|Metadata (Harvesting) API ;
  skos:definition A system capability that exposes metadata in structured, machine-readable formats aligned with FAIR principles, enabling automated parsing and harvesting with minimal human intervention. This includes applying persistent identifiers and descriptive metadata to digital objects, supporting resource discovery through standardized APIs and crosswalk conversions between metadata schemas. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0D3C935A8A
  a skos:Concept ;
  skos:prefLabel "Automated Curation"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Automated Curation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.76B25EFA00 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6E3855425F
  a skos:Concept ;
  skos:prefLabel "File Type Registry API"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|File Type Registry API ;
  skos:definition A capability whereby the system identifies file formats to an appropriate level of precision by referencing established registries such as IANA MIME types or PRONOM. Identified formats are reported in a standardised, machine-actionable manner through links to file type registry URIs, supporting transparency and interoperability in format identification workflows. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.63101DF501
  a skos:Concept ;
  skos:prefLabel "File Type Verification API"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|File Type Verification API ;
  skos:definition A standard API for automated file type verification in which the system identifies file formats to the appropriate level of precision using established registries such as IANA MIME types or PRONOM. It validates files against format specifications, detects wrongly identified files, and performs pre-ingest operations on data objects to ensure compliance with format requirements. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.29A8E8970A
  a skos:Concept ;
  skos:prefLabel "File Verification Error Data"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|File Verification Error Data ;
  skos:definition A responsibility within automated curation whereby the trusted digital archive (TDA) performs periodic file integrity checks, identifies invalid or damaged files, and reports detailed error messages describing each issue. The TDA maintains a regularly updated database documenting common file format validation errors and their solutions, supported by a defined process for database updates. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Schema IRIs" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2B5E85FAE5
  a skos:Concept ;
  skos:prefLabel "Package Validation Service"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|Package Validation Service ;
  skos:definition A repository capability enabling automated validation of Archival Information Packages (AIPs) against the OAIS Information Model requirements. The service assesses the quality and completeness of holdings, providing evidence of conformance and helping identify missing or incomplete information. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark <https://lfs.labs.dansdemo.nl/docs#/> ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.23727D6070
  a skos:Concept ;
  skos:prefLabel "Package Verification Service"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|Package Verification Service ;
  skos:definition A value-added service within the automated curation domain that enables systems and tools to automatically discover and identify the packing standards used during the ingest process. It operates through standard APIs to verify package conformance without requiring manual intervention. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.21F3C82F8B ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

