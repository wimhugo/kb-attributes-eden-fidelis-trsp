trsp:att.0341AA63B1
  a skos:Concept ;
  skos:prefLabel "Research Infrastructures Served"@en ;
  schema:category Sustainability|Infrastructure Links|Research Infrastructures Served ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.650BA75F4F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.04F0DB0243
  a skos:Concept ;
  skos:prefLabel "Planning"@en ;
  schema:category Sustainability|Planning ;
  skos:definition Sustainability planning encompasses strategies for risk mitigation, business continuity, and disaster recovery, with particular emphasis on succession planning. This includes provisions for sudden loss of provider viability, such as set-aside funding and defined operational timeframes to sustain continued service while a successor provider is identified, ensuring preservation of references and ongoing access. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7F7C2776AC ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.11E8C2B7D0
  a skos:Concept ;
  skos:prefLabel "Disaster Recovery Plan"@en ;
  schema:category Sustainability|Planning|Disaster Recovery Plan ;
  skos:definition A disaster recovery plan encompasses the non-technical organizational processes and strategies for ensuring business continuity during service disruptions or disasters. It includes preparation for maintaining normal operations, managing digital objects, and addressing security incidents, as well as succession planning for service termination. Recovery planning complements technical infrastructure measures to support organizational resilience. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.697C57FE46 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.14C87D5FC0
  a skos:Concept ;
  skos:prefLabel "Long-Term Preservation Plan"@en ;
  schema:category Sustainability|Planning|Long-Term Preservation Plan ;
  skos:definition A governance framework ensuring the long-term preservation of data resources so they remain discoverable, accessible, and usable over time. It addresses sustainability planning by establishing policies and structures necessary to maintain data integrity and availability into the future. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4A2CF0AF0A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7495ADA28B
  a skos:Concept ;
  skos:prefLabel "Public Continuity Plan"@en ;
  schema:category Sustainability|Social Sustainability|Planning/ Continuity|Public Continuity Plan ;
  skos:definition A public continuity plan addressing sustainability and planning by identifying and managing third-party organisations, hosts, partners, and other actors essential to operations. This includes ensuring the continued delivery of data or metadata services through effective oversight of external dependencies. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.36E657FC7B
  a skos:Concept ;
  skos:prefLabel "Repository or Collections Data Management Plan"@en ;
  schema:category Sustainability|Planning|Repository or Collections Data Management Plan ;
  skos:definition A data management planning framework addressing repository-level considerations for catalogues and collections, including the acceptance of custody of digital objects from depositors and the transfer of responsibility to the repository. It encompasses the appraisal of offered or requested deposits to ensure they meet established criteria for acceptance. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2744CED24F ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.34A4F04633
  a skos:Concept ;
  skos:prefLabel "Resource Management Plan"@en ;
  schema:category Sustainability|Planning|Resource Management Plan ;
  skos:definition A structured approach to planning and managing human, financial, technological, and energy resources necessary to fulfil an organisation's mission. Encompasses organisational hierarchies, skills development, and risk management, ensuring sufficient internal or external expertise is available. Includes governance of policies, procedures, and the effective deployment of assets over time. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.18D74ED687 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistLegalDocuments ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4B6380A8F0
  a skos:Concept ;
  skos:prefLabel "Risk Plan"@en ;
  schema:category Sustainability|Planning|Risk Plan ;
  skos:definition A Sustainability Risk Plan in which the Technology Dependency Assessment (TDA) monitors technology evolution to identify potential risks. It defines detection methods for each identified risk, supporting proactive planning and long-term sustainability of technology-dependent systems. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3609108196
  a skos:Concept ;
  skos:prefLabel "Succession Plan"@en ;
  schema:category Sustainability|Planning|Succession Plan ;
  skos:definition A sustainability and succession plan outlines options for relocating or transitioning a repository's activities to another host in the event of disruptions such as unexpected funding withdrawal or shifts in institutional priorities. It supports business continuity by addressing non-technical organizational processes, digital object management, and security, as well as recovery plans for service interruptions, disasters, and potential end-of-service scenarios. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2E979C3B25 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0849A7F1E2
  a skos:Concept ;
  skos:prefLabel "Social Sustainability"@en ;
  schema:category Sustainability|Social Sustainability ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.12C140C8CD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0CF10C6CFB
  a skos:Concept ;
  skos:prefLabel "Community Engagement"@en ;
  schema:category Sustainability|Social Sustainability|Community Engagement ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.608015D600 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.04DC5770C9
  a skos:Concept ;
  skos:prefLabel "Documentation on Community Engagement"@en ;
  schema:category Sustainability|Social Sustainability|Community Engagement|Documentation on Community Engagement ;
  skos:definition Documentation on community engagement captures how organizations, particularly Trusted Digital Archives (TDAs), monitor and engage with designated and Indigenous communities to identify evolving needs and ensure data practices are grounded in respect, reciprocity, and self-determination. Such documentation supports ethical data use, informed decision-making, and equitable benefit-sharing, while enabling communities to govern their own data and digital resources. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7F7C2776AC ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.13368CB9AC
  a skos:Concept ;
  skos:prefLabel "Impact Assessment"@en ;
  schema:category Sustainability|Social Sustainability|Community Engagement|Impact Assessment ;
  skos:definition The systematic monitoring and analysis of a designated community and relevant stakeholders to identify evolving needs and assess the impact of repository services. This process combines internal data and external information to verify that the organisation is effectively fulfilling its mission and scope, ensuring accountability and demonstrating value to the community served. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.700343D2B3 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.01D16EFB9B
  a skos:Concept ;
  skos:prefLabel "Managed Stakeholder Dependencies"@en ;
  schema:category Sustainability|Social Sustainability|Community Engagement|Managed Stakeholder Dependencies ;
  skos:definition A structured approach to identifying and managing mutual dependencies with key stakeholders—including end users, depositors, funders, service users, aggregators, and third-party partners—essential to organizational operations. This encompasses documenting the nature of these relationships, stating intentions for partnership management, and ensuring sufficient human resources and skills, internally or externally, to fulfil the organizational mission. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4840647866 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4E4FD79526
  a skos:Concept ;
  skos:prefLabel "Expert Guidance"@en ;
  schema:category Sustainability|Social Sustainability|Expert Guidance ;
  skos:definition A digital repository must identify, source, and maintain the skills necessary to deliver its services, whether through internal staff or external engagement. It ensures business continuity by sustaining normal operations, managing non-technical organisational processes, and preparing recovery and succession plans for disruptions, service interruptions, or the eventual end of a service. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1FC6BCD089
  a skos:Concept ;
  skos:prefLabel "Periodic Expert/ External Review"@en ;
  schema:category Sustainability|Social Sustainability|Expert Guidance|Periodic Expert/ External Review ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6FB10117A8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.539A68DF8A
  a skos:Concept ;
  skos:prefLabel "Governance"@en ;
  schema:category Sustainability|Social Sustainability|Governance ;
  skos:definition A governance practice within social sustainability that involves providing guidance and responding to requests from depositors and users regarding the deposit, appraisal, discovery, access, and re-use of data and metadata. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7C68DBB456
  a skos:Concept ;
  skos:prefLabel "Governance Description"@en ;
  schema:category Sustainability|Social Sustainability|Governance|Governance Description ;
  skos:definition A description of the governance structure of the repository, presented as a transparency measure within the scope of services. This includes value-added information regarding supported package crosswalks and conversions, enabling users to understand how the repository facilitates interoperability between different metadata or data formats. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.494B22C440
  a skos:Concept ;
  skos:prefLabel "Governance Model"@en ;
  schema:category Sustainability|Social Sustainability|Governance|Governance Model ;
  skos:definition A governance model refers to the type of framework or structure through which an organization or system is directed, managed, and held accountable. Within the context of social sustainability, it defines the mechanisms and principles guiding decision-making, authority, and stakeholder relationships to promote equitable and responsible outcomes. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3F6736BF1C ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.247C3C5849
  a skos:Concept ;
  skos:prefLabel "Stakeholder Representation"@en ;
  schema:category Sustainability|Social Sustainability|Governance|Stakeholder Representation ;
  skos:definition Stakeholder representation in governance refers to the inclusion of diverse community members—including Indigenous Peoples—in organizational decision-making structures and data stewardship processes. Board-governed bodies drawn from stakeholder communities foster consensus-driven decisions that reflect varied interests. Indigenous Peoples specifically hold the right to develop cultural governance protocols and exercise authority over how Indigenous data, knowledge, and territories are represented and controlled. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7592D43F0B ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6237ED1101
  a skos:Concept ;
  skos:prefLabel "Living Will"@en ;
  schema:category Sustainability|Social Sustainability|Living Will ;
  skos:definition A living will is a publicly disclosed plan describing the conditions under which an organisation would be wound down, the process by which this would occur, and how its assets would be archived or transferred to a successor organisation. It serves as a trust-building mechanism within social sustainability, requiring any successor to honour the same principles. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.42D7C2C3A4
  a skos:Concept ;
  skos:prefLabel "Public Statement of Wind-Down"@en ;
  schema:category Sustainability|Social Sustainability|Living Will|Public Statement of Wind-Down ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6A8A5E1219 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5FBAF6DC9F
  a skos:Concept ;
  skos:prefLabel "Planning/ Continuity"@en ;
  schema:category Sustainability|Social Sustainability|Planning/ Continuity ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7DA1B3367B
  a skos:Concept ;
  skos:prefLabel "Technical Sustainability"@en ;
  schema:category Sustainability|Technical Sustainability ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.79D95E290A
  a skos:Concept ;
  skos:prefLabel "Data Continuity"@en ;
  schema:category Sustainability|Technical Sustainability|Data Continuity ;
  skos:definition A capability encompassing the monitoring of technology evolution to identify emerging risks and define appropriate detection methods. It supports crosswalks and conversions as value-added services, providing transparency into the scope of supported package crosswalks. This enables informed decision-making regarding technology transitions and risk mitigation. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5CB2FB5B4C
  a skos:Concept ;
  skos:prefLabel "Content is available free"@en ;
  schema:category Sustainability|Technical Sustainability|Data Continuity|Content is available free ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3AD2ECA374
  a skos:Concept ;
  skos:prefLabel "Data is Available"@en ;
  schema:category Sustainability|Technical Sustainability|Data Continuity|Data is Available ;
  skos:definition Data availability is a dimension of technical sustainability ensuring that underlying data can be practically obtained, not merely designated as open. Subject to applicable privacy laws, data should be made easily accessible through mechanisms such as periodic data dumps, enabling actual use rather than nominal openness. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.540F680A1E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.608B9C73BB
  a skos:Concept ;
  skos:prefLabel "Open Data"@en ;
  schema:category Sustainability|Technical Sustainability|Data Continuity|Open Data ;
  skos:definition Open data refers to making data legally and freely available, with the CC0 waiver representing best practice for this purpose. It supports technical sustainability by enabling infrastructure to be forked through replication of all relevant data. Privacy and data protection laws impose limits on the extent to which full openness is achievable. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4B417E2D31
  a skos:Concept ;
  skos:prefLabel "Open Source"@en ;
  schema:category Sustainability|Technical Sustainability|Open Source ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7BCEAFB957
  a skos:Concept ;
  skos:prefLabel "No Patents on Source Code"@en ;
  schema:category Sustainability|Technical Sustainability|Open Source|No Patents on Source Code ;
  skos:definition A commitment by an organisation to a patent non-assertion covenant, whereby patents may be obtained to protect internal operations but must not be used to prevent the broader community from replicating or implementing the infrastructure. This ensures open access and reproducibility of systems without legal restriction. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.792636C88D
  a skos:Concept ;
  skos:prefLabel "Source code is open or available on closure"@en ;
  schema:category Sustainability|Technical Sustainability|Open Source|Source code is open or available on closure ;
  skos:definition Documentation covering the source code repositories used by major repository software and services. This resource supports crosswalk and conversion processes by identifying and mapping the relevant repositories, providing transparency into the scope of value-added services offered. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.56C67A542A
  a skos:Concept ;
  skos:prefLabel "Technology"@en ;
  schema:category Technology ;
  skos:definition The software, hardware, and technical services that support a repository's secure, persistent, and reliable operations through the interaction of people and processes. This encompasses methods for storing and replicating digital objects' data and metadata, including validation of replicated copies and restoration of data from backups in case of errors. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.752453ED45
  a skos:Concept ;
  skos:prefLabel "Accessible"@en ;
  schema:category Technology|Accessible ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

