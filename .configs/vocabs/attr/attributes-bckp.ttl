  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistUserSchemaCrosswalks ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.13FE6DDD8E
  a skos:Concept ;
  skos:prefLabel "Third Party Service Level Agreements"@en ;
  schema:category Technology|Legal|Third Party Service Level Agreements ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.00EDBED146 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7592D43F0B
  a skos:Concept ;
  skos:prefLabel "Open Source"@en ;
  schema:category Technology|Open Source ;
  skos:definition Indicates whether an infrastructure supports package crosswalks through open source software, meaning all software required to operate the infrastructure must be available under an open source license. This requirement applies specifically to the infrastructure's core software and does not extend to other software used by the organisation. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2363F099D9
  a skos:Concept ;
  skos:prefLabel "Community Contributions"@en ;
