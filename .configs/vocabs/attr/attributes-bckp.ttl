  a skos:Concept ;
  skos:prefLabel "Software Development Guidelines and Procedures"@en ;
  schema:category Trust|Certification|Software Development Quality|Software Development Guidelines and Procedures ;
  skos:definition Measures and procedures established to ensure a minimum level of completeness, documentation, and technology readiness in software development. These encompass certification and trust mechanisms alongside guidelines that uphold quality standards throughout the software development process. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5FBAF6DC9F ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

