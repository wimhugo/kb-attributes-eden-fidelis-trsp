trsp:att.65A95F223F
  a skos:Concept ;
  skos:prefLabel "Responsibility"@en ;
  schema:category Responsibility ;
  skos:definition Responsibility denotes the obligation of data stewards and repository holders to account for how data—particularly Indigenous data—are managed, used, and shared. It requires meaningful, openly available evidence that data practices support self-determination and collective benefit for affected communities, while ensuring trustworthy stewardship of data holdings and transparent service to user communities. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4A4B5A22FE
  a skos:Concept ;
  skos:prefLabel "Schema"@en ;
  schema:category Responsibility|Schema ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.74FDFB3E00 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7AD9748A7D
  a skos:Concept ;
  skos:prefLabel "Applicable and appropriate"@en ;
  schema:category Responsibility|Schema|Applicable and appropriate ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1DD721CC5B
  a skos:Concept ;
  skos:prefLabel "Schema aligned with community practices"@en ;
  schema:category Responsibility|Schema|Applicable and appropriate|Schema aligned with community practices ;
  skos:definition A trusted digital archive (TDA) ingests and manages metadata appropriate to its content types and Designated Community, including domain-specific formats such as geospatial or audiovisual. Metadata must conform to relevant standards, schemas, or community best practices, and repositories should declare which schema(s) they apply. Interoperability is supported through mappings that align local practices with broader community conventions. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.04F0DB0243 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5EBEB8EB16
  a skos:Concept ;
  skos:prefLabel "Digital Representation of Physical Objects"@en ;
  schema:category Responsibility|Schema|Digital Representation of Physical Objects ;
  skos:definition Software Quality End Date denotes the date on which a software quality certification expires or ceases to be valid. It marks the temporal boundary of a certification's validity period, after which the certification is no longer considered current or authoritative. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5152A52E1A
  a skos:Concept ;
  skos:prefLabel "Ensure Physical Objects have a Digital Representation"@en ;
  schema:category Responsibility|Schema|Digital Representation of Physical Objects|Ensure Physical Objects have a Digital Representation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.365F68CB18
  a skos:Concept ;
  skos:prefLabel "Metadata and Data"@en ;
  schema:category Responsibility|Schema|Metadata and Data ;
  skos:definition A schema defining the formats used to describe metadata for datasets held within a repository. It establishes the structural standards and conventions by which metadata is recorded, ensuring consistent documentation of dataset characteristics and provenance. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0E2DB53E0E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.02B14C3A2C
  a skos:Concept ;
  skos:prefLabel "Default Language"@en ;
  schema:category Responsibility|Schema|Metadata and Data|Default Language ;
  skos:definition A metadata attribute that specifies the default fallback language within repository scope. It serves as the baseline language used when no other language is explicitly designated for a given data element or metadata record. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.650BA75F4F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.141AB906EC
  a skos:Concept ;
  skos:prefLabel "Default Licence"@en ;
  schema:category Responsibility|Schema|Metadata and Data|Default Licence ;
  skos:definition A metadata element that identifies the license applied by default when no license is explicitly provided by the depositor. It serves as a fallback licensing specification within the responsibility schema, ensuring all deposited resources are assigned a defined set of usage rights. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.00EDBED146 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3D988650EC
  a skos:Concept ;
  skos:prefLabel "Default Metadata Schema/ Profile Indicated"@en ;
  schema:category Responsibility|Schema|Metadata and Data|Default Metadata Schema/ Profile Indicated ;
  skos:definition Indicating that a default metadata schema or profile has been specified and published for use. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.38DA273FCF ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
