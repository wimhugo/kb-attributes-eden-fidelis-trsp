trsp:att.7660700650
  a skos:Concept ;
  skos:prefLabel "Compensation Rule"@en ;
  schema:category Sustainability|Financial Sustainability|Revenue|Data is free|Compensation Rule ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.410BA123B3
  a skos:Concept ;
  skos:prefLabel "Justifiable Cost"@en ;
  schema:category Sustainability|Financial Sustainability|Revenue|Justifiable Cost ;
  skos:definition A financial sustainability principle requiring that PID (Persistent Identifier) services within EOSC be provided at a justifiable cost to PID Owners and PID Managers. This ensures that fees or charges associated with PID services remain reasonable and transparent, supporting equitable access and long-term financial viability of the infrastructure. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.50DA0AA84E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Schema Crosswalk IRIs" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2758AC32B8
  a skos:Concept ;
  skos:prefLabel "Justification of Income"@en ;
  schema:category Sustainability|Financial Sustainability|Revenue|Justifiable Cost|Justification of Income ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1DB4B1E4F0 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.678439CD93
  a skos:Concept ;
  skos:prefLabel "Source"@en ;
  schema:category Sustainability|Financial Sustainability|Revenue|Source ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.076A4C2950
  a skos:Concept ;
  skos:prefLabel "Revenue Source"@en ;
  schema:category Sustainability|Financial Sustainability|Revenue|Source|Revenue Source ;
  skos:definition A revenue source refers to the origins or streams through which an organization generates income to sustain its financial operations. It encompasses the processes and organizational structures by which revenue-generating activities are managed and executed, supporting the entity's broader mission and long-term financial sustainability. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.365F68CB18 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6EF77F35F8
  a skos:Concept ;
  skos:prefLabel "Revenue Type"@en ;
  schema:category Sustainability|Financial Sustainability|Revenue|Source|Revenue Type ;
  skos:definition The sources and types of funding available to a repository, including grants, donations, memberships, and in-kind contributions that support the development or maintenance of repository assets and the broader content ecosystem. Funding structures should reflect non-discriminatory, inclusive principles, welcoming contributions from any stakeholder group. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.375960B05E
  a skos:Concept ;
  skos:prefLabel "Infrastructure Links"@en ;
  schema:category Sustainability|Infrastructure Links ;
