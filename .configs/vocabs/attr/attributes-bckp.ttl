trsp:att.56B57BDCC5
  a skos:Concept ;
  skos:prefLabel "Guidance"@en ;
  schema:category User Focus|Guidance ;
  skos:definition The provision of information about digital objects that documents their history (provenance) and verifies their authenticity. Such information may be captured at the point of deposit, generated through curation and preservation processes, and shared with data or metadata users. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.394D659C0C
  a skos:Concept ;
  skos:prefLabel "API Documentation"@en ;
  schema:category User Focus|Guidance|API Documentation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.66C6612EA5 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.207398D3A8
  a skos:Concept ;
  skos:prefLabel "Human-readable API documentation available"@en ;
  schema:category User Focus|Guidance|API Documentation|Human-readable API documentation available ;
  skos:definition A repository characteristic indicating whether human-readable documentation, such as manuals or guides, is available for its services, protocols, and APIs. This includes specifying result formats and determining appropriate access methods—such as direct download or secure remote environments—based on the nature of the digital objects, user characteristics, and rights management policies. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6FB10117A8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1F40BC420B
  a skos:Concept ;
  skos:prefLabel "Machine-readable API documentation available"@en ;
  schema:category User Focus|Guidance|API Documentation|Machine-readable API documentation available ;
  skos:definition A characteristic indicating whether a repository provides machine-readable API documentation, including manuals or technical references for the services and protocols it uses. Such documentation enables programmatic access and integration by guiding developers through available interfaces and usage conventions. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.04F0DB0243 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.06D09133AE
  a skos:Concept ;
  skos:prefLabel "General Depositor Guidance"@en ;
  schema:category User Focus|Guidance|General Depositor Guidance ;
  skos:definition The stages of the research data lifecycle that occur before data enters a repository. Engaging with data or metadata creators and owners during this phase can improve quality and highlight the benefits of curation, preservation, and reuse. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7AD9748A7D ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.27198D2C3B
  a skos:Concept ;
  skos:prefLabel "Guidance on Repository Selection"@en ;
  schema:category User Focus|Guidance|General Depositor Guidance|Guidance on Repository Selection ;
  skos:definition A guidance service designed to assist depositors in identifying and selecting the most appropriate repository for their materials. It provides targeted support to help users navigate available repository options and make informed deposit decisions. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3720038519 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7C41966AB5
  a skos:Concept ;
  skos:prefLabel "Guidance on Data and Metadata Preparation"@en ;
  schema:category User Focus|Guidance|Guidance on Data and Metadata Preparation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2687A2F0B8
  a skos:Concept ;
  skos:prefLabel "FAIR Aggregation"@en ;
  schema:category User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Aggregation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1AE2618C36 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistAAI ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4673784806
  a skos:Concept ;
  skos:prefLabel "Per Collection"@en ;
  schema:category User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Aggregation|Per Collection ;
  skos:definition A guidance principle in FAIR data aggregation whereby a curator or system assigns and publishes FAIR scores at the per-collection level during the deposit process. These scores are included as part of the deposit metadata and made available across different levels of aggregation, supporting transparency and assessment of data and metadata quality. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5F06EEC902 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "External Registry or List" ;
  skos:inScheme trsp:trsp-attributes .

