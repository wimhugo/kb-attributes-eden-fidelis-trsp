trsp:att.678241192E
  a skos:Concept ;
  skos:prefLabel "Selectable Metadata Profile"@en ;
  schema:category Responsibility|Schema|Metadata and Data|Selectable Metadata Profile ;
  skos:definition A selectable metadata profile is a configurable schema element within the Responsibility metadata and data domain that enables users to choose from available metadata profiles. It supports flexible data description by allowing the appropriate profile to be applied based on context or user requirements. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.40296310DD
  a skos:Concept ;
  skos:prefLabel "Stewardship"@en ;
  schema:category Responsibility|Stewardship ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.50DA0AA84E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Schema Crosswalk IRIs" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5F45FF82F5
  a skos:Concept ;
  skos:prefLabel "Artefacts/ Legal: documented information"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information ;
  skos:definition The protocols, processes, and organisational interactions through which people, technologies, and digital objects engage with external parties, including individuals, partner organisations, and funders. It encompasses the documented frameworks governing how responsibilities and stewardship of artefacts and legal information are managed across organisational boundaries. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.12C140C8CD
  a skos:Concept ;
  skos:prefLabel "Contracts, agreements, roles, responsibilities"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.69BC0467D4 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.58022A9DBD
  a skos:Concept ;
  skos:prefLabel "Contracting Granularity"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Contracting Granularity ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7AD9B8BBCB
  a skos:Concept ;
  skos:prefLabel "Deposit Agreement"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Deposit Agreement ;
  skos:definition A service feature that supports the crosswalking and conversion of packaged data formats, enabling role assignment during data submission and curation processes. It provides transparency into the scope of value-added services by clarifying which package crosswalks are supported within a given system or workflow. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1C94638914
  a skos:Concept ;
  skos:prefLabel "Ecosystem Model Available"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Ecosystem Model Available ;
  skos:definition An ecosystem model capturing documented contracts, agreements, roles, and responsibilities governing the stewardship of digital artefacts. Ensuring long-term usability and understandability depends on deposit, curation, and preservation activities, alongside ongoing engagement with user communities. Repositories may mediate reuse through secure remote access systems or safe rooms, maintaining appropriate control over digital objects. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.375960B05E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark <https://api.ror.org/v2/organizations> ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7D628D907A
  a skos:Concept ;
  skos:prefLabel "Managed Publication Process"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Managed Publication Process ;
  skos:definition An organizational process by which legal, contractual, and responsibility documentation—including publications, policies, and guidelines—is created, managed, approved, released, updated, and withdrawn in a controlled manner. The process encompasses versioning and monitoring of these artefacts, supports external assessments and stakeholder engagement, and provides transparent evidence of organizational roles and responsibilities. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.20EFD54EFD
  a skos:Concept ;
  skos:prefLabel "Privacy Statement"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Privacy Statement ;
  skos:definition A privacy statement is a documented information artefact in which a repository formally discloses its data privacy practices and policies. It falls within the scope of contracts, agreements, roles, and responsibilities, representing a stewardship obligation. Evidence of its publication may be assessed to verify the repository's accountability regarding personal data handling. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6237ED1101 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1D00720769
  a skos:Concept ;
  skos:prefLabel "Records Retention Policy/ Procedure"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Records Retention Policy/ Procedure ;
  skos:definition A records retention policy and associated procedure by which the organisation formally manages the lifecycle of documented information artefacts—such as publications, policies, and guidelines—covering their creation, approval, release, update, and withdrawal. The policy provides evidence of systematic stewardship and supports both external assessments and stakeholder engagement. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.375960B05E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Registry IRIs" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2218E83FC4
  a skos:Concept ;
  skos:prefLabel "Roles and Responsibilities Defined"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Roles and Responsibilities Defined ;
  skos:definition A characteristic of systems that capture and expose metadata about individual and organizational roles involved in the deposit, curation, maintenance, and management of digital objects. Defined roles may include data steward, curator, depositor, reviewer, or administrator, and may incorporate group or role memberships provided by identity providers. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0ED3D624B3 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.54339656E9
  a skos:Concept ;
  skos:prefLabel "Summary of Depositor Contract(s) Available"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Summary of Depositor Contract(s) Available ;
  skos:definition A repository capability whereby depositor contracts, agreements, and consents are documented, managed, and linked to individual digital objects as necessary. This ensures that preservation agreements and related responsibilities are systematically recorded and accessible, supporting accountability and stewardship of deposited artefacts. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.687D20F962
  a skos:Concept ;
  skos:prefLabel "Terms and Conditions of Use"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Terms and Conditions of Use ;
  skos:definition Terms and conditions governing access to and reuse of data holdings within a repository, including licences, access criteria, and permissible conditions of use. These policies define who may view, download, or reuse datasets—either uniformly or per dataset—and determine appropriate access methods such as direct download or secure remote environments, in alignment with rights management policies. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6D6A09147B
  a skos:Concept ;
  skos:prefLabel "Terms of Deposit/ Accession Policy"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Terms of Deposit/ Accession Policy ;
  skos:definition A repository's policy or guidance governing the scope of permissible data deposits, including any restrictions based on location, country, or organizational affiliation. This encompasses whether deposit access is open to all or limited to specific groups, and clarifies which content types are eligible for submission. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.419EE6D029
  a skos:Concept ;
  skos:prefLabel "Licences"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Licences ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.50DA0AA84E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7DFD48623C
  a skos:Concept ;
  skos:prefLabel "Published Custom Licences Available"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Licences|Published Custom Licences Available ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5CE6A2BBCE
  a skos:Concept ;
  skos:prefLabel "Risk Management"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Risk Management ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0FF7E5B673
  a skos:Concept ;
  skos:prefLabel "Bibliographic Metadata Policy"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Risk Management|Bibliographic Metadata Policy ;
  skos:definition TBD ;
