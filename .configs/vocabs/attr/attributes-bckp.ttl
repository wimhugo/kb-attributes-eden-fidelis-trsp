trsp:att.5E50766D16
  a skos:Concept ;
  skos:prefLabel "Link to DMP"@en ;
  schema:category User Focus|Guidance|Guidance on Data and Metadata Preparation|Integrations (DMP, RO-Crate, ...)|Link to DMP ;
  skos:definition A concept indicating that a machine-actionable Data Management Plan (maDMP) is available and linked within the research workflow. It addresses the pre-repository stages of the research data lifecycle, supporting data and metadata creators in improving quality and understanding the benefits of curation, preservation, and reuse through integration with standards such as RO-Crate. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1AAA70FB51
  a skos:Concept ;
