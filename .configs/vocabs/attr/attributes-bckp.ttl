trsp:att.38DA273FCF
  a skos:Concept ;
  skos:prefLabel "Pre-deposit"@en ;
  schema:category Transparency|Scope of Services|Pre-deposit ;
  skos:definition A pre-deposit stage mechanism that governs transparency and scope of services before research data enters a repository. It encompasses processes for sharing deposited data anonymously via links to support peer review, including confidential or double-blind access depending on journal policy, while engaging with data creators to improve quality and highlight the benefits of curation, preservation, and reuse. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.371D70B854 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Assessment IRIs" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6C673D59D2
  a skos:Concept ;
  skos:prefLabel "Link to or Ingest External Metadata"@en ;
  schema:category Transparency|Scope of Services|Pre-deposit|Link to or Ingest External Metadata ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5214DF9D16
  a skos:Concept ;
  skos:prefLabel "Pre-publication Peer Review"@en ;
  schema:category Transparency|Scope of Services|Pre-deposit|Pre-publication Peer Review ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.156B52FB19
  a skos:Concept ;
  skos:prefLabel "Preservation"@en ;
  schema:category Transparency|Scope of Services|Preservation ;
  skos:definition Preservation refers to a repository's documented commitment to maintaining data holdings over the long term, ensuring continued access and fitness for use. The repository defines minimum digital preservation timeframes and assumes planned responsibility for adapting services to meet evolving user community requirements. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.553A464EC8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.08AB24D0F7
  a skos:Concept ;
  skos:prefLabel "Commitment is Defined"@en ;
  schema:category Transparency|Scope of Services|Preservation|Commitment is Defined ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.12C140C8CD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6EB55F36B2
  a skos:Concept ;
  skos:prefLabel "List of Preservation Support Services"@en ;
  schema:category Transparency|Scope of Services|Preservation|List of Preservation Support Services ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3DA6C87583
  a skos:Concept ;
  skos:prefLabel "Timeframe is Defined"@en ;
  schema:category Transparency|Scope of Services|Preservation|Timeframe is Defined ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.156B52FB19 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7362D6D981
  a skos:Concept ;
  skos:prefLabel "Reuse"@en ;
  schema:category Transparency|Scope of Services|Reuse ;
  skos:definition A trusted digital repository (TDR) demonstrates essential capabilities to enable long-term access and reuse of digital objects for its designated communities. The repository ensures appropriate information is available to support understanding and use over time, and facilitates access through suitable methods—such as direct download or secure remote environments—based on object characteristics, user attributes, and rights management policies. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7D09257304
  a skos:Concept ;
  skos:prefLabel "Reuse Provisions"@en ;
  schema:category Transparency|Scope of Services|Reuse|Reuse Provisions ;
  skos:definition A documented checklist, supported by evidence, of measures designed to facilitate the reuse of digital objects. Effective reuse depends on deposit, curation, and preservation activities informed by an understanding of user needs and designated communities. Repositories may mediate reuse through secure remote access systems, safe rooms, or other controlled tools. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.67DE43D8DF
  a skos:Concept ;
  skos:prefLabel "Rich Metadata"@en ;
  schema:category Transparency|Scope of Services|Reuse|Rich Metadata ;
  skos:definition A principle ensuring that metadata contains sufficient contextual information to enable the reuse of data. This includes provenance information and usage licensing details, providing transparency about the scope of services associated with the data. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7F80554D90
  a skos:Concept ;
  skos:prefLabel "Clear Licence Provisions"@en ;
  schema:category Transparency|Scope of Services|Reuse|Rich Metadata|Clear Licence Provisions ;
  skos:definition A value-added service attribute indicating whether package crosswalks and format conversions are supported within the scope of services. It ensures that metadata holds sufficient context—such as usage licensing information—to enable meaningful reuse of the data across different systems or standards. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1A78609F7E
  a skos:Concept ;
  skos:prefLabel "Provenance is recorded at object level"@en ;
  schema:category User Focus|Discovery|Provenance|Provenance is recorded at object level ;
  skos:definition Provenance is recorded and maintained at the individual object level, capturing the history, context, and lifecycle of data through changelogs, timestamped audit trails, and descriptive metadata. This ensures that datasets can be understood, discovered, and reused, while supporting authenticity and accountability through auditable records of role-related actions and curation processes. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.28A2220E45 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.536467081E
  a skos:Concept ;
  skos:prefLabel "Value-Added"@en ;
  schema:category Transparency|Scope of Services|Value-Added ;
  skos:definition A concept relating to transparency in the scope of services, specifically concerning value-added offerings. It identifies value-added services as appropriate potential revenue sources within a service framework. This concept supports clear disclosure of which services generate revenue through added value. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.110C424081
  a skos:Concept ;
  skos:prefLabel "Annotation"@en ;
  schema:category Transparency|Scope of Services|Value-Added|Annotation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4AA1880060 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7ABEF7ECA8
  a skos:Concept ;
  skos:prefLabel "Semantic Annotation Tools/ Services Supported"@en ;
  schema:category Transparency|Scope of Services|Value-Added|Annotation|Semantic Annotation Tools/ Services Supported ;
  skos:definition Indicates whether the system supports external tools or services for applying, managing, or enriching metadata with semantic annotations. This capability may enable decoupled annotation workflows, allowing metadata enrichment processes to operate independently from core system functions. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

