  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6D43E7EB5B
  a skos:Concept ;
  skos:prefLabel "List of Technology Measures"@en ;
  schema:category Trust|Technology Measures|List of Technology Measures ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.27E790A86B
  a skos:Concept ;
  skos:prefLabel "User Focus"@en ;
  schema:category User Focus ;
  skos:definition User Focus refers to the principle that a trustworthy repository must prioritize serving its designated user community, recognizing that different communities have varying expectations depending on their maturity in data management and sharing. A trustworthy repository is embedded in its community's data practices, enabling it to respond effectively to evolving requirements. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1DB4B1E4F0 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.70C4C7B218
  a skos:Concept ;
  skos:prefLabel "Annotation, Metrics, Feedback and Use"@en ;
  schema:category User Focus|Annotation, Metrics, Feedback and Use ;
  skos:definition A capability encompassing reporting, analytics, and compliance assessment to support effective management of objects and services. It delivers functional, operational, and statistical reports while evaluating adherence to standards, policies, and procedures. Findings inform continuous and targeted improvement actions across crosswalks, conversions, and user-focused service packages. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5103AC4BB0
  a skos:Concept ;
  skos:prefLabel "(Forward) Provenance"@en ;
  schema:category User Focus|Annotation, Metrics, Feedback and Use|(Forward) Provenance ;
  skos:definition A user-focused concept concerning the forward provenance of a dataset, capturing how the dataset has been applied as an input to the creation of new datasets. It encompasses annotations, metrics, and feedback related to downstream usage, enabling tracking of a dataset's influence and reuse across subsequent data creation processes. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.51FA72053A
  a skos:Concept ;
  skos:prefLabel "Citation and Mentions Metrics"@en ;
  schema:category User Focus|Annotation, Metrics, Feedback and Use|Citation and Mentions Metrics ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.21C38D1D00
  a skos:Concept ;
  skos:prefLabel "Survey and Quality Feedback"@en ;
  schema:category User Focus|Annotation, Metrics, Feedback and Use|Survey and Quality Feedback ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.79D95E290A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6A8A5E1219
  a skos:Concept ;
  skos:prefLabel "Application and Reuse"@en ;
  schema:category User Focus|Application and Reuse ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4FE3AA3A42
  a skos:Concept ;
  skos:prefLabel "Analyse and Pre-Process"@en ;
  schema:category User Focus|Application and Reuse|Analyse and Pre-Process ;
  skos:definition A capability within the application and reuse domain that enables users to render digital objects through the application of emulation and/or other specialist tools. It supports the analysis and pre-processing of content to facilitate access and reuse. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6BA2330E96
  a skos:Concept ;
  skos:prefLabel "Bind to Application/ Semantic Mapping"@en ;
  schema:category User Focus|Application and Reuse|Bind to Application/ Semantic Mapping ;
  skos:definition A capability that enables the rendering of digital objects through the application of emulation and other specialist tools, supporting the integration of multiple tools across different file formats to facilitate application-level access and semantic mapping. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.04C904A984
  a skos:Concept ;
  skos:prefLabel "Download or stream"@en ;
  schema:category User Focus|Application and Reuse|Download or stream ;
  skos:definition A capability enabling users to download or stream digital objects for application and reuse purposes. The TDA facilitates the rendering of objects through the application of emulation and/or other specialist tools, supporting direct access and use of preserved digital content. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7F7C2776AC ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0F56D6B0C4
  a skos:Concept ;
  skos:prefLabel "Include into VRE or workflow"@en ;
  schema:category User Focus|Application and Reuse|Include into VRE or workflow ;
  skos:definition A user-focused capability that enables the rendering within or dissemination of digital objects to a Virtual Research Environment (VRE) or workflow. It supports the inclusion, application, and reuse of objects by providing appropriate technical means for their display and interaction. It supports application and reuse by making objects accessible and functional within designated research or processing environments. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.497C7ACE99 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2F6F8568A8
  a skos:Concept ;
  skos:prefLabel "Subset"@en ;
  schema:category User Focus|Application and Reuse|Subset ;
  skos:definition A capability that allows users to filter large datasets and retrieve only a specified subset of the resulting data. The system also enables the rendering of objects through the application of emulation and other specialist tools, supporting targeted access and reuse of content. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark iso:iso-3166-1.ttl ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6FB10117A8
  a skos:Concept ;
  skos:prefLabel "Community Engagement"@en ;
  schema:category User Focus|Community Engagement ;
  skos:definition A capability indicating whether the repository supports crosswalks and conversions between metadata packages as part of its value-added services. The TDA monitors its Designated Community to identify evolving needs and knowledge, ensuring transparency in the scope of services offered, including which package crosswalks are supported. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.319BC310D5
  a skos:Concept ;
  skos:prefLabel "Roadmaps"@en ;
  schema:category User Focus|Community Engagement|Roadmaps ;
  skos:definition A structured approach encompassing technology statements, planning processes, and implementation roadmaps that centers on user focus and community engagement. It provides directional guidance for technology adoption and development by aligning organizational planning with community needs and priorities. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_1 ;
  trsp:hasMeasurementType trsp:measurementTypeFormat ;
  trsp:hasBenchmark "Text" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.368F99A5F7
  a skos:Concept ;
  skos:prefLabel "Stakeholder Involvement"@en ;
  schema:category User Focus|Community Engagement|Stakeholder Involvement ;
  skos:definition The organisational practice of interacting with external parties, including individuals, partner organisations, funders, and other relevant bodies. This encompasses user focus, community engagement, and stakeholder involvement to foster meaningful participation and collaboration beyond the organisation's internal boundaries. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0E2DB53E0E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.675434DF2B
  a skos:Concept ;
  skos:prefLabel "Training Offered"@en ;
  schema:category User Focus|Community Engagement|Training Offered ;
  skos:definition Formal training provided to depositors, end users, stewards, internal staff, and other stakeholder groups to support effective use of repository services and to improve research data management practices. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0062B8B2C5
  a skos:Concept ;
  skos:prefLabel "User surveys"@en ;
  schema:category User Focus|Community Engagement|User surveys ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.650BA75F4F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6E790E641F
  a skos:Concept ;
  skos:prefLabel "Context"@en ;
  schema:category User Focus|Context ;
  skos:definition Indicates whether the owner or maintainer of a repository has claimed and vetted its corresponding FAIRsharing record. While FAIRsharing records are curated by an in-house team, direct participation of the responsible contact helps verify descriptions and track the evolution of the resource over time. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4B81FE7163
  a skos:Concept ;
  skos:prefLabel "Indexed in Scientific Knowledge Graphs"@en ;
  schema:category User Focus|Context|Indexed in Scientific Knowledge Graphs ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0893119B50
  a skos:Concept ;
  skos:prefLabel "Supports LOD References"@en ;
  schema:category User Focus|Context|Supports LOD References ;
  skos:definition A repository feature that supports the linking of datasets to related articles or pre-prints through Linked Open Data (LOD) references. It indicates whether the repository enables users to establish such links at the point of submission or at a later, post-submission stage. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.12C140C8CD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

