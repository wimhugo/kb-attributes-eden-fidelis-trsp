trsp:att.5BAF2CF9AA
  a skos:Concept ;
  skos:prefLabel "Information Management"@en ;
  schema:category Performance|Performance Assessment|Information Management ;
  skos:definition A set of processes used to assess compliance with standards, policies, and procedures, while identifying actions for continuous improvement. It encompasses the provision of hardware, software, and IT service management, monitoring user and technical needs to maintain and update levels of technical service across the organisation. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5086BAFCE4
  a skos:Concept ;
  skos:prefLabel "KPI-based monitoring"@en ;
  schema:category Performance|Performance Assessment|KPI-based monitoring ;
  skos:definition The extent to which strategic objectives and service KPIs are being achieved, assessed through the analysis of internal data and external information. This monitoring verifies and demonstrates that an organisation is effectively fulfilling its mission and scope. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

