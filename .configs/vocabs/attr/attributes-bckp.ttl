  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5A6C15E767 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.08DACE15B1
  a skos:Concept ;
  skos:prefLabel "Interoperability"@en ;
  schema:category Transparency|Scope of Services|Interoperability ;
  skos:definition The organizational processes for creating, managing, approving, releasing, updating, and withdrawing information artefacts—such as publications, policies, and guidelines—related to repository activities and functions. This encompasses publishing information that supports external assessments and external engagement, but excludes deposited digital objects. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.12C140C8CD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.696B580E35
  a skos:Concept ;
  skos:prefLabel "Interoperability Management"@en ;
  schema:category Transparency|Scope of Services|Interoperability|Interoperability Management ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.360E4F3F7F
  a skos:Concept ;
  skos:prefLabel "Interoperability Policy and Planning"@en ;
  schema:category Transparency|Scope of Services|Interoperability|Interoperability Management|Interoperability Policy and Planning ;
  skos:definition A policy framework that defines the considerations, drivers, and standards informing interoperability, encompassing the protocols and processes by which people, processes, technologies, and digital objects effectively interact within and across organisational entities. It covers the policy itself and associated implementation planning to guide consistent interoperability management. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2E979C3B25 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0C3DB9BFAA
  a skos:Concept ;
  skos:prefLabel "Interoperability Procedures"@en ;
  schema:category Transparency|Scope of Services|Interoperability|Interoperability Management|Interoperability Procedures ;
  skos:definition Documented protocols and processes that govern how people, processes, technologies, and digital objects effectively interact within and across organisational entities. These procedures ensure that interoperability policies and planning are consistently implemented, facilitating seamless exchange and cooperation both internally and externally. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.16855D3CB9 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

