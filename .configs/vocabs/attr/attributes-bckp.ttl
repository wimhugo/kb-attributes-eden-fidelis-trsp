  skos:broader trsp:att.4AA1880060 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.08C2A995C0
  a skos:Concept ;
  skos:prefLabel "Disclosure Risk Assessment Policy"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Risk Management|Disclosure Risk Assessment Policy ;
  skos:definition A policy governing the assessment and management of disclosure risks associated with documented information assets, including datasets that cannot be openly shared. It encompasses monitoring of technology evolution, identification of applicable risks, and definition of detection methods. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.12C140C8CD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1A4E593402
  a skos:Concept ;
  skos:prefLabel "Service Level Agreement"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4A2CF0AF0A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3B023F9CF0
  a skos:Concept ;
  skos:prefLabel "Machine-Readable SLA"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement|Machine-Readable SLA ;
  skos:definition A Service Level Agreement (SLA) attribute indicating whether a system publishes its SLAs in a machine-readable format, optionally linked to a corresponding human-readable version. This supports automated processing and interoperability while maintaining accessibility for human stakeholders. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.540F680A1E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.34C7F266CD
  a skos:Concept ;
  skos:prefLabel "Service Level Agreement Available"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement|Service Level Agreement Available ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.035ACCB10D ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5568B6EC80
  a skos:Concept ;
  skos:prefLabel "SLA based on community expectations"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement|SLA based on community expectations ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4B703E5E93
  a skos:Concept ;
  skos:prefLabel "SLA Vocabulary Used"@en ;
  schema:category Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement|SLA Vocabulary Used ;
  skos:definition An attribute identifying the vocabulary used by a system to define machine-readable Service Level Agreements (SLAs). It specifies the formal vocabulary or ontology adopted to structure and express SLA terms in a machine-interpretable format, ensuring interoperability and consistency in documented service commitments. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3532A00A80
  a skos:Concept ;
  skos:prefLabel "Confidentiality and Ethics"@en ;
  schema:category Responsibility|Stewardship|Confidentiality and Ethics ;
  skos:definition A set of protocols and processes governing how people, processes, technologies, and digital objects effectively interact with one another, both within and across organisational entities. This encompasses responsibilities related to stewardship, confidentiality, and ethical conduct in managing these interactions. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.035ACCB10D ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4DE2DD546E
  a skos:Concept ;
  skos:prefLabel "Confidentiality"@en ;
  schema:category Responsibility|Stewardship|Confidentiality and Ethics|Confidentiality ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.22D6F28F7C
  a skos:Concept ;
  skos:prefLabel "Sensitive Data Protection Measures in Place"@en ;
  schema:category Responsibility|Stewardship|Confidentiality and Ethics|Confidentiality|Sensitive Data Protection Measures in Place ;
  skos:definition The practice of safeguarding sensitive information and resources through the application of licence conditions and ongoing compliance monitoring. It encompasses stewardship responsibilities and ethical obligations to ensure confidential data is handled appropriately and protected from unauthorized use or disclosure. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.70DECA9F26 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.16855D3CB9
  a skos:Concept ;
  skos:prefLabel "Ethics"@en ;
  schema:category Responsibility|Stewardship|Confidentiality and Ethics|Ethics ;
  skos:definition A repository responsibility ensuring that data and metadata are created, curated, preserved, accessed, and used in compliance with legal and ethical norms, including privacy, confidentiality, and Indigenous Peoples' rights and wellbeing. It encompasses institutional awareness and processes for managing ethical and legal issues throughout the digital object lifecycle. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.24650A32BA ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.51E4556DFE
  a skos:Concept ;
  skos:prefLabel "Consent Obtained"@en ;
  schema:category Responsibility|Stewardship|Confidentiality and Ethics|Ethics|Consent Obtained ;
  skos:definition Consent Obtained denotes the fulfilment of legal and ethical obligations requiring organisations to engage inclusive, representative processes with relevant Indigenous communities. Such processes must address imbalances in power and resources and their effects on the expression of Indigenous and human rights. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.56F24C24C3
  a skos:Concept ;
  skos:prefLabel "Ethics Checklist"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows|Ethics Checklist ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2B19863F6A
  a skos:Concept ;
  skos:prefLabel "Ethics Guidance"@en ;
  schema:category Responsibility|Stewardship|Confidentiality and Ethics|Ethics|Ethics Guidance ;
  skos:definition The legal and ethical obligations an organisation must be aware of and adhere to, encompassing the provision of ethics-related guidance to depositors and end users. This includes stewardship responsibilities related to confidentiality, ensuring that both the organisation and its stakeholders operate within established ethical and legal frameworks. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "File Type IRIs" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1617820477
  a skos:Concept ;
  skos:prefLabel "Future Use Clarified with Subjects"@en ;
  schema:category Responsibility|Stewardship|Confidentiality and Ethics|Ethics|Future Use Clarified with Subjects ;
  skos:definition A principle requiring that data governance account for potential future uses and harms through ethical frameworks grounded in Indigenous community values. Metadata should document provenance, original purpose, and any limitations or obligations on secondary use, including consent requirements, ensuring subjects are informed of and have clarity on how their data may be used in the future. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5A6C15E767 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.61C5AB7572
  a skos:Concept ;
  skos:prefLabel "Institutional Ethics Clearance"@en ;
  schema:category Responsibility|Stewardship|Confidentiality and Ethics|Ethics|Institutional Ethics Clearance ;
  skos:definition Institutional Ethics Clearance refers to the formal process by which a repository obtains and documents ethical approval in accordance with its policy. Repositories demonstrate compliance by linking to relevant ethics clearance documentation and policy evidence. This attribute confirms that such documentation is accessible and verifiable through the repository. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.72F38A16D8
  a skos:Concept ;
  skos:prefLabel "Integrity and Authenticity"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity ;
  skos:definition A stewardship practice involving the ongoing monitoring of technological developments and user community needs to identify changes that may affect the usability or comprehension of digital objects. When risks are identified, preservation actions such as format migration, metadata updating, or environment emulation are undertaken. These measures ensure the long-term viability and continued accessibility of digital objects. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.608015D600
  a skos:Concept ;
  skos:prefLabel "Authenticity - determine and protect"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4808A1524B
  a skos:Concept ;
  skos:prefLabel "Checked for AI-generated Content"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for AI-generated Content ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.06D09133AE ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5AF211B2C5
  a skos:Concept ;
  skos:prefLabel "Checked for Duplicate Publication"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for Duplicate Publication ;
  skos:definition A quality control process in which submitted or existing publications are examined to verify whether they have been previously published elsewhere. This check ensures integrity and authenticity by identifying and protecting against duplicate publication. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.44841F89C3
  a skos:Concept ;
  skos:prefLabel "Checked for Illegal Content"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for Illegal Content ;
  skos:definition A process in which the legality of content is verified to ensure compliance with applicable laws and regulations. This check forms part of broader efforts to maintain integrity and authenticity by identifying and protecting against illegal material within a collection or system. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6E790E641F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeChecklistEvidence ;
  trsp:hasBenchmark trsp:checklistIndex ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5E73BD05DF
  a skos:Concept ;
  skos:prefLabel "Checked for Irrelevant Content"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for Irrelevant Content ;
  skos:definition A process in which content is examined to identify and address nonsense or irrelevant material. This check supports authenticity and integrity by ensuring that only meaningful, relevant content is retained or presented. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1C495E8A94
  a skos:Concept ;
  skos:prefLabel "Checked for Malicious Content"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for Malicious Content ;
  skos:definition A practice in which digital or physical content is examined to identify and remove harmful or malicious elements. This process supports authenticity and integrity by ensuring that materials are free from threats before use or distribution. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.678439CD93 ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark trsp:compensation-rule-type ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.72DE0527E3
  a skos:Concept ;
  skos:prefLabel "Documented Pre-submission Provenance"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Documented Pre-submission Provenance ;
  skos:definition A repository practice encompassing the documentation and inspection of provenance information to confirm the authenticity of digital objects submitted for publication or preservation. Provenance and authenticity records may be captured at deposit, generated during curation, and shared with users. Preservation actions—such as format migration or metadata updates—are taken as needed to ensure long-term accessibility. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.76B25EFA00
  a skos:Concept ;
  skos:prefLabel "Identify Depositors"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Identify Depositors ;
  skos:definition A transparency attribute identifying the scope of value-added crosswalk and conversion services supported within a package, specifically focusing on identification checks performed for depositors. It documents which crosswalk mappings are available and supported as part of the service offering. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.301A364D55
  a skos:Concept ;
  skos:prefLabel "Depositors are identified and verified"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Identify Depositors|Depositors are identified and verified ;
  skos:definition The repository identifies and verifies that submissions are made by researchers or individuals acting in a research context, ensuring the deposit is a dataset associated with original research. Verification relies on metadata attributes supplied by an identity provider. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2080C1D4EE
  a skos:Concept ;
  skos:prefLabel "Integrity"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Integrity ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4E4FD79526 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4B8DBC2795
  a skos:Concept ;
  skos:prefLabel "Checksum Computation/ Verification"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Integrity|Checksum Computation/ Verification ;
  skos:definition A trustworthy digital archive computes and records checksums for every file, validating them against values stored in the Information Package at ingest or access. Checksums are also computed before and after migration and retained to support future preservation management, ensuring the ongoing integrity and authenticity of digital objects. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.09B9B96513
  a skos:Concept ;
  skos:prefLabel "File Repair"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Integrity|File Repair ;
  skos:definition A standardized process in which a trusted digital archive (TDA) corrects structural issues identified in files, addressing validation or rendering errors. Invalid files are repaired according to a governing document, ensuring the integrity and authenticity of preserved content. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.419EE6D029 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6AF0D4DC26
  a skos:Concept ;
  skos:prefLabel "Plagiarism Verification"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Integrity|Plagiarism Verification ;
  skos:definition Plagiarism Verification is the practice of performing systematic checks to detect instances of plagiarism within content or work. It supports principles of integrity and authenticity by ensuring that material is original and properly attributed. This process upholds responsible stewardship of intellectual and scholarly standards. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6CCE23A07E
  a skos:Concept ;
  skos:prefLabel "Statistical Integrity"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Integrity|Statistical Integrity ;
  skos:definition A value-added service capability indicating the scope of crosswalk and conversion packages supported within a system or service offering. It encompasses statistical integrity verification to ensure accuracy and consistency when mapping or translating data between different schemas, formats, or standards. This transparency attribute helps users assess interoperability and data quality assurance. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2923D6DE38
  a skos:Concept ;
  skos:prefLabel "Virus and Malware Checking"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Integrity|Virus and Malware Checking ;
  skos:definition A process in which information packages and digital objects are checked for viruses and malware, typically performed at ingest. Infected items are managed through appropriate quarantine facilities to protect the integrity and authenticity of the repository's holdings. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.27F5C3BD10
  a skos:Concept ;
  skos:prefLabel "Version Maintenance"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Version Maintenance ;
  skos:definition A property indicating whether a persistent identifier (PID) system tracks different versions of a digital object over time. Version maintenance supports integrity and authenticity by ensuring that distinct states or revisions of an object are identifiable and distinguishable within the PID system. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5ABD0E52C7 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.242EE15759
  a skos:Concept ;
  skos:prefLabel "Submission and Archival Package Maintenance"@en ;
  schema:category Responsibility|Stewardship|Integrity and Authenticity|Version Maintenance|Submission and Archival Package Maintenance ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7592D43F0B ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.570534F4B8
  a skos:Concept ;
  skos:prefLabel "Long-term Preservation"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation ;
  skos:definition Processes and activities for managing, changing, and maintaining digital objects along with their associated data and metadata in accordance with legal, ethical, policy, and other standards and operating procedures. This encompasses long-term stewardship responsibilities to ensure digital content remains accessible, authentic, and compliant with relevant frameworks over time. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.76E3F555FC
  a skos:Concept ;
  skos:prefLabel "Bit-Level Preservation"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Bit-Level Preservation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1C44587E88
  a skos:Concept ;
  skos:prefLabel "Persistence Median"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Persistence Median ;
  skos:definition The persistence median is a measure used to assess the long-term preservation performance of Persistent Identifier (PID) services, reflecting the typical duration for which identifiers remain reliably resolvable. PID services should target a persistence median that meets the expectations of dependent communities and stakeholders, ensuring stewardship responsibilities are fulfilled over time. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.678439CD93 ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark trsp:revenue-method-type-scheme ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.497C7ACE99
  a skos:Concept ;
  skos:prefLabel "Re-appraisal"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Re-appraisal ;
  skos:definition Repositories bear a stewardship responsibility to periodically re-appraise the digital objects they hold, either on a scheduled basis or in response to defined triggers. This ongoing evaluation ensures that preserved objects continue to meet the repository's collection criteria and long-term preservation objectives. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.48B32FB000 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4EA4FE6911
  a skos:Concept ;
  skos:prefLabel "Re-appraisal Plan"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Re-appraisal Plan ;
  skos:definition A repository stewardship function encompassing the acceptance of custody of digital objects from depositors and the ongoing evaluation and re-evaluation of their data quality. It includes planning for re-appraisal activities—covering frequency, triggers, scope, tools, and procedures—to ensure Information Objects continue to meet established criteria for long-term preservation. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3FD2C99B44
  a skos:Concept ;
  skos:prefLabel "(Re-)Appraisal of Licence Applicability"@en ;
  schema:category Responsibility|Stewardship|Process|Licence-Related Processes|(Re-)Appraisal of Licence Applicability ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.50DA0AA84E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.720D076722
  a skos:Concept ;
  skos:prefLabel "File format preservation actions"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Re-appraisal|File format preservation actions ;
  skos:definition A service capability encompassing periodic integrity checking of files, reporting damaged or missing content, and ongoing evaluation of data quality for information objects. Files in obsolete formats are migrated to sustainable formats, ensuring long-term accessibility and reliability of preserved content. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.36E9CFFB4B
  a skos:Concept ;
  skos:prefLabel "Record of Re-Appraisal"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Re-appraisal|Record of Re-Appraisal ;
  skos:definition A record documenting the re-appraisal of repository holdings, capturing the most recent date on which a Trusted Digital Archive evaluated or re-evaluated the data quality of its Information Objects. Re-appraisal is an ongoing stewardship responsibility supporting long-term preservation. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2744CED24F ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.00577FC6FC
  a skos:Concept ;
  skos:prefLabel "Resolution Authenticity or Efficiency"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Resolution Authenticity or Efficiency ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4840647866 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6D7D249110
  a skos:Concept ;
  skos:prefLabel "Active Bit-Level Preservation in Place"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Resolution Authenticity or Efficiency|Active Bit-Level Preservation in Place ;
  skos:definition Active bit-level preservation in place encompasses periodic integrity checking of stored Information Packages, replacement of damaged files from replicated copies, and migration of packages to new storage media at end-of-life, with reporting on all actions taken. Activities may also extend to projects involving new approaches to data, metadata, technology, and research infrastructure beyond routine maintenance. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5842EC5239
  a skos:Concept ;
  skos:prefLabel "Resolution Percentage"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Resolution Authenticity or Efficiency|Resolution Percentage ;
  skos:definition A stewardship responsibility requiring that a PID service resolve at least a defined percentage (p) of persistent identifiers drawn from a randomised sample, where the threshold value of p is determined by community and dependency expectations. This metric supports long-term preservation goals by ensuring authentic and efficient resolution of PIDs over time. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.54CF71ED24
  a skos:Concept ;
  skos:prefLabel "Resolution Integrity"@en ;
  schema:category Responsibility|Stewardship|Long-term Preservation|Resolution Integrity ;
  skos:definition A PID Manager must ensure that entities remain persistently linked to their Persistent Identifiers (PIDs), maintaining the integrity of this relationship in conformance with the relevant PID Scheme defined by a PID Authority. If an identified entity is deleted or ceases to exist, tombstone information must be included in the PID attribute set to preserve resolution integrity. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.297ED3685C
  a skos:Concept ;
  skos:prefLabel "Process"@en ;
  schema:category Responsibility|Stewardship|Process ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4AA1880060
  a skos:Concept ;
  skos:prefLabel "Curation & Preservation Workflows"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows ;
  skos:definition Curation and preservation workflows encompass the defined processes—from deposit through access—by which digital objects are made and kept usable and understandable. Facilitating reuse depends on understanding user needs, including those of designated communities, through ongoing external engagement. Repositories may mediate access via secure remote systems or safe rooms that keep digital objects under the service provider's control. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E9295C9A1 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.18E904AAE2
  a skos:Concept ;
  skos:prefLabel "Disposal and Retraction Workflows"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows|Disposal and Retraction Workflows ;
  skos:definition A workflow within the Trusted Digital Archive (TDA) that governs the managed disposal or retraction of Information Packages under defined policies and conditions. Even after content removal, the TDA retains and maintains tombstone metadata, ensuring a persistent record of the disposed resource. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0D3C935A8A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0FE5D01C72
  a skos:Concept ;
  skos:prefLabel "FAIR Assessment"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows|FAIR Assessment ;
  skos:definition The process of defining an organisation's mission and the boundaries of activities for which it holds ultimate responsibility, including those involving partners or outsourced services. It provides reference information and context for all related repository activities and functions, ensuring accountability is retained regardless of how services are delivered. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.00577FC6FC ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeFormat ;
  trsp:hasBenchmark "Float" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.50ADCE9E0D
  a skos:Concept ;
  skos:prefLabel "FAIR Assessment Tool(s)"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows|FAIR Assessment Tool(s) ;
  skos:definition A process responsibility within curation and preservation workflows whereby repositories disclose and document the specific FAIR assessment tool or tools used to evaluate the FAIRness of their resources. Transparency in tool selection supports reproducibility and accountability in stewardship practices. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.64A44F5193
  a skos:Concept ;
  skos:prefLabel "Legal Compliance Checklist"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows|Legal Compliance Checklist ;
  skos:definition A structured checklist capturing the legal and ethical obligations—including GDPR, national open data laws, and institutional or funding policies—that a repository must identify and adhere to. It supports curation and preservation workflows by providing mechanisms to assess and ensure lawful access, storage, and sharing of digital assets. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5F37A613BB
  a skos:Concept ;
  skos:prefLabel "Preservation Workflow"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows|Preservation Workflow ;
  skos:definition A preservation workflow encompasses the standard procedures and ongoing activities aimed at safeguarding digital objects over the long term. It involves monitoring changes in the technology landscape and user community that may affect usability, and taking corrective actions—such as format migration, metadata updates, or environment emulation—to ensure continued accessibility and reuse. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2EC221BD80
  a skos:Concept ;
  skos:prefLabel "Privacy/ Sensitive Data Checklist"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows|Privacy/ Sensitive Data Checklist ;
  skos:definition A repository process in which deposited content is examined to determine whether personal or pseudonymised data is present. If such data is identified, the repository applies a documented procedure to assess the required level of protection and implements appropriate safeguards accordingly. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.64FDE59BAD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark r3d:content-types.ttl ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6A5BF0698F
  a skos:Concept ;
  skos:prefLabel "Rights Obtained from Depositor"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows|Rights Obtained from Depositor ;
  skos:definition A record or reference linking to documentation that verifies license mandate checks obtained from a depositor, supporting curation and preservation workflows. It captures the rights and permissions acquired during the deposit process, ensuring responsible stewardship of deposited materials. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.12CA661DF7
  a skos:Concept ;
  skos:prefLabel "Submission Workflow"@en ;
  schema:category Responsibility|Stewardship|Process|Curation & Preservation Workflows|Submission Workflow ;
  skos:definition A submission workflow encompasses the processes by which a trusted digital archive accepts custody of digital objects from depositors, performs operations to transform Submission Information Packages (SIPs) into Archival Information Packages (AIPs), and ensures compliance with format requirements, metadata standards, and quality criteria. It includes ingesting and managing metadata appropriate to specific content types, validating submissions against agreed protocols, and supporting harmonised, community-aligned deposit workflows to foster interoperability and consistent metadata quality. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0FEE58FD17 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.697C57FE46
  a skos:Concept ;
  skos:prefLabel "Licence-Related Processes"@en ;
  schema:category Responsibility|Stewardship|Process|Licence-Related Processes ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.769A9F52BD
  a skos:Concept ;
  skos:prefLabel "Explanation of Licence Provisions"@en ;
  schema:category Transparency|Scope of Services|Discovery|Proper Citation|Explanation of Licence Provisions ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.49EE16D366
  a skos:Concept ;
  skos:prefLabel "Licence Combination Supported/ Verified"@en ;
  schema:category Responsibility|Stewardship|Process|Licence-Related Processes|Licence Combination Supported/ Verified ;
  skos:definition A stewardship process concerned with publishing a compatibility matrix or guidance to support the combining of licences. It enables users to verify which licence combinations are permissible, facilitating informed decisions when integrating multiply-licensed resources. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.74FDFB3E00 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Schema IRIs" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0CBE414A78
  a skos:Concept ;
  skos:prefLabel "Verification of Licence Assent"@en ;
  schema:category Responsibility|Stewardship|Process|Licence-Related Processes|Verification of Licence Assent ;
  skos:definition A process in which the repository verifies and records whether end users assent to licence conditions prior to accessing or downloading data. It also ensures that actors expected to act on licence provisions are identified according to a specific model or vocabulary. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.608015D600 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4D039CA977
  a skos:Concept ;
  skos:prefLabel "Monitoring"@en ;
  schema:category Responsibility|Stewardship|Process|Monitoring ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3E5B47B5C9
  a skos:Concept ;
  skos:prefLabel "Inventory - SOPs and Workflows"@en ;
  schema:category Responsibility|Stewardship|Process|Monitoring|Inventory - SOPs and Workflows ;
  skos:definition A structured inventory of standard operating procedures and workflows—supported by evidence links—governing the management, maintenance, and quality control of digital objects and their associated metadata. These processes ensure that digital objects meet defined legal, ethical, policy, and quality standards before being made available for reuse, and ensures reuse in accordance with policies and applicable licences. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7362D6D981 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistReuse ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.24C260AA9C
  a skos:Concept ;
  skos:prefLabel "Monitor Process Compliance"@en ;
  schema:category Responsibility|Stewardship|Process|Monitoring|Monitor Process Compliance ;
  skos:definition A stewardship and monitoring process that verifies alignment of submissions with policy or guidance requirements. It encompasses delivery of reporting—including functional, operational, and statistical reports and analytics—to enable the effective management of objects and ensure ongoing process compliance. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6A837D5A94 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.22831D6953
  a skos:Concept ;
  skos:prefLabel "Provenance"@en ;
  schema:category Responsibility|Stewardship|Provenance ;
  skos:definition A repository mechanism encompassing the processes by which edits, corrections, and additions to a deposited dataset are tracked and managed, including version control and linking of successive versions. The repository guarantees authenticity of digital objects by recording provenance information and audit trails for all data and metadata processing, ensuring full accountability and traceability. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.70DECA9F26 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3C8326FC1D
  a skos:Concept ;
  skos:prefLabel "Update Functionality"@en ;
  schema:category Responsibility|Stewardship|Provenance|Update Functionality ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.696B580E35 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.11DF98311A
  a skos:Concept ;
  skos:prefLabel "Software provides update functionality"@en ;
  schema:category Responsibility|Stewardship|Provenance|Update Functionality|Software provides update functionality ;
  skos:definition A functional requirement specifying that the PID manager must provide the capabilities necessary to maintain and update PID attributes. This encompasses stewardship and provenance responsibilities, ensuring that the software delivering update functionality upholds accountability for the ongoing management of persistent identifier records. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.697C57FE46 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0FEE58FD17
  a skos:Concept ;
  skos:prefLabel "Versioning - Procedure"@en ;
  schema:category Responsibility|Stewardship|Provenance|Versioning - Procedure ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.570534F4B8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0EBAC52CB6
  a skos:Concept ;
  skos:prefLabel "Published versioning procedure available"@en ;
  schema:category Responsibility|Stewardship|Provenance|Versioning - Procedure|Published versioning procedure available ;
  skos:definition A procedure in which persistent identifiers are assigned to objects, information packages, and metadata and managed throughout their life cycle. PID services and PID managers should maintain clear, published versioning policies governing how identifiers and their associated resources are updated over time. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2080C1D4EE ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.73E0B308E5
  a skos:Concept ;
  skos:prefLabel "Versioning Strategy/ Objective"@en ;
  schema:category Responsibility|Stewardship|Provenance|Versioning - Procedure|Versioning Strategy/ Objective ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.00C02C55DC
  a skos:Concept ;
  skos:prefLabel "Quality Control - Deposit Documentation"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation ;
  skos:definition Deposit documentation and quality control encompasses the acceptance of digital objects from depositors, transferring custodial responsibility to the repository while ensuring submissions meet established metadata, curation, and technical standards. The repository evaluates compliance before making objects available for reuse and provides sufficient information for end users to make quality-related assessments. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0DA8E81794 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.700343D2B3
  a skos:Concept ;
  skos:prefLabel "Accurate Entity Metadata"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata ;
  skos:definition The PID Manager must maintain entity metadata as accurately as possible in collaboration with the PID Owner, with this copy serving as the authoritative version. This requirement supports transparency in scope of services by ensuring reliable, value-added package crosswalks and conversions are underpinned by accurate, authoritative metadata. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4EA572A954
  a skos:Concept ;
  skos:prefLabel "Mandatory Metadata Verified"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata|Mandatory Metadata Verified ;
  skos:definition A process by which mandatory metadata is validated against a defined profile to verify completeness and accuracy of deposit documentation. Repositories can assess Archival Information Packages (AIPs) in a standardised way using the OAIS Information Model, enabling identification of missing or incomplete information. The AIP information model is flexible enough to accommodate emerging standards supporting quality control and fitness assessment. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6420BCA43E
  a skos:Concept ;
  skos:prefLabel "Metadata validated against profile"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata|Metadata validated against profile ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7AC495443D
  a skos:Concept ;
  skos:prefLabel "URI-linked semantics in metadata"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata|URI-linked semantics in metadata ;
  skos:definition A system capability indicating whether controlled vocabulary and ontology terms are exposed via persistent URIs that resolve to machine-readable representations. This supports automated metadata interpretation, reasoning, and cross-system integration, and indicates whether persistent identifiers (PIDs) are provided for semantic terms. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.51C655BFB0
  a skos:Concept ;
  skos:prefLabel "Vocabulary and semantic artefacts linked in metadata"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata|Vocabulary and semantic artefacts linked in metadata ;
  skos:definition A quality control requirement ensuring that semantic artefacts (vocabularies, ontologies, and context files) used in deposit metadata are published, discoverable, and accessible through domain-recognized reference repositories. Compliant systems expose these resources via APIs or queryable endpoints, apply persistent identifiers, and make metadata available for harvesting to promote reuse, semantic consistency, and machine-actionability. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2AF9C821F9
  a skos:Concept ;
  skos:prefLabel "Data Validation"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Data Validation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark trsp:package-type-scheme ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.66C51E0B90
  a skos:Concept ;
  skos:prefLabel "Validation of Data Against Schema or Rules"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Data Validation|Validation of Data Against Schema or Rules ;
  skos:definition A repository process that validates deposited file contents against a defined set of rules or schema requirements, ensuring conformance to repository standards. For example, constraints such as uniqueness of values in a specified field are enforced systematically. Associated documentation references are linked to each relevant profile. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4A98F89201
  a skos:Concept ;
  skos:prefLabel "Deposit Documentation Checklist"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Deposit Documentation Checklist ;
  skos:definition A structured checklist, supported by evidence, documenting the quality assurance measures applied to deposits (submissions) accepted into the repository. It encompasses the evaluation and re-evaluation of data quality for information objects, as well as the transfer of custodial responsibility from depositors to the repository, including appraisal against established acceptance criteria. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4721CBC19A ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.00EDBED146
  a skos:Concept ;
  skos:prefLabel "Technical validation"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Technical validation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4A04909C47 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.552D4D7CBF
  a skos:Concept ;
  skos:prefLabel "Machine-actionable format templates in use"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Technical validation|Machine-actionable format templates in use ;
  skos:definition Machine-actionable format templates define and structure the significant properties for each file format supported within a deposit documentation workflow. These templates enable technical validation by providing scoring or weighting criteria for evaluating format-specific properties, supporting systematic quality control and stewardship responsibilities. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.25D8680361
  a skos:Concept ;
  skos:prefLabel "Significant Properties Extracted"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Technical validation|Significant Properties Extracted ;
  skos:definition The repository extracts and records significant technical properties—such as file size, image dimensions, video codec, audio runtime, and creating application—from ingested Information Objects. These properties, defined by the repository for supported file formats, represent characteristics it commits to preserve over the long term through preservation actions and rendition. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1AE2618C36 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.650F58F3BC
  a skos:Concept ;
  skos:prefLabel "Tools for Technical Metadata Extraction"@en ;
  schema:category Responsibility|Stewardship|Quality Control - Deposit Documentation|Technical validation|Tools for Technical Metadata Extraction ;
  skos:definition A set of tools used within deposit documentation workflows to automatically extract technical metadata characteristics from digital objects, including properties such as file size, image dimensions, video codec, audio run time, and creating application. These tools support technical validation and quality control responsibilities in digital stewardship. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.06F21028D1
  a skos:Concept ;
  skos:prefLabel "Rights Management"@en ;
  schema:category Responsibility|Stewardship|Rights Management ;
  skos:definition A repository function encompassing the management and communication of all rights—permissions, prohibitions, and obligations—related to data and metadata deposit, storage, preservation, access, and use. It involves adopting policies, standards, and criteria aligned with governance structures, operational workflows, and applicable legal and ethical frameworks to guide stewardship practice. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.365F68CB18 ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark iso:iso-639-3.ttl ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.297AD6F574
  a skos:Concept ;
  skos:prefLabel "Considerations"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Considerations ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2A0E93C1AC
  a skos:Concept ;
  skos:prefLabel "IP Management"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Considerations|IP Management ;
  skos:definition The process by which a Trusted Digital Archive manages intellectual property, licence conditions, and rights related to Information Objects. This encompasses rights for internal agents—such as access and migration—as well as for end users, including access and reuse permissions. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistPIDResolution ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1B812FFC4E
  a skos:Concept ;
  skos:prefLabel "No Harm, Maximise Benefit"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Considerations|No Harm, Maximise Benefit ;
  skos:definition A stewardship principle encompassing the management of rights over information objects for both internal agents and end users, while ensuring data practices align with relevant ethical frameworks—including Indigenous rights affirmed in UNDRIP—and that benefits and harms are assessed from the perspective of the communities to whom the data relate. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5CF6AB3B6E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5D17940B6B
  a skos:Concept ;
  skos:prefLabel "Privacy and GDPR Addressed"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Considerations|Privacy and GDPR Addressed ;
  skos:definition A trusted digital archive (TDA) manages rights related to information objects for both internal agents (e.g., access, migration) and end users (e.g., access, reuse), while ensuring its privacy statement complies with GDPR requirements. This encompasses stewardship responsibilities spanning rights management, access control, and data protection obligations. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.553A464EC8
  a skos:Concept ;
  skos:prefLabel "Depositor Rights"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Depositor Rights ;
  skos:definition Depositor Rights refers to the protection and management of intellectual property rights belonging to data producers. It encompasses the stewardship responsibilities associated with safeguarding these rights while enabling appropriate publication and use of the data. This ensures that creators retain recognized ownership and control over their produced data assets. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.521A4A9E17
  a skos:Concept ;
  skos:prefLabel "Appraisal/ Accession Policy"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Depositor Rights|Appraisal/ Accession Policy ;
  skos:definition A policy governing the deposit and accession of materials into a repository, defining the rights, responsibilities, and stewardship obligations of depositors. It establishes the terms under which content is accepted, appraised, and managed, clarifying depositor rights and the repository's role in long-term preservation and access. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.206C4C60AA
  a skos:Concept ;
  skos:prefLabel "Terms of Deposit"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Depositor Rights|Terms of Deposit ;
  skos:definition A repository's framework governing the scope of its mission, rights management over information objects, and terms of deposit. It defines which datasets are accepted, from whom, and under what conditions, while managing access and reuse rights for internal agents and end users. The organization retains ultimate responsibility for all activities, even when delivered through partners or outsourced services. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6FB10117A8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3D6A6043D4
  a skos:Concept ;
  skos:prefLabel "Documentation"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Documentation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.71A5D27D84 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.550348356C
  a skos:Concept ;
  skos:prefLabel "Human-readable rights documentation"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Documentation|Human-readable rights documentation ;
  skos:definition The management of permissions, prohibitions, and obligations governing how digital objects are accessed, migrated, and reused by agents within a repository and by end users. Rights metadata is maintained for both human-readable consumption—referenced via URI as licence documents—and machine-readable processing, covering access, reuse, and other applicable conditions. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7C56B5ED00
  a skos:Concept ;
  skos:prefLabel "Encoding"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Encoding ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7D05A04E46
  a skos:Concept ;
  skos:prefLabel "Basis of Rights Encoding"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Encoding|Basis of Rights Encoding ;
  skos:definition Rights Expression Languages (RELs) are formal models for declaring the conditions under which digital content may be accessed, reused, or redistributed, defining actors, actions, constraints, and duties. Rights Markup Languages (RMLs) implement these models within metadata schemas and web standards using machine-readable formats such as RDF, XML, or JSON-LD. Package crosswalk support enables transparency in mapping and converting between these frameworks across services. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5A6C15E767
  a skos:Concept ;
  skos:prefLabel "Other Actor Rights"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Other Actor Rights ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.48C6F0C32D
  a skos:Concept ;
  skos:prefLabel "Curator Rights"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Other Actor Rights|Curator Rights ;
  skos:definition Curator rights encompass the permissions, prohibitions, and obligations governing how digital objects and their metadata are accessed, improved, and published within a trusted digital archive. These rights apply to agents inside the repository's scope—covering tasks such as migration and metadata enhancement—as well as to end users, including adjudicating access requests and enabling reuse. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3F6736BF1C ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.76E631CB8D
  a skos:Concept ;
  skos:prefLabel "End User Rights"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Other Actor Rights|End User Rights ;
  skos:definition A capability indicating that the Trusted Digital Archive (TDA) manages rights related to Information Objects for both internal agents—covering operations such as access and migration—and end users, including access and reuse permissions. This encompasses the scope of rights management services provided across supported package crosswalk conversions. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.49C7B241EA
  a skos:Concept ;
  skos:prefLabel "Owners/ Rightsholder Rights"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Other Actor Rights|Owners/ Rightsholder Rights ;
  skos:definition The Trusted Digital Archive (TDA) manages rights related to Information Objects on behalf of both internal agents and end users, covering access, migration, and reuse. It verifies the legal basis for holding and preserving AIPs, obtains rightsholder consent, and ensures rightsholders may consent to publication and select appropriate licences or access conditions. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.48B32FB000 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.24650A32BA
  a skos:Concept ;
  skos:prefLabel "Subject Rights"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Subject Rights ;
  skos:definition A concept encompassing the rights and ethical considerations pertaining to research subjects, including policies and evidence addressing those rights. It specifically recognizes that Indigenous Peoples hold collective and individual rights over Indigenous Knowledge and data, including free, prior, and informed consent in data collection, use, and policy development. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7592D43F0B ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2D03EB4E9B
  a skos:Concept ;
  skos:prefLabel "Consent Form Example Available"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Subject Rights|Consent Form Example Available ;
  skos:definition An attribute indicating that the repository provides access to example consent forms, confirming the availability of a link to such forms. This supports transparency in rights management and subject rights by demonstrating how informed consent is documented and managed within the repository's stewardship practices. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark <https://lov.linkeddata.es/dataset/api/v2/vocabulary/list> ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1B3A0A1CF6
  a skos:Concept ;
  skos:prefLabel "Consent Forms Verified, Linked"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Subject Rights|Consent Forms Verified, Linked ;
  skos:definition A stewardship and rights management state in which consent forms pertaining to a subject have been verified and are linked or otherwise available within the system. This condition confirms that the necessary authorizations and subject rights documentation are accessible, supporting accountability and responsible data governance. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5CF6AB3B6E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5ADB3FC0BB
  a skos:Concept ;
  skos:prefLabel "Grounded - Aligned with Subject Context"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Subject Rights|Grounded - Aligned with Subject Context ;
  skos:definition Resources must be provided to generate data that is grounded in the languages, worldviews, and lived experiences of Indigenous Peoples, including their values and principles. This responsibility ensures that rights management and stewardship practices are aligned with the subject context of Indigenous communities. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5DCB41BB3F
  a skos:Concept ;
  skos:prefLabel "Registry of Access Requests"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Subject Rights|Registry of Access Requests ;
  skos:definition A registry in which the repository records all access requests and their outcomes, supporting accountability and transparency in rights management. Maintaining such a registry demonstrates the repository's commitment to subject rights and responsible stewardship of access decisions. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.264E948225
  a skos:Concept ;
  skos:prefLabel "Subjects Have a Right to the Data"@en ;
  schema:category Responsibility|Stewardship|Rights Management|Subject Rights|Subjects Have a Right to the Data ;
  skos:definition Indigenous Peoples hold an inherent right to data relevant to their worldviews, self-determination, and effective self-governance. Indigenous data must be made accessible to Indigenous nations and communities to support Indigenous governance. This principle falls within the domain of responsibility, stewardship, and rights management over data. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1AE2618C36 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3319EEDC99
  a skos:Concept ;
  skos:prefLabel "Transfer"@en ;
  schema:category Responsibility|Stewardship|Transfer ;
  skos:definition The transfer of stewardship responsibility occurs when a PID owner is no longer able to fulfill their obligations under applicable policy. To support continuity, the PID manager should establish policies and contractual arrangements that govern the transfer of ownership in such circumstances. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0B3D7477E7 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1257C370DF
  a skos:Concept ;
  skos:prefLabel "PID Ownership Transfer is Possible"@en ;
  schema:category Responsibility|Stewardship|Transfer|PID Ownership Transfer is Possible ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4D039CA977 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.7436BDEA62
  a skos:Concept ;
  skos:prefLabel "Repository Transfer is Possible"@en ;
  schema:category Responsibility|Stewardship|Transfer|Repository Transfer is Possible ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4A43A19133
  a skos:Concept ;
  skos:prefLabel "Typical Value-added Services"@en ;
  schema:category Responsibility|Typical Value-added Services ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.74FDFB3E00 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Schema IRIs" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.50AF53C9B2
  a skos:Concept ;
  skos:prefLabel "Community Support"@en ;
  schema:category Responsibility|Typical Value-added Services|Community Support ;
  skos:definition A community support service encompassing brokering, mediation, and content negotiation on behalf of the community, as well as providing provenance and authenticity information about digital objects. Such information details the history of digital objects, may be captured at deposit or during curation, and is shared with data and metadata users to ensure authenticity. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5DC262FE75
  a skos:Concept ;
  skos:prefLabel "Guidelines and Support"@en ;
  schema:category Responsibility|Typical Value-added Services|Community Support|Guidelines and Support ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.62E1C089DB
  a skos:Concept ;
  skos:prefLabel "User Guidance and Documentation"@en ;
  schema:category Responsibility|Typical Value-added Services|Community Support|Guidelines and Support|User Guidance and Documentation ;
  skos:definition A repository responsibility encompassing the provision of clear, user-friendly documentation, tutorials, and support services that guide depositors and users through deposit, discovery, access, and reuse of data and metadata. It includes defining organizational purpose and boundaries of responsibility, leveraging internal expertise to deliver training across the digital object lifecycle, and maintaining accessible, consistent interfaces to lower barriers to effective use. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3E85A87190
  a skos:Concept ;
  skos:prefLabel "User-focused Access"@en ;
  schema:category Responsibility|Typical Value-added Services|Community Support|Guidelines and Support|User-focused Access ;
  skos:definition The process of determining and facilitating appropriate methods of user access to digital objects—such as direct download or use within a secure remote environment—based on the characteristics of both the objects and the users. Access criteria are applied in alignment with rights management policies to ensure compliant and user-appropriate delivery. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.67DE43D8DF ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.532324DE1D
  a skos:Concept ;
  skos:prefLabel "Inventory of Available Services"@en ;
  schema:category Responsibility|Typical Value-added Services|Inventory of Available Services ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1146FD1520
  a skos:Concept ;
  skos:prefLabel "Documentation Available"@en ;
  schema:category Responsibility|Typical Value-added Services|Inventory of Available Services|Documentation Available ;
  skos:definition A service attribute indicating whether a system provides comprehensive documentation, tutorials, and support resources that enable users to access, understand, and effectively use available services—particularly in cross-disciplinary or multi-platform environments. This includes clear service descriptions, links to deployed instances (test, development, production), and relevant source code, collectively lowering barriers to entry and promoting effective onboarding. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4AA1880060 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4CB4F7ED15
  a skos:Concept ;
  skos:prefLabel "Machine-Readable Inventory"@en ;
  schema:category Responsibility|Typical Value-added Services|Inventory of Available Services|Machine-Readable Inventory ;
  skos:definition A machine-readable inventory that documents the value-added services available within a given responsibility domain, specifically cataloguing the harvesting protocols that are supported. It enables automated systems to discover and interact with available services through standardized, machine-interpretable representations. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1F4AE0B0F8
  a skos:Concept ;
  skos:prefLabel "Metrics"@en ;
  schema:category Responsibility|Typical Value-added Services|Metrics ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.04F0DB0243 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0C3FB3218D
  a skos:Concept ;
  skos:prefLabel "Usage Metrics"@en ;
  schema:category Responsibility|Typical Value-added Services|Metrics|Usage Metrics ;
  skos:definition The implementation and provision of relevant data metrics to users, encompassing the analysis of internal data and external information to verify and demonstrate that an organisation is effectively fulfilling its mission. These usage metrics serve as evidence of performance and accountability in relation to defined mission and scope. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.608015D600 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.05CDC6D747
  a skos:Concept ;
  skos:prefLabel "Standard APIs"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs ;
  skos:definition Standard APIs are application programming interfaces, service endpoints, and protocol interfaces that enable machine access to a repository. They encompass standard discovery, metadata management, and data access capabilities, including protocol, schema, and semantic specifications, and represent a typical value-added service responsibility within a repository context. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1095E8CF4A ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistQualityAssurance ;
  skos:inScheme trsp:trsp-attributes .

