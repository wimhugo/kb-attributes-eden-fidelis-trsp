  skos:inScheme trsp:trsp-attributes .

trsp:att.6D8778C1BE
  a skos:Concept ;
  skos:prefLabel "Re-establishment of service elsewhere"@en ;
  schema:category Technology|Open Source|Re-establishment of service elsewhere ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6A837D5A94
  a skos:Concept ;
  skos:prefLabel "Reliable"@en ;
  schema:category Technology|Reliable ;
  skos:definition A characteristic of technology pertaining to the implementation of relevant and appropriate standards, tools, and technologies for data management and curation. It emphasizes the selection and application of dependable technical approaches that ensure effective stewardship of data resources. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2FCC26EFC0
  a skos:Concept ;
  skos:prefLabel "Description of Reliability Measures"@en ;
