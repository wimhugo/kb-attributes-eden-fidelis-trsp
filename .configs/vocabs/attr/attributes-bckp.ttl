  skos:broader trsp:att.1BF97AE324 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2E92627E37
  a skos:Concept ;
  skos:prefLabel "Advisory or Consulting Services Offered"@en ;
  schema:category Transparency|Scope of Services|Value-Added|Consulting Services|Advisory or Consulting Services Offered ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
