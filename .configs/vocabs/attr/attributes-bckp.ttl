trsp:att.394BC515E7
  a skos:Concept ;
  skos:prefLabel "EOSC Node Service"@en ;
  schema:category Sustainability|Infrastructure Links|EOSC Node Service ;
  skos:definition A classification attribute indicating whether a service or infrastructure is part of a current or aspiring EOSC (European Open Science Cloud) Node. It captures the relationship between a given service and its membership or candidacy within the EOSC Node ecosystem, supporting sustainability and infrastructure linkage assessments. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.66C6612EA5 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.241E6C58DF
  a skos:Concept ;
  skos:prefLabel "Network Membership"@en ;
  schema:category Sustainability|Infrastructure Links|Network Membership ;
  skos:definition A repository's membership in external initiatives, networks, or infrastructures that support its sustainability. This concept encompasses the formal affiliations and collaborative frameworks to which a repository belongs, reflecting its integration within broader organizational or technical ecosystems. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.21F3C82F8B ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

