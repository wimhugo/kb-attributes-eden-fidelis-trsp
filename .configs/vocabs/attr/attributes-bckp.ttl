  a skos:Concept ;
  skos:prefLabel "Submission API is available"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|Submission API is available ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1F4AE0B0F8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistMetrics ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4A2CF0AF0A
  a skos:Concept ;
  skos:prefLabel "Considerations"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Considerations ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.74FDFB3E00 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.1C5F7AAA09
  a skos:Concept ;
  skos:prefLabel "Makes use of standard API specifications"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Considerations|Makes use of standard API specifications ;
  skos:definition A consideration addressing whether a repository makes use of standard API specifications, standards, and protocols in its implementation. This involves identifying which specific API standards and protocols are adopted to ensure interoperability and value-added services. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.375960B05E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.515B8F83FB
  a skos:Concept ;
  skos:prefLabel "Offers API Documentation"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Considerations|Offers API Documentation ;
  skos:definition A repository consideration addressing whether the service exposes its interfaces through documented, standardized API protocols. It encompasses the standards and processes by which people, systems, and digital objects interact within and across organizations, and requires that a service description has been published to support effective interoperability. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.28A2220E45
  a skos:Concept ;
  skos:prefLabel "Machine-Readable Licences"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Licences ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3219437E8F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.2F39DE4E78
  a skos:Concept ;
  skos:prefLabel "Access Conditions"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Licences|Access Conditions ;
  skos:definition Access conditions define the terms and mechanisms through which authorised users may obtain access to data or information objects, expressed clearly in metadata to support both human understanding and automated decision-making. This encompasses the access request and approval process, appropriate access methods (such as direct download or secure remote environments), and criteria based on object characteristics and user rights management policies. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.64FDE59BAD ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeFormat ;
  trsp:hasBenchmark "Start Date|End Date" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6628E95EAC
  a skos:Concept ;
  skos:prefLabel "Machine-readable Licence Provisions (REL)"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Licences|Machine-readable Licence Provisions (REL) ;
  skos:definition Machine-readable licence provisions (REL) refer to the use of standard vocabularies and metadata formats to explicitly express access, reuse, and publication rights in a semantically tagged, machine-readable form. Repositories adopt REL vocabularies to ensure that access conditions and restrictions are transparent and automatically parseable by tools, enabling consistent interpretation of licence and policy clauses. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.3E5176E2B8
  a skos:Concept ;
  skos:prefLabel "Standardised Licence URIs"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Licences|Standardised Licence URIs ;
  skos:definition Repositories use standardised, commonly accepted URIs or identifiers to identify licences in use. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.156B52FB19 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.03110A5773
  a skos:Concept ;
  skos:prefLabel "Machine-Readable Policies"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Policies ;
  skos:definition A requirement that repositories make their applicable policies available in a machine-readable format. This enables automated systems to interpret and process policy information directly, supporting interoperability and programmatic access to repository governance rules through standard APIs. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.66003293B3 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.58166D724B
  a skos:Concept ;
  skos:prefLabel "Machine-readable Policies"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Policies|Machine-readable Policies ;
  skos:definition A characteristic indicating whether a repository's data policy is encoded in a structured, machine-readable format such as JSON-LD, XML, or RDF. This enables automated tools and external systems to ingest, assess, or integrate policy information programmatically. The repository exposes policies in a standardised, interoperable way. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.02BDA33B58
  a skos:Concept ;
  skos:prefLabel "Machine-readable Terms and Conditions"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Policies|Machine-readable Terms and Conditions ;
  skos:definition A service characteristic in which usage rights and terms of use are formally published and provided to users in a structured, machine-readable format. This enables automated processing of policies, standard APIs, and value-added service conditions, ensuring transparency and clear delineation of responsibilities between provider and consumer. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.650BA75F4F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.435A79A35F
  a skos:Concept ;
  skos:prefLabel "Policy Vocabulary URI"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Policies|Policy Vocabulary URI ;
  skos:definition A controlled vocabulary URI used to indicate the policy type of a repository's policy documents. It specifies which format or encoding is applied to the data policy, enabling machine-readable interpretation of policy types through standard, standardized policy vocabulary references. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6A8A5E1219 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4CB9ED25FE
  a skos:Concept ;
  skos:prefLabel "Sustainability"@en ;
  schema:category Sustainability ;
  skos:definition Sustainability refers to a trustworthy repository's capacity to ensure uninterrupted, long-term access to its data holdings for current and future user communities. It encompasses the repository's ability to maintain and evolve its services over time, typically documented through a formal sustainability plan or dedicated webpage outlining strategies to meet changing user requirements. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.5CF6AB3B6E
  a skos:Concept ;
  skos:prefLabel "Adequacy of Structural Income"@en ;
  schema:category Sustainability|Financial Sustainability|Adequacy of Structural Income ;
  skos:definition Adequacy of structural income refers to the principle that recurring operational activities should be funded through stable, sustainable revenue sources rather than time-limited grants. Relying on grant funding for day-to-day operations creates financial fragility and may divert focus from building core infrastructure. Time-limited funds are reserved for time-limited activities. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.52A2A122AF
  a skos:Concept ;
  skos:prefLabel "Base operations structurally funded"@en ;
  schema:category Sustainability|Financial Sustainability|Adequacy of Structural Income|Base operations structurally funded ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.6EDF9A999F
  a skos:Concept ;
  skos:prefLabel "Defined and predictable funding regime"@en ;
  schema:category Sustainability|Financial Sustainability|Adequacy of Structural Income|Defined and predictable funding regime ;
  skos:definition A defined and predictable funding regime refers to the organisational hierarchies and processes through which an entity's human and financial resources are obtained and managed. It encompasses knowledge of, and effective deployment of, human, financial, and energy assets to ensure structural income adequacy and long-term financial sustainability. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.4C2B1EA7BC
  a skos:Concept ;
  skos:prefLabel "Funding Details"@en ;
  schema:category Sustainability|Financial Sustainability|Adequacy of Structural Income|Funding Details ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .

