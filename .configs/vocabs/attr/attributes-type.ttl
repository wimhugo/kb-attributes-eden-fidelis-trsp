trsp:att.0CEF99A2D6
  a skos:Concept ;
  skos:prefLabel "Frequency of Indexing"@en ;
  schema:category Transparency|Scope of Services|Discovery|Service APIs|Frequency of Indexing ;
  skos:definition Frequency of Indexing refers to how often a service's index is updated within the scope of its discovery and service API operations. It reflects the rate at which new or changed information is incorporated into the index, directly affecting the currency and accuracy of discoverable content. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.608015D600 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.283D0EB595
  a skos:Concept ;
  skos:prefLabel "Indexing Specification or Standard"@en ;
  schema:category Transparency|Scope of Services|Discovery|Service APIs|Indexing Specification or Standard ;
  skos:definition A specification or standard that defines the structure and format of indexed data made available through discovery service APIs. It publishes the levels of data exposed to harvesters, ensuring transparency in the scope of services provided. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5ABD0E52C7 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.374F095E69
  a skos:Concept ;
  skos:prefLabel "Level of Indexing Granularity"@en ;
  schema:category Transparency|Scope of Services|Discovery|Service APIs|Level of Indexing Granularity ;
  skos:definition Level of Indexing Granularity refers to the distinct metadata levelsâsuch as dataset, file, or service levelâsupported by a discovery service API for indexing and querying. It defines which granularity tiers are available per source and specifies the queryable fields associated with each level, enabling users to understand the scope and precision of discoverable metadata. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2847F75853 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


