trsp:att.6D262193A1
  a skos:Concept ;
  skos:prefLabel "Secure"@en ;
  schema:category Technology|Secure ;
  skos:definition The extent to which a service supports crosswalks and conversions between metadata packages, with plans and mechanisms in place to prevent, detect, and respond to cyber or physical security threats. This value-added capability falls within the scope of services transparency. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1AE2618C36
  a skos:Concept ;
  skos:prefLabel "e-Infrastructure security and Integrity"@en ;
  schema:category Technology|Secure|e-Infrastructure security and Integrity ;
  skos:definition e-Infrastructure security and integrity encompasses the management and protection of systems, their content, and associated data to ensure secure and reliable operation. It includes the comprehensive provision of hardware, software, and IT service management, alongside monitoring technical needs to maintain service levels. New approaches to security, data, and research infrastructure may be introduced through dedicated projects and activities. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.58166D724B ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.178C46C3F1
  a skos:Concept ;
  skos:prefLabel "Active Threat Monitoring in Place"@en ;
  schema:category Technology|Secure|e-Infrastructure security and Integrity|Active Threat Monitoring in Place ;
  skos:definition A security practice in which the TDA continuously monitors technology evolution to identify emerging risks and defines appropriate detection methods for those risks. It ensures active oversight of threats to e-infrastructure security and integrity. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5DC262FE75 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.181F35E46A
  a skos:Concept ;
  skos:prefLabel "Published Security and Integrity Measures"@en ;
  schema:category Technology|Secure|e-Infrastructure security and Integrity|Published Security and Integrity Measures ;
  skos:definition A repository's published security and integrity measures encompass documented processes for ensuring data, metadata, and infrastructure security across digital object management and organizational systems. These measures address risks at the boundary between the repository and external entities, including users, depositors, and third-party dependencies, and are made available as a summary upon request. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.532324DE1D ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Service IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.337C35222E
  a skos:Concept ;
  skos:prefLabel "Standardised AAI"@en ;
  schema:category Technology|Secure|e-Infrastructure security and Integrity|Standardised AAI ;
  skos:definition Standardised AAI refers to the implementation of widely accepted authentication and authorisation protocolsâsuch as SAML, OpenID Connect, or OAuth2âwithin a repository or service. Adopting these standards ensures compatibility with federated identity providers, secure machine-to-machine communication, and interoperability with ecosystems like EOSC, facilitating cross-service user access and integration with external infrastructures. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0B3D7477E7 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.5EFDB0D148
  a skos:Concept ;
  skos:prefLabel "Object Storage"@en ;
  schema:category Technology|Secure|Object Storage ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.075738C8DF
  a skos:Concept ;
  skos:prefLabel "Documented Measures for Backup, Replication, and Restoration"@en ;
  schema:category Technology|Secure|Object Storage|Documented Measures for Backup, Replication, and Restoration ;
  skos:definition Documented measures for maintaining the physical integrity and availability of digital objects through verified replication across multiple storage locations, backup provisions, and restoration procedures. The system automatically manages replication of information packagesâpotentially across geographically distributed sitesâreplaces damaged files from replicated copies, and validates restored data to ensure accuracy and completeness. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.365F68CB18 ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark <https://api.pidmr.argo.grnet.gr/v1/providers> ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6F82B396BD
  a skos:Concept ;
  skos:prefLabel "Sovereignty Considerations"@en ;
  schema:category Technology|Secure|Sovereignty Considerations ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1DB0A6F7DB
  a skos:Concept ;
  skos:prefLabel "Locality of Data Storage and Archiving"@en ;
  schema:category Technology|Secure|Sovereignty Considerations|Locality of Data Storage and Archiving ;
  skos:definition A sovereignty consideration relating to the geographic jurisdiction in which data and metadata are physically stored and archived. It identifies the country of storage location, which has implications for legal compliance, data governance, and national sovereignty over sensitive information. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.375960B05E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "ESFRI IRIs" ;
  skos:inScheme trsp:trsp-attributes .


