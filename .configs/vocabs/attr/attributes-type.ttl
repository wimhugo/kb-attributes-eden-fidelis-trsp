  owl:versionInfo "0.4" ;
  skos:broader trsp:att.50DA0AA84E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5f45ff82f5
  a skos:Concept ;
  skos:prefLabel "Artefacts/ Legal: documented information"@en ;
  skos:description "The protocols, processes, and organisational interactions through which people, technologies, and digital objects engage with external parties, including individuals, partner organisations, and funders. It encompasses the documented frameworks governing how responsibilities and stewardship of artefacts and legal information are managed across organisational boundaries."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att12c140c8cd
  a skos:Concept ;
  skos:prefLabel "Contracts, agreements, roles, responsibilities"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.69BC0467D4 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att58022a9dbd
  a skos:Concept ;
  skos:prefLabel "Contracting Granularity"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Contracting Granularity" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7ad9b8bbcb
  a skos:Concept ;
  skos:prefLabel "Deposit Agreement"@en ;
  skos:description "A service feature that supports the crosswalking and conversion of packaged data formats, enabling role assignment during data submission and curation processes. It provides transparency into the scope of value-added services by clarifying which package crosswalks are supported within a given system or workflow."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Deposit Agreement" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1c94638914
  a skos:Concept ;
  skos:prefLabel "Ecosystem Model Available"@en ;
  skos:description "An ecosystem model capturing documented contracts, agreements, roles, and responsibilities governing the stewardship of digital artefacts. Ensuring long-term usability and understandability depends on deposit, curation, and preservation activities, alongside ongoing engagement with user communities. Repositories may mediate reuse through secure remote access systems or safe rooms, maintaining appropriate control over digital objects."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Ecosystem Model Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.375960B05E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7d628d907a
  a skos:Concept ;
  skos:prefLabel "Managed Publication Process"@en ;
  skos:description "An organizational process by which legal, contractual, and responsibility documentation—including publications, policies, and guidelines—is created, managed, approved, released, updated, and withdrawn in a controlled manner. The process encompasses versioning and monitoring of these artefacts, supports external assessments and stakeholder engagement, and provides transparent evidence of organizational roles and responsibilities."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Managed Publication Process" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att20efd54efd
  a skos:Concept ;
  skos:prefLabel "Privacy Statement"@en ;
  skos:description "A privacy statement is a documented information artefact in which a repository formally discloses its data privacy practices and policies. It falls within the scope of contracts, agreements, roles, and responsibilities, representing a stewardship obligation. Evidence of its publication may be assessed to verify the repository's accountability regarding personal data handling."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Privacy Statement" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6237ED1101 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1d00720769
  a skos:Concept ;
  skos:prefLabel "Records Retention Policy/ Procedure"@en ;
  skos:description "A records retention policy and associated procedure by which the organisation formally manages the lifecycle of documented information artefacts—such as publications, policies, and guidelines—covering their creation, approval, release, update, and withdrawal. The policy provides evidence of systematic stewardship and supports both external assessments and stakeholder engagement."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Records Retention Policy/ Procedure" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.375960B05E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2218e83fc4
  a skos:Concept ;
  skos:prefLabel "Roles and Responsibilities Defined"@en ;
  skos:description "A characteristic of systems that capture and expose metadata about individual and organizational roles involved in the deposit, curation, maintenance, and management of digital objects. Defined roles may include data steward, curator, depositor, reviewer, or administrator, and may incorporate group or role memberships provided by identity providers."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Roles and Responsibilities Defined" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0ED3D624B3 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att54339656e9
  a skos:Concept ;
  skos:prefLabel "Summary of Depositor Contract(s) Available"@en ;
  skos:description "A repository capability whereby depositor contracts, agreements, and consents are documented, managed, and linked to individual digital objects as necessary. This ensures that preservation agreements and related responsibilities are systematically recorded and accessible, supporting accountability and stewardship of deposited artefacts."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Summary of Depositor Contract(s) Available" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att687d20f962
  a skos:Concept ;
  skos:prefLabel "Terms and Conditions of Use"@en ;
  skos:description "Terms and conditions governing access to and reuse of data holdings within a repository, including licences, access criteria, and permissible conditions of use. These policies define who may view, download, or reuse datasets—either uniformly or per dataset—and determine appropriate access methods such as direct download or secure remote environments, in alignment with rights management policies."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Terms and Conditions of Use" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6d6a09147b
  a skos:Concept ;
  skos:prefLabel "Terms of Deposit/ Accession Policy"@en ;
  skos:description "A repository's policy or guidance governing the scope of permissible data deposits, including any restrictions based on location, country, or organizational affiliation. This encompasses whether deposit access is open to all or limited to specific groups, and clarifies which content types are eligible for submission."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Contracts, agreements, roles, responsibilities|Terms of Deposit/ Accession Policy" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att419ee6d029
  a skos:Concept ;
  skos:prefLabel "Licences"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Licences" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.50DA0AA84E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7dfd48623c
  a skos:Concept ;
  skos:prefLabel "Published Custom Licences Available"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Licences|Published Custom Licences Available" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5ce6a2bbce
  a skos:Concept ;
  skos:prefLabel "Risk Management"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Risk Management" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0ff7e5b673
  a skos:Concept ;
  skos:prefLabel "Bibliographic Metadata Policy"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Risk Management|Bibliographic Metadata Policy" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4AA1880060 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att08c2a995c0
  a skos:Concept ;
  skos:prefLabel "Disclosure Risk Assessment Policy"@en ;
  skos:description "A policy governing the assessment and management of disclosure risks associated with documented information assets, including datasets that cannot be openly shared. It encompasses monitoring of technology evolution, identification of applicable risks, and definition of detection methods."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Risk Management|Disclosure Risk Assessment Policy" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1a4e593402
  a skos:Concept ;
  skos:prefLabel "Service Level Agreement"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4A2CF0AF0A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3b023f9cf0
  a skos:Concept ;
  skos:prefLabel "Machine-Readable SLA"@en ;
  skos:description "A Service Level Agreement (SLA) attribute indicating whether a system publishes its SLAs in a machine-readable format, optionally linked to a corresponding human-readable version. This supports automated processing and interoperability while maintaining accessibility for human stakeholders."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement|Machine-Readable SLA" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.540F680A1E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att34c7f266cd
  a skos:Concept ;
  skos:prefLabel "Service Level Agreement Available"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement|Service Level Agreement Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.035ACCB10D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5568b6ec80
  a skos:Concept ;
  skos:prefLabel "SLA based on community expectations"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement|SLA based on community expectations" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4b703e5e93
  a skos:Concept ;
  skos:prefLabel "SLA Vocabulary Used"@en ;
  skos:description "An attribute identifying the vocabulary used by a system to define machine-readable Service Level Agreements (SLAs). It specifies the formal vocabulary or ontology adopted to structure and express SLA terms in a machine-interpretable format, ensuring interoperability and consistency in documented service commitments."@en ;
  schema:category "Responsibility|Stewardship|Artefacts/ Legal: documented information|Service Level Agreement|SLA Vocabulary Used" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3532a00a80
  a skos:Concept ;
  skos:prefLabel "Confidentiality and Ethics"@en ;
  skos:description "A set of protocols and processes governing how people, processes, technologies, and digital objects effectively interact with one another, both within and across organisational entities. This encompasses responsibilities related to stewardship, confidentiality, and ethical conduct in managing these interactions."@en ;
  schema:category "Responsibility|Stewardship|Confidentiality and Ethics" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.035ACCB10D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4de2dd546e
  a skos:Concept ;
  skos:prefLabel "Confidentiality"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Confidentiality and Ethics|Confidentiality" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att22d6f28f7c
  a skos:Concept ;
  skos:prefLabel "Sensitive Data Protection Measures in Place"@en ;
  skos:description "The practice of safeguarding sensitive information and resources through the application of licence conditions and ongoing compliance monitoring. It encompasses stewardship responsibilities and ethical obligations to ensure confidential data is handled appropriately and protected from unauthorized use or disclosure."@en ;
  schema:category "Responsibility|Stewardship|Confidentiality and Ethics|Confidentiality|Sensitive Data Protection Measures in Place" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.70DECA9F26 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att16855d3cb9
  a skos:Concept ;
  skos:prefLabel "Ethics"@en ;
  skos:description "A repository responsibility ensuring that data and metadata are created, curated, preserved, accessed, and used in compliance with legal and ethical norms, including privacy, confidentiality, and Indigenous Peoples' rights and wellbeing. It encompasses institutional awareness and processes for managing ethical and legal issues throughout the digital object lifecycle."@en ;
  schema:category "Responsibility|Stewardship|Confidentiality and Ethics|Ethics" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.24650A32BA ;
  skos:inScheme trsp:ConceptScheme .

trsp:att51e4556dfe
  a skos:Concept ;
  skos:prefLabel "Consent Obtained"@en ;
  skos:description "Consent Obtained denotes the fulfilment of legal and ethical obligations requiring organisations to engage inclusive, representative processes with relevant Indigenous communities. Such processes must address imbalances in power and resources and their effects on the expression of Indigenous and human rights."@en ;
  schema:category "Responsibility|Stewardship|Confidentiality and Ethics|Ethics|Consent Obtained" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att56f24c24c3
  a skos:Concept ;
  skos:prefLabel "Ethics Checklist"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows|Ethics Checklist" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2b19863f6a
  a skos:Concept ;
  skos:prefLabel "Ethics Guidance"@en ;
  skos:description "The legal and ethical obligations an organisation must be aware of and adhere to, encompassing the provision of ethics-related guidance to depositors and end users. This includes stewardship responsibilities related to confidentiality, ensuring that both the organisation and its stakeholders operate within established ethical and legal frameworks."@en ;
  schema:category "Responsibility|Stewardship|Confidentiality and Ethics|Ethics|Ethics Guidance" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1617820477
  a skos:Concept ;
  skos:prefLabel "Future Use Clarified with Subjects"@en ;
  skos:description "A principle requiring that data governance account for potential future uses and harms through ethical frameworks grounded in Indigenous community values. Metadata should document provenance, original purpose, and any limitations or obligations on secondary use, including consent requirements, ensuring subjects are informed of and have clarity on how their data may be used in the future."@en ;
  schema:category "Responsibility|Stewardship|Confidentiality and Ethics|Ethics|Future Use Clarified with Subjects" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5A6C15E767 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att61c5ab7572
  a skos:Concept ;
  skos:prefLabel "Institutional Ethics Clearance"@en ;
  skos:description "Institutional Ethics Clearance refers to the formal process by which a repository obtains and documents ethical approval in accordance with its policy. Repositories demonstrate compliance by linking to relevant ethics clearance documentation and policy evidence. This attribute confirms that such documentation is accessible and verifiable through the repository."@en ;
  schema:category "Responsibility|Stewardship|Confidentiality and Ethics|Ethics|Institutional Ethics Clearance" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att72f38a16d8
  a skos:Concept ;
  skos:prefLabel "Integrity and Authenticity"@en ;
  skos:description "A stewardship practice involving the ongoing monitoring of technological developments and user community needs to identify changes that may affect the usability or comprehension of digital objects. When risks are identified, preservation actions such as format migration, metadata updating, or environment emulation are undertaken. These measures ensure the long-term viability and continued accessibility of digital objects."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att608015d600
  a skos:Concept ;
  skos:prefLabel "Authenticity - determine and protect"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4808a1524b
  a skos:Concept ;
  skos:prefLabel "Checked for AI-generated Content"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for AI-generated Content" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.06D09133AE ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5af211b2c5
  a skos:Concept ;
  skos:prefLabel "Checked for Duplicate Publication"@en ;
  skos:description "A quality control process in which submitted or existing publications are examined to verify whether they have been previously published elsewhere. This check ensures integrity and authenticity by identifying and protecting against duplicate publication."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for Duplicate Publication" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att44841f89c3
  a skos:Concept ;
  skos:prefLabel "Checked for Illegal Content"@en ;
  skos:description "A process in which the legality of content is verified to ensure compliance with applicable laws and regulations. This check forms part of broader efforts to maintain integrity and authenticity by identifying and protecting against illegal material within a collection or system."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for Illegal Content" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6E790E641F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5e73bd05df
  a skos:Concept ;
  skos:prefLabel "Checked for Irrelevant Content"@en ;
  skos:description "A process in which content is examined to identify and address nonsense or irrelevant material. This check supports authenticity and integrity by ensuring that only meaningful, relevant content is retained or presented."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for Irrelevant Content" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1c495e8a94
  a skos:Concept ;
  skos:prefLabel "Checked for Malicious Content"@en ;
  skos:description "A practice in which digital or physical content is examined to identify and remove harmful or malicious elements. This process supports authenticity and integrity by ensuring that materials are free from threats before use or distribution."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Checked for Malicious Content" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.678439CD93 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att72de0527e3
  a skos:Concept ;
  skos:prefLabel "Documented Pre-submission Provenance"@en ;
  skos:description "A repository practice encompassing the documentation and inspection of provenance information to confirm the authenticity of digital objects submitted for publication or preservation. Provenance and authenticity records may be captured at deposit, generated during curation, and shared with users. Preservation actions—such as format migration or metadata updates—are taken as needed to ensure long-term accessibility."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Authenticity - determine and protect|Documented Pre-submission Provenance" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att76b25efa00
  a skos:Concept ;
  skos:prefLabel "Identify Depositors"@en ;
  skos:description "A transparency attribute identifying the scope of value-added crosswalk and conversion services supported within a package, specifically focusing on identification checks performed for depositors. It documents which crosswalk mappings are available and supported as part of the service offering."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Identify Depositors" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att301a364d55
  a skos:Concept ;
  skos:prefLabel "Depositors are identified and verified"@en ;
  skos:description "The repository identifies and verifies that submissions are made by researchers or individuals acting in a research context, ensuring the deposit is a dataset associated with original research. Verification relies on metadata attributes supplied by an identity provider."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Identify Depositors|Depositors are identified and verified" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2080c1d4ee
  a skos:Concept ;
  skos:prefLabel "Integrity"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Integrity" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4E4FD79526 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4b8dbc2795
  a skos:Concept ;
  skos:prefLabel "Checksum Computation/ Verification"@en ;
  skos:description "A trustworthy digital archive computes and records checksums for every file, validating them against values stored in the Information Package at ingest or access. Checksums are also computed before and after migration and retained to support future preservation management, ensuring the ongoing integrity and authenticity of digital objects."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Integrity|Checksum Computation/ Verification" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att09b9b96513
  a skos:Concept ;
  skos:prefLabel "File Repair"@en ;
  skos:description "A standardized process in which a trusted digital archive (TDA) corrects structural issues identified in files, addressing validation or rendering errors. Invalid files are repaired according to a governing document, ensuring the integrity and authenticity of preserved content."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Integrity|File Repair" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.419EE6D029 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6af0d4dc26
  a skos:Concept ;
  skos:prefLabel "Plagiarism Verification"@en ;
  skos:description "Plagiarism Verification is the practice of performing systematic checks to detect instances of plagiarism within content or work. It supports principles of integrity and authenticity by ensuring that material is original and properly attributed. This process upholds responsible stewardship of intellectual and scholarly standards."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Integrity|Plagiarism Verification" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6cce23a07e
  a skos:Concept ;
  skos:prefLabel "Statistical Integrity"@en ;
  skos:description "A value-added service capability indicating the scope of crosswalk and conversion packages supported within a system or service offering. It encompasses statistical integrity verification to ensure accuracy and consistency when mapping or translating data between different schemas, formats, or standards. This transparency attribute helps users assess interoperability and data quality assurance."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Integrity|Statistical Integrity" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2923d6de38
  a skos:Concept ;
  skos:prefLabel "Virus and Malware Checking"@en ;
  skos:description "A process in which information packages and digital objects are checked for viruses and malware, typically performed at ingest. Infected items are managed through appropriate quarantine facilities to protect the integrity and authenticity of the repository's holdings."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Integrity|Virus and Malware Checking" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att27f5c3bd10
  a skos:Concept ;
  skos:prefLabel "Version Maintenance"@en ;
  skos:description "A property indicating whether a persistent identifier (PID) system tracks different versions of a digital object over time. Version maintenance supports integrity and authenticity by ensuring that distinct states or revisions of an object are identifiable and distinguishable within the PID system."@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Version Maintenance" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5ABD0E52C7 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att242ee15759
  a skos:Concept ;
  skos:prefLabel "Submission and Archival Package Maintenance"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Integrity and Authenticity|Version Maintenance|Submission and Archival Package Maintenance" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7592D43F0B ;
  skos:inScheme trsp:ConceptScheme .

trsp:att570534f4b8
  a skos:Concept ;
  skos:prefLabel "Long-term Preservation"@en ;
  skos:description "Processes and activities for managing, changing, and maintaining digital objects along with their associated data and metadata in accordance with legal, ethical, policy, and other standards and operating procedures. This encompasses long-term stewardship responsibilities to ensure digital content remains accessible, authentic, and compliant with relevant frameworks over time."@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att76e3f555fc
  a skos:Concept ;
  skos:prefLabel "Bit-Level Preservation"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Bit-Level Preservation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1c44587e88
  a skos:Concept ;
  skos:prefLabel "Persistence Median"@en ;
  skos:description "The persistence median is a measure used to assess the long-term preservation performance of Persistent Identifier (PID) services, reflecting the typical duration for which identifiers remain reliably resolvable. PID services should target a persistence median that meets the expectations of dependent communities and stakeholders, ensuring stewardship responsibilities are fulfilled over time."@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Persistence Median" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.678439CD93 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att497c7ace99
  a skos:Concept ;
  skos:prefLabel "Re-appraisal"@en ;
  skos:description "Repositories bear a stewardship responsibility to periodically re-appraise the digital objects they hold, either on a scheduled basis or in response to defined triggers. This ongoing evaluation ensures that preserved objects continue to meet the repository's collection criteria and long-term preservation objectives."@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Re-appraisal" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.48B32FB000 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4ea4fe6911
  a skos:Concept ;
  skos:prefLabel "Re-appraisal Plan"@en ;
  skos:description "A repository stewardship function encompassing the acceptance of custody of digital objects from depositors and the ongoing evaluation and re-evaluation of their data quality. It includes planning for re-appraisal activities—covering frequency, triggers, scope, tools, and procedures—to ensure Information Objects continue to meet established criteria for long-term preservation."@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Re-appraisal Plan" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3fd2c99b44
  a skos:Concept ;
  skos:prefLabel "(Re-)Appraisal of Licence Applicability"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Process|Licence-Related Processes|(Re-)Appraisal of Licence Applicability" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.50DA0AA84E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att720d076722
  a skos:Concept ;
  skos:prefLabel "File format preservation actions"@en ;
  skos:description "A service capability encompassing periodic integrity checking of files, reporting damaged or missing content, and ongoing evaluation of data quality for information objects. Files in obsolete formats are migrated to sustainable formats, ensuring long-term accessibility and reliability of preserved content."@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Re-appraisal|File format preservation actions" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att36e9cffb4b
  a skos:Concept ;
  skos:prefLabel "Record of Re-Appraisal"@en ;
  skos:description "A record documenting the re-appraisal of repository holdings, capturing the most recent date on which a Trusted Digital Archive evaluated or re-evaluated the data quality of its Information Objects. Re-appraisal is an ongoing stewardship responsibility supporting long-term preservation."@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Re-appraisal|Record of Re-Appraisal" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2744CED24F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att00577fc6fc
  a skos:Concept ;
  skos:prefLabel "Resolution Authenticity or Efficiency"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Resolution Authenticity or Efficiency" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4840647866 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6d7d249110
  a skos:Concept ;
  skos:prefLabel "Active Bit-Level Preservation in Place"@en ;
  skos:description "Active bit-level preservation in place encompasses periodic integrity checking of stored Information Packages, replacement of damaged files from replicated copies, and migration of packages to new storage media at end-of-life, with reporting on all actions taken. Activities may also extend to projects involving new approaches to data, metadata, technology, and research infrastructure beyond routine maintenance."@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Resolution Authenticity or Efficiency|Active Bit-Level Preservation in Place" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5842ec5239
  a skos:Concept ;
  skos:prefLabel "Resolution Percentage"@en ;
  skos:description "A stewardship responsibility requiring that a PID service resolve at least a defined percentage (p) of persistent identifiers drawn from a randomised sample, where the threshold value of p is determined by community and dependency expectations. This metric supports long-term preservation goals by ensuring authentic and efficient resolution of PIDs over time."@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Resolution Authenticity or Efficiency|Resolution Percentage" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att54cf71ed24
  a skos:Concept ;
  skos:prefLabel "Resolution Integrity"@en ;
  skos:description "A PID Manager must ensure that entities remain persistently linked to their Persistent Identifiers (PIDs), maintaining the integrity of this relationship in conformance with the relevant PID Scheme defined by a PID Authority. If an identified entity is deleted or ceases to exist, tombstone information must be included in the PID attribute set to preserve resolution integrity."@en ;
  schema:category "Responsibility|Stewardship|Long-term Preservation|Resolution Integrity" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att297ed3685c
  a skos:Concept ;
  skos:prefLabel "Process"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Process" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4aa1880060
  a skos:Concept ;
  skos:prefLabel "Curation & Preservation Workflows"@en ;
  skos:description "Curation and preservation workflows encompass the defined processes—from deposit through access—by which digital objects are made and kept usable and understandable. Facilitating reuse depends on understanding user needs, including those of designated communities, through ongoing external engagement. Repositories may mediate access via secure remote systems or safe rooms that keep digital objects under the service provider's control."@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E9295C9A1 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att18e904aae2
  a skos:Concept ;
  skos:prefLabel "Disposal and Retraction Workflows"@en ;
  skos:description "A workflow within the Trusted Digital Archive (TDA) that governs the managed disposal or retraction of Information Packages under defined policies and conditions. Even after content removal, the TDA retains and maintains tombstone metadata, ensuring a persistent record of the disposed resource."@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows|Disposal and Retraction Workflows" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0D3C935A8A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0fe5d01c72
  a skos:Concept ;
  skos:prefLabel "FAIR Assessment"@en ;
  skos:description "The process of defining an organisation's mission and the boundaries of activities for which it holds ultimate responsibility, including those involving partners or outsourced services. It provides reference information and context for all related repository activities and functions, ensuring accountability is retained regardless of how services are delivered."@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows|FAIR Assessment" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.00577FC6FC ;
  skos:inScheme trsp:ConceptScheme .

trsp:att50adce9e0d
  a skos:Concept ;
  skos:prefLabel "FAIR Assessment Tool(s)"@en ;
  skos:description "A process responsibility within curation and preservation workflows whereby repositories disclose and document the specific FAIR assessment tool or tools used to evaluate the FAIRness of their resources. Transparency in tool selection supports reproducibility and accountability in stewardship practices."@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows|FAIR Assessment Tool(s)" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att64a44f5193
  a skos:Concept ;
  skos:prefLabel "Legal Compliance Checklist"@en ;
  skos:description "A structured checklist capturing the legal and ethical obligations—including GDPR, national open data laws, and institutional or funding policies—that a repository must identify and adhere to. It supports curation and preservation workflows by providing mechanisms to assess and ensure lawful access, storage, and sharing of digital assets."@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows|Legal Compliance Checklist" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5f37a613bb
  a skos:Concept ;
  skos:prefLabel "Preservation Workflow"@en ;
  skos:description "A preservation workflow encompasses the standard procedures and ongoing activities aimed at safeguarding digital objects over the long term. It involves monitoring changes in the technology landscape and user community that may affect usability, and taking corrective actions—such as format migration, metadata updates, or environment emulation—to ensure continued accessibility and reuse."@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows|Preservation Workflow" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2ec221bd80
  a skos:Concept ;
  skos:prefLabel "Privacy/ Sensitive Data Checklist"@en ;
  skos:description "A repository process in which deposited content is examined to determine whether personal or pseudonymised data is present. If such data is identified, the repository applies a documented procedure to assess the required level of protection and implements appropriate safeguards accordingly."@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows|Privacy/ Sensitive Data Checklist" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.64FDE59BAD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6a5bf0698f
  a skos:Concept ;
  skos:prefLabel "Rights Obtained from Depositor"@en ;
  skos:description "A record or reference linking to documentation that verifies license mandate checks obtained from a depositor, supporting curation and preservation workflows. It captures the rights and permissions acquired during the deposit process, ensuring responsible stewardship of deposited materials."@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows|Rights Obtained from Depositor" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att12ca661df7
  a skos:Concept ;
  skos:prefLabel "Submission Workflow"@en ;
  skos:description "A submission workflow encompasses the processes by which a trusted digital archive accepts custody of digital objects from depositors, performs operations to transform Submission Information Packages (SIPs) into Archival Information Packages (AIPs), and ensures compliance with format requirements, metadata standards, and quality criteria. It includes ingesting and managing metadata appropriate to specific content types, validating submissions against agreed protocols, and supporting harmonised, community-aligned deposit workflows to foster interoperability and consistent metadata quality."@en ;
  schema:category "Responsibility|Stewardship|Process|Curation & Preservation Workflows|Submission Workflow" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0FEE58FD17 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att697c57fe46
  a skos:Concept ;
  skos:prefLabel "Licence-Related Processes"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Process|Licence-Related Processes" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att769a9f52bd
  a skos:Concept ;
  skos:prefLabel "Explanation of Licence Provisions"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Discovery|Proper Citation|Explanation of Licence Provisions" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att49ee16d366
  a skos:Concept ;
  skos:prefLabel "Licence Combination Supported/ Verified"@en ;
  skos:description "A stewardship process concerned with publishing a compatibility matrix or guidance to support the combining of licences. It enables users to verify which licence combinations are permissible, facilitating informed decisions when integrating multiply-licensed resources."@en ;
  schema:category "Responsibility|Stewardship|Process|Licence-Related Processes|Licence Combination Supported/ Verified" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.74FDFB3E00 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0cbe414a78
  a skos:Concept ;
  skos:prefLabel "Verification of Licence Assent"@en ;
  skos:description "A process in which the repository verifies and records whether end users assent to licence conditions prior to accessing or downloading data. It also ensures that actors expected to act on licence provisions are identified according to a specific model or vocabulary."@en ;
  schema:category "Responsibility|Stewardship|Process|Licence-Related Processes|Verification of Licence Assent" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.608015D600 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4d039ca977
  a skos:Concept ;
  skos:prefLabel "Monitoring"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Process|Monitoring" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3e5b47b5c9
  a skos:Concept ;
  skos:prefLabel "Inventory - SOPs and Workflows"@en ;
  skos:description "A structured inventory of standard operating procedures and workflows—supported by evidence links—governing the management, maintenance, and quality control of digital objects and their associated metadata. These processes ensure that digital objects meet defined legal, ethical, policy, and quality standards before being made available for reuse, and ensures reuse in accordance with policies and applicable licences."@en ;
  schema:category "Responsibility|Stewardship|Process|Monitoring|Inventory - SOPs and Workflows" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7362D6D981 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att24c260aa9c
  a skos:Concept ;
  skos:prefLabel "Monitor Process Compliance"@en ;
  skos:description "A stewardship and monitoring process that verifies alignment of submissions with policy or guidance requirements. It encompasses delivery of reporting—including functional, operational, and statistical reports and analytics—to enable the effective management of objects and ensure ongoing process compliance."@en ;
  schema:category "Responsibility|Stewardship|Process|Monitoring|Monitor Process Compliance" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6A837D5A94 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att22831d6953
  a skos:Concept ;
  skos:prefLabel "Provenance"@en ;
  skos:description "A repository mechanism encompassing the processes by which edits, corrections, and additions to a deposited dataset are tracked and managed, including version control and linking of successive versions. The repository guarantees authenticity of digital objects by recording provenance information and audit trails for all data and metadata processing, ensuring full accountability and traceability."@en ;
  schema:category "Responsibility|Stewardship|Provenance" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.70DECA9F26 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3c8326fc1d
  a skos:Concept ;
  skos:prefLabel "Update Functionality"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Provenance|Update Functionality" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.696B580E35 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att11df98311a
  a skos:Concept ;
  skos:prefLabel "Software provides update functionality"@en ;
  skos:description "A functional requirement specifying that the PID manager must provide the capabilities necessary to maintain and update PID attributes. This encompasses stewardship and provenance responsibilities, ensuring that the software delivering update functionality upholds accountability for the ongoing management of persistent identifier records."@en ;
  schema:category "Responsibility|Stewardship|Provenance|Update Functionality|Software provides update functionality" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.697C57FE46 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0fee58fd17
  a skos:Concept ;
  skos:prefLabel "Versioning - Procedure"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Provenance|Versioning - Procedure" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.570534F4B8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0ebac52cb6
  a skos:Concept ;
  skos:prefLabel "Published versioning procedure available"@en ;
  skos:description "A procedure in which persistent identifiers are assigned to objects, information packages, and metadata and managed throughout their life cycle. PID services and PID managers should maintain clear, published versioning policies governing how identifiers and their associated resources are updated over time."@en ;
  schema:category "Responsibility|Stewardship|Provenance|Versioning - Procedure|Published versioning procedure available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2080C1D4EE ;
  skos:inScheme trsp:ConceptScheme .

trsp:att73e0b308e5
  a skos:Concept ;
  skos:prefLabel "Versioning Strategy/ Objective"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Provenance|Versioning - Procedure|Versioning Strategy/ Objective" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att00c02c55dc
  a skos:Concept ;
  skos:prefLabel "Quality Control - Deposit Documentation"@en ;
  skos:description "Deposit documentation and quality control encompasses the acceptance of digital objects from depositors, transferring custodial responsibility to the repository while ensuring submissions meet established metadata, curation, and technical standards. The repository evaluates compliance before making objects available for reuse and provides sufficient information for end users to make quality-related assessments."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0DA8E81794 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att700343d2b3
  a skos:Concept ;
  skos:prefLabel "Accurate Entity Metadata"@en ;
  skos:description "The PID Manager must maintain entity metadata as accurately as possible in collaboration with the PID Owner, with this copy serving as the authoritative version. This requirement supports transparency in scope of services by ensuring reliable, value-added package crosswalks and conversions are underpinned by accurate, authoritative metadata."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4ea572a954
  a skos:Concept ;
  skos:prefLabel "Mandatory Metadata Verified"@en ;
  skos:description "A process by which mandatory metadata is validated against a defined profile to verify completeness and accuracy of deposit documentation. Repositories can assess Archival Information Packages (AIPs) in a standardised way using the OAIS Information Model, enabling identification of missing or incomplete information. The AIP information model is flexible enough to accommodate emerging standards supporting quality control and fitness assessment."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata|Mandatory Metadata Verified" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6420bca43e
  a skos:Concept ;
  skos:prefLabel "Metadata validated against profile"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata|Metadata validated against profile" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7ac495443d
  a skos:Concept ;
  skos:prefLabel "URI-linked semantics in metadata"@en ;
  skos:description "A system capability indicating whether controlled vocabulary and ontology terms are exposed via persistent URIs that resolve to machine-readable representations. This supports automated metadata interpretation, reasoning, and cross-system integration, and indicates whether persistent identifiers (PIDs) are provided for semantic terms."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata|URI-linked semantics in metadata" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att51c655bfb0
  a skos:Concept ;
  skos:prefLabel "Vocabulary and semantic artefacts linked in metadata"@en ;
  skos:description "A quality control requirement ensuring that semantic artefacts (vocabularies, ontologies, and context files) used in deposit metadata are published, discoverable, and accessible through domain-recognized reference repositories. Compliant systems expose these resources via APIs or queryable endpoints, apply persistent identifiers, and make metadata available for harvesting to promote reuse, semantic consistency, and machine-actionability."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Accurate Entity Metadata|Vocabulary and semantic artefacts linked in metadata" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2af9c821f9
  a skos:Concept ;
  skos:prefLabel "Data Validation"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Data Validation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att66c51e0b90
  a skos:Concept ;
  skos:prefLabel "Validation of Data Against Schema or Rules"@en ;
  skos:description "A repository process that validates deposited file contents against a defined set of rules or schema requirements, ensuring conformance to repository standards. For example, constraints such as uniqueness of values in a specified field are enforced systematically. Associated documentation references are linked to each relevant profile."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Data Validation|Validation of Data Against Schema or Rules" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4a98f89201
  a skos:Concept ;
  skos:prefLabel "Deposit Documentation Checklist"@en ;
  skos:description "A structured checklist, supported by evidence, documenting the quality assurance measures applied to deposits (submissions) accepted into the repository. It encompasses the evaluation and re-evaluation of data quality for information objects, as well as the transfer of custodial responsibility from depositors to the repository, including appraisal against established acceptance criteria."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Deposit Documentation Checklist" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4721CBC19A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att00edbed146
  a skos:Concept ;
  skos:prefLabel "Technical validation"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Technical validation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4A04909C47 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att552d4d7cbf
  a skos:Concept ;
  skos:prefLabel "Machine-actionable format templates in use"@en ;
  skos:description "Machine-actionable format templates define and structure the significant properties for each file format supported within a deposit documentation workflow. These templates enable technical validation by providing scoring or weighting criteria for evaluating format-specific properties, supporting systematic quality control and stewardship responsibilities."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Technical validation|Machine-actionable format templates in use" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att25d8680361
  a skos:Concept ;
  skos:prefLabel "Significant Properties Extracted"@en ;
  skos:description "The repository extracts and records significant technical properties—such as file size, image dimensions, video codec, audio runtime, and creating application—from ingested Information Objects. These properties, defined by the repository for supported file formats, represent characteristics it commits to preserve over the long term through preservation actions and rendition."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Technical validation|Significant Properties Extracted" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1AE2618C36 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att650f58f3bc
  a skos:Concept ;
  skos:prefLabel "Tools for Technical Metadata Extraction"@en ;
  skos:description "A set of tools used within deposit documentation workflows to automatically extract technical metadata characteristics from digital objects, including properties such as file size, image dimensions, video codec, audio run time, and creating application. These tools support technical validation and quality control responsibilities in digital stewardship."@en ;
  schema:category "Responsibility|Stewardship|Quality Control - Deposit Documentation|Technical validation|Tools for Technical Metadata Extraction" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att06f21028d1
  a skos:Concept ;
  skos:prefLabel "Rights Management"@en ;
  skos:description "A repository function encompassing the management and communication of all rights—permissions, prohibitions, and obligations—related to data and metadata deposit, storage, preservation, access, and use. It involves adopting policies, standards, and criteria aligned with governance structures, operational workflows, and applicable legal and ethical frameworks to guide stewardship practice."@en ;
  schema:category "Responsibility|Stewardship|Rights Management" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.365F68CB18 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att297ad6f574
  a skos:Concept ;
  skos:prefLabel "Considerations"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Considerations" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2a0e93c1ac
  a skos:Concept ;
  skos:prefLabel "IP Management"@en ;
  skos:description "The process by which a Trusted Digital Archive manages intellectual property, licence conditions, and rights related to Information Objects. This encompasses rights for internal agents—such as access and migration—as well as for end users, including access and reuse permissions."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Considerations|IP Management" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1b812ffc4e
  a skos:Concept ;
  skos:prefLabel "No Harm, Maximise Benefit"@en ;
  skos:description "A stewardship principle encompassing the management of rights over information objects for both internal agents and end users, while ensuring data practices align with relevant ethical frameworks—including Indigenous rights affirmed in UNDRIP—and that benefits and harms are assessed from the perspective of the communities to whom the data relate."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Considerations|No Harm, Maximise Benefit" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5CF6AB3B6E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5d17940b6b
  a skos:Concept ;
  skos:prefLabel "Privacy and GDPR Addressed"@en ;
  skos:description "A trusted digital archive (TDA) manages rights related to information objects for both internal agents (e.g., access, migration) and end users (e.g., access, reuse), while ensuring its privacy statement complies with GDPR requirements. This encompasses stewardship responsibilities spanning rights management, access control, and data protection obligations."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Considerations|Privacy and GDPR Addressed" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att553a464ec8
  a skos:Concept ;
  skos:prefLabel "Depositor Rights"@en ;
  skos:description "Depositor Rights refers to the protection and management of intellectual property rights belonging to data producers. It encompasses the stewardship responsibilities associated with safeguarding these rights while enabling appropriate publication and use of the data. This ensures that creators retain recognized ownership and control over their produced data assets."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Depositor Rights" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att521a4a9e17
  a skos:Concept ;
  skos:prefLabel "Appraisal/ Accession Policy"@en ;
  skos:description "A policy governing the deposit and accession of materials into a repository, defining the rights, responsibilities, and stewardship obligations of depositors. It establishes the terms under which content is accepted, appraised, and managed, clarifying depositor rights and the repository's role in long-term preservation and access."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Depositor Rights|Appraisal/ Accession Policy" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att206c4c60aa
  a skos:Concept ;
  skos:prefLabel "Terms of Deposit"@en ;
  skos:description "A repository's framework governing the scope of its mission, rights management over information objects, and terms of deposit. It defines which datasets are accepted, from whom, and under what conditions, while managing access and reuse rights for internal agents and end users. The organization retains ultimate responsibility for all activities, even when delivered through partners or outsourced services."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Depositor Rights|Terms of Deposit" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6FB10117A8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3d6a6043d4
  a skos:Concept ;
  skos:prefLabel "Documentation"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Documentation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.71A5D27D84 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att550348356c
  a skos:Concept ;
  skos:prefLabel "Human-readable rights documentation"@en ;
  skos:description "The management of permissions, prohibitions, and obligations governing how digital objects are accessed, migrated, and reused by agents within a repository and by end users. Rights metadata is maintained for both human-readable consumption—referenced via URI as licence documents—and machine-readable processing, covering access, reuse, and other applicable conditions."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Documentation|Human-readable rights documentation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7c56b5ed00
  a skos:Concept ;
  skos:prefLabel "Encoding"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Encoding" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7d05a04e46
  a skos:Concept ;
  skos:prefLabel "Basis of Rights Encoding"@en ;
  skos:description "Rights Expression Languages (RELs) are formal models for declaring the conditions under which digital content may be accessed, reused, or redistributed, defining actors, actions, constraints, and duties. Rights Markup Languages (RMLs) implement these models within metadata schemas and web standards using machine-readable formats such as RDF, XML, or JSON-LD. Package crosswalk support enables transparency in mapping and converting between these frameworks across services."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Encoding|Basis of Rights Encoding" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5a6c15e767
  a skos:Concept ;
  skos:prefLabel "Other Actor Rights"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Other Actor Rights" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att48c6f0c32d
  a skos:Concept ;
  skos:prefLabel "Curator Rights"@en ;
  skos:description "Curator rights encompass the permissions, prohibitions, and obligations governing how digital objects and their metadata are accessed, improved, and published within a trusted digital archive. These rights apply to agents inside the repository's scope—covering tasks such as migration and metadata enhancement—as well as to end users, including adjudicating access requests and enabling reuse."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Other Actor Rights|Curator Rights" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3F6736BF1C ;
  skos:inScheme trsp:ConceptScheme .

trsp:att76e631cb8d
  a skos:Concept ;
  skos:prefLabel "End User Rights"@en ;
  skos:description "A capability indicating that the Trusted Digital Archive (TDA) manages rights related to Information Objects for both internal agents—covering operations such as access and migration—and end users, including access and reuse permissions. This encompasses the scope of rights management services provided across supported package crosswalk conversions."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Other Actor Rights|End User Rights" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att49c7b241ea
  a skos:Concept ;
  skos:prefLabel "Owners/ Rightsholder Rights"@en ;
  skos:description "The Trusted Digital Archive (TDA) manages rights related to Information Objects on behalf of both internal agents and end users, covering access, migration, and reuse. It verifies the legal basis for holding and preserving AIPs, obtains rightsholder consent, and ensures rightsholders may consent to publication and select appropriate licences or access conditions."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Other Actor Rights|Owners/ Rightsholder Rights" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.48B32FB000 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att24650a32ba
  a skos:Concept ;
  skos:prefLabel "Subject Rights"@en ;
  skos:description "A concept encompassing the rights and ethical considerations pertaining to research subjects, including policies and evidence addressing those rights. It specifically recognizes that Indigenous Peoples hold collective and individual rights over Indigenous Knowledge and data, including free, prior, and informed consent in data collection, use, and policy development."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Subject Rights" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7592D43F0B ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2d03eb4e9b
  a skos:Concept ;
  skos:prefLabel "Consent Form Example Available"@en ;
  skos:description "An attribute indicating that the repository provides access to example consent forms, confirming the availability of a link to such forms. This supports transparency in rights management and subject rights by demonstrating how informed consent is documented and managed within the repository's stewardship practices."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Subject Rights|Consent Form Example Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1b3a0a1cf6
  a skos:Concept ;
  skos:prefLabel "Consent Forms Verified, Linked"@en ;
  skos:description "A stewardship and rights management state in which consent forms pertaining to a subject have been verified and are linked or otherwise available within the system. This condition confirms that the necessary authorizations and subject rights documentation are accessible, supporting accountability and responsible data governance."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Subject Rights|Consent Forms Verified, Linked" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5CF6AB3B6E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5adb3fc0bb
  a skos:Concept ;
  skos:prefLabel "Grounded - Aligned with Subject Context"@en ;
  skos:description "Resources must be provided to generate data that is grounded in the languages, worldviews, and lived experiences of Indigenous Peoples, including their values and principles. This responsibility ensures that rights management and stewardship practices are aligned with the subject context of Indigenous communities."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Subject Rights|Grounded - Aligned with Subject Context" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5dcb41bb3f
  a skos:Concept ;
  skos:prefLabel "Registry of Access Requests"@en ;
  skos:description "A registry in which the repository records all access requests and their outcomes, supporting accountability and transparency in rights management. Maintaining such a registry demonstrates the repository's commitment to subject rights and responsible stewardship of access decisions."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Subject Rights|Registry of Access Requests" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att264e948225
  a skos:Concept ;
  skos:prefLabel "Subjects Have a Right to the Data"@en ;
  skos:description "Indigenous Peoples hold an inherent right to data relevant to their worldviews, self-determination, and effective self-governance. Indigenous data must be made accessible to Indigenous nations and communities to support Indigenous governance. This principle falls within the domain of responsibility, stewardship, and rights management over data."@en ;
  schema:category "Responsibility|Stewardship|Rights Management|Subject Rights|Subjects Have a Right to the Data" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1AE2618C36 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3319eedc99
  a skos:Concept ;
  skos:prefLabel "Transfer"@en ;
  skos:description "The transfer of stewardship responsibility occurs when a PID owner is no longer able to fulfill their obligations under applicable policy. To support continuity, the PID manager should establish policies and contractual arrangements that govern the transfer of ownership in such circumstances."@en ;
  schema:category "Responsibility|Stewardship|Transfer" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0B3D7477E7 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1257c370df
  a skos:Concept ;
  skos:prefLabel "PID Ownership Transfer is Possible"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Transfer|PID Ownership Transfer is Possible" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4D039CA977 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7436bdea62
  a skos:Concept ;
  skos:prefLabel "Repository Transfer is Possible"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Stewardship|Transfer|Repository Transfer is Possible" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4a43a19133
  a skos:Concept ;
  skos:prefLabel "Typical Value-added Services"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.74FDFB3E00 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att50af53c9b2
  a skos:Concept ;
  skos:prefLabel "Community Support"@en ;
  skos:description "A community support service encompassing brokering, mediation, and content negotiation on behalf of the community, as well as providing provenance and authenticity information about digital objects. Such information details the history of digital objects, may be captured at deposit or during curation, and is shared with data and metadata users to ensure authenticity."@en ;
  schema:category "Responsibility|Typical Value-added Services|Community Support" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5dc262fe75
  a skos:Concept ;
  skos:prefLabel "Guidelines and Support"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services|Community Support|Guidelines and Support" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att62e1c089db
  a skos:Concept ;
  skos:prefLabel "User Guidance and Documentation"@en ;
  skos:description "A repository responsibility encompassing the provision of clear, user-friendly documentation, tutorials, and support services that guide depositors and users through deposit, discovery, access, and reuse of data and metadata. It includes defining organizational purpose and boundaries of responsibility, leveraging internal expertise to deliver training across the digital object lifecycle, and maintaining accessible, consistent interfaces to lower barriers to effective use."@en ;
  schema:category "Responsibility|Typical Value-added Services|Community Support|Guidelines and Support|User Guidance and Documentation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3e85a87190
  a skos:Concept ;
  skos:prefLabel "User-focused Access"@en ;
  skos:description "The process of determining and facilitating appropriate methods of user access to digital objects—such as direct download or use within a secure remote environment—based on the characteristics of both the objects and the users. Access criteria are applied in alignment with rights management policies to ensure compliant and user-appropriate delivery."@en ;
  schema:category "Responsibility|Typical Value-added Services|Community Support|Guidelines and Support|User-focused Access" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.67DE43D8DF ;
  skos:inScheme trsp:ConceptScheme .

trsp:att532324de1d
  a skos:Concept ;
  skos:prefLabel "Inventory of Available Services"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services|Inventory of Available Services" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1146fd1520
  a skos:Concept ;
  skos:prefLabel "Documentation Available"@en ;
  skos:description "A service attribute indicating whether a system provides comprehensive documentation, tutorials, and support resources that enable users to access, understand, and effectively use available services—particularly in cross-disciplinary or multi-platform environments. This includes clear service descriptions, links to deployed instances (test, development, production), and relevant source code, collectively lowering barriers to entry and promoting effective onboarding."@en ;
  schema:category "Responsibility|Typical Value-added Services|Inventory of Available Services|Documentation Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4AA1880060 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4cb4f7ed15
  a skos:Concept ;
  skos:prefLabel "Machine-Readable Inventory"@en ;
  skos:description "A machine-readable inventory that documents the value-added services available within a given responsibility domain, specifically cataloguing the harvesting protocols that are supported. It enables automated systems to discover and interact with available services through standardized, machine-interpretable representations."@en ;
  schema:category "Responsibility|Typical Value-added Services|Inventory of Available Services|Machine-Readable Inventory" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1f4ae0b0f8
  a skos:Concept ;
  skos:prefLabel "Metrics"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services|Metrics" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.04F0DB0243 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0c3fb3218d
  a skos:Concept ;
  skos:prefLabel "Usage Metrics"@en ;
  skos:description "The implementation and provision of relevant data metrics to users, encompassing the analysis of internal data and external information to verify and demonstrate that an organisation is effectively fulfilling its mission. These usage metrics serve as evidence of performance and accountability in relation to defined mission and scope."@en ;
  schema:category "Responsibility|Typical Value-added Services|Metrics|Usage Metrics" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.608015D600 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att05cdc6d747
  a skos:Concept ;
  skos:prefLabel "Standard APIs"@en ;
  skos:description "Standard APIs are application programming interfaces, service endpoints, and protocol interfaces that enable machine access to a repository. They encompass standard discovery, metadata management, and data access capabilities, including protocol, schema, and semantic specifications, and represent a typical value-added service responsibility within a repository context."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1095E8CF4A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2922ed695e
  a skos:Concept ;
  skos:prefLabel "Access to Metadata and Data"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Access to Metadata and Data" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att714ec2aa27
  a skos:Concept ;
  skos:prefLabel "Data API"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Access to Metadata and Data|Data API" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7298144e24
  a skos:Concept ;
  skos:prefLabel "Metadata (Harvesting) API"@en ;
  skos:description "A system capability that exposes metadata in structured, machine-readable formats aligned with FAIR principles, enabling automated parsing and harvesting with minimal human intervention. This includes applying persistent identifiers and descriptive metadata to digital objects, supporting resource discovery through standardized APIs and crosswalk conversions between metadata schemas."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Access to Metadata and Data|Metadata (Harvesting) API" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0d3c935a8a
  a skos:Concept ;
  skos:prefLabel "Automated Curation"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Automated Curation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.76B25EFA00 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6e3855425f
  a skos:Concept ;
  skos:prefLabel "File Type Registry API"@en ;
  skos:description "A capability whereby the system identifies file formats to an appropriate level of precision by referencing established registries such as IANA MIME types or PRONOM. Identified formats are reported in a standardised, machine-actionable manner through links to file type registry URIs, supporting transparency and interoperability in format identification workflows."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|File Type Registry API" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att63101df501
  a skos:Concept ;
  skos:prefLabel "File Type Verification API"@en ;
  skos:description "A standard API for automated file type verification in which the system identifies file formats to the appropriate level of precision using established registries such as IANA MIME types or PRONOM. It validates files against format specifications, detects wrongly identified files, and performs pre-ingest operations on data objects to ensure compliance with format requirements."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|File Type Verification API" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att29a8e8970a
  a skos:Concept ;
  skos:prefLabel "File Verification Error Data"@en ;
  skos:description "A responsibility within automated curation whereby the trusted digital archive (TDA) performs periodic file integrity checks, identifies invalid or damaged files, and reports detailed error messages describing each issue. The TDA maintains a regularly updated database documenting common file format validation errors and their solutions, supported by a defined process for database updates."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|File Verification Error Data" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2b5e85fae5
  a skos:Concept ;
  skos:prefLabel "Package Validation Service"@en ;
  skos:description "A repository capability enabling automated validation of Archival Information Packages (AIPs) against the OAIS Information Model requirements. The service assesses the quality and completeness of holdings, providing evidence of conformance and helping identify missing or incomplete information."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|Package Validation Service" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att23727d6070
  a skos:Concept ;
  skos:prefLabel "Package Verification Service"@en ;
  skos:description "A value-added service within the automated curation domain that enables systems and tools to automatically discover and identify the packing standards used during the ingest process. It operates through standard APIs to verify package conformance without requiring manual intervention."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|Package Verification Service" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.21F3C82F8B ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1828900f1b
  a skos:Concept ;
  skos:prefLabel "Submission API is available"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Automated Curation|Submission API is available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1F4AE0B0F8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4a2cf0af0a
  a skos:Concept ;
  skos:prefLabel "Considerations"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Considerations" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.74FDFB3E00 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1c5f7aaa09
  a skos:Concept ;
  skos:prefLabel "Makes use of standard API specifications"@en ;
  skos:description "A consideration addressing whether a repository makes use of standard API specifications, standards, and protocols in its implementation. This involves identifying which specific API standards and protocols are adopted to ensure interoperability and value-added services."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Considerations|Makes use of standard API specifications" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.375960B05E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att515b8f83fb
  a skos:Concept ;
  skos:prefLabel "Offers API Documentation"@en ;
  skos:description "A repository consideration addressing whether the service exposes its interfaces through documented, standardized API protocols. It encompasses the standards and processes by which people, systems, and digital objects interact within and across organizations, and requires that a service description has been published to support effective interoperability."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Considerations|Offers API Documentation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att28a2220e45
  a skos:Concept ;
  skos:prefLabel "Machine-Readable Licences"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Licences" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3219437E8F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2f39de4e78
  a skos:Concept ;
  skos:prefLabel "Access Conditions"@en ;
  skos:description "Access conditions define the terms and mechanisms through which authorised users may obtain access to data or information objects, expressed clearly in metadata to support both human understanding and automated decision-making. This encompasses the access request and approval process, appropriate access methods (such as direct download or secure remote environments), and criteria based on object characteristics and user rights management policies."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Licences|Access Conditions" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.64FDE59BAD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6628e95eac
  a skos:Concept ;
  skos:prefLabel "Machine-readable Licence Provisions (REL)"@en ;
  skos:description "Machine-readable licence provisions (REL) refer to the use of standard vocabularies and metadata formats to explicitly express access, reuse, and publication rights in a semantically tagged, machine-readable form. Repositories adopt REL vocabularies to ensure that access conditions and restrictions are transparent and automatically parseable by tools, enabling consistent interpretation of licence and policy clauses."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Licences|Machine-readable Licence Provisions (REL)" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3e5176e2b8
  a skos:Concept ;
  skos:prefLabel "Standardised Licence URIs"@en ;
  skos:description "Repositories use standardised, commonly accepted URIs or identifiers to identify licences in use."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Licences|Standardised Licence URIs" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.156B52FB19 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att03110a5773
  a skos:Concept ;
  skos:prefLabel "Machine-Readable Policies"@en ;
  skos:description "A requirement that repositories make their applicable policies available in a machine-readable format. This enables automated systems to interpret and process policy information directly, supporting interoperability and programmatic access to repository governance rules through standard APIs."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Policies" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.66003293B3 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att58166d724b
  a skos:Concept ;
  skos:prefLabel "Machine-readable Policies"@en ;
  skos:description "A characteristic indicating whether a repository's data policy is encoded in a structured, machine-readable format such as JSON-LD, XML, or RDF. This enables automated tools and external systems to ingest, assess, or integrate policy information programmatically. The repository exposes policies in a standardised, interoperable way."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Policies|Machine-readable Policies" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att02bda33b58
  a skos:Concept ;
  skos:prefLabel "Machine-readable Terms and Conditions"@en ;
  skos:description "A service characteristic in which usage rights and terms of use are formally published and provided to users in a structured, machine-readable format. This enables automated processing of policies, standard APIs, and value-added service conditions, ensuring transparency and clear delineation of responsibilities between provider and consumer."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Policies|Machine-readable Terms and Conditions" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.650BA75F4F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att435a79a35f
  a skos:Concept ;
  skos:prefLabel "Policy Vocabulary URI"@en ;
  skos:description "A controlled vocabulary URI used to indicate the policy type of a repository's policy documents. It specifies which format or encoding is applied to the data policy, enabling machine-readable interpretation of policy types through standard, standardized policy vocabulary references."@en ;
  schema:category "Responsibility|Typical Value-added Services|Standard APIs|Machine-Readable Policies|Policy Vocabulary URI" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6A8A5E1219 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4cb9ed25fe
  a skos:Concept ;
  skos:prefLabel "Sustainability"@en ;
  skos:description "Sustainability refers to a trustworthy repository's capacity to ensure uninterrupted, long-term access to its data holdings for current and future user communities. It encompasses the repository's ability to maintain and evolve its services over time, typically documented through a formal sustainability plan or dedicated webpage outlining strategies to meet changing user requirements."@en ;
  schema:category "Sustainability" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5cf6ab3b6e
  a skos:Concept ;
  skos:prefLabel "Adequacy of Structural Income"@en ;
  skos:description "Adequacy of structural income refers to the principle that recurring operational activities should be funded through stable, sustainable revenue sources rather than time-limited grants. Relying on grant funding for day-to-day operations creates financial fragility and may divert focus from building core infrastructure. Time-limited funds are reserved for time-limited activities."@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att52a2a122af
  a skos:Concept ;
  skos:prefLabel "Base operations structurally funded"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Base operations structurally funded" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6edf9a999f
  a skos:Concept ;
  skos:prefLabel "Defined and predictable funding regime"@en ;
  skos:description "A defined and predictable funding regime refers to the organisational hierarchies and processes through which an entity's human and financial resources are obtained and managed. It encompasses knowledge of, and effective deployment of, human, financial, and energy assets to ensure structural income adequacy and long-term financial sustainability."@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Defined and predictable funding regime" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4c2b1ea7bc
  a skos:Concept ;
  skos:prefLabel "Funding Details"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Funding Details" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att58915ad64b
  a skos:Concept ;
  skos:prefLabel "Funder List"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Funding Details|Funder List" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att07370acb06
  a skos:Concept ;
  skos:prefLabel "Funder IRI"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Funding Details|Grant List|Funder IRI" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.365F68CB18 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att00912fbe63
  a skos:Concept ;
  skos:prefLabel "Funder Name"@en ;
  skos:description "Funder Name denotes the official name of the organization or entity that provides financial support to a repository. It identifies the funding source associated with the repository's financial backing."@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Funding Details|Funder List|Funder Name" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6D12041533 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2a1e8cb3a2
  a skos:Concept ;
  skos:prefLabel "Grant List"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Funding Details|Grant List" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att025e0b27c7
  a skos:Concept ;
  skos:prefLabel "Grant Amount"@en ;
  skos:description "Grant Amount refers to the monetary value awarded as part of a grant. It represents the total sum of funding provided to a recipient organization or individual under a specific grant agreement."@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Funding Details|Grant List|Grant Amount" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4840647866 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att41de70e553
  a skos:Concept ;
  skos:prefLabel "Grant IRI"@en ;
  skos:description "A Grant IRI is a unique identifier assigned to a grant, used to distinguish and reference it within a system or dataset. It serves as a persistent, machine-readable locator for grant-related information."@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Funding Details|Grant List|Grant IRI" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.70C4C7B218 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att75b98bcb19
  a skos:Concept ;
  skos:prefLabel "Grant Name"@en ;
  skos:description "A Grant Name is the official designation assigned to a specific fund or grant. It serves as the primary identifier used to reference and distinguish the fund within administrative and reporting contexts."@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Funding Details|Grant List|Grant Name" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6f306e2cea
  a skos:Concept ;
  skos:prefLabel "Publicly Available Accounts"@en ;
  skos:description "The organisational hierarchies and processes by which an entity's human and financial resources are obtained and managed. This encompasses knowledge of and effective deployment of human, financial, and energy assets to support financial sustainability and ensure the adequacy of structural income."@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|Publicly Available Accounts" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att269758d5a0
  a skos:Concept ;
  skos:prefLabel "R&D is Possible"@en ;
  skos:description "A state of financial sustainability in which structural income makes sufficient provision for research and development activity, ensuring that continuous improvement and baseline innovation are not dependent on ad-hoc or contingent funding sources. At this level, R&D capacity is embedded within the organisation's core financial model."@en ;
  schema:category "Sustainability|Financial Sustainability|Adequacy of Structural Income|R&D is Possible" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5EFDB0D148 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3e8808255f
  a skos:Concept ;
  skos:prefLabel "Business Model"@en ;
  skos:description "A financial sustainability concept referring to the generation of revenue through means consistent with an organisation's mission and aims. A viable business model ensures stable funding for long-term operations; without such a model, adoption and implementation of dependent systems may be impeded. Revenue sources should be evaluated to avoid conflicts with organisational objectives."@en ;
  schema:category "Sustainability|Financial Sustainability|Business Model" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.67DE43D8DF ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7cbe776c7a
  a skos:Concept ;
  skos:prefLabel "Business Model Type"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Business Model|Business Model Type" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att139cd89a8a
  a skos:Concept ;
  skos:prefLabel "Community Engagement"@en ;
  skos:description "Financial sustainability in a repository context refers to securing the funding necessary to support ongoing use of data resources while maintaining their desirable properties over time. It encompasses the financial strategies that enable a repository to fulfill its long-term preservation and dissemination responsibilities for entrusted data."@en ;
  schema:category "Sustainability|Financial Sustainability|Community Engagement" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.00C02C55DC ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1eb263b2ce
  a skos:Concept ;
  skos:prefLabel "Revenue"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Revenue" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.04F0DB0243 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0e0c905d2a
  a skos:Concept ;
  skos:prefLabel "Data is free"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Revenue|Data is free" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2080C1D4EE ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7660700650
  a skos:Concept ;
  skos:prefLabel "Compensation Rule"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Revenue|Data is free|Compensation Rule" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att410ba123b3
  a skos:Concept ;
  skos:prefLabel "Justifiable Cost"@en ;
  skos:description "A financial sustainability principle requiring that PID (Persistent Identifier) services within EOSC be provided at a justifiable cost to PID Owners and PID Managers. This ensures that fees or charges associated with PID services remain reasonable and transparent, supporting equitable access and long-term financial viability of the infrastructure."@en ;
  schema:category "Sustainability|Financial Sustainability|Revenue|Justifiable Cost" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.50DA0AA84E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2758ac32b8
  a skos:Concept ;
  skos:prefLabel "Justification of Income"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Revenue|Justifiable Cost|Justification of Income" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1DB4B1E4F0 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att678439cd93
  a skos:Concept ;
  skos:prefLabel "Source"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Financial Sustainability|Revenue|Source" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att076a4c2950
  a skos:Concept ;
  skos:prefLabel "Revenue Source"@en ;
  skos:description "A revenue source refers to the origins or streams through which an organization generates income to sustain its financial operations. It encompasses the processes and organizational structures by which revenue-generating activities are managed and executed, supporting the entity's broader mission and long-term financial sustainability."@en ;
  schema:category "Sustainability|Financial Sustainability|Revenue|Source|Revenue Source" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.365F68CB18 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6ef77f35f8
  a skos:Concept ;
  skos:prefLabel "Revenue Type"@en ;
  skos:description "The sources and types of funding available to a repository, including grants, donations, memberships, and in-kind contributions that support the development or maintenance of repository assets and the broader content ecosystem. Funding structures should reflect non-discriminatory, inclusive principles, welcoming contributions from any stakeholder group."@en ;
  schema:category "Sustainability|Financial Sustainability|Revenue|Source|Revenue Type" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att375960b05e
  a skos:Concept ;
  skos:prefLabel "Infrastructure Links"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Infrastructure Links" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3619EF1B84 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att394bc515e7
  a skos:Concept ;
  skos:prefLabel "EOSC Node Service"@en ;
  skos:description "A classification attribute indicating whether a service or infrastructure is part of a current or aspiring EOSC (European Open Science Cloud) Node. It captures the relationship between a given service and its membership or candidacy within the EOSC Node ecosystem, supporting sustainability and infrastructure linkage assessments."@en ;
  schema:category "Sustainability|Infrastructure Links|EOSC Node Service" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.66C6612EA5 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att241e6c58df
  a skos:Concept ;
  skos:prefLabel "Network Membership"@en ;
  skos:description "A repository's membership in external initiatives, networks, or infrastructures that support its sustainability. This concept encompasses the formal affiliations and collaborative frameworks to which a repository belongs, reflecting its integration within broader organizational or technical ecosystems."@en ;
  schema:category "Sustainability|Infrastructure Links|Network Membership" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.21F3C82F8B ;
  skos:inScheme trsp:ConceptScheme .

trsp:att70bfed1ac3
  a skos:Concept ;
  skos:prefLabel "Portal Inclusion"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Infrastructure Links|Portal Inclusion" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att00bafe4b4e
  a skos:Concept ;
  skos:prefLabel "Registered in EOSC Marketplace"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Infrastructure Links|Registered in EOSC Marketplace" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5FFCEEB1F9 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0341aa63b1
  a skos:Concept ;
  skos:prefLabel "Research Infrastructures Served"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Infrastructure Links|Research Infrastructures Served" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.650BA75F4F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att04f0db0243
  a skos:Concept ;
  skos:prefLabel "Planning"@en ;
  skos:description "Sustainability planning encompasses strategies for risk mitigation, business continuity, and disaster recovery, with particular emphasis on succession planning. This includes provisions for sudden loss of provider viability, such as set-aside funding and defined operational timeframes to sustain continued service while a successor provider is identified, ensuring preservation of references and ongoing access."@en ;
  schema:category "Sustainability|Planning" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7F7C2776AC ;
  skos:inScheme trsp:ConceptScheme .

trsp:att11e8c2b7d0
  a skos:Concept ;
  skos:prefLabel "Disaster Recovery Plan"@en ;
  skos:description "A disaster recovery plan encompasses the non-technical organizational processes and strategies for ensuring business continuity during service disruptions or disasters. It includes preparation for maintaining normal operations, managing digital objects, and addressing security incidents, as well as succession planning for service termination. Recovery planning complements technical infrastructure measures to support organizational resilience."@en ;
  schema:category "Sustainability|Planning|Disaster Recovery Plan" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.697C57FE46 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att14c87d5fc0
  a skos:Concept ;
  skos:prefLabel "Long-Term Preservation Plan"@en ;
  skos:description "A governance framework ensuring the long-term preservation of data resources so they remain discoverable, accessible, and usable over time. It addresses sustainability planning by establishing policies and structures necessary to maintain data integrity and availability into the future."@en ;
  schema:category "Sustainability|Planning|Long-Term Preservation Plan" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4A2CF0AF0A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7495ada28b
  a skos:Concept ;
  skos:prefLabel "Public Continuity Plan"@en ;
  skos:description "A public continuity plan addressing sustainability and planning by identifying and managing third-party organisations, hosts, partners, and other actors essential to operations. This includes ensuring the continued delivery of data or metadata services through effective oversight of external dependencies."@en ;
  schema:category "Sustainability|Social Sustainability|Planning/ Continuity|Public Continuity Plan" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att36e657fc7b
  a skos:Concept ;
  skos:prefLabel "Repository or Collections Data Management Plan"@en ;
  skos:description "A data management planning framework addressing repository-level considerations for catalogues and collections, including the acceptance of custody of digital objects from depositors and the transfer of responsibility to the repository. It encompasses the appraisal of offered or requested deposits to ensure they meet established criteria for acceptance."@en ;
  schema:category "Sustainability|Planning|Repository or Collections Data Management Plan" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2744CED24F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att34a4f04633
  a skos:Concept ;
  skos:prefLabel "Resource Management Plan"@en ;
  skos:description "A structured approach to planning and managing human, financial, technological, and energy resources necessary to fulfil an organisation's mission. Encompasses organisational hierarchies, skills development, and risk management, ensuring sufficient internal or external expertise is available. Includes governance of policies, procedures, and the effective deployment of assets over time."@en ;
  schema:category "Sustainability|Planning|Resource Management Plan" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.18D74ED687 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4b6380a8f0
  a skos:Concept ;
  skos:prefLabel "Risk Plan"@en ;
  skos:description "A Sustainability Risk Plan in which the Technology Dependency Assessment (TDA) monitors technology evolution to identify potential risks. It defines detection methods for each identified risk, supporting proactive planning and long-term sustainability of technology-dependent systems."@en ;
  schema:category "Sustainability|Planning|Risk Plan" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3609108196
  a skos:Concept ;
  skos:prefLabel "Succession Plan"@en ;
  skos:description "A sustainability and succession plan outlines options for relocating or transitioning a repository's activities to another host in the event of disruptions such as unexpected funding withdrawal or shifts in institutional priorities. It supports business continuity by addressing non-technical organizational processes, digital object management, and security, as well as recovery plans for service interruptions, disasters, and potential end-of-service scenarios."@en ;
  schema:category "Sustainability|Planning|Succession Plan" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2E979C3B25 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0849a7f1e2
  a skos:Concept ;
  skos:prefLabel "Social Sustainability"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Social Sustainability" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0cf10c6cfb
  a skos:Concept ;
  skos:prefLabel "Community Engagement"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Social Sustainability|Community Engagement" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.608015D600 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att04dc5770c9
  a skos:Concept ;
  skos:prefLabel "Documentation on Community Engagement"@en ;
  skos:description "Documentation on community engagement captures how organizations, particularly Trusted Digital Archives (TDAs), monitor and engage with designated and Indigenous communities to identify evolving needs and ensure data practices are grounded in respect, reciprocity, and self-determination. Such documentation supports ethical data use, informed decision-making, and equitable benefit-sharing, while enabling communities to govern their own data and digital resources."@en ;
  schema:category "Sustainability|Social Sustainability|Community Engagement|Documentation on Community Engagement" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7F7C2776AC ;
  skos:inScheme trsp:ConceptScheme .

trsp:att13368cb9ac
  a skos:Concept ;
  skos:prefLabel "Impact Assessment"@en ;
  skos:description "The systematic monitoring and analysis of a designated community and relevant stakeholders to identify evolving needs and assess the impact of repository services. This process combines internal data and external information to verify that the organisation is effectively fulfilling its mission and scope, ensuring accountability and demonstrating value to the community served."@en ;
  schema:category "Sustainability|Social Sustainability|Community Engagement|Impact Assessment" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.700343D2B3 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att01d16efb9b
  a skos:Concept ;
  skos:prefLabel "Managed Stakeholder Dependencies"@en ;
  skos:description "A structured approach to identifying and managing mutual dependencies with key stakeholders—including end users, depositors, funders, service users, aggregators, and third-party partners—essential to organizational operations. This encompasses documenting the nature of these relationships, stating intentions for partnership management, and ensuring sufficient human resources and skills, internally or externally, to fulfil the organizational mission."@en ;
  schema:category "Sustainability|Social Sustainability|Community Engagement|Managed Stakeholder Dependencies" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4840647866 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4e4fd79526
  a skos:Concept ;
  skos:prefLabel "Expert Guidance"@en ;
  skos:description "A digital repository must identify, source, and maintain the skills necessary to deliver its services, whether through internal staff or external engagement. It ensures business continuity by sustaining normal operations, managing non-technical organisational processes, and preparing recovery and succession plans for disruptions, service interruptions, or the eventual end of a service."@en ;
  schema:category "Sustainability|Social Sustainability|Expert Guidance" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1fc6bcd089
  a skos:Concept ;
  skos:prefLabel "Periodic Expert/ External Review"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Social Sustainability|Expert Guidance|Periodic Expert/ External Review" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6FB10117A8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att539a68df8a
  a skos:Concept ;
  skos:prefLabel "Governance"@en ;
  skos:description "A governance practice within social sustainability that involves providing guidance and responding to requests from depositors and users regarding the deposit, appraisal, discovery, access, and re-use of data and metadata."@en ;
  schema:category "Sustainability|Social Sustainability|Governance" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7c68dbb456
  a skos:Concept ;
  skos:prefLabel "Governance Description"@en ;
  skos:description "A description of the governance structure of the repository, presented as a transparency measure within the scope of services. This includes value-added information regarding supported package crosswalks and conversions, enabling users to understand how the repository facilitates interoperability between different metadata or data formats."@en ;
  schema:category "Sustainability|Social Sustainability|Governance|Governance Description" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att494b22c440
  a skos:Concept ;
  skos:prefLabel "Governance Model"@en ;
  skos:description "A governance model refers to the type of framework or structure through which an organization or system is directed, managed, and held accountable. Within the context of social sustainability, it defines the mechanisms and principles guiding decision-making, authority, and stakeholder relationships to promote equitable and responsible outcomes."@en ;
  schema:category "Sustainability|Social Sustainability|Governance|Governance Model" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3F6736BF1C ;
  skos:inScheme trsp:ConceptScheme .

trsp:att247c3c5849
  a skos:Concept ;
  skos:prefLabel "Stakeholder Representation"@en ;
  skos:description "Stakeholder representation in governance refers to the inclusion of diverse community members—including Indigenous Peoples—in organizational decision-making structures and data stewardship processes. Board-governed bodies drawn from stakeholder communities foster consensus-driven decisions that reflect varied interests. Indigenous Peoples specifically hold the right to develop cultural governance protocols and exercise authority over how Indigenous data, knowledge, and territories are represented and controlled."@en ;
  schema:category "Sustainability|Social Sustainability|Governance|Stakeholder Representation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7592D43F0B ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6237ed1101
  a skos:Concept ;
  skos:prefLabel "Living Will"@en ;
  skos:description "A living will is a publicly disclosed plan describing the conditions under which an organisation would be wound down, the process by which this would occur, and how its assets would be archived or transferred to a successor organisation. It serves as a trust-building mechanism within social sustainability, requiring any successor to honour the same principles."@en ;
  schema:category "Sustainability|Social Sustainability|Living Will" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att42d7c2c3a4
  a skos:Concept ;
  skos:prefLabel "Public Statement of Wind-Down"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Social Sustainability|Living Will|Public Statement of Wind-Down" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6A8A5E1219 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5fbaf6dc9f
  a skos:Concept ;
  skos:prefLabel "Planning/ Continuity"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Social Sustainability|Planning/ Continuity" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7da1b3367b
  a skos:Concept ;
  skos:prefLabel "Technical Sustainability"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Technical Sustainability" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att79d95e290a
  a skos:Concept ;
  skos:prefLabel "Data Continuity"@en ;
  skos:description "A capability encompassing the monitoring of technology evolution to identify emerging risks and define appropriate detection methods. It supports crosswalks and conversions as value-added services, providing transparency into the scope of supported package crosswalks. This enables informed decision-making regarding technology transitions and risk mitigation."@en ;
  schema:category "Sustainability|Technical Sustainability|Data Continuity" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5cb2fb5b4c
  a skos:Concept ;
  skos:prefLabel "Content is available free"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Technical Sustainability|Data Continuity|Content is available free" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3ad2eca374
  a skos:Concept ;
  skos:prefLabel "Data is Available"@en ;
  skos:description "Data availability is a dimension of technical sustainability ensuring that underlying data can be practically obtained, not merely designated as open. Subject to applicable privacy laws, data should be made easily accessible through mechanisms such as periodic data dumps, enabling actual use rather than nominal openness."@en ;
  schema:category "Sustainability|Technical Sustainability|Data Continuity|Data is Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.540F680A1E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att608b9c73bb
  a skos:Concept ;
  skos:prefLabel "Open Data"@en ;
  skos:description "Open data refers to making data legally and freely available, with the CC0 waiver representing best practice for this purpose. It supports technical sustainability by enabling infrastructure to be forked through replication of all relevant data. Privacy and data protection laws impose limits on the extent to which full openness is achievable."@en ;
  schema:category "Sustainability|Technical Sustainability|Data Continuity|Open Data" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4b417e2d31
  a skos:Concept ;
  skos:prefLabel "Open Source"@en ;
  skos:description "TBD"@en ;
  schema:category "Sustainability|Technical Sustainability|Open Source" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7bceafb957
  a skos:Concept ;
  skos:prefLabel "No Patents on Source Code"@en ;
  skos:description "A commitment by an organisation to a patent non-assertion covenant, whereby patents may be obtained to protect internal operations but must not be used to prevent the broader community from replicating or implementing the infrastructure. This ensures open access and reproducibility of systems without legal restriction."@en ;
  schema:category "Sustainability|Technical Sustainability|Open Source|No Patents on Source Code" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att792636c88d
  a skos:Concept ;
  skos:prefLabel "Source code is open or available on closure"@en ;
  skos:description "Documentation covering the source code repositories used by major repository software and services. This resource supports crosswalk and conversion processes by identifying and mapping the relevant repositories, providing transparency into the scope of value-added services offered."@en ;
  schema:category "Sustainability|Technical Sustainability|Open Source|Source code is open or available on closure" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att56c67a542a
  a skos:Concept ;
  skos:prefLabel "Technology"@en ;
  skos:description "The software, hardware, and technical services that support a repository's secure, persistent, and reliable operations through the interaction of people and processes. This encompasses methods for storing and replicating digital objects' data and metadata, including validation of replicated copies and restoration of data from backups in case of errors."@en ;
  schema:category "Technology" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att752453ed45
  a skos:Concept ;
  skos:prefLabel "Accessible"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Accessible" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0ed3d624b3
  a skos:Concept ;
  skos:prefLabel "Accessibility Measures"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Accessible|Accessibility Measures" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.570534F4B8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att455fb4a066
  a skos:Concept ;
  skos:prefLabel "Accessibility Rating"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Accessible|Accessibility Measures|Accessibility Rating" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6E790E641F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att70deca9f26
  a skos:Concept ;
  skos:prefLabel "Multi-Language Support"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Accessible|Multi-Language Support" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att78a504b99f
  a skos:Concept ;
  skos:prefLabel "Language Support Scope and Documentation"@en ;
  skos:description "This concept identifies which languages are supported per vocabulary within a repository's scope of services, providing reference information about the boundaries of linguistic coverage for which the organization retains responsibility. It documents multi-language support scope, including crosswalks and conversions, ensuring transparency about accessible language capabilities and any partner or outsourced involvement in delivering those functions."@en ;
  schema:category "Technology|Accessible|Multi-Language Support|Language Support Scope and Documentation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att42a3d7a518
  a skos:Concept ;
  skos:prefLabel "Metadata"@en ;
  skos:description "A system capability that enables metadata and controlled vocabularies to be provided in multiple languages through the use of language tags. This supports consistent interpretation of metadata by users from diverse linguistic backgrounds, thereby broadening accessibility across different communities."@en ;
  schema:category "Technology|Accessible|Multi-Language Support|Metadata" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.70C4C7B218 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att211f98fa33
  a skos:Concept ;
  skos:prefLabel "Vocabularies and Thesauri"@en ;
  skos:description "A system capability that enables the use or exposure of controlled vocabularies—such as multilingual thesauri—across multiple languages. This allows users from different linguistic backgrounds to interpret, search, and reuse metadata consistently across domains, for example by providing translated titles, abstracts, or subject terms."@en ;
  schema:category "Technology|Accessible|Multi-Language Support|Vocabularies and Thesauri" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5FBAF6DC9F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att60f7491b6a
  a skos:Concept ;
  skos:prefLabel "Websites and Services"@en ;
  skos:description "A feature of websites and services that enables users to browse or search content in their preferred language, with clear indication of which languages are supported. This accessibility capability ensures that digital services can be used effectively by speakers of different languages, promoting inclusivity across diverse user communities."@en ;
  schema:category "Technology|Accessible|Multi-Language Support|Websites and Services" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att21f3c82f8b
  a skos:Concept ;
  skos:prefLabel "Legal"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Legal" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7592D43F0B ;
  skos:inScheme trsp:ConceptScheme .

trsp:att17b2a92ec9
  a skos:Concept ;
  skos:prefLabel "List of Third Party Services"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Legal|List of Third Party Services" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5DC262FE75 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att13fe6ddd8e
  a skos:Concept ;
  skos:prefLabel "Third Party Service Level Agreements"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Legal|Third Party Service Level Agreements" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.00EDBED146 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7592d43f0b
  a skos:Concept ;
  skos:prefLabel "Open Source"@en ;
  skos:description "Indicates whether an infrastructure supports package crosswalks through open source software, meaning all software required to operate the infrastructure must be available under an open source license. This requirement applies specifically to the infrastructure's core software and does not extend to other software used by the organisation."@en ;
  schema:category "Technology|Open Source" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2363f099d9
  a skos:Concept ;
  skos:prefLabel "Community Contributions"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Open Source|Community Contributions" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1593E1AE08 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5247a27418
  a skos:Concept ;
  skos:prefLabel "Confirmation of Open Source Stack"@en ;
  skos:description "A confirmation that the repository's technology stack is built on well-supported, open-source operating systems and core infrastructural software and hardware. These components are appropriate to the services provided to the repository's Designated Community, ensuring reliability and sustainability of the underlying infrastructure."@en ;
  schema:category "Technology|Open Source|Confirmation of Open Source Stack" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att17f915c6d9
  a skos:Concept ;
  skos:prefLabel "Primary Software Platform"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Open Source|Primary Software Platform" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.532324DE1D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6d8778c1be
  a skos:Concept ;
  skos:prefLabel "Re-establishment of service elsewhere"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Open Source|Re-establishment of service elsewhere" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6a837d5a94
  a skos:Concept ;
  skos:prefLabel "Reliable"@en ;
  skos:description "A characteristic of technology pertaining to the implementation of relevant and appropriate standards, tools, and technologies for data management and curation. It emphasizes the selection and application of dependable technical approaches that ensure effective stewardship of data resources."@en ;
  schema:category "Technology|Reliable" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2fcc26efc0
  a skos:Concept ;
  skos:prefLabel "Description of Reliability Measures"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Reliable|Description of Reliability Measures" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att209066030x
  a skos:Concept ;
  skos:prefLabel "Uptime"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Reliable|Uptime" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.539A68DF8A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6d262193a1
  a skos:Concept ;
  skos:prefLabel "Secure"@en ;
  skos:description "The extent to which a service supports crosswalks and conversions between metadata packages, with plans and mechanisms in place to prevent, detect, and respond to cyber or physical security threats. This value-added capability falls within the scope of services transparency."@en ;
  schema:category "Technology|Secure" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1ae2618c36
  a skos:Concept ;
  skos:prefLabel "e-Infrastructure security and Integrity"@en ;
  skos:description "e-Infrastructure security and integrity encompasses the management and protection of systems, their content, and associated data to ensure secure and reliable operation. It includes the comprehensive provision of hardware, software, and IT service management, alongside monitoring technical needs to maintain service levels. New approaches to security, data, and research infrastructure may be introduced through dedicated projects and activities."@en ;
  schema:category "Technology|Secure|e-Infrastructure security and Integrity" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.58166D724B ;
  skos:inScheme trsp:ConceptScheme .

trsp:att178c46c3f1
  a skos:Concept ;
  skos:prefLabel "Active Threat Monitoring in Place"@en ;
  skos:description "A security practice in which the TDA continuously monitors technology evolution to identify emerging risks and defines appropriate detection methods for those risks. It ensures active oversight of threats to e-infrastructure security and integrity."@en ;
  schema:category "Technology|Secure|e-Infrastructure security and Integrity|Active Threat Monitoring in Place" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5DC262FE75 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att181f35e46a
  a skos:Concept ;
  skos:prefLabel "Published Security and Integrity Measures"@en ;
  skos:description "A repository's published security and integrity measures encompass documented processes for ensuring data, metadata, and infrastructure security across digital object management and organizational systems. These measures address risks at the boundary between the repository and external entities, including users, depositors, and third-party dependencies, and are made available as a summary upon request."@en ;
  schema:category "Technology|Secure|e-Infrastructure security and Integrity|Published Security and Integrity Measures" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.532324DE1D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att337c35222e
  a skos:Concept ;
  skos:prefLabel "Standardised AAI"@en ;
  skos:description "Standardised AAI refers to the implementation of widely accepted authentication and authorisation protocols—such as SAML, OpenID Connect, or OAuth2—within a repository or service. Adopting these standards ensures compatibility with federated identity providers, secure machine-to-machine communication, and interoperability with ecosystems like EOSC, facilitating cross-service user access and integration with external infrastructures."@en ;
  schema:category "Technology|Secure|e-Infrastructure security and Integrity|Standardised AAI" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0B3D7477E7 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5efdb0d148
  a skos:Concept ;
  skos:prefLabel "Object Storage"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Secure|Object Storage" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att075738c8df
  a skos:Concept ;
  skos:prefLabel "Documented Measures for Backup, Replication, and Restoration"@en ;
  skos:description "Documented measures for maintaining the physical integrity and availability of digital objects through verified replication across multiple storage locations, backup provisions, and restoration procedures. The system automatically manages replication of information packages—potentially across geographically distributed sites—replaces damaged files from replicated copies, and validates restored data to ensure accuracy and completeness."@en ;
  schema:category "Technology|Secure|Object Storage|Documented Measures for Backup, Replication, and Restoration" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.365F68CB18 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6f82b396bd
  a skos:Concept ;
  skos:prefLabel "Sovereignty Considerations"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Secure|Sovereignty Considerations" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1db0a6f7db
  a skos:Concept ;
  skos:prefLabel "Locality of Data Storage and Archiving"@en ;
  skos:description "A sovereignty consideration relating to the geographic jurisdiction in which data and metadata are physically stored and archived. It identifies the country of storage location, which has implications for legal compliance, data governance, and national sovereignty over sensitive information."@en ;
  schema:category "Technology|Secure|Sovereignty Considerations|Locality of Data Storage and Archiving" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.375960B05E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att35579be2fc
  a skos:Concept ;
  skos:prefLabel "Services"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Services" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6105038322 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att46058de67b
  a skos:Concept ;
  skos:prefLabel "External/ Micro-Services"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Services|External/ Micro-Services" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6B61F7AF54 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3720038519
  a skos:Concept ;
  skos:prefLabel "Dependencies"@en ;
  skos:description "The management of human resources to fulfil an organizational mission, encompassing the identification and maintenance of sufficient skills and competencies. This includes sourcing capabilities both internally and through external engagement, and managing dependencies on external or micro-services to ensure operational continuity."@en ;
  schema:category "Technology|Services|External/ Micro-Services|Dependencies" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2847F75853 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att693f62f485
  a skos:Concept ;
  skos:prefLabel "Availability Monitoring"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Services|External/ Micro-Services|Dependencies|Availability Monitoring" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att32048a7179
  a skos:Concept ;
  skos:prefLabel "Verified and Documented"@en ;
  skos:description "A classification denoting that external or micro-service dependencies within a technology or service context have been verified and formally documented by designated curators. This status confirms that dependency relationships are reviewed and recorded, ensuring transparency and accountability in the management of service interdependencies."@en ;
  schema:category "Technology|Services|External/ Micro-Services|Dependencies|Verified and Documented" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1db4b1e4f0
  a skos:Concept ;
  skos:prefLabel "Ownership"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Services|External/ Micro-Services|Ownership" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.04F0DB0243 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4813acf624
  a skos:Concept ;
  skos:prefLabel "Changes are Tracked"@en ;
  skos:description "A property of external and micro-services whereby changes in service ownership are systematically tracked and versioned over time. This ensures a maintained historical record of ownership transitions, supporting accountability and auditability across the service lifecycle."@en ;
  schema:category "Technology|Services|External/ Micro-Services|Ownership|Changes are Tracked" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2687A2F0B8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att08417eddfc
  a skos:Concept ;
  skos:prefLabel "Contact Point is Maintained"@en ;
  skos:description "A condition in which the owning organization or contact point for an external or micro-service is persistently identified and maintained. This includes recording names, abbreviations, and contact details to provide reference context, and encompasses the identification and management of third-party organizations, hosts, partners, and other actors essential to service operations and data delivery."@en ;
  schema:category "Technology|Services|External/ Micro-Services|Ownership|Contact Point is Maintained" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att19af20660a
  a skos:Concept ;
  skos:prefLabel "Documented and Published"@en ;
  skos:description "A classification for external or micro-services in which ownership is clearly documented and published. This designation indicates that the responsible party for a given service is explicitly recorded and made available, ensuring transparency and accountability within the service ecosystem."@en ;
  schema:category "Technology|Services|External/ Micro-Services|Ownership|Documented and Published" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0D3C935A8A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2da1c98050
  a skos:Concept ;
  skos:prefLabel "Service Metdata Available"@en ;
  skos:description "A service characteristic in which ownership metadata is made available and exposed through service catalogues or registries. This enables consumers and administrators to identify and access authoritative information about service ownership via external or micro-service interfaces."@en ;
  schema:category "Technology|Services|External/ Micro-Services|Ownership|Service Metdata Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0afac21629
  a skos:Concept ;
  skos:prefLabel "Performance"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Services|External/ Micro-Services|Performance" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1A4E593402 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2f5b9b4823
  a skos:Concept ;
  skos:prefLabel "Automated Retrieval from Tape"@en ;
  skos:description "A technology service capability in which the retrieval of data from tape storage is performed automatically, without manual intervention. This automated recall process is provided as an external or micro-service and is evaluated in terms of performance."@en ;
  schema:category "Technology|Services|External/ Micro-Services|Performance|Automated Retrieval from Tape" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0ef898b591
  a skos:Concept ;
  skos:prefLabel "Large File Transport Support"@en ;
  skos:description "A capability demonstrating efficient upload and download of large files exceeding 100 GB within an external or micro-services architecture. It serves as evidence that the service can handle high-volume data transport with acceptable performance, ensuring reliable transfer of large-scale assets across system boundaries."@en ;
  schema:category "Technology|Services|External/ Micro-Services|Performance|Large File Transport Support" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.570534F4B8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att79c13fd633
  a skos:Concept ;
  skos:prefLabel "Tape Storage Support"@en ;
  skos:description "A service capability indicating support for package crosswalks, enabling the conversion and mapping of content between different formats or standards. This value-added feature falls within the scope of transparency-related services. It also encompasses the ability to store content data on offline tape libraries."@en ;
  schema:category "Technology|Services|External/ Micro-Services|Performance|Tape Storage Support" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att216fec031c
  a skos:Concept ;
  skos:prefLabel "Service Maturity/ Readiness"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Services|Service Maturity/ Readiness" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.79D95E290A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3219437e8f
  a skos:Concept ;
  skos:prefLabel "Software and Service Quality"@en ;
  skos:description "TBD"@en ;
  schema:category "Technology|Services|Service Maturity/ Readiness|Software and Service Quality" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att64e3e49e89
  a skos:Concept ;
  skos:prefLabel "Conformance Testing Tool(s)"@en ;
  skos:description "A conformance testing tool is a software utility used to evaluate whether a given service or tool meets specified standards or requirements. It is published and applied on a per-service or per-tool basis, where available, to assess software and service quality within a service maturity and readiness framework."@en ;
  schema:category "Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Conformance Testing Tool(s)" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att09bfa24214
  a skos:Concept ;
  skos:prefLabel "Formal Testing in Place"@en ;
  skos:description "A quality indicator denoting whether automated conformance tests are formally conducted and published for a given software or service. It reflects the presence of structured, repeatable testing processes that verify conformance to specified requirements, serving as a measure of service maturity and readiness."@en ;
  schema:category "Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Formal Testing in Place" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5CE6A2BBCE ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1adeec1d3a
  a skos:Concept ;
  skos:prefLabel "Frequency of Formal Testing"@en ;
  skos:description "The frequency at which formal testing activities are conducted and officially documented or published for a given software or service. This measure reflects the regularity of quality assurance cycles and provides transparency into the maturity and readiness of the software or service under evaluation."@en ;
  schema:category "Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Frequency of Formal Testing" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.58166D724B ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4c6a46fb4c
  a skos:Concept ;
  skos:prefLabel "Service Maturity Assessment"@en ;
  skos:description "Service Maturity Assessment evaluates whether a PID service infrastructure meets a minimum technology readiness level of 8 for core functions such as registration and resolution. It encompasses projects and activities beyond routine operations, including new approaches to data, metadata, business processes, technology, security, and research infrastructure."@en ;
  schema:category "Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Service Maturity Assessment" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3a2655abb6
  a skos:Concept ;
  skos:prefLabel "Test Results Published"@en ;
  skos:description "A quality attribute indicating that the latest conformance test results for a software or service are published and made available for reference. This supports transparency and accountability by allowing stakeholders to verify the service's adherence to relevant standards or specifications."@en ;
  schema:category "Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Test Results Published" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.540F680A1E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att693d7b796f
  a skos:Concept ;
  skos:prefLabel "Transparency"@en ;
  skos:description "Transparency refers to the practice of conducting governance processes and operations openly, enabling trust in the selection of representatives to governance groups. This approach operates within the constraints of applicable privacy laws. The ARKs in the Open project exemplifies a completely open governance structure applied to public good services."@en ;
  schema:category "Transparency" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att26cd4b30b3
  a skos:Concept ;
  skos:prefLabel "Benefits and Constraints"@en ;
  skos:description "Transparency regarding benefits and constraints refers to the clear disclosure of information about the advantages and limitations associated with the use of a resource, system, or service. This concept encompasses making such information openly accessible to enable informed decision-making by users or stakeholders."@en ;
  schema:category "Transparency|Benefits and Constraints" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3720038519 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att060e8af1a4
  a skos:Concept ;
  skos:prefLabel "Context"@en ;
  skos:description "A contextual overview of a repository's key characteristics, encompassing its type, scope, and scale of data collections. This includes information on the data types and formats held, providing transparency about the nature and constraints of the repository to inform prospective users and stakeholders."@en ;
  schema:category "Transparency|Benefits and Constraints|Context" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.57326A13EB ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3e5f32a9e8
  a skos:Concept ;
  skos:prefLabel "Capabilities"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.67DE43D8DF ;
  skos:inScheme trsp:ConceptScheme .

trsp:att48e7481cdd
  a skos:Concept ;
  skos:prefLabel "Administrative Capacity"@en ;
  skos:description "Administrative capacity refers to the organizational capability to effectively manage and sustain operations, encompassing adequate funding, sufficient staffing, and clear governance structures. In the context of DOI registration and digital repositories, it supports minimum quality standards of administration and enables Registration Agencies to fulfill their missions reliably."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Administrative Capacity" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3F6736BF1C ;
  skos:inScheme trsp:ConceptScheme .

trsp:att32846cb4df
  a skos:Concept ;
  skos:prefLabel "Data Transformation Service(s) Available"@en ;
  skos:description "A characteristic indicating whether a repository employs services or tools capable of translating, transforming, or mediating between different data formats, including package structures, file formats, and metadata standards. This capability reflects a transparency consideration within the repository's operational context, highlighting the availability of data transformation services to end users or depositors."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Data Transformation Service(s) Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4f90c51d4c
  a skos:Concept ;
  skos:prefLabel "Level of Curation"@en ;
  skos:description "The Level of Curation attribute characterizes the degree to which a repository processes and enhances deposited content, ranging from distribution as-is (no curation) through basic metadata addition, format conversion and documentation enhancement, to full data-level editing. It situates curation activities within the repository's defined mission and organizational boundaries, including responsibilities retained when partners or outsourced services are involved."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Level of Curation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5960a93a27
  a skos:Concept ;
  skos:prefLabel "Level of Licence Applicability"@en ;
  skos:description "A controlled vocabulary attribute indicating the level of granularity at which a repository licence applies. It specifies the contextual scope—such as repository, collection, or item level—within which licence terms are applicable. Values are drawn from a predefined controlled list."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Level of Licence Applicability" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1a4192f248
  a skos:Concept ;
  skos:prefLabel "Linked Open Data Support"@en ;
  skos:description "A capability describing whether a persistent identifier (PID) system supports linking to objects across different domains and resolving external PIDs. Identifiers used in metadata can be dereferenced, enabling linked entity resolution. This includes features such as linking peer-reviewed publications and other resources through Linked Open Data principles."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Linked Open Data Support" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4A2CF0AF0A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att45ec53c288
  a skos:Concept ;
  skos:prefLabel "Metadata Schema Export Options"@en ;
  skos:description "A repository capability concerning the support for mapping, transforming, and aligning metadata across different schemas, standards, or structural formats. This includes the availability of export options that facilitate interoperability between heterogeneous metadata structures, enabling transparent exchange and integration of metadata across systems."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Metadata Schema Export Options" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6B61F7AF54 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6eed29cae5
  a skos:Concept ;
  skos:prefLabel "PID Resolution Support"@en ;
  skos:description "A repository capability indicating whether persistent identifiers (PIDs) are resolvable via HTTPS and return structured, machine-readable descriptive metadata. This includes autoresolution of metadata based on PIDs and support for PIDs linked to structured descriptive metadata, enabling reliable access to standardized, interoperable data."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|PID Resolution Support" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2c32459481
  a skos:Concept ;
  skos:prefLabel "Supported AAI Services"@en ;
  skos:description "A capability indicating support for login through federated identity providers. It encompasses a list of the specific identity providers or authentication and authorization infrastructures (AAI) that are supported, enabling users to authenticate via established federated services."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported AAI Services" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att01924ad3a3
  a skos:Concept ;
  skos:prefLabel "Supported Data/ Metadata Packages"@en ;
  skos:description "A declaration of the packaging standards associated with a service or tool, covering the standards supported, accepted or preferred for input, produced or exported as output, used internally, and any community-specific packaging standards. This information enables transparency about data and metadata packaging capabilities and constraints within a given context."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Data/ Metadata Packages" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4840647866 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4234565a8d
  a skos:Concept ;
  skos:prefLabel "Supported Dataset Formats"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Dataset Formats" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.70C4C7B218 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att543a727f84
  a skos:Concept ;
  skos:prefLabel "Supported Licences"@en ;
  skos:description "A repository transparency attribute indicating that the list of accepted or supported license types is publicly documented. The repository maintains and publishes a registry of licenses governing how deposited digital objects may be accessed and used, enabling depositors and users to understand the rights, permissions, and obligations that apply."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Licences" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6b9370a3bb
  a skos:Concept ;
  skos:prefLabel "LicenseIRI"@en ;
  skos:description "A LicenseIRI is the IRI (Internationalized Resource Identifier) that uniquely identifies a license. It serves as a globally unique reference to a specific license resource, enabling unambiguous identification and retrieval of license information."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Licences|LicenseIRI" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5d06c32e4c
  a skos:Concept ;
  skos:prefLabel "LicenseName"@en ;
  skos:description "A LicenseName is the designated name identifying a specific license. It serves as a human-readable label used to reference and distinguish a license from others within a system or dataset."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Licences|LicenseName" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6c03ab58b8
  a skos:Concept ;
  skos:prefLabel "Supported Metadata Schema"@en ;
  skos:description "A repository capability indicating the metadata schemas and standards supported by the system, including formats appropriate for specific content types such as geospatial or audiovisual data. The repository publicly discloses which metadata standards it supports, including FAIR-compliant formats, adherence to specific metadata models or profiles, and the standards used by its API."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Metadata Schema" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0b54e5c8f5
  a skos:Concept ;
  skos:prefLabel "Metadata Schema IRI"@en ;
  skos:description "A Metadata Schema IRI is the International Resource Identifier (IRI) that uniquely identifies a metadata standard. It serves as a persistent, globally unique reference to the schema defining the structure and semantics of metadata."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Metadata Schema|Metadata Schema IRI" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4DE2DD546E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att72082342ee
  a skos:Concept ;
  skos:prefLabel "Metadata Schema Name"@en ;
  skos:description "Metadata Schema Name denotes the designation of a metadata standard associated with a resource or system. It identifies the specific schema or framework used to structure and describe metadata. This name serves as a reference to the governing standard that defines the metadata elements and their usage."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Metadata Schema|Metadata Schema Name" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2f993b25ad
  a skos:Concept ;
  skos:prefLabel "Supported Persistent Identifiers"@en ;
  skos:description "A repository capability reflecting its support for persistent identifier (PID) standards, applied to objects, information packages, metadata, and roles across their life cycle. The repository publishes its supported PID systems in a machine-readable way, aligning with well-established identifier schemes to enhance discoverability, resource discovery, and metadata reuse."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Persistent Identifiers" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att69c41a039a
  a skos:Concept ;
  skos:prefLabel "Supported Policies"@en ;
  skos:description "Supported Policies refers to a documented list of policies that a repository implements, accompanied by supporting evidence. It provides a structured account of the governance and operational rules in effect within the repository, enabling transparency and accountability regarding its policy framework."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4cd4fde817
  a skos:Concept ;
  skos:prefLabel "Data Upload Types"@en ;
  skos:description "Data Upload Types denotes the set of regulated categories governing how research data may be submitted to a repository. It functions as a wrapper element that groups the applicable submission rules and upload classifications. The concept provides a structured framework for managing data ingestion policies within a repository system."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|Data Upload Types" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att56c6946e5a
  a skos:Concept ;
  skos:prefLabel "Metadata Access Types"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|Metadata Access Types" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att760bf58aab
  a skos:Concept ;
  skos:prefLabel "PolicyIRI"@en ;
  skos:description "PolicyIRI denotes the Internationalized Resource Identifier (IRI) that uniquely identifies a policy within a system or framework. It serves as a stable, globally unique reference used to locate or retrieve the specific policy resource."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|PolicyIRI" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att34f02b2da3
  a skos:Concept ;
  skos:prefLabel "PolicyName"@en ;
  skos:description "PolicyName denotes the designated name assigned to a policy. It serves as a human-readable identifier that distinguishes one policy from another within a given context."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|PolicyName" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.035ACCB10D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att642c080d89
  a skos:Concept ;
  skos:prefLabel "Supported Access Types"@en ;
  skos:description "Supported Access Types denotes the set of access regulations governing research data sets provided by a Research Data Repository (RDR). It serves as a wrapper element that encapsulates the permitted modes of access to such data sets. This concept defines the overarching structure for specifying how and under what conditions research data may be accessed."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|Supported Access Types" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att167c47d292
  a skos:Concept ;
  skos:prefLabel "Supported Standards/ Specifications"@en ;
  skos:description "A documented list, supported by evidence, of the standards and specifications with which a repository aligns, conforms to, and implements. This encompasses the adoption and development of policies and criteria that guide practice, aligned with governance structures, operational workflows, and the applicable legal and ethical framework."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Standards/ Specifications" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.24650A32BA ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6af56a372d
  a skos:Concept ;
  skos:prefLabel "Supported Vocabularies"@en ;
  skos:description "A capability indicating whether a system supports, publishes, and documents the controlled vocabularies, semantic standards, and ontologies used to describe its holdings. This includes identifying authoritative sources for entities, mapping or aligning terms across vocabularies to ensure consistent interpretation across communities, and demonstrating alignment with recognized information models such as OAIS."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supported Vocabularies" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att50239fc483
  a skos:Concept ;
  skos:prefLabel "Supports Data Expiration"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supports Data Expiration" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6aa7258da9
  a skos:Concept ;
  skos:prefLabel "Supports Embargoes"@en ;
  skos:description "A capability that enables the support of embargo expiration and enforcement within a given context. It provides mechanisms to manage the timing and application of embargoes, ensuring that access or release restrictions are applied and lifted appropriately. This capability operates as both a benefit and a constraint within the transparency domain."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supports Embargoes" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att67e6c4912c
  a skos:Concept ;
  skos:prefLabel "Supports Redaction/ Obfuscation"@en ;
  skos:description "A capability that supports workflows for redacting or obfuscating data, ensuring that metadata indicates whether data has been generalised or redacted. It operates within transparency contexts by balancing disclosure with appropriate data protection constraints."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supports Redaction/ Obfuscation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6f05b292bd
  a skos:Concept ;
  skos:prefLabel "Supports Signposting"@en ;
  skos:description "Package crosswalks supported refers to the capability of converting or mapping metadata between different packaging formats or standards, ensuring that object metadata remains accessible and interoperable. This supports both human and machine findability by enabling automated discovery and exchange of metadata across systems and vocabularies."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Capabilities|Supports Signposting" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att64fde59bad
  a skos:Concept ;
  skos:prefLabel "Coverage"@en ;
  skos:description "Coverage refers to the breadth of scope across the research enterprise, encompassing disciplines, geographies, institutions, and stakeholders. It includes the subject areas, cross-disciplinary domains, data types, and technologies a repository addresses, ensuring infrastructure transcends individual fields. Organisational names, abbreviations, and contact details provide contextual reference for related activities."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att115beec616
  a skos:Concept ;
  skos:prefLabel "Community Coverage"@en ;
  skos:description "Community Coverage refers to the scope of a repository's data acceptance with respect to its originating community. A repository with broad community coverage accepts data contributions from sources beyond its own community. This characteristic reflects an aspect of transparency regarding the contextual reach and inclusivity of the repository's data collection practices."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Community Coverage" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4AA1880060 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3b633179c5
  a skos:Concept ;
  skos:prefLabel "Disciplinary Coverage"@en ;
  skos:description "Disciplinary Coverage refers to the primary research domain or domains addressed within a given context. It identifies the academic or professional fields that a resource, study, or system is designed to serve or represent. This attribute helps clarify the scope and applicability of a resource across different disciplines."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Disciplinary Coverage" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.540F680A1E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1ebe22f750
  a skos:Concept ;
  skos:prefLabel "Discipline"@en ;
  skos:description "A discipline refers to the subject area or field of study associated with a Research Data Repository (RDR). It categorizes the thematic or academic domain to which the repository's content belongs. A single RDR may be associated with one or more disciplines."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Disciplinary Coverage|Discipline" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.04F0DB0243 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att59caa27ce9
  a skos:Concept ;
  skos:prefLabel "Discipline ID"@en ;
  skos:description "A unique identifier or notation assigned to a subject or discipline classification. It serves as a standardized code used to distinguish and reference a specific academic or thematic discipline within a classification system."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Disciplinary Coverage|Discipline ID" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att60fd6669a5
  a skos:Concept ;
  skos:prefLabel "Discipline Scheme"@en ;
  skos:description "A Discipline Scheme is a structured framework used to describe and categorize the subject or discipline of a repository. It provides a standardized scheme for classifying repository content by academic or thematic discipline."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Disciplinary Coverage|Discipline Scheme" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att54317f78cb
  a skos:Concept ;
  skos:prefLabel "Object Coverage"@en ;
  skos:description "A list of object types accepted by a repository, defining the scope of materials for which the organisation holds responsibility. It establishes the boundaries of the repository's mission and activities, including those involving partners or outsourced services, and provides contextual reference for all related functions and outcomes."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Object Coverage" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att14605c9b1c
  a skos:Concept ;
  skos:prefLabel "Object Type ID"@en ;
  skos:description "Object Type ID is the URI that uniquely identifies a particular object or content type. It serves as a standardized reference identifier for distinguishing between different types of objects or content within a system."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Object Coverage|Object Type ID" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4A2CF0AF0A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att756d3790e0
  a skos:Concept ;
  skos:prefLabel "Object Type Name"@en ;
  skos:description "Object Type Name denotes the name assigned to a particular object or content type. It serves as a identifying label that distinguishes one type of object or content from another within a given system or classification scheme."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Object Coverage|Object Type Name" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0613b795fe
  a skos:Concept ;
  skos:prefLabel "Object Type Scheme"@en ;
  skos:description "A scheme used to classify or categorize objects or content by name and/or URL. It provides a structured reference to the classification code or system applied to an object type. This enables consistent identification and organization of content within a defined classification framework."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Object Coverage|Object Type Scheme" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1BF97AE324 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att34d1282f11
  a skos:Concept ;
  skos:prefLabel "Spatial Coverage"@en ;
  skos:description "The articulation of an organisation's purpose and the boundaries of activities for which it holds ultimate responsibility, including those involving partners or outsourced services. This contextual information provides a reference framework for all related activities and functions, clarifying the spatial and operational coverage of the repository's mission."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Spatial Coverage" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.035ACCB10D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5d0e8069fc
  a skos:Concept ;
  skos:prefLabel "Temporal Coverage"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Coverage|Temporal Coverage" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att761c0fb70d
  a skos:Concept ;
  skos:prefLabel "Repository Characterisation"@en ;
  skos:description "A designated contact point associated with a repository, specifically relating to the scope of value-added services offered, including support for package crosswalks and conversions. This resource provides transparency regarding the crosswalk formats and conversion capabilities supported by the repository."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att291848cb10
  a skos:Concept ;
  skos:prefLabel "Contact"@en ;
  skos:description "Contact information for a data repository, including names, abbreviations, and other details of the responsible organisation. This information provides reference context for the repository's activities and functions."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Contact" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3219437E8F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1f522cda86
  a skos:Concept ;
  skos:prefLabel "Contact Information"@en ;
  skos:description "Contact Information refers to the means by which a Research Data Repository (RDR) can be reached, specifically comprising an email address or a URL pointing to an online contact form. It provides users with direct communication channels to the repository."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Contact Information" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.04F0DB0243 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1a387a8e23
  a skos:Concept ;
  skos:prefLabel "Contact Type"@en ;
  skos:description "Contact Type denotes the classification or category assigned to a piece of contact information, distinguishing it by its nature or purpose (e.g., telephone, email, address). It provides a structured means of identifying how a contact can be reached or communicated with."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Contact Type" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0D3C935A8A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4570870110
  a skos:Concept ;
  skos:prefLabel "Country"@en ;
  skos:description "The country in which a repository or service is located and operates. This attribute forms part of the repository's contextual characterisation, supporting transparency by identifying its geographic jurisdiction alongside descriptive information and applicable standards."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Country" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6A47F71F59 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0c1737084b
  a skos:Concept ;
  skos:prefLabel "Description"@en ;
  skos:description "A characterisation of a data repository providing a general descriptive overview of the repository. This information supports transparency by contextualising the repository within a broader descriptive framework."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Description" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.16855D3CB9 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att19c2eb7dab
  a skos:Concept ;
  skos:prefLabel "Identifier"@en ;
  skos:description "A unique identifier or persistent identifier (PID) assigned to a repository to distinguish it within its context. One or more such identifiers may be associated with a single repository, supporting unambiguous reference and characterisation."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Identifier" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0D3C935A8A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att225686595e
  a skos:Concept ;
  skos:prefLabel "Identifier Type"@en ;
  skos:description "A characteristic of systems that capture and expose metadata about individual and organizational roles involved in the deposit, curation, maintenance, and management of digital objects. Defined roles may include data steward, curator, depositor, reviewer, or administrator, and may incorporate group or role memberships provided by identity providers."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Identifier|Identifier Type" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.70DECA9F26 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5f7c942b1e
  a skos:Concept ;
  skos:prefLabel "Identifier Value"@en ;
  skos:description "An Identifier Value is a globally unique identifier that refers to a Research Data Repository (RDR) or to a record describing the RDR. It serves as a distinct, unambiguous reference for locating or describing the repository within a broader information system."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Identifier|Identifier Value" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3a6badbdb9
  a skos:Concept ;
  skos:prefLabel "Landing Page"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Landing Page" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.540F680A1E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att57c5a7579f
  a skos:Concept ;
  skos:prefLabel "Language"@en ;
  skos:description "Transparency refers to the native language of the repository's user interface, characterizing the linguistic context in which the repository presents itself to users. This attribute forms part of the broader repository characterisation, capturing the primary language through which the system's interface communicates with its audience."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Language" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att698943c6a7
  a skos:Concept ;
  skos:prefLabel "Linked Resources"@en ;
  skos:description "Transparency in repository characterisation involves recommending publications for all FAIRsharing records and applying persistent identifiers and descriptive metadata to digital objects to support resource discovery. This includes providing discovery systems and making metadata available for harvesting, enabling linked resources to be reliably identified and accessed within their broader context."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Linked Resources" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7a3a7003b4
  a skos:Concept ;
  skos:prefLabel "Resource Identifier"@en ;
  skos:description "A Related Resource Identifier is an identifier assigned to a resource that is associated with or related to the primary resource in question. It serves to uniquely reference and distinguish the related resource within a given system or context."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Linked Resources|Resource Identifier" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2e2fa03db5
  a skos:Concept ;
  skos:prefLabel "Resource Type"@en ;
  skos:description "A classification of the relationship between a repository and an associated external resource. It specifies the nature of the connection using named relationship types, including those employed by the re3data registry."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Linked Resources|Resource Type" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.64FDE59BAD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0ab11676b0
  a skos:Concept ;
  skos:prefLabel "List of Catalogue(s)"@en ;
  skos:description "A web resource or API that lists available catalogues, their endpoints, and their identifiers.. A resource, such as an API or web endpoint, that lists available catalogues along with their identifiers, names, abbreviations, and contact details for the responsible organisation. It provides reference information and contextual background to support repository characterisation and related activities."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|List of Catalogue(s)" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1A4E593402 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4763130464
  a skos:Concept ;
  skos:prefLabel "List of Documents"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|List of Documents" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5E44673C02 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att78cc017229
  a skos:Concept ;
  skos:prefLabel "List of Endorsements"@en ;
  skos:description "A repository characterisation attribute capturing the organisation's list of formal endorsements, including endorsed principles, frameworks, and standards such as the TRUST principles, with links to applicable definitions. It also identifies the repository's publisher(s) and defines the purpose or mission of the organisation, establishing the scope and boundaries of its activities and responsibilities."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|List of Endorsements" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att41f4454a97
  a skos:Concept ;
  skos:prefLabel "Organisation"@en ;
  skos:description "The organisation responsible for hosting or managing a data repository, identified by its name, abbreviations, and contact details. This includes relevant identifiers and language indicators for all associated institutions, along with the organisational hierarchies and processes through which the entity's mission is managed and executed."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.70C4C7B218 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att22e9d90455
  a skos:Concept ;
  skos:prefLabel "Organisation Additional Name"@en ;
  skos:description "An alternative name or acronym used to identify a responsible institution. This designation supplements the primary name of the organisation, providing additional labelling options that may include shortened forms or widely recognised aliases."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Additional Name" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.70DECA9F26 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att44434ab8ba
  a skos:Concept ;
  skos:prefLabel "Organisation Country"@en ;
  skos:description "Organisation Country denotes the country in which a responsible institution is located. It identifies the geographic location of the organisation accountable for a given resource, process, or record."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Country" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6FB10117A8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6db955e068
  a skos:Concept ;
  skos:prefLabel "Organisation Identifier"@en ;
  skos:description "An Organisation Identifier is a structured data element that serves as a unique identifier for a responsible institution. It functions as a wrapper element, encapsulating the identifying information associated with the relevant organisation."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Identifier" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2ed61f28ac
  a skos:Concept ;
  skos:prefLabel "Organisation Identifier Type"@en ;
  skos:description "An Organisation Identifier Type denotes the category or scheme used to identify a responsible institution by its provider name. It classifies the type of identifier assigned to an organisation, enabling consistent referencing of the issuing or responsible body."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Identifier|Organisation Identifier Type" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.64FDE59BAD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att07bafd06a8
  a skos:Concept ;
  skos:prefLabel "Organisation Identifier URL"@en ;
  skos:description "An Organisation Identifier URL is a globally unique identifier in URL form that refers to a responsible institution. It serves as an unambiguous, web-resolvable reference to distinguish one organisation from another within a shared information context."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Identifier|Organisation Identifier URL" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att030c7caa30
  a skos:Concept ;
  skos:prefLabel "Organisation Name"@en ;
  skos:description "An Organisation Name is the official designation or title assigned to an institution. It serves as the primary label by which the institution is formally known and referenced."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Name" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.66003293B3 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att078274837c
  a skos:Concept ;
  skos:prefLabel "Organisation Responsibility End Date"@en ;
  skos:description "Organisation Responsibility End Date denotes the date on which an organisation's period of responsibility concludes. It marks the termination point of a defined accountability or duty held by the organisation."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Responsibility End Date" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4ef949b147
  a skos:Concept ;
  skos:prefLabel "Organisation Responsibility Start Date"@en ;
  skos:description "The date on which an organisation's period of responsibility begins. It marks the commencement of the timeframe during which the organisation holds accountability for a given role, function, or obligation."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Responsibility Start Date" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att027652cb34
  a skos:Concept ;
  skos:prefLabel "Organisation Type"@en ;
  skos:description "Organisation Type denotes the category or classification of a responsible institution. It is used to characterize the nature or role of an organization within a given context, distinguishing between different kinds of accountable or governing bodies."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Type" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.650BA75F4F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att393b1cea88
  a skos:Concept ;
  skos:prefLabel "Organisation URL"@en ;
  skos:description "The URL of the institution responsible for a given resource or activity. It provides a direct web reference to the authoritative organisation associated with the described entity."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation URL" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.66C6612EA5 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att10b6918167
  a skos:Concept ;
  skos:prefLabel "responsibilityType"@en ;
  skos:description "ResponsibilityType denotes the category or nature of responsibility assigned to a responsible institution. It classifies the specific role or obligation that an institution holds in relation to a given context or resource."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|responsibilityType" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4AA1880060 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att64da341b5f
  a skos:Concept ;
  skos:prefLabel "Repository Name"@en ;
  skos:description "The name by which a repository is formally identified and commonly known to its users. It serves as a key descriptive attribute within repository characterisation, providing context for understanding the repository's identity and transparency."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Repository Name" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att280fb56a40
  a skos:Concept ;
  skos:prefLabel "Repository Size"@en ;
  skos:description "Repository Size denotes the total count of items contained within a repository. It serves as a quantitative measure reflecting the volume or scale of a repository's holdings at a given point in time."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Repository Size" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5ABD0E52C7 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att11e21ff2fc
  a skos:Concept ;
  skos:prefLabel "Repository Status"@en ;
  skos:description "A typology characterising the life cycle status of a repository, indicating whether it is under development or in production and actively accepting data submissions. Production status does not preclude ongoing development, enhancement, or maintenance, as is common in mature systems."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Repository Status" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.697C57FE46 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6a715e3a22
  a skos:Concept ;
  skos:prefLabel "Repository Type"@en ;
  skos:description "Repository Type characterises whether a repository is discipline-specific or generalist, defining the purpose and mission of the organisation and the boundaries of activities for which it is responsible. Even where activities involve partners or outsourced services, the organisation retains ultimate responsibility for outcomes. This classification provides essential reference context for all other repository activities and functions."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Repository Type" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att08f1f3fab7
  a skos:Concept ;
  skos:prefLabel "Research Area"@en ;
  skos:description "A repository characterisation attribute capturing contextual information about the subject classification of resources (assets) held within it. These elements support the identification and discoverability of repository contents with transparency as a goal."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Research Area" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7470da5bba
  a skos:Concept ;
  skos:prefLabel "URL"@en ;
  skos:description "A repository attribute capturing identifying and contextual information, including the uniform resource locator (URL) serving as its primary web entry point, along with names, abbreviations, and contact details for the responsible organisation. This information provides reference context for understanding the repository's activities and functions."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|URL" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att48bf7e1522
  a skos:Concept ;
  skos:prefLabel "Year of Commencement"@en ;
  skos:description "The year in which a repository was established or first commenced operation. This attribute characterises the repository by recording its founding year, providing contextual information about the age and origins of the resource."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Repository Characterisation|Year of Commencement" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.176CC246A8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0b3d7477e7
  a skos:Concept ;
  skos:prefLabel "Source of Repository Attributes"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Source of Repository Attributes" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1A4E593402 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att236c15fea4
  a skos:Concept ;
  skos:prefLabel "FAIRiCAT URL"@en ;
  skos:description "A URL associated with the FAIRiCAT resource that serves as a source of repository attributes, enabling repository affordances to be discoverable by both humans and machines. This transparency-related property provides contextual information about the benefits and constraints of a repository within a FAIR-aligned framework."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Source of Repository Attributes|FAIRiCAT URL" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1593E1AE08 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3f76446066
  a skos:Concept ;
  skos:prefLabel "Registry URL"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Source of Repository Attributes|Registry URL" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.50DA0AA84E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4bfd6fb9b3
  a skos:Concept ;
  skos:prefLabel "Target User Community"@en ;
  skos:description "The target user community refers to the defined designated audience of a repository, situated within the broader context of the organisation's stated purpose, mission, and boundaries of responsibility. Even where activities involve partners or outsourced services, the organisation retains ultimate responsibility for outcomes. This definition provides essential reference context for all related repository activities and functions."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Target User Community" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3282bd1281
  a skos:Concept ;
  skos:prefLabel "Designated Community Definition"@en ;
  skos:description "A repository's designated community definition establishes the organization's purpose, the boundaries of its responsibilities, and the needs and expectations of its target user communities. It provides reference context for deposit, curation, and preservation activities, while recognizing that facilitating reuse requires ongoing engagement with users. Where partners or outsourced services are involved, the organization retains ultimate responsibility for all functions and outcomes."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Target User Community|Designated Community Definition" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4aee114a6b
  a skos:Concept ;
  skos:prefLabel "Equitable Engagement"@en ;
  skos:description "Transparency in equitable engagement refers to the practice of actively monitoring the Designated Community to identify and respond to its evolving needs and knowledge. This ongoing observation ensures that the repository remains responsive to its target user community within the appropriate context, balancing the benefits and constraints of transparent engagement."@en ;
  schema:category "Transparency|Benefits and Constraints|Context|Target User Community|Equitable Engagement" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att18d74ed687
  a skos:Concept ;
  skos:prefLabel "Legal and Regulatory"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Legal and Regulatory" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0D3C935A8A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0f78d12691
  a skos:Concept ;
  skos:prefLabel "Inventory of Considerations"@en ;
  skos:description "A structured inventory of legal and regulatory considerations related to transparency, encompassing the terms of use that govern both the repository itself and its data holdings. It identifies the benefits and constraints arising from these terms, supporting informed compliance and governance decisions."@en ;
  schema:category "Transparency|Benefits and Constraints|Legal and Regulatory|Inventory of Considerations" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.497C7ACE99 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7af3a65add
  a skos:Concept ;
  skos:prefLabel "Mission and Mandate"@en ;
  skos:description "A repository characteristic indicating that the scope of services and supported package crosswalks and conversions are clearly and transparently documented. At a minimum, repositories should ensure their mission statement and service scope are explicitly stated, enabling users to understand the value-added functions and crosswalk capabilities offered."@en ;
  schema:category "Transparency|Benefits and Constraints|Mission and Mandate" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att035accb10d
  a skos:Concept ;
  skos:prefLabel "Mission"@en ;
  skos:description "This attribute captures a brief description of the purpose of research infrastructures served through sustainability and infrastructure links. Trustworthy repositories assume explicit responsibility for the curation and active preservation of digital objects, ensuring materials are held in appropriate environments for defined periods and that continued access remains a clearly stated commitment to both depositors and users."@en ;
  schema:category "Transparency|Benefits and Constraints|Mission and Mandate|Mission" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.72CBE64ACC ;
  skos:inScheme trsp:ConceptScheme .

trsp:att516450bf5e
  a skos:Concept ;
  skos:prefLabel "Active Preservation"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Mission and Mandate|Mission|Active Preservation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att04b70a444f
  a skos:Concept ;
  skos:prefLabel "Approved public mission statement"@en ;
  skos:description "A formally approved public mission statement that defines an organization's purpose and the boundaries of activities for which it holds ultimate responsibility, including those involving partners or outsourced services. It provides essential reference information and context for all related activities and functions, incorporating names, abbreviations, and contact details."@en ;
  schema:category "Transparency|Benefits and Constraints|Mission and Mandate|Mission|Approved public mission statement" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7F7C2776AC ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1dad162d7a
  a skos:Concept ;
  skos:prefLabel "Continued Access"@en ;
  skos:description "A requirement that repositories maintain measures to address risks from changing circumstances, including shifts in mission or scope. It encompasses stable management of services over time (business continuity), response to service disruptions (disaster recovery), and preparation for transferring digital objects and services to another repository (succession planning)."@en ;
  schema:category "Transparency|Benefits and Constraints|Mission and Mandate|Mission|Continued Access" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.375960B05E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2f80b22a4d
  a skos:Concept ;
  skos:prefLabel "Level of Approval is Public"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Mission and Mandate|Mission|Level of Approval is Public" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att65a383c886
  a skos:Concept ;
  skos:prefLabel "Policy statement signed off by a governing board"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Mission and Mandate|Mission|Policy statement signed off by a governing board" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att43abb27ebe
  a skos:Concept ;
  skos:prefLabel "Single Focus"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Mission and Mandate|Single Focus" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6FB10117A8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0b807cc544
  a skos:Concept ;
  skos:prefLabel "Well-defined focus"@en ;
  skos:description "A principle whereby infrastructures established for a specific purpose should incorporate formal incentives that motivate the organisation and its staff to fulfil that mission and, where appropriate, wind down operations. Because technological or social change can simplify or render a purpose obsolete, clear incentive structures help ensure alignment with the original mandate rather than institutional self-perpetuation."@en ;
  schema:category "Transparency|Benefits and Constraints|Mission and Mandate|Single Focus|Well-defined focus" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.16855D3CB9 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att13132a45e7
  a skos:Concept ;
  skos:prefLabel "Policy"@en ;
  skos:description "Transparency in the context of benefits, constraints, and policy refers to the organisational hierarchies and processes by which an entity's mission is managed and executed. It encompasses the structures and mechanisms that govern how decisions are made and carried out within an organisation."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0FEE58FD17 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6105038322
  a skos:Concept ;
  skos:prefLabel "Appraisal/ Accession Policy"@en ;
  skos:description "The process of accepting custody of digital objects from depositors and transferring responsibility to the repository. It may include appraising offered or requested deposits against established criteria to determine suitability for acceptance, balancing transparency with the constraints of repository policy."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Appraisal/ Accession Policy" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7f6f3e3dde
  a skos:Concept ;
  skos:prefLabel "Ethics Clearance Verification Policy"@en ;
  skos:description "A policy governing the legal and ethical obligations that an organisation must recognize and adhere to in the context of appraisal and accession, specifically concerning ethics clearance verification. It ensures transparency by establishing clear constraints and benefits related to compliance with applicable legal and ethical requirements."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Appraisal/ Accession Policy|Ethics Clearance Verification Policy" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2b81c65ffb
  a skos:Concept ;
  skos:prefLabel "Sensitive Data Appraisal Policy"@en ;
  skos:description "A repository policy governing the appraisal and accession of sensitive data, addressing whether the repository publishes such a policy and whether supporting evidence of its existence is publicly available. It falls within the broader framework of transparency, benefits and constraints, and appraisal/accession policy."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Appraisal/ Accession Policy|Sensitive Data Appraisal Policy" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E5F32A9E8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2e979c3b25
  a skos:Concept ;
  skos:prefLabel "Data Policy"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Data Policy" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att768dafa0db
  a skos:Concept ;
  skos:prefLabel "Data Preservation Policy"@en ;
  skos:description "A repository's Data Preservation Policy governs long-term stewardship of digital objects by monitoring the technology landscape and user community for changes that may affect usability or comprehension. When necessary, preservation actions—such as format migration, metadata updates, or environment emulation—are taken to ensure continued accessibility and viability of digital content over time."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Data Policy|Data Preservation Policy" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7ec681717d
  a skos:Concept ;
  skos:prefLabel "Licence Policy"@en ;
  skos:description "A feature indicating that the URI of the applicable license policy is explicitly published and made accessible within the service offering. This supports transparency by enabling users to identify and reference the governing license terms directly. It falls within the scope of value-added crosswalk and conversion services."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Data Policy|Licence Policy" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2901b9e359
  a skos:Concept ;
  skos:prefLabel "PID Policy"@en ;
  skos:description "A repository policy governing the assignment and lifecycle management of globally unique Persistent Identifiers (PIDs) to deposited data objects, information packages, and metadata. The policy is published openly and aligned with global, regional, and national PID initiatives (e.g., EOSC PID Policy, National PID Strategies), supporting resource discovery through descriptive metadata and interoperable identifier schemes."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Data Policy|PID Policy" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3219437E8F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att549827c8b4
  a skos:Concept ;
  skos:prefLabel "Preferred Formats Policy"@en ;
  skos:description "A policy governing the preferred formats for data ingestion, under which the Trusted Digital Archive (TDA) performs operations on data objects prior to ingest to ensure compliance with its format requirements. This policy sits within the broader framework of data policy, balancing transparency with the operational constraints of format standardization."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Data Policy|Preferred Formats Policy" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1395fd0f03
  a skos:Concept ;
  skos:prefLabel "Versioning Policy"@en ;
  skos:description "A policy governing the assignment, reassignment, and deprecation of persistent identifiers, as well as the versioning of data and metadata. It defines how changes are managed and communicated to data depositors and users, ensuring transparency in the repository's approach to evolving records."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Data Policy|Versioning Policy" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2AF9C821F9 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0e2db53e0e
  a skos:Concept ;
  skos:prefLabel "Disclosure Risk"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Disclosure Risk" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2080C1D4EE ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4f40729393
  a skos:Concept ;
  skos:prefLabel "Appropriate Licences"@en ;
  skos:description "Transparency in data access encompasses the disclosure of restrictions applied to digital objects, including justification and responsible authority, alongside appropriate deposit, access agreements, and licences. It involves assigning persistent identifiers and descriptive metadata to support resource discovery, while determining suitable access methods—such as direct download or secure remote environments—based on object characteristics and rights management policies."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Disclosure Risk|Appropriate Licences" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6b7ced5897
  a skos:Concept ;
  skos:prefLabel "Assessment and Access Policy"@en ;
  skos:description "A repository practice in which policies are presented on a dedicated summary page and linked from metadata and/or landing pages. Each policy entry includes a title, a purpose or category (such as rights, compliance, PID, or access), and a link to the relevant web resource, enabling users to locate and understand the repository's governance frameworks."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Disclosure Risk|Assessment and Access Policy" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att45f7a22412
  a skos:Concept ;
  skos:prefLabel "Bibliographic Metadata - CC0"@en ;
  skos:description "A policy attribute confirming the application of a CC0 (public domain) licence to bibliographic and non-sensitive metadata. It addresses the balance between transparency benefits and disclosure risk constraints, enabling unrestricted public access and reuse of such metadata."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Disclosure Risk|Bibliographic Metadata - CC0" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6B61F7AF54 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2744ced24f
  a skos:Concept ;
  skos:prefLabel "Policy Management"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Policy Management" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1DB4B1E4F0 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att11b8a1b690
  a skos:Concept ;
  skos:prefLabel "Policies are versioned"@en ;
  skos:description "A characteristic of policy management indicating whether a repository maintains and displays a version history of its data policies, enabling traceability and clarity over changes. Older policy versions are archived and remain accessible to users, collaborators, and external parties such as funders and partner organisations."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Policy Management|Policies are versioned" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.697C57FE46 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att145bd6becd
  a skos:Concept ;
  skos:prefLabel "Policies linked or are easily found"@en ;
  skos:description "A repository's data policies—covering access, reuse, and preservation conditions—are published in a clearly accessible location on its website and linked from metadata and/or landing pages. Concise summary pages and URIs to restriction policies or legal guidance enable external partners, funders, and other stakeholders to readily locate and understand the applicable frameworks governing data use."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Policy Management|Policies linked or are easily found" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.00EDBED146 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6437b9e8e1
  a skos:Concept ;
  skos:prefLabel "Policy Development Process"@en ;
  skos:description "The policy development process encompasses the creation, maintenance, and revision of policies, standards, and other criteria that guide practice. It operates in alignment with governance structures and operational workflows, ensuring compliance with applicable legal and ethical frameworks. This process also includes the evaluation and incorporation of evolving standards into organizational policies."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Policy Management|Policy Development Process" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2847f75853
  a skos:Concept ;
  skos:prefLabel "Privacy Policy"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Privacy Policy" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3219437E8F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1042d04416
  a skos:Concept ;
  skos:prefLabel "Complies with relevant legislation"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Privacy Policy|Complies with relevant legislation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4AA1880060 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att39d810eec9
  a skos:Concept ;
  skos:prefLabel "Personal Data Removal Request Procedure exists"@en ;
  skos:description "A policy element indicating that a procedure exists for requesting the removal of personal data, with confirmation of such removal available upon completion. It encompasses both the benefits of enabling individuals to exercise data removal rights and the constraints governing how such requests are processed and confirmed."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Privacy Policy|Personal Data Removal Request Procedure exists" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.354E278D69 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att434f29edb9
  a skos:Concept ;
  skos:prefLabel "Right to be forgotten implemented"@en ;
  skos:description "A transparency criterion assessing whether a repository has implemented a right-to-be-forgotten procedure by publishing a formal personal data removal process. It evaluates both the existence of such a policy and the availability of supporting evidence demonstrating its implementation."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Privacy Policy|Right to be forgotten implemented" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6A8A5E1219 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3619ef1b84
  a skos:Concept ;
  skos:prefLabel "Rights Management"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Rights Management" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2E979C3B25 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att390feb7218
  a skos:Concept ;
  skos:prefLabel "Inventory of Managed Rights"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Rights Management|Inventory of Managed Rights" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.371D70B854 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6c9fcd9125
  a skos:Concept ;
  skos:prefLabel "Rights Policy"@en ;
  skos:description "A rights policy establishing principles and provisions for the protection of relevant stakeholder rights, governing the management of permissions, prohibitions, and obligations that determine how digital objects are accessed and used by individuals and organisations, both within and outside the repository."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Rights Management|Rights Policy" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1b94296bad
  a skos:Concept ;
  skos:prefLabel "Supported Formats"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Supported Formats" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5CF6AB3B6E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att50e0581b3d
  a skos:Concept ;
  skos:prefLabel "Archiving-Preservation"@en ;
  skos:description "A policy detailing how the preservation of data is ensured by the repository, including evidence of the sustainability of different file formats for long-term preservation. The policy provides guidance on the most appropriate formats for archiving and may be presented as a dedicated page or formal document."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Supported Formats|Archiving-Preservation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3e1ca96845
  a skos:Concept ;
  skos:prefLabel "Dissemination"@en ;
  skos:description "A policy dimension describing the file formats supported by a resource for dissemination purposes. The TDA generates derivative copies to meet the specific needs of its Designated Community, and a service ensures that files remain accessible using contemporary software."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Supported Formats|Dissemination" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.156B52FB19 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1bf23e39f5
  a skos:Concept ;
  skos:prefLabel "Submission/ Preferred Formats"@en ;
  skos:description "A repository policy that specifies which file formats are accepted or preferred for submission, organized into categories such as Preferred, Dissemination, and Preservation formats. The policy defines formatting requirements and identifies the types of machine-readable content stored, including software, analysis outputs, and raw data."@en ;
  schema:category "Transparency|Benefits and Constraints|Policy|Supported Formats|Submission/ Preferred Formats" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3E8808255F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att371d70b854
  a skos:Concept ;
  skos:prefLabel "Certification and Assessment"@en ;
  skos:description "A requirement whereby PID Authorities and Services commit to undergoing certification assessments at mutually agreed intervals to verify compliance with established policies. This ensures ongoing accountability and transparency in the governance of persistent identifier infrastructure."@en ;
  schema:category "Transparency|Certification and Assessment" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2744CED24F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att27c898e8a0
  a skos:Concept ;
  skos:prefLabel "List of Certifications"@en ;
  skos:description "A record of formal certifications obtained by a repository, such as CoreTrustSeal, demonstrating compliance with recognized standards and best professional practices. Certifications are typically awarded through third-party audits or community endorsement processes and serve as evidence of a repository's trustworthiness, fitness, and adherence to established quality benchmarks."@en ;
  schema:category "Transparency|Certification and Assessment|List of Certifications" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1DB4B1E4F0 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6e27def3a1
  a skos:Concept ;
  skos:prefLabel "List of Self-Assessments"@en ;
  skos:description "Self-assessment processes used to evaluate compliance with standards, policies, and procedures. It also supports the identification of actions for continuous and targeted improvement, including implementation of encoded EOSC PID Policy for Managers."@en ;
  schema:category "Transparency|Certification and Assessment|List of Self-Assessments" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1224e087e0
  a skos:Concept ;
  skos:prefLabel "List of Third-Party Assessments"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Certification and Assessment|List of Third-Party Assessments" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4D039CA977 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att613f28af34
  a skos:Concept ;
  skos:prefLabel "Scope of Services"@en ;
  skos:description "The range of functions and services offered by a repository to depositors and users, which must be openly available to all researchers in the EU. In accordance with EOSC PID Policy C20, accessibility across the European research community is a mandatory requirement for compliant services."@en ;
  schema:category "Transparency|Scope of Services" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3788bfb26a
  a skos:Concept ;
  skos:prefLabel "API Services"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|API Services" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1B94296BAD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att62bd42cf21
  a skos:Concept ;
  skos:prefLabel "API Conforms To"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|API Services|API Conforms To" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att64d59a05cf
  a skos:Concept ;
  skos:prefLabel "API Documentation"@en ;
  skos:description "API Documentation refers to a resource, typically a website, that describes the availability and usage details of an application programming interface (API). It provides essential information for developers seeking to understand and integrate the API into their applications."@en ;
  schema:category "Transparency|Scope of Services|API Services|API Documentation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0925ff0c65
  a skos:Concept ;
  skos:prefLabel "API Endpoint"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|API Services|API Endpoint" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7e16b0a695
  a skos:Concept ;
  skos:prefLabel "API Format Support"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|API Services|API Format Support" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att06e31a70a5
  a skos:Concept ;
  skos:prefLabel "API IRI"@en ;
  skos:description "An API IRI is the URL identifying the endpoint of an application programming interface (API) used for machine processing of data or metadata. It provides a standardized address through which automated systems can access and interact with the associated data resources."@en ;
  schema:category "Transparency|Scope of Services|API Services|API IRI" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.219A2950AE ;
  skos:inScheme trsp:ConceptScheme .

trsp:att37c06f15e8
  a skos:Concept ;
  skos:prefLabel "API Name"@en ;
  skos:description "An API Service Name is the designated identifier used to refer to a specific application programming interface (API). It serves as the human-readable label that distinguishes one API from another within a system or catalog."@en ;
  schema:category "Transparency|Scope of Services|API Services|API Name" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1B94296BAD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3b4d9d3642
  a skos:Concept ;
  skos:prefLabel "API Type"@en ;
  skos:description "API Type denotes the classification or category assigned to an application programming interface (API). It characterizes the nature, architectural style, or protocol of the API, enabling consistent identification and organization of APIs within a system or vocabulary."@en ;
  schema:category "Transparency|Scope of Services|API Services|API Type" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.540F680A1E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4dedf80ad3
  a skos:Concept ;
  skos:prefLabel "List of API Services"@en ;
  skos:description "A structured listing of the application programming interfaces (APIs) supported by a given repository. This element serves as a wrapper container that enumerates the available API services associated with the repository."@en ;
  schema:category "Transparency|Scope of Services|API Services|List of API Services" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att66c6612ea5
  a skos:Concept ;
  skos:prefLabel "Curation"@en ;
  skos:description "Curatorial services performed by repository functionality or personnel that enhance or add value to datasets and create purposeful collections of data. This encompasses the transparent scope of activities through which data is selected, organized, and maintained to improve discoverability and usability."@en ;
  schema:category "Transparency|Scope of Services|Curation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0563752c9f
  a skos:Concept ;
  skos:prefLabel "List of Curation Support Services"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Curation|List of Curation Support Services" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1095E8CF4A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att53947860b6
  a skos:Concept ;
  skos:prefLabel "Provenance Approach Documented"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Curation|Provenance Approach Documented" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7feea35bff
  a skos:Concept ;
  skos:prefLabel "Versioning Process Documented"@en ;
  skos:description "A capability whereby the TDA creates successive versions of Information Objects, either autonomously or at producer initiative, with data deposits linked to persistent identifiers and versioned consistently. This supports transparent, traceable management of content across package crosswalks and conversions."@en ;
  schema:category "Transparency|Scope of Services|Curation|Versioning Process Documented" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3754546590
  a skos:Concept ;
  skos:prefLabel "Deposit/ Appraisal/ Ingest"@en ;
  skos:description "A repository practice in which data and metadata are accepted according to defined criteria to ensure relevance and understandability for users. This encompasses the stages of the research data lifecycle prior to ingest, including collaboration with data and metadata creators to improve quality and highlight the benefits of curation, preservation, and reuse."@en ;
  schema:category "Transparency|Scope of Services|Deposit/ Appraisal/ Ingest" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2847F75853 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4dcdbad9b4
  a skos:Concept ;
  skos:prefLabel "Semantic Enhancement"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Deposit/ Appraisal/ Ingest|Semantic Enhancement" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att67d4ecb749
  a skos:Concept ;
  skos:prefLabel "Named Entity Recognition Service"@en ;
  skos:description "A service supporting manual or assisted semantic enrichment of content through named entity recognition, operating within the deposit, appraisal, and ingest stage of the scope of services. It contributes to transparency by enabling the identification and tagging of named entities to enhance the semantic quality of ingested materials."@en ;
  schema:category "Transparency|Scope of Services|Deposit/ Appraisal/ Ingest|Semantic Enhancement|Named Entity Recognition Service" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att34e5521dd7
  a skos:Concept ;
  skos:prefLabel "Discovery"@en ;
  skos:description "A repository practice encompassing the provision of or contribution to community catalogues to facilitate data discovery, enabling users to locate digital objects and cite them persistently. This includes ensuring digital objects meet defined quality and standards compliance thresholds before being made available for reuse."@en ;
  schema:category "Transparency|Scope of Services|Discovery" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.035ACCB10D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att354e278d69
  a skos:Concept ;
  skos:prefLabel "Proper Citation"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Discovery|Proper Citation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6105038322 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0485c82a49
  a skos:Concept ;
  skos:prefLabel "Citation Export and Formatting Support"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Discovery|Proper Citation|Citation Export and Formatting Support" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7F7C2776AC ;
  skos:inScheme trsp:ConceptScheme .

trsp:att540f680a1e
  a skos:Concept ;
  skos:prefLabel "Service APIs"@en ;
  skos:description "Community-defined standards implemented by a repository to represent data and/or metadata in a consistent, machine-readable form through models, formats, schemas, vocabularies, or ontologies. These standards facilitate the discovery and interpretation of data and metadata via service APIs."@en ;
  schema:category "Transparency|Scope of Services|Discovery|Service APIs" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att601eaf4625
  a skos:Concept ;
  skos:prefLabel "Depositor Contact Information Available"@en ;
  skos:description "A repository capability indicating whether contact information for the data's depositor, producer, or owner—such as an individual (ideally identified by ORCID) or organization—is retained and publicly displayed. This supports transparency by enabling discovery of responsible parties associated with a dataset."@en ;
  schema:category "Transparency|Scope of Services|Discovery|Service APIs|Depositor Contact Information Available" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att31600cb8d6
  a skos:Concept ;
  skos:prefLabel "File-Level Metadata API"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Discovery|Service APIs|File-Level Metadata API" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0cef99a2d6
  a skos:Concept ;
  skos:prefLabel "Frequency of Indexing"@en ;
  skos:description "Frequency of Indexing refers to how often a service's index is updated within the scope of its discovery and service API operations. It reflects the rate at which new or changed information is incorporated into the index, directly affecting the currency and accuracy of discoverable content."@en ;
  schema:category "Transparency|Scope of Services|Discovery|Service APIs|Frequency of Indexing" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.608015D600 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att283d0eb595
  a skos:Concept ;
  skos:prefLabel "Indexing Specification or Standard"@en ;
  skos:description "A specification or standard that defines the structure and format of indexed data made available through discovery service APIs. It publishes the levels of data exposed to harvesters, ensuring transparency in the scope of services provided."@en ;
  schema:category "Transparency|Scope of Services|Discovery|Service APIs|Indexing Specification or Standard" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5ABD0E52C7 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att374f095e69
  a skos:Concept ;
  skos:prefLabel "Level of Indexing Granularity"@en ;
  skos:description "Level of Indexing Granularity refers to the distinct metadata levels—such as dataset, file, or service level—supported by a discovery service API for indexing and querying. It defines which granularity tiers are available per source and specifies the queryable fields associated with each level, enabling users to understand the scope and precision of discoverable metadata."@en ;
  schema:category "Transparency|Scope of Services|Discovery|Service APIs|Level of Indexing Granularity" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2847F75853 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att754bcac5a8
  a skos:Concept ;
  skos:prefLabel "Object-Level Metadata API"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Reuse|Rich Metadata|Object-Level Metadata API" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att18ce7d92fa
  a skos:Concept ;
  skos:prefLabel "Standard Discovery API Supported"@en ;
  skos:description "A standard discovery API that supports resource discovery through persistent identifiers and descriptive metadata applied to digital objects. The API is documented and accessible via a defined URL, employing a specified query language to enable metadata harvesting and retrieval from discovery systems."@en ;
  schema:category "Transparency|Scope of Services|Discovery|Service APIs|Standard Discovery API Supported" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2922ED695E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1669af8869
  a skos:Concept ;
  skos:prefLabel "Supported Metadata Export Schema"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Discovery|Service APIs|Supported Metadata Export Schema" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5A6C15E767 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att08dace15b1
  a skos:Concept ;
  skos:prefLabel "Interoperability"@en ;
  skos:description "The organizational processes for creating, managing, approving, releasing, updating, and withdrawing information artefacts—such as publications, policies, and guidelines—related to repository activities and functions. This encompasses publishing information that supports external assessments and external engagement, but excludes deposited digital objects."@en ;
  schema:category "Transparency|Scope of Services|Interoperability" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att696b580e35
  a skos:Concept ;
  skos:prefLabel "Interoperability Management"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Interoperability|Interoperability Management" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att360e4f3f7f
  a skos:Concept ;
  skos:prefLabel "Interoperability Policy and Planning"@en ;
  skos:description "A policy framework that defines the considerations, drivers, and standards informing interoperability, encompassing the protocols and processes by which people, processes, technologies, and digital objects effectively interact within and across organisational entities. It covers the policy itself and associated implementation planning to guide consistent interoperability management."@en ;
  schema:category "Transparency|Scope of Services|Interoperability|Interoperability Management|Interoperability Policy and Planning" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2E979C3B25 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0c3db9bfaa
  a skos:Concept ;
  skos:prefLabel "Interoperability Procedures"@en ;
  skos:description "Documented protocols and processes that govern how people, processes, technologies, and digital objects effectively interact within and across organisational entities. These procedures ensure that interoperability policies and planning are consistently implemented, facilitating seamless exchange and cooperation both internally and externally."@en ;
  schema:category "Transparency|Scope of Services|Interoperability|Interoperability Management|Interoperability Procedures" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.16855D3CB9 ;
  skos:inScheme trsp:ConceptScheme .

