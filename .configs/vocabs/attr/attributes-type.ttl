  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistMetrics ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4A2CF0AF0A
  a skos:Concept ;
  skos:prefLabel "Considerations"@en ;
  schema:category Responsibility|Typical Value-added Services|Standard APIs|Considerations ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.74FDFB3E00 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
