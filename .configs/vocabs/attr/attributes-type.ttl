trsp:att.693F62F485
  a skos:Concept ;
  skos:prefLabel "Availability Monitoring"@en ;
  schema:category Technology|Services|External/ Micro-Services|Dependencies|Availability Monitoring ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.32048A7179
  a skos:Concept ;
  skos:prefLabel "Verified and Documented"@en ;
  schema:category Technology|Services|External/ Micro-Services|Dependencies|Verified and Documented ;
  skos:definition A classification denoting that external or micro-service dependencies within a technology or service context have been verified and formally documented by designated curators. This status confirms that dependency relationships are reviewed and recorded, ensuring transparency and accountability in the management of service interdependencies. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_1 ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
