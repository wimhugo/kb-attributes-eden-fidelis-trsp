  skos:inScheme trsp:ConceptScheme .

trsp:att386291b08e
  a skos:Concept ;
  skos:prefLabel "Software Quality Status"@en ;
  skos:description "Software Quality Status refers to the certification state of a software artifact or system. It indicates the current level or outcome of quality assessment and certification processes applied to the software."@en ;
  schema:category "Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality Status" ;
