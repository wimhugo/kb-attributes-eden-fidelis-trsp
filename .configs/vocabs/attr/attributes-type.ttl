trsp:att.1DB4B1E4F0
  a skos:Concept ;
  skos:prefLabel "Ownership"@en ;
  schema:category Technology|Services|External/ Micro-Services|Ownership ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.04F0DB0243 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4813ACF624
  a skos:Concept ;
  skos:prefLabel "Changes are Tracked"@en ;
  schema:category Technology|Services|External/ Micro-Services|Ownership|Changes are Tracked ;
  skos:definition A property of external and micro-services whereby changes in service ownership are systematically tracked and versioned over time. This ensures a maintained historical record of ownership transitions, supporting accountability and auditability across the service lifecycle. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2687A2F0B8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.08417EDDFC
  a skos:Concept ;
  skos:prefLabel "Contact Point is Maintained"@en ;
  schema:category Technology|Services|External/ Micro-Services|Ownership|Contact Point is Maintained ;
  skos:definition A condition in which the owning organization or contact point for an external or micro-service is persistently identified and maintained. This includes recording names, abbreviations, and contact details to provide reference context, and encompasses the identification and management of third-party organizations, hosts, partners, and other actors essential to service operations and data delivery. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.12C140C8CD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.19AF20660A
  a skos:Concept ;
  skos:prefLabel "Documented and Published"@en ;
  schema:category Technology|Services|External/ Micro-Services|Ownership|Documented and Published ;
  skos:definition A classification for external or micro-services in which ownership is clearly documented and published. This designation indicates that the responsible party for a given service is explicitly recorded and made available, ensuring transparency and accountability within the service ecosystem. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0D3C935A8A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2DA1C98050
  a skos:Concept ;
  skos:prefLabel "Service Metdata Available"@en ;
  schema:category Technology|Services|External/ Micro-Services|Ownership|Service Metdata Available ;
  skos:definition A service characteristic in which ownership metadata is made available and exposed through service catalogues or registries. This enables consumers and administrators to identify and access authoritative information about service ownership via external or micro-service interfaces. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


