trsp:att6fb4481988
  a skos:Concept ;
  skos:prefLabel "Service Quality and Security"@en ;
  skos:description "A trust, certification, and service quality and security concept encompassing the organisational measures required to ensure business continuity. It covers non-technical processes related to operations, digital object management, and security, as well as recovery planning for service interruptions and disasters. Continuity also includes succession planning to address the potential end of a service."@en ;
  schema:category "Trust|Certification|Service Quality and Security" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

