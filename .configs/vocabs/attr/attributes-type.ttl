trsp:att398417702d
  a skos:Concept ;
  skos:prefLabel "Rich Metadata is Available"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Discovery|Understand|Rich Metadata is Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4DCDBAD9B4 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att56b57bdcc5
  a skos:Concept ;
  skos:prefLabel "Guidance"@en ;
  skos:description "The provision of information about digital objects that documents their history (provenance) and verifies their authenticity. Such information may be captured at the point of deposit, generated through curation and preservation processes, and shared with data or metadata users."@en ;
  schema:category "User Focus|Guidance" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att394d659c0c
  a skos:Concept ;
  skos:prefLabel "API Documentation"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|API Documentation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.66C6612EA5 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att207398d3a8
  a skos:Concept ;
  skos:prefLabel "Human-readable API documentation available"@en ;
  skos:description "A repository characteristic indicating whether human-readable documentation, such as manuals or guides, is available for its services, protocols, and APIs. This includes specifying result formats and determining appropriate access methods—such as direct download or secure remote environments—based on the nature of the digital objects, user characteristics, and rights management policies."@en ;
  schema:category "User Focus|Guidance|API Documentation|Human-readable API documentation available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6FB10117A8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1f40bc420b
  a skos:Concept ;
  skos:prefLabel "Machine-readable API documentation available"@en ;
  skos:description "A characteristic indicating whether a repository provides machine-readable API documentation, including manuals or technical references for the services and protocols it uses. Such documentation enables programmatic access and integration by guiding developers through available interfaces and usage conventions."@en ;
  schema:category "User Focus|Guidance|API Documentation|Machine-readable API documentation available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.04F0DB0243 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att06d09133ae
  a skos:Concept ;
  skos:prefLabel "General Depositor Guidance"@en ;
  skos:description "The stages of the research data lifecycle that occur before data enters a repository. Engaging with data or metadata creators and owners during this phase can improve quality and highlight the benefits of curation, preservation, and reuse."@en ;
  schema:category "User Focus|Guidance|General Depositor Guidance" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7AD9748A7D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att27198d2c3b
  a skos:Concept ;
  skos:prefLabel "Guidance on Repository Selection"@en ;
  skos:description "A guidance service designed to assist depositors in identifying and selecting the most appropriate repository for their materials. It provides targeted support to help users navigate available repository options and make informed deposit decisions."@en ;
  schema:category "User Focus|Guidance|General Depositor Guidance|Guidance on Repository Selection" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3720038519 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7c41966ab5
  a skos:Concept ;
  skos:prefLabel "Guidance on Data and Metadata Preparation"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2687a2f0b8
  a skos:Concept ;
  skos:prefLabel "FAIR Aggregation"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Aggregation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1AE2618C36 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4673784806
  a skos:Concept ;
  skos:prefLabel "Per Collection"@en ;
  skos:description "A guidance principle in FAIR data aggregation whereby a curator or system assigns and publishes FAIR scores at the per-collection level during the deposit process. These scores are included as part of the deposit metadata and made available across different levels of aggregation, supporting transparency and assessment of data and metadata quality."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Aggregation|Per Collection" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5F06EEC902 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att16ab115add
  a skos:Concept ;
  skos:prefLabel "Per Institution"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Aggregation|Per Institution" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.24650A32BA ;
  skos:inScheme trsp:ConceptScheme .

trsp:att74778c177c
  a skos:Concept ;
  skos:prefLabel "Per Repository/ Catalogue"@en ;
  skos:description "Publication of FAIR scores aggregated to repository or catalogue level."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Aggregation|Per Repository/ Catalogue" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att176cc246a8
  a skos:Concept ;
  skos:prefLabel "FAIR Assessment"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Assessment" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3319EEDC99 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3c89a4df3f
  a skos:Concept ;
  skos:prefLabel "Per Object"@en ;
  skos:description "A FAIR assessment approach in which a curator or system generates and includes a FAIR score for each individual deposited object. These scores are published at multiple levels, supporting granular evaluation of how well data and metadata meet Findability, Accessibility, Interoperability, and Reusability principles."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Assessment|Per Object" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.15DBB60AC2 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3f6736bf1c
  a skos:Concept ;
  skos:prefLabel "Format guidance and conversion"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Format guidance and conversion" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0674156B7E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att435f7d1b94
  a skos:Concept ;
  skos:prefLabel "Format Guidance API"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Format guidance and conversion|Format Guidance API" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6FB10117A8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att57d4bd2121
  a skos:Concept ;
  skos:prefLabel "Format guidance documentation"@en ;
  skos:description "A URI or reference to documentation specifying the file format and vocabulary used in a given context. This documentation supports workflows for planning and evaluating possible file format conversion paths and processes."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Format guidance and conversion|Format guidance documentation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att45e4291e97
  a skos:Concept ;
  skos:prefLabel "Format Guidance Granularity"@en ;
  skos:description "The level of specificity at which guidance is provided for each file format, encompassing details such as file format versions and applicable profiles. This granularity indication helps users understand the precise scope and applicability of format-related recommendations during data and metadata preparation."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Format guidance and conversion|Format Guidance Granularity" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6B61F7AF54 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att48b32fb000
  a skos:Concept ;
  skos:prefLabel "Integrations (DMP, RO-Crate, ...)"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Integrations (DMP, RO-Crate, ...)" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.2687A2F0B8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5e50766d16
  a skos:Concept ;
  skos:prefLabel "Link to DMP"@en ;
  skos:description "A concept indicating that a machine-actionable Data Management Plan (maDMP) is available and linked within the research workflow. It addresses the pre-repository stages of the research data lifecycle, supporting data and metadata creators in improving quality and understanding the benefits of curation, preservation, and reuse through integration with standards such as RO-Crate."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Integrations (DMP, RO-Crate, ...)|Link to DMP" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1aaa70fb51
  a skos:Concept ;
  skos:prefLabel "Link to RO-Crate"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Integrations (DMP, RO-Crate, ...)|Link to RO-Crate" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.28A2220E45 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7c3a4c601f
  a skos:Concept ;
  skos:prefLabel "Licence guidance and selection"@en ;
  skos:description "A repository feature that provides user guidance for selecting the most appropriate and combinable licenses. This support helps users navigate license compatibility and make informed decisions when combining multiple licenses within a package or service context."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Licence guidance and selection" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5b6f52b2cf
  a skos:Concept ;
  skos:prefLabel "Licence Selection Guidance"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Licence guidance and selection|Licence Selection Guidance" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att74fdfb3e00
  a skos:Concept ;
  skos:prefLabel "Metadata Schema"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Metadata Schema" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7f192dc5ff
  a skos:Concept ;
  skos:prefLabel "Community Metadata Schema Recommendations"@en ;
  skos:description "A service capability that enforces the use of community-agreed metadata standards during the deposit process. It supports package crosswalks and conversions, enabling interoperability across different metadata formats as a value-added feature within the scope of transparent repository services."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Metadata Schema|Community Metadata Schema Recommendations" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att353453c585
  a skos:Concept ;
  skos:prefLabel "Documentation on Profiles"@en ;
  skos:description "Documentation describing which metadata values are associated with URI-based identifiers within a metadata schema profile. This guidance supports users in correctly preparing and interpreting metadata by clarifying the relationship between metadata elements and their corresponding URI-based identifier values."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Metadata Schema|Documentation on Profiles" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.43ABB27EBE ;
  skos:inScheme trsp:ConceptScheme .

trsp:att568d8c8984
  a skos:Concept ;
  skos:prefLabel "Profiles are Extensible"@en ;
  skos:description "A characteristic of metadata schema profiles whereby the profile structure can be extended beyond its base specification. This extensibility allows users to add or adapt elements to meet specific requirements without altering the core profile definition."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Metadata Schema|Profiles are Extensible" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5bdcfb83b0
  a skos:Concept ;
  skos:prefLabel "Profiles are Registered"@en ;
  skos:description "A stage in metadata schema guidance whereby a system formally submits and registers its metadata profile to a recognized community registry. This process makes the profile discoverable and accessible to other systems and stakeholders within the community, supporting interoperability and reuse."@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Metadata Schema|Profiles are Registered" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att14eec67ec3
  a skos:Concept ;
  skos:prefLabel "Supported FAIR Implementation Profiles"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Guidance|Guidance on Data and Metadata Preparation|Metadata Schema|Supported FAIR Implementation Profiles" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4A2CF0AF0A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4721cbc19a
  a skos:Concept ;
  skos:prefLabel "Object Maintenance"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Object Maintenance" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.5E44673C02 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att69bc0467d4
  a skos:Concept ;
  skos:prefLabel "Update Functionality"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Object Maintenance|Update Functionality" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3e9295c9a1
  a skos:Concept ;
  skos:prefLabel "User Support Mechanisms"@en ;
  skos:description "A repository feature encompassing mechanisms that assist data depositors and users during or after the submission process. This includes dedicated contact points such as helpdesk email addresses or contact forms through which users can seek guidance or resolve issues related to data deposit and access."@en ;
  schema:category "User Focus|User Support Mechanisms" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.110C424081 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att434b4a0632
  a skos:Concept ;
  skos:prefLabel "Helpdesk Available"@en ;
  skos:description "A helpdesk mechanism that provides users with a dedicated point of contact for reporting ethical misconduct. It serves as a structured support channel enabling individuals to raise concerns about unethical behavior within an organization or system."@en ;
  schema:category "User Focus|User Support Mechanisms|Helpdesk Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6A8A5E1219 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att24c6e69fbf
  a skos:Concept ;
  skos:prefLabel "SLA is Available"@en ;
  skos:description "A service-level agreement (SLA) is available that defines community-aligned commitments for key service attributes, including uptime, availability expectations, and ticket response and resolution times. Where applicable, these commitments are differentiated between free and paid service tiers and reflect community best practices."@en ;
  schema:category "User Focus|User Support Mechanisms|SLA is Available" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6A837D5A94 ;
  skos:inScheme trsp:ConceptScheme .
