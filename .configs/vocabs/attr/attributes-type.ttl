trsp:att6d12041533
  a skos:Concept ;
  skos:prefLabel "Research and Development"@en ;
  skos:description "Package crosswalks supported refers to the capacity to map and convert metadata across different packaging formats or schemas, enabling interoperability between systems. Sustainable provision of this service requires generating financial surplus beyond basic operating costs, allowing organizations to adapt to economic, social, and technological change rather than merely recovering immediate expenses."@en ;
  schema:category "Income and Expenditure|Capital Costs|Research and Development" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att52fdc90aa3
  a skos:Concept ;
  skos:prefLabel "Surplus/ Grants"@en ;
  skos:description "A record of projects, grants, and related activities that contribute to research and development, encompassing initiatives outside current operations, routine maintenance, and standard upgrades. These may include new approaches to data, metadata, business processes, technology, security, and research infrastructure, along with their associated capital costs and surplus or grant funding."@en ;
  schema:category "Income and Expenditure|Capital Costs|Research and Development|Surplus/ Grants" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

