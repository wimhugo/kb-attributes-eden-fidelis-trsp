trsp:att4c80663041
  a skos:Concept ;
  skos:prefLabel "Contingency Provision/ Reserves"@en ;
  skos:description "A financial reserve established to sustain operations for up to 12 months in the event of an orderly wind-down. Classified under operating costs, this contingency fund is maintained separately from reserves covering operational risk or development investment, and represents a high-priority allocation within an organization's expenditure planning."@en ;
  schema:category "Income and Expenditure|Operating Costs|Other|Contingency Provision/ Reserves" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

