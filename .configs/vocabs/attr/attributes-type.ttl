  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeChecklistEvidence ;
  trsp:hasBenchmark trsp:checklistQualityAssurance ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.5247A27418
  a skos:Concept ;
  skos:prefLabel "Confirmation of Open Source Stack"@en ;
  schema:category Technology|Open Source|Confirmation of Open Source Stack ;
  skos:definition A confirmation that the repository's technology stack is built on well-supported, open-source operating systems and core infrastructural software and hardware. These components are appropriate to the services provided to the repository's Designated Community, ensuring reliability and sustainability of the underlying infrastructure. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


