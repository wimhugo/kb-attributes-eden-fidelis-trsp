trsp:att.65A95F223F
  a skos:Concept ;
  skos:prefLabel "Responsibility"@en ;
  schema:category Responsibility ;
  skos:definition Responsibility denotes the obligation of data stewards and repository holders to account for how dataâparticularly Indigenous dataâare managed, used, and shared. It requires meaningful, openly available evidence that data practices support self-determination and collective benefit for affected communities, while ensuring trustworthy stewardship of data holdings and transparent service to user communities. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4A4B5A22FE
  a skos:Concept ;
