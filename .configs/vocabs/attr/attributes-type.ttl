  a skos:Concept ;
  skos:prefLabel "Bind to Application/ Semantic Mapping"@en ;
  skos:description "A capability that enables the rendering of digital objects through the application of emulation and other specialist tools, supporting the integration of multiple tools across different file formats to facilitate application-level access and semantic mapping."@en ;
  schema:category "User Focus|Application and Reuse|Bind to Application/ Semantic Mapping" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att04c904a984
  a skos:Concept ;
  skos:prefLabel "Download or stream"@en ;
  skos:description "A capability enabling users to download or stream digital objects for application and reuse purposes. The TDA facilitates the rendering of objects through the application of emulation and/or other specialist tools, supporting direct access and use of preserved digital content."@en ;
  schema:category "User Focus|Application and Reuse|Download or stream" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.7F7C2776AC ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0f56d6b0c4
  a skos:Concept ;
  skos:prefLabel "Include into VRE or workflow"@en ;
  skos:description "A user-focused capability that enables the rendering within or dissemination of digital objects to a Virtual Research Environment (VRE) or workflow. It supports the inclusion, application, and reuse of objects by providing appropriate technical means for their display and interaction. It supports application and reuse by making objects accessible and functional within designated research or processing environments."@en ;
  schema:category "User Focus|Application and Reuse|Include into VRE or workflow" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.497C7ACE99 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2f6f8568a8
  a skos:Concept ;
  skos:prefLabel "Subset"@en ;
  skos:description "A capability that allows users to filter large datasets and retrieve only a specified subset of the resulting data. The system also enables the rendering of objects through the application of emulation and other specialist tools, supporting targeted access and reuse of content."@en ;
  schema:category "User Focus|Application and Reuse|Subset" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6fb10117a8
  a skos:Concept ;
  skos:prefLabel "Community Engagement"@en ;
  skos:description "A capability indicating whether the repository supports crosswalks and conversions between metadata packages as part of its value-added services. The TDA monitors its Designated Community to identify evolving needs and knowledge, ensuring transparency in the scope of services offered, including which package crosswalks are supported."@en ;
  schema:category "User Focus|Community Engagement" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att319bc310d5
  a skos:Concept ;
  skos:prefLabel "Roadmaps"@en ;
  skos:description "A structured approach encompassing technology statements, planning processes, and implementation roadmaps that centers on user focus and community engagement. It provides directional guidance for technology adoption and development by aligning organizational planning with community needs and priorities."@en ;
  schema:category "User Focus|Community Engagement|Roadmaps" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.761C0FB70D ;
  skos:inScheme trsp:ConceptScheme .

trsp:att368f99a5f7
  a skos:Concept ;
  skos:prefLabel "Stakeholder Involvement"@en ;
  skos:description "The organisational practice of interacting with external parties, including individuals, partner organisations, funders, and other relevant bodies. This encompasses user focus, community engagement, and stakeholder involvement to foster meaningful participation and collaboration beyond the organisation's internal boundaries."@en ;
  schema:category "User Focus|Community Engagement|Stakeholder Involvement" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0E2DB53E0E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att675434df2b
  a skos:Concept ;
  skos:prefLabel "Training Offered"@en ;
  skos:description "Formal training provided to depositors, end users, stewards, internal staff, and other stakeholder groups to support effective use of repository services and to improve research data management practices."@en ;
  schema:category "User Focus|Community Engagement|Training Offered" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0062b8b2c5
  a skos:Concept ;
  skos:prefLabel "User surveys"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Community Engagement|User surveys" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.650BA75F4F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6e790e641f
  a skos:Concept ;
  skos:prefLabel "Context"@en ;
  skos:description "Indicates whether the owner or maintainer of a repository has claimed and vetted its corresponding FAIRsharing record. While FAIRsharing records are curated by an in-house team, direct participation of the responsible contact helps verify descriptions and track the evolution of the resource over time."@en ;
  schema:category "User Focus|Context" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4b81fe7163
  a skos:Concept ;
  skos:prefLabel "Indexed in Scientific Knowledge Graphs"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Context|Indexed in Scientific Knowledge Graphs" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0893119b50
  a skos:Concept ;
  skos:prefLabel "Supports LOD References"@en ;
  skos:description "A repository feature that supports the linking of datasets to related articles or pre-prints through Linked Open Data (LOD) references. It indicates whether the repository enables users to establish such links at the point of submission or at a later, post-submission stage."@en ;
  schema:category "User Focus|Context|Supports LOD References" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att234960b12d
  a skos:Concept ;
  skos:prefLabel "Discovery"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Discovery" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.6FB4481988 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6a47f71f59
  a skos:Concept ;
  skos:prefLabel "Explore"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Discovery|Explore" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3458fe4af7
  a skos:Concept ;
  skos:prefLabel "Linked Visualisation and Analysis Tools"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Discovery|Explore|Linked Visualisation and Analysis Tools" ;
