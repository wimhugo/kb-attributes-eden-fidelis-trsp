trsp:att.4CB9ED25FE
  a skos:Concept ;
  trsp:property "sustainability" ;
  skos:prefLabel "Sustainability" ;
  skos:definition "Sustainability refers to a trustworthy repository's capacity to ensure uninterrupted, long-term access to its data holdings for current and future user communities. It encompasses the repository's ability to maintain and evolve its services over time, typically documented through a formal sustainability plan or dedicated webpage outlining strategies to meet changing user requirements."@en ;
  dct:subject "Sustainability" ;
  schema:category "Sustainability" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.0849A7F1E2
  a skos:Concept ;
  trsp:property "socialSustainability" ;
  skos:prefLabel "Social Sustainability" ;
  skos:definition "Aspects such as open governance, community involvement and engagement, planning and continuity arrangements, forum and working group participation and creation. Frequent user surveys, publication of roadmaps."@en ;
  dct:subject "Sustainability,Social Sustainability" ;
  schema:category "Sustainability|Social Sustainability" ;
  owl:versionInfo "0.4" ;
  skos:broader att.4CB9ED25FE ;
  skos:inScheme trsp:trsp-attributes .

trsp:att.539A68DF8A
  a skos:Concept ;
  trsp:property "governance" ;
  skos:prefLabel "Governance" ;
  skos:definition "The structures, authority, decision processes and accountability arrangements by which an organisation or service is directed and controlled."@en ;
  dct:subject "Sustainability,Social Sustainability,Governance,CTS, POSI, TRUST, CARE" ;
  schema:category "Sustainability|Social Sustainability|Governance" ;
  dcat:keyword "CTS, POSI, TRUST, CARE" ;
  owl:versionInfo "0.4" ;
  skos:broader att.0849A7F1E2 ;
  skos:inScheme trsp:trsp-attributes .

