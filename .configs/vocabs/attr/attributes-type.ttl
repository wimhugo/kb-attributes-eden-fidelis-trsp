trsp:att.0FAB8D7E65
  a skos:Concept ;
  skos:prefLabel "Crosswalk Documentation Provided"@en ;
  schema:category Transparency|Scope of Services|Value-Added|Crosswalks and Conversions|Crosswalk Documentation Provided ;
  skos:definition A crosswalk service that translates, transforms, or mediates between different metadata and data formatsâincluding package structures, file formats, and metadata standardsâand for which human-readable documentation of the crosswalk process is provided and publicly accessible. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.00577FC6FC ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
