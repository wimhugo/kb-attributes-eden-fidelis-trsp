trsp:att.04F0DB0243
  a skos:Concept ;
  skos:prefLabel "Planning"@en ;
  schema:category Sustainability|Planning ;
  skos:definition Sustainability planning encompasses strategies for risk mitigation, business continuity, and disaster recovery, with particular emphasis on succession planning. This includes provisions for sudden loss of provider viability, such as set-aside funding and defined operational timeframes to sustain continued service while a successor provider is identified, ensuring preservation of references and ongoing access. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7F7C2776AC ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.11E8C2B7D0
  a skos:Concept ;
  skos:prefLabel "Disaster Recovery Plan"@en ;
  schema:category Sustainability|Planning|Disaster Recovery Plan ;
  skos:definition A disaster recovery plan encompasses the non-technical organizational processes and strategies for ensuring business continuity during service disruptions or disasters. It includes preparation for maintaining normal operations, managing digital objects, and addressing security incidents, as well as succession planning for service termination. Recovery planning complements technical infrastructure measures to support organizational resilience. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.697C57FE46 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.14C87D5FC0
  a skos:Concept ;
  skos:prefLabel "Long-Term Preservation Plan"@en ;
  schema:category Sustainability|Planning|Long-Term Preservation Plan ;
  skos:definition A governance framework ensuring the long-term preservation of data resources so they remain discoverable, accessible, and usable over time. It addresses sustainability planning by establishing policies and structures necessary to maintain data integrity and availability into the future. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4A2CF0AF0A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7495ADA28B
  a skos:Concept ;
  skos:prefLabel "Public Continuity Plan"@en ;
  schema:category Sustainability|Social Sustainability|Planning/ Continuity|Public Continuity Plan ;
  skos:definition A public continuity plan addressing sustainability and planning by identifying and managing third-party organisations, hosts, partners, and other actors essential to operations. This includes ensuring the continued delivery of data or metadata services through effective oversight of external dependencies. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.36E657FC7B
  a skos:Concept ;
  skos:prefLabel "Repository or Collections Data Management Plan"@en ;
  schema:category Sustainability|Planning|Repository or Collections Data Management Plan ;
  skos:definition A data management planning framework addressing repository-level considerations for catalogues and collections, including the acceptance of custody of digital objects from depositors and the transfer of responsibility to the repository. It encompasses the appraisal of offered or requested deposits to ensure they meet established criteria for acceptance. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2744CED24F ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.34A4F04633
  a skos:Concept ;
  skos:prefLabel "Resource Management Plan"@en ;
  schema:category Sustainability|Planning|Resource Management Plan ;
  skos:definition A structured approach to planning and managing human, financial, technological, and energy resources necessary to fulfil an organisation's mission. Encompasses organisational hierarchies, skills development, and risk management, ensuring sufficient internal or external expertise is available. Includes governance of policies, procedures, and the effective deployment of assets over time. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.18D74ED687 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistLegalDocuments ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4B6380A8F0
  a skos:Concept ;
  skos:prefLabel "Risk Plan"@en ;
  schema:category Sustainability|Planning|Risk Plan ;
  skos:definition A Sustainability Risk Plan in which the Technology Dependency Assessment (TDA) monitors technology evolution to identify potential risks. It defines detection methods for each identified risk, supporting proactive planning and long-term sustainability of technology-dependent systems. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3609108196
  a skos:Concept ;
  skos:prefLabel "Succession Plan"@en ;
  schema:category Sustainability|Planning|Succession Plan ;
  skos:definition A sustainability and succession plan outlines options for relocating or transitioning a repository's activities to another host in the event of disruptions such as unexpected funding withdrawal or shifts in institutional priorities. It supports business continuity by addressing non-technical organizational processes, digital object management, and security, as well as recovery plans for service interruptions, disasters, and potential end-of-service scenarios. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2E979C3B25 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


