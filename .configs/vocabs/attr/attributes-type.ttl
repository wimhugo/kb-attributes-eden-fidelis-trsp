  a skos:Concept ;
  skos:prefLabel "Performance"@en ;
  schema:category Technology|Services|External/ Micro-Services|Performance ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1A4E593402 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2F5B9B4823
  a skos:Concept ;
  skos:prefLabel "Automated Retrieval from Tape"@en ;
  schema:category Technology|Services|External/ Micro-Services|Performance|Automated Retrieval from Tape ;
  skos:definition A technology service capability in which the retrieval of data from tape storage is performed automatically, without manual intervention. This automated recall process is provided as an external or micro-service and is evaluated in terms of performance. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_1 ;
  trsp:hasMeasurementType trsp:measurementTypeFormat ;
  trsp:hasBenchmark "Text" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0EF898B591
  a skos:Concept ;
  skos:prefLabel "Large File Transport Support"@en ;
  schema:category Technology|Services|External/ Micro-Services|Performance|Large File Transport Support ;
  skos:definition A capability demonstrating efficient upload and download of large files exceeding 100 GB within an external or micro-services architecture. It serves as evidence that the service can handle high-volume data transport with acceptable performance, ensuring reliable transfer of large-scale assets across system boundaries. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.570534F4B8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.79C13FD633
  a skos:Concept ;
  skos:prefLabel "Tape Storage Support"@en ;
  schema:category Technology|Services|External/ Micro-Services|Performance|Tape Storage Support ;
  skos:definition A service capability indicating support for package crosswalks, enabling the conversion and mapping of content between different formats or standards. This value-added feature falls within the scope of transparency-related services. It also encompasses the ability to store content data on offline tape libraries. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


