  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3219437E8F
  a skos:Concept ;
  skos:prefLabel "Software and Service Quality"@en ;
  schema:category Technology|Services|Service Maturity/ Readiness|Software and Service Quality ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_1 ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark r3d:repository-type ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.64E3E49E89
  a skos:Concept ;
  skos:prefLabel "Conformance Testing Tool(s)"@en ;
  schema:category Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Conformance Testing Tool(s) ;
  skos:definition A conformance testing tool is a software utility used to evaluate whether a given service or tool meets specified standards or requirements. It is published and applied on a per-service or per-tool basis, where available, to assess software and service quality within a service maturity and readiness framework. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.09BFA24214
  a skos:Concept ;
  skos:prefLabel "Formal Testing in Place"@en ;
  schema:category Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Formal Testing in Place ;
  skos:definition A quality indicator denoting whether automated conformance tests are formally conducted and published for a given software or service. It reflects the presence of structured, repeatable testing processes that verify conformance to specified requirements, serving as a measure of service maturity and readiness. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5CE6A2BBCE ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1ADEEC1D3A
  a skos:Concept ;
  skos:prefLabel "Frequency of Formal Testing"@en ;
  schema:category Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Frequency of Formal Testing ;
  skos:definition The frequency at which formal testing activities are conducted and officially documented or published for a given software or service. This measure reflects the regularity of quality assurance cycles and provides transparency into the maturity and readiness of the software or service under evaluation. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.58166D724B ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4C6A46FB4C
  a skos:Concept ;
  skos:prefLabel "Service Maturity Assessment"@en ;
  schema:category Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Service Maturity Assessment ;
  skos:definition Service Maturity Assessment evaluates whether a PID service infrastructure meets a minimum technology readiness level of 8 for core functions such as registration and resolution. It encompasses projects and activities beyond routine operations, including new approaches to data, metadata, business processes, technology, security, and research infrastructure. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3A2655ABB6
  a skos:Concept ;
  skos:prefLabel "Test Results Published"@en ;
  schema:category Technology|Services|Service Maturity/ Readiness|Software and Service Quality|Test Results Published ;
  skos:definition A quality attribute indicating that the latest conformance test results for a software or service are published and made available for reference. This supports transparency and accountability by allowing stakeholders to verify the service's adherence to relevant standards or specifications. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.540F680A1E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.693D7B796F
  a skos:Concept ;
  skos:prefLabel "Transparency"@en ;
  schema:category Transparency ;
  skos:definition Transparency refers to the practice of conducting governance processes and operations openly, enabling trust in the selection of representatives to governance groups. This approach operates within the constraints of applicable privacy laws. The ARKs in the Open project exemplifies a completely open governance structure applied to public good services. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.26CD4B30B3
  a skos:Concept ;
  skos:prefLabel "Benefits and Constraints"@en ;
  schema:category Transparency|Benefits and Constraints ;
  skos:definition Transparency regarding benefits and constraints refers to the clear disclosure of information about the advantages and limitations associated with the use of a resource, system, or service. This concept encompasses making such information openly accessible to enable informed decision-making by users or stakeholders. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3720038519 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.060E8AF1A4
  a skos:Concept ;
  skos:prefLabel "Context"@en ;
  schema:category Transparency|Benefits and Constraints|Context ;
  skos:definition A contextual overview of a repository's key characteristics, encompassing its type, scope, and scale of data collections. This includes information on the data types and formats held, providing transparency about the nature and constraints of the repository to inform prospective users and stakeholders. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.57326A13EB ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3E5F32A9E8
  a skos:Concept ;
  skos:prefLabel "Capabilities"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.67DE43D8DF ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.48E7481CDD
  a skos:Concept ;
  skos:prefLabel "Administrative Capacity"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Administrative Capacity ;
  skos:definition Administrative capacity refers to the organizational capability to effectively manage and sustain operations, encompassing adequate funding, sufficient staffing, and clear governance structures. In the context of DOI registration and digital repositories, it supports minimum quality standards of administration and enables Registration Agencies to fulfill their missions reliably. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3F6736BF1C ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.32846CB4DF
  a skos:Concept ;
  skos:prefLabel "Data Transformation Service(s) Available"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Data Transformation Service(s) Available ;
  skos:definition A characteristic indicating whether a repository employs services or tools capable of translating, transforming, or mediating between different data formats, including package structures, file formats, and metadata standards. This capability reflects a transparency consideration within the repository's operational context, highlighting the availability of data transformation services to end users or depositors. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_1 ;
  trsp:hasMeasurementType trsp:measurementTypeFormat ;
  trsp:hasBenchmark "Integer" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4F90C51D4C
  a skos:Concept ;
  skos:prefLabel "Level of Curation"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Level of Curation ;
  skos:definition The Level of Curation attribute characterizes the degree to which a repository processes and enhances deposited content, ranging from distribution as-is (no curation) through basic metadata addition, format conversion and documentation enhancement, to full data-level editing. It situates curation activities within the repository's defined mission and organizational boundaries, including responsibilities retained when partners or outsourced services are involved. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.5960A93A27
  a skos:Concept ;
  skos:prefLabel "Level of Licence Applicability"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Level of Licence Applicability ;
  skos:definition A controlled vocabulary attribute indicating the level of granularity at which a repository licence applies. It specifies the contextual scopeâsuch as repository, collection, or item levelâwithin which licence terms are applicable. Values are drawn from a predefined controlled list. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1A4192F248
  a skos:Concept ;
  skos:prefLabel "Linked Open Data Support"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Linked Open Data Support ;
  skos:definition A capability describing whether a persistent identifier (PID) system supports linking to objects across different domains and resolving external PIDs. Identifiers used in metadata can be dereferenced, enabling linked entity resolution. This includes features such as linking peer-reviewed publications and other resources through Linked Open Data principles. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4A2CF0AF0A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.45EC53C288
  a skos:Concept ;
  skos:prefLabel "Metadata Schema Export Options"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Metadata Schema Export Options ;
  skos:definition A repository capability concerning the support for mapping, transforming, and aligning metadata across different schemas, standards, or structural formats. This includes the availability of export options that facilitate interoperability between heterogeneous metadata structures, enabling transparent exchange and integration of metadata across systems. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6B61F7AF54 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6EED29CAE5
  a skos:Concept ;
  skos:prefLabel "PID Resolution Support"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|PID Resolution Support ;
  skos:definition A repository capability indicating whether persistent identifiers (PIDs) are resolvable via HTTPS and return structured, machine-readable descriptive metadata. This includes autoresolution of metadata based on PIDs and support for PIDs linked to structured descriptive metadata, enabling reliable access to standardized, interoperable data. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2C32459481
  a skos:Concept ;
  skos:prefLabel "Supported AAI Services"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported AAI Services ;
  skos:definition A capability indicating support for login through federated identity providers. It encompasses a list of the specific identity providers or authentication and authorization infrastructures (AAI) that are supported, enabling users to authenticate via established federated services. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeChecklistEvidence ;
  trsp:hasBenchmark "Custom with Evidence" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.01924AD3A3
  a skos:Concept ;
  skos:prefLabel "Supported Data/ Metadata Packages"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Data/ Metadata Packages ;
  skos:definition A declaration of the packaging standards associated with a service or tool, covering the standards supported, accepted or preferred for input, produced or exported as output, used internally, and any community-specific packaging standards. This information enables transparency about data and metadata packaging capabilities and constraints within a given context. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4840647866 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4234565A8D
  a skos:Concept ;
  skos:prefLabel "Supported Dataset Formats"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Dataset Formats ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.70C4C7B218 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.543A727F84
  a skos:Concept ;
  skos:prefLabel "Supported Licences"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Licences ;
  skos:definition A repository transparency attribute indicating that the list of accepted or supported license types is publicly documented. The repository maintains and publishes a registry of licenses governing how deposited digital objects may be accessed and used, enabling depositors and users to understand the rights, permissions, and obligations that apply. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6B9370A3BB
  a skos:Concept ;
  skos:prefLabel "LicenseIRI"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Licences|LicenseIRI ;
  skos:definition A LicenseIRI is the IRI (Internationalized Resource Identifier) that uniquely identifies a license. It serves as a globally unique reference to a specific license resource, enabling unambiguous identification and retrieval of license information. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.5D06C32E4C
  a skos:Concept ;
  skos:prefLabel "LicenseName"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Licences|LicenseName ;
  skos:definition A LicenseName is the designated name identifying a specific license. It serves as a human-readable label used to reference and distinguish a license from others within a system or dataset. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6C03AB58B8
  a skos:Concept ;
  skos:prefLabel "Supported Metadata Schema"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Metadata Schema ;
  skos:definition A repository capability indicating the metadata schemas and standards supported by the system, including formats appropriate for specific content types such as geospatial or audiovisual data. The repository publicly discloses which metadata standards it supports, including FAIR-compliant formats, adherence to specific metadata models or profiles, and the standards used by its API. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0B54E5C8F5
  a skos:Concept ;
  skos:prefLabel "Metadata Schema IRI"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Metadata Schema|Metadata Schema IRI ;
  skos:definition A Metadata Schema IRI is the International Resource Identifier (IRI) that uniquely identifies a metadata standard. It serves as a persistent, globally unique reference to the schema defining the structure and semantics of metadata. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4DE2DD546E ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeChecklist ;
  trsp:hasBenchmark trsp:checklistDataProtection ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.72082342EE
  a skos:Concept ;
  skos:prefLabel "Metadata Schema Name"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Metadata Schema|Metadata Schema Name ;
  skos:definition Metadata Schema Name denotes the designation of a metadata standard associated with a resource or system. It identifies the specific schema or framework used to structure and describe metadata. This name serves as a reference to the governing standard that defines the metadata elements and their usage. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2F993B25AD
  a skos:Concept ;
  skos:prefLabel "Supported Persistent Identifiers"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Persistent Identifiers ;
  skos:definition A repository capability reflecting its support for persistent identifier (PID) standards, applied to objects, information packages, metadata, and roles across their life cycle. The repository publishes its supported PID systems in a machine-readable way, aligning with well-established identifier schemes to enhance discoverability, resource discovery, and metadata reuse. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark iso:iso-639-3.ttl ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.69C41A039A
  a skos:Concept ;
  skos:prefLabel "Supported Policies"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies ;
  skos:definition Supported Policies refers to a documented list of policies that a repository implements, accompanied by supporting evidence. It provides a structured account of the governance and operational rules in effect within the repository, enabling transparency and accountability regarding its policy framework. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4CD4FDE817
  a skos:Concept ;
  skos:prefLabel "Data Upload Types"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|Data Upload Types ;
  skos:definition Data Upload Types denotes the set of regulated categories governing how research data may be submitted to a repository. It functions as a wrapper element that groups the applicable submission rules and upload classifications. The concept provides a structured framework for managing data ingestion policies within a repository system. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.56C6946E5A
  a skos:Concept ;
  skos:prefLabel "Metadata Access Types"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|Metadata Access Types ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.760BF58AAB
  a skos:Concept ;
  skos:prefLabel "PolicyIRI"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|PolicyIRI ;
  skos:definition PolicyIRI denotes the Internationalized Resource Identifier (IRI) that uniquely identifies a policy within a system or framework. It serves as a stable, globally unique reference used to locate or retrieve the specific policy resource. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.34F02B2DA3
  a skos:Concept ;
  skos:prefLabel "PolicyName"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|PolicyName ;
  skos:definition PolicyName denotes the designated name assigned to a policy. It serves as a human-readable identifier that distinguishes one policy from another within a given context. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.035ACCB10D ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.642C080D89
  a skos:Concept ;
  skos:prefLabel "Supported Access Types"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Policies|Supported Access Types ;
  skos:definition Supported Access Types denotes the set of access regulations governing research data sets provided by a Research Data Repository (RDR). It serves as a wrapper element that encapsulates the permitted modes of access to such data sets. This concept defines the overarching structure for specifying how and under what conditions research data may be accessed. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.167C47D292
  a skos:Concept ;
  skos:prefLabel "Supported Standards/ Specifications"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Standards/ Specifications ;
  skos:definition A documented list, supported by evidence, of the standards and specifications with which a repository aligns, conforms to, and implements. This encompasses the adoption and development of policies and criteria that guide practice, aligned with governance structures, operational workflows, and the applicable legal and ethical framework. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.24650A32BA ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6AF56A372D
  a skos:Concept ;
  skos:prefLabel "Supported Vocabularies"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supported Vocabularies ;
  skos:definition A capability indicating whether a system supports, publishes, and documents the controlled vocabularies, semantic standards, and ontologies used to describe its holdings. This includes identifying authoritative sources for entities, mapping or aligning terms across vocabularies to ensure consistent interpretation across communities, and demonstrating alignment with recognized information models such as OAIS. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.50239FC483
  a skos:Concept ;
  skos:prefLabel "Supports Data Expiration"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supports Data Expiration ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6AA7258DA9
  a skos:Concept ;
  skos:prefLabel "Supports Embargoes"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supports Embargoes ;
  skos:definition A capability that enables the support of embargo expiration and enforcement within a given context. It provides mechanisms to manage the timing and application of embargoes, ensuring that access or release restrictions are applied and lifted appropriately. This capability operates as both a benefit and a constraint within the transparency domain. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.67E6C4912C
  a skos:Concept ;
  skos:prefLabel "Supports Redaction/ Obfuscation"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supports Redaction/ Obfuscation ;
  skos:definition A capability that supports workflows for redacting or obfuscating data, ensuring that metadata indicates whether data has been generalised or redacted. It operates within transparency contexts by balancing disclosure with appropriate data protection constraints. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6F05B292BD
  a skos:Concept ;
  skos:prefLabel "Supports Signposting"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Capabilities|Supports Signposting ;
  skos:definition Package crosswalks supported refers to the capability of converting or mapping metadata between different packaging formats or standards, ensuring that object metadata remains accessible and interoperable. This supports both human and machine findability by enabling automated discovery and exchange of metadata across systems and vocabularies. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.64FDE59BAD
  a skos:Concept ;
  skos:prefLabel "Coverage"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage ;
  skos:definition Coverage refers to the breadth of scope across the research enterprise, encompassing disciplines, geographies, institutions, and stakeholders. It includes the subject areas, cross-disciplinary domains, data types, and technologies a repository addresses, ensuring infrastructure transcends individual fields. Organisational names, abbreviations, and contact details provide contextual reference for related activities. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.115BEEC616
  a skos:Concept ;
  skos:prefLabel "Community Coverage"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Community Coverage ;
  skos:definition Community Coverage refers to the scope of a repository's data acceptance with respect to its originating community. A repository with broad community coverage accepts data contributions from sources beyond its own community. This characteristic reflects an aspect of transparency regarding the contextual reach and inclusivity of the repository's data collection practices. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4AA1880060 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3B633179C5
  a skos:Concept ;
  skos:prefLabel "Disciplinary Coverage"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Disciplinary Coverage ;
  skos:definition Disciplinary Coverage refers to the primary research domain or domains addressed within a given context. It identifies the academic or professional fields that a resource, study, or system is designed to serve or represent. This attribute helps clarify the scope and applicability of a resource across different disciplines. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.540F680A1E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Schema IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1EBE22F750
  a skos:Concept ;
  skos:prefLabel "Discipline"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Disciplinary Coverage|Discipline ;
  skos:definition A discipline refers to the subject area or field of study associated with a Research Data Repository (RDR). It categorizes the thematic or academic domain to which the repository's content belongs. A single RDR may be associated with one or more disciplines. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.04F0DB0243 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.59CAA27CE9
  a skos:Concept ;
  skos:prefLabel "Discipline ID"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Disciplinary Coverage|Discipline ID ;
  skos:definition A unique identifier or notation assigned to a subject or discipline classification. It serves as a standardized code used to distinguish and reference a specific academic or thematic discipline within a classification system. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.60FD6669A5
  a skos:Concept ;
  skos:prefLabel "Discipline Scheme"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Disciplinary Coverage|Discipline Scheme ;
  skos:definition A Discipline Scheme is a structured framework used to describe and categorize the subject or discipline of a repository. It provides a standardized scheme for classifying repository content by academic or thematic discipline. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.54317F78CB
  a skos:Concept ;
  skos:prefLabel "Object Coverage"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Object Coverage ;
  skos:definition A list of object types accepted by a repository, defining the scope of materials for which the organisation holds responsibility. It establishes the boundaries of the repository's mission and activities, including those involving partners or outsourced services, and provides contextual reference for all related functions and outcomes. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.14605C9B1C
  a skos:Concept ;
  skos:prefLabel "Object Type ID"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Object Coverage|Object Type ID ;
  skos:definition Object Type ID is the URI that uniquely identifies a particular object or content type. It serves as a standardized reference identifier for distinguishing between different types of objects or content within a system. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4A2CF0AF0A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.756D3790E0
  a skos:Concept ;
  skos:prefLabel "Object Type Name"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Object Coverage|Object Type Name ;
  skos:definition Object Type Name denotes the name assigned to a particular object or content type. It serves as a identifying label that distinguishes one type of object or content from another within a given system or classification scheme. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0613B795FE
  a skos:Concept ;
  skos:prefLabel "Object Type Scheme"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Object Coverage|Object Type Scheme ;
  skos:definition A scheme used to classify or categorize objects or content by name and/or URL. It provides a structured reference to the classification code or system applied to an object type. This enables consistent identification and organization of content within a defined classification framework. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1BF97AE324 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.34D1282F11
  a skos:Concept ;
  skos:prefLabel "Spatial Coverage"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Spatial Coverage ;
  skos:definition The articulation of an organisation's purpose and the boundaries of activities for which it holds ultimate responsibility, including those involving partners or outsourced services. This contextual information provides a reference framework for all related activities and functions, clarifying the spatial and operational coverage of the repository's mission. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.035ACCB10D ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.5D0E8069FC
  a skos:Concept ;
  skos:prefLabel "Temporal Coverage"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Coverage|Temporal Coverage ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.761C0FB70D
  a skos:Concept ;
  skos:prefLabel "Repository Characterisation"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation ;
  skos:definition A designated contact point associated with a repository, specifically relating to the scope of value-added services offered, including support for package crosswalks and conversions. This resource provides transparency regarding the crosswalk formats and conversion capabilities supported by the repository. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.291848CB10
  a skos:Concept ;
  skos:prefLabel "Contact"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Contact ;
  skos:definition Contact information for a data repository, including names, abbreviations, and other details of the responsible organisation. This information provides reference context for the repository's activities and functions. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3219437E8F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1F522CDA86
  a skos:Concept ;
  skos:prefLabel "Contact Information"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Contact Information ;
  skos:definition Contact Information refers to the means by which a Research Data Repository (RDR) can be reached, specifically comprising an email address or a URL pointing to an online contact form. It provides users with direct communication channels to the repository. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.04F0DB0243 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1A387A8E23
  a skos:Concept ;
  skos:prefLabel "Contact Type"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Contact Type ;
  skos:definition Contact Type denotes the classification or category assigned to a piece of contact information, distinguishing it by its nature or purpose (e.g., telephone, email, address). It provides a structured means of identifying how a contact can be reached or communicated with. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0D3C935A8A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4570870110
  a skos:Concept ;
  skos:prefLabel "Country"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Country ;
  skos:definition The country in which a repository or service is located and operates. This attribute forms part of the repository's contextual characterisation, supporting transparency by identifying its geographic jurisdiction alongside descriptive information and applicable standards. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6A47F71F59 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0C1737084B
  a skos:Concept ;
  skos:prefLabel "Description"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Description ;
  skos:definition A characterisation of a data repository providing a general descriptive overview of the repository. This information supports transparency by contextualising the repository within a broader descriptive framework. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.16855D3CB9 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.19C2EB7DAB
  a skos:Concept ;
  skos:prefLabel "Identifier"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Identifier ;
  skos:definition A unique identifier or persistent identifier (PID) assigned to a repository to distinguish it within its context. One or more such identifiers may be associated with a single repository, supporting unambiguous reference and characterisation. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0D3C935A8A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.225686595E
  a skos:Concept ;
  skos:prefLabel "Identifier Type"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Identifier|Identifier Type ;
  skos:definition A characteristic of systems that capture and expose metadata about individual and organizational roles involved in the deposit, curation, maintenance, and management of digital objects. Defined roles may include data steward, curator, depositor, reviewer, or administrator, and may incorporate group or role memberships provided by identity providers. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.70DECA9F26 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.5F7C942B1E
  a skos:Concept ;
  skos:prefLabel "Identifier Value"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Identifier|Identifier Value ;
  skos:definition An Identifier Value is a globally unique identifier that refers to a Research Data Repository (RDR) or to a record describing the RDR. It serves as a distinct, unambiguous reference for locating or describing the repository within a broader information system. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3A6BADBDB9
  a skos:Concept ;
  skos:prefLabel "Landing Page"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Landing Page ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.540F680A1E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.57C5A7579F
  a skos:Concept ;
  skos:prefLabel "Language"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Language ;
  skos:definition Transparency refers to the native language of the repository's user interface, characterizing the linguistic context in which the repository presents itself to users. This attribute forms part of the broader repository characterisation, capturing the primary language through which the system's interface communicates with its audience. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.698943C6A7
  a skos:Concept ;
  skos:prefLabel "Linked Resources"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Linked Resources ;
  skos:definition Transparency in repository characterisation involves recommending publications for all FAIRsharing records and applying persistent identifiers and descriptive metadata to digital objects to support resource discovery. This includes providing discovery systems and making metadata available for harvesting, enabling linked resources to be reliably identified and accessed within their broader context. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7A3A7003B4
  a skos:Concept ;
  skos:prefLabel "Resource Identifier"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Linked Resources|Resource Identifier ;
  skos:definition A Related Resource Identifier is an identifier assigned to a resource that is associated with or related to the primary resource in question. It serves to uniquely reference and distinguish the related resource within a given system or context. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2E2FA03DB5
  a skos:Concept ;
  skos:prefLabel "Resource Type"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Linked Resources|Resource Type ;
  skos:definition A classification of the relationship between a repository and an associated external resource. It specifies the nature of the connection using named relationship types, including those employed by the re3data registry. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.64FDE59BAD ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0AB11676B0
  a skos:Concept ;
  skos:prefLabel "List of Catalogue(s)"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|List of Catalogue(s) ;
  skos:definition A web resource or API that lists available catalogues, their endpoints, and their identifiers.. A resource, such as an API or web endpoint, that lists available catalogues along with their identifiers, names, abbreviations, and contact details for the responsible organisation. It provides reference information and contextual background to support repository characterisation and related activities. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1A4E593402 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4763130464
  a skos:Concept ;
  skos:prefLabel "List of Documents"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|List of Documents ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5E44673C02 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.78CC017229
  a skos:Concept ;
  skos:prefLabel "List of Endorsements"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|List of Endorsements ;
  skos:definition A repository characterisation attribute capturing the organisation's list of formal endorsements, including endorsed principles, frameworks, and standards such as the TRUST principles, with links to applicable definitions. It also identifies the repository's publisher(s) and defines the purpose or mission of the organisation, establishing the scope and boundaries of its activities and responsibilities. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.41F4454A97
  a skos:Concept ;
  skos:prefLabel "Organisation"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation ;
  skos:definition The organisation responsible for hosting or managing a data repository, identified by its name, abbreviations, and contact details. This includes relevant identifiers and language indicators for all associated institutions, along with the organisational hierarchies and processes through which the entity's mission is managed and executed. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.70C4C7B218 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.22E9D90455
  a skos:Concept ;
  skos:prefLabel "Organisation Additional Name"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Additional Name ;
  skos:definition An alternative name or acronym used to identify a responsible institution. This designation supplements the primary name of the organisation, providing additional labelling options that may include shortened forms or widely recognised aliases. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.70DECA9F26 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.44434AB8BA
  a skos:Concept ;
  skos:prefLabel "Organisation Country"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Country ;
  skos:definition Organisation Country denotes the country in which a responsible institution is located. It identifies the geographic location of the organisation accountable for a given resource, process, or record. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6FB10117A8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6DB955E068
  a skos:Concept ;
  skos:prefLabel "Organisation Identifier"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Identifier ;
  skos:definition An Organisation Identifier is a structured data element that serves as a unique identifier for a responsible institution. It functions as a wrapper element, encapsulating the identifying information associated with the relevant organisation. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2ED61F28AC
  a skos:Concept ;
  skos:prefLabel "Organisation Identifier Type"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Identifier|Organisation Identifier Type ;
  skos:definition An Organisation Identifier Type denotes the category or scheme used to identify a responsible institution by its provider name. It classifies the type of identifier assigned to an organisation, enabling consistent referencing of the issuing or responsible body. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.64FDE59BAD ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark iso:iso-3166-1.ttl ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.07BAFD06A8
  a skos:Concept ;
  skos:prefLabel "Organisation Identifier URL"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Identifier|Organisation Identifier URL ;
  skos:definition An Organisation Identifier URL is a globally unique identifier in URL form that refers to a responsible institution. It serves as an unambiguous, web-resolvable reference to distinguish one organisation from another within a shared information context. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.12C140C8CD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.030C7CAA30
  a skos:Concept ;
  skos:prefLabel "Organisation Name"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Name ;
  skos:definition An Organisation Name is the official designation or title assigned to an institution. It serves as the primary label by which the institution is formally known and referenced. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.66003293B3 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.078274837C
  a skos:Concept ;
  skos:prefLabel "Organisation Responsibility End Date"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Responsibility End Date ;
  skos:definition Organisation Responsibility End Date denotes the date on which an organisation's period of responsibility concludes. It marks the termination point of a defined accountability or duty held by the organisation. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.12C140C8CD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4EF949B147
  a skos:Concept ;
  skos:prefLabel "Organisation Responsibility Start Date"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Responsibility Start Date ;
  skos:definition The date on which an organisation's period of responsibility begins. It marks the commencement of the timeframe during which the organisation holds accountability for a given role, function, or obligation. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.027652CB34
  a skos:Concept ;
  skos:prefLabel "Organisation Type"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation Type ;
  skos:definition Organisation Type denotes the category or classification of a responsible institution. It is used to characterize the nature or role of an organization within a given context, distinguishing between different kinds of accountable or governing bodies. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.650BA75F4F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.393B1CEA88
  a skos:Concept ;
  skos:prefLabel "Organisation URL"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|Organisation URL ;
  skos:definition The URL of the institution responsible for a given resource or activity. It provides a direct web reference to the authoritative organisation associated with the described entity. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.66C6612EA5 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Service IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.10B6918167
  a skos:Concept ;
  skos:prefLabel "responsibilityType"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Organisation|responsibilityType ;
  skos:definition ResponsibilityType denotes the category or nature of responsibility assigned to a responsible institution. It classifies the specific role or obligation that an institution holds in relation to a given context or resource. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4AA1880060 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.64DA341B5F
  a skos:Concept ;
  skos:prefLabel "Repository Name"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Repository Name ;
  skos:definition The name by which a repository is formally identified and commonly known to its users. It serves as a key descriptive attribute within repository characterisation, providing context for understanding the repository's identity and transparency. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.280FB56A40
  a skos:Concept ;
  skos:prefLabel "Repository Size"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Repository Size ;
  skos:definition Repository Size denotes the total count of items contained within a repository. It serves as a quantitative measure reflecting the volume or scale of a repository's holdings at a given point in time. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5ABD0E52C7 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.11E21FF2FC
  a skos:Concept ;
  skos:prefLabel "Repository Status"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Repository Status ;
  skos:definition A typology characterising the life cycle status of a repository, indicating whether it is under development or in production and actively accepting data submissions. Production status does not preclude ongoing development, enhancement, or maintenance, as is common in mature systems. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.697C57FE46 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6A715E3A22
  a skos:Concept ;
  skos:prefLabel "Repository Type"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Repository Type ;
  skos:definition Repository Type characterises whether a repository is discipline-specific or generalist, defining the purpose and mission of the organisation and the boundaries of activities for which it is responsible. Even where activities involve partners or outsourced services, the organisation retains ultimate responsibility for outcomes. This classification provides essential reference context for all other repository activities and functions. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.08F1F3FAB7
  a skos:Concept ;
  skos:prefLabel "Research Area"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Research Area ;
  skos:definition A repository characterisation attribute capturing contextual information about the subject classification of resources (assets) held within it. These elements support the identification and discoverability of repository contents with transparency as a goal. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.12C140C8CD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7470DA5BBA
  a skos:Concept ;
  skos:prefLabel "URL"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|URL ;
  skos:definition A repository attribute capturing identifying and contextual information, including the uniform resource locator (URL) serving as its primary web entry point, along with names, abbreviations, and contact details for the responsible organisation. This information provides reference context for understanding the repository's activities and functions. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.48BF7E1522
  a skos:Concept ;
  skos:prefLabel "Year of Commencement"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Repository Characterisation|Year of Commencement ;
  skos:definition The year in which a repository was established or first commenced operation. This attribute characterises the repository by recording its founding year, providing contextual information about the age and origins of the resource. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.176CC246A8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0B3D7477E7
  a skos:Concept ;
  skos:prefLabel "Source of Repository Attributes"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Source of Repository Attributes ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1A4E593402 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.236C15FEA4
  a skos:Concept ;
  skos:prefLabel "FAIRiCAT URL"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Source of Repository Attributes|FAIRiCAT URL ;
  skos:definition A URL associated with the FAIRiCAT resource that serves as a source of repository attributes, enabling repository affordances to be discoverable by both humans and machines. This transparency-related property provides contextual information about the benefits and constraints of a repository within a FAIR-aligned framework. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1593E1AE08 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3F76446066
  a skos:Concept ;
  skos:prefLabel "Registry URL"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Source of Repository Attributes|Registry URL ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.50DA0AA84E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4BFD6FB9B3
  a skos:Concept ;
  skos:prefLabel "Target User Community"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Target User Community ;
  skos:definition The target user community refers to the defined designated audience of a repository, situated within the broader context of the organisation's stated purpose, mission, and boundaries of responsibility. Even where activities involve partners or outsourced services, the organisation retains ultimate responsibility for outcomes. This definition provides essential reference context for all related repository activities and functions. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3282BD1281
  a skos:Concept ;
  skos:prefLabel "Designated Community Definition"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Target User Community|Designated Community Definition ;
  skos:definition A repository's designated community definition establishes the organization's purpose, the boundaries of its responsibilities, and the needs and expectations of its target user communities. It provides reference context for deposit, curation, and preservation activities, while recognizing that facilitating reuse requires ongoing engagement with users. Where partners or outsourced services are involved, the organization retains ultimate responsibility for all functions and outcomes. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4AEE114A6B
  a skos:Concept ;
  skos:prefLabel "Equitable Engagement"@en ;
  schema:category Transparency|Benefits and Constraints|Context|Target User Community|Equitable Engagement ;
  skos:definition Transparency in equitable engagement refers to the practice of actively monitoring the Designated Community to identify and respond to its evolving needs and knowledge. This ongoing observation ensures that the repository remains responsive to its target user community within the appropriate context, balancing the benefits and constraints of transparent engagement. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.18D74ED687
  a skos:Concept ;
  skos:prefLabel "Legal and Regulatory"@en ;
  schema:category Transparency|Benefits and Constraints|Legal and Regulatory ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0D3C935A8A ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0F78D12691
  a skos:Concept ;
  skos:prefLabel "Inventory of Considerations"@en ;
  schema:category Transparency|Benefits and Constraints|Legal and Regulatory|Inventory of Considerations ;
  skos:definition A structured inventory of legal and regulatory considerations related to transparency, encompassing the terms of use that govern both the repository itself and its data holdings. It identifies the benefits and constraints arising from these terms, supporting informed compliance and governance decisions. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.497C7ACE99 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7AF3A65ADD
  a skos:Concept ;
  skos:prefLabel "Mission and Mandate"@en ;
  schema:category Transparency|Benefits and Constraints|Mission and Mandate ;
  skos:definition A repository characteristic indicating that the scope of services and supported package crosswalks and conversions are clearly and transparently documented. At a minimum, repositories should ensure their mission statement and service scope are explicitly stated, enabling users to understand the value-added functions and crosswalk capabilities offered. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.035ACCB10D
  a skos:Concept ;
  skos:prefLabel "Mission"@en ;
  schema:category Transparency|Benefits and Constraints|Mission and Mandate|Mission ;
  skos:definition This attribute captures a brief description of the purpose of research infrastructures served through sustainability and infrastructure links. Trustworthy repositories assume explicit responsibility for the curation and active preservation of digital objects, ensuring materials are held in appropriate environments for defined periods and that continued access remains a clearly stated commitment to both depositors and users. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.72CBE64ACC ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.516450BF5E
  a skos:Concept ;
  skos:prefLabel "Active Preservation"@en ;
  schema:category Transparency|Benefits and Constraints|Mission and Mandate|Mission|Active Preservation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.04B70A444F
  a skos:Concept ;
  skos:prefLabel "Approved public mission statement"@en ;
  schema:category Transparency|Benefits and Constraints|Mission and Mandate|Mission|Approved public mission statement ;
  skos:definition A formally approved public mission statement that defines an organization's purpose and the boundaries of activities for which it holds ultimate responsibility, including those involving partners or outsourced services. It provides essential reference information and context for all related activities and functions, incorporating names, abbreviations, and contact details. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.7F7C2776AC ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1DAD162D7A
  a skos:Concept ;
  skos:prefLabel "Continued Access"@en ;
  schema:category Transparency|Benefits and Constraints|Mission and Mandate|Mission|Continued Access ;
  skos:definition A requirement that repositories maintain measures to address risks from changing circumstances, including shifts in mission or scope. It encompasses stable management of services over time (business continuity), response to service disruptions (disaster recovery), and preparation for transferring digital objects and services to another repository (succession planning). ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.375960B05E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2F80B22A4D
  a skos:Concept ;
  skos:prefLabel "Level of Approval is Public"@en ;
  schema:category Transparency|Benefits and Constraints|Mission and Mandate|Mission|Level of Approval is Public ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_1 ;
  trsp:hasMeasurementType trsp:measurementTypeFormat ;
  trsp:hasBenchmark "Text" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.65A383C886
  a skos:Concept ;
  skos:prefLabel "Policy statement signed off by a governing board"@en ;
  schema:category Transparency|Benefits and Constraints|Mission and Mandate|Mission|Policy statement signed off by a governing board ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.43ABB27EBE
  a skos:Concept ;
  skos:prefLabel "Single Focus"@en ;
  schema:category Transparency|Benefits and Constraints|Mission and Mandate|Single Focus ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6FB10117A8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0B807CC544
  a skos:Concept ;
  skos:prefLabel "Well-defined focus"@en ;
  schema:category Transparency|Benefits and Constraints|Mission and Mandate|Single Focus|Well-defined focus ;
  skos:definition A principle whereby infrastructures established for a specific purpose should incorporate formal incentives that motivate the organisation and its staff to fulfil that mission and, where appropriate, wind down operations. Because technological or social change can simplify or render a purpose obsolete, clear incentive structures help ensure alignment with the original mandate rather than institutional self-perpetuation. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.16855D3CB9 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.13132A45E7
  a skos:Concept ;
  skos:prefLabel "Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy ;
  skos:definition Transparency in the context of benefits, constraints, and policy refers to the organisational hierarchies and processes by which an entity's mission is managed and executed. It encompasses the structures and mechanisms that govern how decisions are made and carried out within an organisation. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.0FEE58FD17 ;
  trsp:hasCardinalityType trsp:cardinality1_1 ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark trsp:versioning-strategy-type-scheme ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6105038322
  a skos:Concept ;
  skos:prefLabel "Appraisal/ Accession Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Appraisal/ Accession Policy ;
  skos:definition The process of accepting custody of digital objects from depositors and transferring responsibility to the repository. It may include appraising offered or requested deposits against established criteria to determine suitability for acceptance, balancing transparency with the constraints of repository policy. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7F6F3E3DDE
  a skos:Concept ;
  skos:prefLabel "Ethics Clearance Verification Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Appraisal/ Accession Policy|Ethics Clearance Verification Policy ;
  skos:definition A policy governing the legal and ethical obligations that an organisation must recognize and adhere to in the context of appraisal and accession, specifically concerning ethics clearance verification. It ensures transparency by establishing clear constraints and benefits related to compliance with applicable legal and ethical requirements. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2B81C65FFB
  a skos:Concept ;
  skos:prefLabel "Sensitive Data Appraisal Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Appraisal/ Accession Policy|Sensitive Data Appraisal Policy ;
  skos:definition A repository policy governing the appraisal and accession of sensitive data, addressing whether the repository publishes such a policy and whether supporting evidence of its existence is publicly available. It falls within the broader framework of transparency, benefits and constraints, and appraisal/accession policy. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E5F32A9E8 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Schema IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2E979C3B25
  a skos:Concept ;
  skos:prefLabel "Data Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Data Policy ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Registry IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.768DAFA0DB
  a skos:Concept ;
  skos:prefLabel "Data Preservation Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Data Policy|Data Preservation Policy ;
  skos:definition A repository's Data Preservation Policy governs long-term stewardship of digital objects by monitoring the technology landscape and user community for changes that may affect usability or comprehension. When necessary, preservation actionsâsuch as format migration, metadata updates, or environment emulationâare taken to ensure continued accessibility and viability of digital content over time. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7EC681717D
  a skos:Concept ;
  skos:prefLabel "Licence Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Data Policy|Licence Policy ;
  skos:definition A feature indicating that the URI of the applicable license policy is explicitly published and made accessible within the service offering. This supports transparency by enabling users to identify and reference the governing license terms directly. It falls within the scope of value-added crosswalk and conversion services. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2901B9E359
  a skos:Concept ;
  skos:prefLabel "PID Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Data Policy|PID Policy ;
  skos:definition A repository policy governing the assignment and lifecycle management of globally unique Persistent Identifiers (PIDs) to deposited data objects, information packages, and metadata. The policy is published openly and aligned with global, regional, and national PID initiatives (e.g., EOSC PID Policy, National PID Strategies), supporting resource discovery through descriptive metadata and interoperable identifier schemes. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3219437E8F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.549827C8B4
  a skos:Concept ;
  skos:prefLabel "Preferred Formats Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Data Policy|Preferred Formats Policy ;
  skos:definition A policy governing the preferred formats for data ingestion, under which the Trusted Digital Archive (TDA) performs operations on data objects prior to ingest to ensure compliance with its format requirements. This policy sits within the broader framework of data policy, balancing transparency with the operational constraints of format standardization. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1395FD0F03
  a skos:Concept ;
  skos:prefLabel "Versioning Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Data Policy|Versioning Policy ;
  skos:definition A policy governing the assignment, reassignment, and deprecation of persistent identifiers, as well as the versioning of data and metadata. It defines how changes are managed and communicated to data depositors and users, ensuring transparency in the repository's approach to evolving records. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2AF9C821F9 ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0E2DB53E0E
  a skos:Concept ;
  skos:prefLabel "Disclosure Risk"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Disclosure Risk ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2080C1D4EE ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4F40729393
  a skos:Concept ;
  skos:prefLabel "Appropriate Licences"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Disclosure Risk|Appropriate Licences ;
  skos:definition Transparency in data access encompasses the disclosure of restrictions applied to digital objects, including justification and responsible authority, alongside appropriate deposit, access agreements, and licences. It involves assigning persistent identifiers and descriptive metadata to support resource discovery, while determining suitable access methodsâsuch as direct download or secure remote environmentsâbased on object characteristics and rights management policies. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6B7CED5897
  a skos:Concept ;
  skos:prefLabel "Assessment and Access Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Disclosure Risk|Assessment and Access Policy ;
  skos:definition A repository practice in which policies are presented on a dedicated summary page and linked from metadata and/or landing pages. Each policy entry includes a title, a purpose or category (such as rights, compliance, PID, or access), and a link to the relevant web resource, enabling users to locate and understand the repository's governance frameworks. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.45F7A22412
  a skos:Concept ;
  skos:prefLabel "Bibliographic Metadata - CC0"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Disclosure Risk|Bibliographic Metadata - CC0 ;
  skos:definition A policy attribute confirming the application of a CC0 (public domain) licence to bibliographic and non-sensitive metadata. It addresses the balance between transparency benefits and disclosure risk constraints, enabling unrestricted public access and reuse of such metadata. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6B61F7AF54 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2744CED24F
  a skos:Concept ;
  skos:prefLabel "Policy Management"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Policy Management ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1DB4B1E4F0 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.11B8A1B690
  a skos:Concept ;
  skos:prefLabel "Policies are versioned"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Policy Management|Policies are versioned ;
  skos:definition A characteristic of policy management indicating whether a repository maintains and displays a version history of its data policies, enabling traceability and clarity over changes. Older policy versions are archived and remain accessible to users, collaborators, and external parties such as funders and partner organisations. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.697C57FE46 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.145BD6BECD
  a skos:Concept ;
  skos:prefLabel "Policies linked or are easily found"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Policy Management|Policies linked or are easily found ;
  skos:definition A repository's data policiesâcovering access, reuse, and preservation conditionsâare published in a clearly accessible location on its website and linked from metadata and/or landing pages. Concise summary pages and URIs to restriction policies or legal guidance enable external partners, funders, and other stakeholders to readily locate and understand the applicable frameworks governing data use. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.00EDBED146 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6437B9E8E1
  a skos:Concept ;
  skos:prefLabel "Policy Development Process"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Policy Management|Policy Development Process ;
  skos:definition The policy development process encompasses the creation, maintenance, and revision of policies, standards, and other criteria that guide practice. It operates in alignment with governance structures and operational workflows, ensuring compliance with applicable legal and ethical frameworks. This process also includes the evaluation and incorporation of evolving standards into organizational policies. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.2847F75853
  a skos:Concept ;
  skos:prefLabel "Privacy Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Privacy Policy ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3219437E8F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1042D04416
  a skos:Concept ;
  skos:prefLabel "Complies with relevant legislation"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Privacy Policy|Complies with relevant legislation ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4AA1880060 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.39D810EEC9
  a skos:Concept ;
  skos:prefLabel "Personal Data Removal Request Procedure exists"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Privacy Policy|Personal Data Removal Request Procedure exists ;
  skos:definition A policy element indicating that a procedure exists for requesting the removal of personal data, with confirmation of such removal available upon completion. It encompasses both the benefits of enabling individuals to exercise data removal rights and the constraints governing how such requests are processed and confirmed. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.354E278D69 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.434F29EDB9
  a skos:Concept ;
  skos:prefLabel "Right to be forgotten implemented"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Privacy Policy|Right to be forgotten implemented ;
  skos:definition A transparency criterion assessing whether a repository has implemented a right-to-be-forgotten procedure by publishing a formal personal data removal process. It evaluates both the existence of such a policy and the availability of supporting evidence demonstrating its implementation. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6A8A5E1219 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3619EF1B84
  a skos:Concept ;
  skos:prefLabel "Rights Management"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Rights Management ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2E979C3B25 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.390FEB7218
  a skos:Concept ;
  skos:prefLabel "Inventory of Managed Rights"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Rights Management|Inventory of Managed Rights ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.371D70B854 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Assessment IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6C9FCD9125
  a skos:Concept ;
  skos:prefLabel "Rights Policy"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Rights Management|Rights Policy ;
  skos:definition A rights policy establishing principles and provisions for the protection of relevant stakeholder rights, governing the management of permissions, prohibitions, and obligations that determine how digital objects are accessed and used by individuals and organisations, both within and outside the repository. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1B94296BAD
  a skos:Concept ;
  skos:prefLabel "Supported Formats"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Supported Formats ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5CF6AB3B6E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.50E0581B3D
  a skos:Concept ;
  skos:prefLabel "Archiving-Preservation"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Supported Formats|Archiving-Preservation ;
  skos:definition A policy detailing how the preservation of data is ensured by the repository, including evidence of the sustainability of different file formats for long-term preservation. The policy provides guidance on the most appropriate formats for archiving and may be presented as a dedicated page or formal document. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3E1CA96845
  a skos:Concept ;
  skos:prefLabel "Dissemination"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Supported Formats|Dissemination ;
  skos:definition A policy dimension describing the file formats supported by a resource for dissemination purposes. The TDA generates derivative copies to meet the specific needs of its Designated Community, and a service ensures that files remain accessible using contemporary software. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.156B52FB19 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Service IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1BF23E39F5
  a skos:Concept ;
  skos:prefLabel "Submission/ Preferred Formats"@en ;
  schema:category Transparency|Benefits and Constraints|Policy|Supported Formats|Submission/ Preferred Formats ;
  skos:definition A repository policy that specifies which file formats are accepted or preferred for submission, organized into categories such as Preferred, Dissemination, and Preservation formats. The policy defines formatting requirements and identifies the types of machine-readable content stored, including software, analysis outputs, and raw data. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3E8808255F ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeVocabulary ;
  trsp:hasBenchmark trsp:businessmodel-type ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.371D70B854
  a skos:Concept ;
  skos:prefLabel "Certification and Assessment"@en ;
  schema:category Transparency|Certification and Assessment ;
  skos:definition A requirement whereby PID Authorities and Services commit to undergoing certification assessments at mutually agreed intervals to verify compliance with established policies. This ensures ongoing accountability and transparency in the governance of persistent identifier infrastructure. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2744CED24F ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.27C898E8A0
  a skos:Concept ;
  skos:prefLabel "List of Certifications"@en ;
  schema:category Transparency|Certification and Assessment|List of Certifications ;
  skos:definition A record of formal certifications obtained by a repository, such as CoreTrustSeal, demonstrating compliance with recognized standards and best professional practices. Certifications are typically awarded through third-party audits or community endorsement processes and serve as evidence of a repository's trustworthiness, fitness, and adherence to established quality benchmarks. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1DB4B1E4F0 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6E27DEF3A1
  a skos:Concept ;
  skos:prefLabel "List of Self-Assessments"@en ;
  schema:category Transparency|Certification and Assessment|List of Self-Assessments ;
  skos:definition Self-assessment processes used to evaluate compliance with standards, policies, and procedures. It also supports the identification of actions for continuous and targeted improvement, including implementation of encoded EOSC PID Policy for Managers. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1224E087E0
  a skos:Concept ;
  skos:prefLabel "List of Third-Party Assessments"@en ;
  schema:category Transparency|Certification and Assessment|List of Third-Party Assessments ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.4D039CA977 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeChecklistEvidence ;
  trsp:hasBenchmark trsp:checklistProceduresWorkflow ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.613F28AF34
  a skos:Concept ;
  skos:prefLabel "Scope of Services"@en ;
  schema:category Transparency|Scope of Services ;
  skos:definition The range of functions and services offered by a repository to depositors and users, which must be openly available to all researchers in the EU. In accordance with EOSC PID Policy C20, accessibility across the European research community is a mandatory requirement for compliant services. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3788BFB26A
  a skos:Concept ;
  skos:prefLabel "API Services"@en ;
  schema:category Transparency|Scope of Services|API Services ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1B94296BAD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "File Type IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.62BD42CF21
  a skos:Concept ;
  skos:prefLabel "API Conforms To"@en ;
  schema:category Transparency|Scope of Services|API Services|API Conforms To ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.64D59A05CF
  a skos:Concept ;
  skos:prefLabel "API Documentation"@en ;
  schema:category Transparency|Scope of Services|API Services|API Documentation ;
  skos:definition API Documentation refers to a resource, typically a website, that describes the availability and usage details of an application programming interface (API). It provides essential information for developers seeking to understand and integrate the API into their applications. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


