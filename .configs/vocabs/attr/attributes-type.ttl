  a skos:Concept ;
  skos:prefLabel "Object-Level Metadata API"@en ;
  schema:category Transparency|Scope of Services|Reuse|Rich Metadata|Object-Level Metadata API ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.18CE7D92FA
  a skos:Concept ;
  skos:prefLabel "Standard Discovery API Supported"@en ;
  schema:category Transparency|Scope of Services|Discovery|Service APIs|Standard Discovery API Supported ;
  skos:definition A standard discovery API that supports resource discovery through persistent identifiers and descriptive metadata applied to digital objects. The API is documented and accessible via a defined URL, employing a specified query language to enable metadata harvesting and retrieval from discovery systems. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2922ED695E ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


