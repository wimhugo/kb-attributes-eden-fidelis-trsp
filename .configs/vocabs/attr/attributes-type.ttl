trsp:att.57D4BD2121
  a skos:Concept ;
  skos:prefLabel "Format guidance documentation"@en ;
  schema:category User Focus|Guidance|Guidance on Data and Metadata Preparation|Format guidance and conversion|Format guidance documentation ;
  skos:definition A URI or reference to documentation specifying the file format and vocabulary used in a given context. This documentation supports workflows for planning and evaluating possible file format conversion paths and processes. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.45E4291E97
  a skos:Concept ;
  skos:prefLabel "Format Guidance Granularity"@en ;
  schema:category User Focus|Guidance|Guidance on Data and Metadata Preparation|Format guidance and conversion|Format Guidance Granularity ;
  skos:definition The level of specificity at which guidance is provided for each file format, encompassing details such as file format versions and applicable profiles. This granularity indication helps users understand the precise scope and applicability of format-related recommendations during data and metadata preparation. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6B61F7AF54 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
