trsp:att27e790a86b
  a skos:Concept ;
  skos:prefLabel "User Focus"@en ;
  skos:description "User Focus refers to the principle that a trustworthy repository must prioritize serving its designated user community, recognizing that different communities have varying expectations depending on their maturity in data management and sharing. A trustworthy repository is embedded in its community's data practices, enabling it to respond effectively to evolving requirements."@en ;
  schema:category "User Focus" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1DB4B1E4F0 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att70c4c7b218
  a skos:Concept ;
  skos:prefLabel "Annotation, Metrics, Feedback and Use"@en ;
  skos:description "A capability encompassing reporting, analytics, and compliance assessment to support effective management of objects and services. It delivers functional, operational, and statistical reports while evaluating adherence to standards, policies, and procedures. Findings inform continuous and targeted improvement actions across crosswalks, conversions, and user-focused service packages."@en ;
  schema:category "User Focus|Annotation, Metrics, Feedback and Use" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5103ac4bb0
  a skos:Concept ;
  skos:prefLabel "(Forward) Provenance"@en ;
  skos:description "A user-focused concept concerning the forward provenance of a dataset, capturing how the dataset has been applied as an input to the creation of new datasets. It encompasses annotations, metrics, and feedback related to downstream usage, enabling tracking of a dataset's influence and reuse across subsequent data creation processes."@en ;
  schema:category "User Focus|Annotation, Metrics, Feedback and Use|(Forward) Provenance" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

