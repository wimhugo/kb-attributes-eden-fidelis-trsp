trsp:att5baf2cf9aa
  a skos:Concept ;
  skos:prefLabel "Information Management"@en ;
  skos:description "A set of processes used to assess compliance with standards, policies, and procedures, while identifying actions for continuous improvement. It encompasses the provision of hardware, software, and IT service management, monitoring user and technical needs to maintain and update levels of technical service across the organisation."@en ;
  schema:category "Performance|Performance Assessment|Information Management" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5086bafce4
  a skos:Concept ;
  skos:prefLabel "KPI-based monitoring"@en ;
  skos:description "The extent to which strategic objectives and service KPIs are being achieved, assessed through the analysis of internal data and external information. This monitoring verifies and demonstrates that an organisation is effectively fulfilling its mission and scope."@en ;
  schema:category "Performance|Performance Assessment|KPI-based monitoring" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

