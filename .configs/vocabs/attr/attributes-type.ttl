trsp:att067b4c3677
  a skos:Concept ;
  skos:prefLabel "Software Development Guidelines and Procedures"@en ;
  skos:description "Measures and procedures established to ensure a minimum level of completeness, documentation, and technology readiness in software development. These encompass certification and trust mechanisms alongside guidelines that uphold quality standards throughout the software development process."@en ;
  schema:category "Trust|Certification|Software Development Quality|Software Development Guidelines and Procedures" ;
  owl:versionInfo "0.4" ;
