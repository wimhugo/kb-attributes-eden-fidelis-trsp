trsp:att.0C85A9C228
  a skos:Concept ;
  skos:prefLabel "Storage Type"@en ;
  schema:category Performance|Deposit Properties|File and Dataset Properties|Storage Type ;
  skos:definition A property indicating the storage type status of a file or dataset, such as whether it is online, offline, or held on tape. This classification supports performance assessment by enabling systems to determine the accessibility and retrieval characteristics of stored files. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.608015D600 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


