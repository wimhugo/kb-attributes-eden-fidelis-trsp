trsp:att.0E0C905D2A
  a skos:Concept ;
  trsp:property "dataIsFree" ;
  skos:prefLabel "Data is free" ;
  skos:definition "Identified primarily as a requirement for public infrastructure services by POSI, this criterion ensures that the data gathered by services is available without cost to the community, and serves as insurance should the service no longer be available."@en ;
