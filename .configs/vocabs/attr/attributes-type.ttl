trsp:att.540F680A1E
  a skos:Concept ;
  skos:prefLabel "Service APIs"@en ;
  schema:category Transparency|Scope of Services|Discovery|Service APIs ;
  skos:definition Community-defined standards implemented by a repository to represent data and/or metadata in a consistent, machine-readable form through models, formats, schemas, vocabularies, or ontologies. These standards facilitate the discovery and interpretation of data and metadata via service APIs. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.601EAF4625
  a skos:Concept ;
  skos:prefLabel "Depositor Contact Information Available"@en ;
  schema:category Transparency|Scope of Services|Discovery|Service APIs|Depositor Contact Information Available ;
  skos:definition A repository capability indicating whether contact information for the data's depositor, producer, or ownerâsuch as an individual (ideally identified by ORCID) or organizationâis retained and publicly displayed. This supports transparency by enabling discovery of responsible parties associated with a dataset. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.31600CB8D6
  a skos:Concept ;
  skos:prefLabel "File-Level Metadata API"@en ;
  schema:category Transparency|Scope of Services|Discovery|Service APIs|File-Level Metadata API ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.761C0FB70D ;
  trsp:hasCardinalityType trsp:cardinality1_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
