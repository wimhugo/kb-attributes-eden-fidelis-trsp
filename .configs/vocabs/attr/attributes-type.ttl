  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.53947860B6
  a skos:Concept ;
  skos:prefLabel "Provenance Approach Documented"@en ;
  schema:category Transparency|Scope of Services|Curation|Provenance Approach Documented ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7FEEA35BFF
  a skos:Concept ;
  skos:prefLabel "Versioning Process Documented"@en ;
  schema:category Transparency|Scope of Services|Curation|Versioning Process Documented ;
  skos:definition A capability whereby the TDA creates successive versions of Information Objects, either autonomously or at producer initiative, with data deposits linked to persistent identifiers and versioned consistently. This supports transparent, traceable management of content across package crosswalks and conversions. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3754546590
  a skos:Concept ;
  skos:prefLabel "Deposit/ Appraisal/ Ingest"@en ;
  schema:category Transparency|Scope of Services|Deposit/ Appraisal/ Ingest ;
  skos:definition A repository practice in which data and metadata are accepted according to defined criteria to ensure relevance and understandability for users. This encompasses the stages of the research data lifecycle prior to ingest, including collaboration with data and metadata creators to improve quality and highlight the benefits of curation, preservation, and reuse. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2847F75853 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4DCDBAD9B4
  a skos:Concept ;
  skos:prefLabel "Semantic Enhancement"@en ;
  schema:category Transparency|Scope of Services|Deposit/ Appraisal/ Ingest|Semantic Enhancement ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.67D4ECB749
  a skos:Concept ;
  skos:prefLabel "Named Entity Recognition Service"@en ;
  schema:category Transparency|Scope of Services|Deposit/ Appraisal/ Ingest|Semantic Enhancement|Named Entity Recognition Service ;
  skos:definition A service supporting manual or assisted semantic enrichment of content through named entity recognition, operating within the deposit, appraisal, and ingest stage of the scope of services. It contributes to transparency by enabling the identification and tagging of named entities to enhance the semantic quality of ingested materials. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.34E5521DD7
  a skos:Concept ;
  skos:prefLabel "Discovery"@en ;
  schema:category Transparency|Scope of Services|Discovery ;
  skos:definition A repository practice encompassing the provision of or contribution to community catalogues to facilitate data discovery, enabling users to locate digital objects and cite them persistently. This includes ensuring digital objects meet defined quality and standards compliance thresholds before being made available for reuse. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.035ACCB10D ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


