trsp:att.207398D3A8
  a skos:Concept ;
  skos:prefLabel "Human-readable API documentation available"@en ;
  schema:category User Focus|Guidance|API Documentation|Human-readable API documentation available ;
  skos:definition A repository characteristic indicating whether human-readable documentation, such as manuals or guides, is available for its services, protocols, and APIs. This includes specifying result formats and determining appropriate access methodsâsuch as direct download or secure remote environmentsâbased on the nature of the digital objects, user characteristics, and rights management policies. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6FB10117A8 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
