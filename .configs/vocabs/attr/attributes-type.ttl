trsp:att6b61f7af54
  a skos:Concept ;
  skos:prefLabel "Find"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Discovery|Find" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att562c603e9f
  a skos:Concept ;
  skos:prefLabel "Advanced discovery"@en ;
  skos:description "A catalogue service capability that enables consumers to discover objects of interest by searching across metadata fields at multiple levels, including nested (low-level) and high-level schemas such as Dublin Core. It supports advanced filtering based on content properties to refine discovery results."@en ;
  schema:category "User Focus|Discovery|Find|Advanced discovery" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4bfe0576a2
  a skos:Concept ;
  skos:prefLabel "Federated Search Available"@en ;
  skos:description "A capability indicating whether a system can execute queries across multiple domains to participate in external, cross-domain discovery networks. It reflects the system's support for federated search, enabling unified discovery of resources distributed across disparate sources or repositories."@en ;
  schema:category "User Focus|Discovery|Find|Federated Search Available" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att50f2dbf5c1
  a skos:Concept ;
  skos:prefLabel "Named and Persisted Search Criteria"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Discovery|Find|Named and Persisted Search Criteria" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att16c85273ee
  a skos:Concept ;
  skos:prefLabel "Semantic, NL, or AI Search"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Discovery|Find|Semantic, NL, or AI Search" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.3319EEDC99 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7170942244
  a skos:Concept ;
  skos:prefLabel "Simple discovery"@en ;
  skos:description "A characteristic indicating whether a repository supports package crosswalks, enabling high-level search and discovery across different formats or standards. This value-added capability falls within the scope of transparency and crosswalk and conversion services offered by the repository."@en ;
  schema:category "User Focus|Discovery|Find|Simple discovery" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5f06eec902
  a skos:Concept ;
  skos:prefLabel "Harvestable"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Discovery|Harvestable" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

