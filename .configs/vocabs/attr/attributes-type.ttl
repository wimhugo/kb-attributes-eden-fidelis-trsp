  a skos:Concept ;
  skos:prefLabel "Default Metadata Schema/ Profile Indicated"@en ;
  schema:category Responsibility|Schema|Metadata and Data|Default Metadata Schema/ Profile Indicated ;
  skos:definition Indicating that a default metadata schema or profile has been specified and published for use. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.38DA273FCF ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


