trsp:att.3720038519
  a skos:Concept ;
  skos:prefLabel "Dependencies"@en ;
  schema:category Technology|Services|External/ Micro-Services|Dependencies ;
  skos:definition The management of human resources to fulfil an organizational mission, encompassing the identification and maintenance of sufficient skills and competencies. This includes sourcing capabilities both internally and through external engagement, and managing dependencies on external or micro-services to ensure operational continuity. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.2847F75853 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
