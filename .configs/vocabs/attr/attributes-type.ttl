trsp:att.7362D6D981
  a skos:Concept ;
  skos:prefLabel "Reuse"@en ;
  schema:category Transparency|Scope of Services|Reuse ;
  skos:definition A trusted digital repository (TDR) demonstrates essential capabilities to enable long-term access and reuse of digital objects for its designated communities. The repository ensures appropriate information is available to support understanding and use over time, and facilitates access through suitable methodsâsuch as direct download or secure remote environmentsâbased on object characteristics, user attributes, and rights management policies. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7D09257304
  a skos:Concept ;
  skos:prefLabel "Reuse Provisions"@en ;
  schema:category Transparency|Scope of Services|Reuse|Reuse Provisions ;
  skos:definition A documented checklist, supported by evidence, of measures designed to facilitate the reuse of digital objects. Effective reuse depends on deposit, curation, and preservation activities informed by an understanding of user needs and designated communities. Repositories may mediate reuse through secure remote access systems, safe rooms, or other controlled tools. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.67DE43D8DF
  a skos:Concept ;
  skos:prefLabel "Rich Metadata"@en ;
  schema:category Transparency|Scope of Services|Reuse|Rich Metadata ;
  skos:definition A principle ensuring that metadata contains sufficient contextual information to enable the reuse of data. This includes provenance information and usage licensing details, providing transparency about the scope of services associated with the data. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7F80554D90
  a skos:Concept ;
  skos:prefLabel "Clear Licence Provisions"@en ;
  schema:category Transparency|Scope of Services|Reuse|Rich Metadata|Clear Licence Provisions ;
  skos:definition A value-added service attribute indicating whether package crosswalks and format conversions are supported within the scope of services. It ensures that metadata holds sufficient contextâsuch as usage licensing informationâto enable meaningful reuse of the data across different systems or standards. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.1A78609F7E
  a skos:Concept ;
  skos:prefLabel "Provenance is recorded at object level"@en ;
  schema:category User Focus|Discovery|Provenance|Provenance is recorded at object level ;
  skos:definition Provenance is recorded and maintained at the individual object level, capturing the history, context, and lifecycle of data through changelogs, timestamped audit trails, and descriptive metadata. This ensures that datasets can be understood, discovered, and reused, while supporting authenticity and accountability through auditable records of role-related actions and curation processes. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.28A2220E45 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.536467081E
  a skos:Concept ;
  skos:prefLabel "Value-Added"@en ;
  schema:category Transparency|Scope of Services|Value-Added ;
  skos:definition A concept relating to transparency in the scope of services, specifically concerning value-added offerings. It identifies value-added services as appropriate potential revenue sources within a service framework. This concept supports clear disclosure of which services generate revenue through added value. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


