  a skos:Concept ;
  skos:prefLabel "Process Quality IRL"@en ;
  skos:description "Process Quality IRL denotes a level of process maturity evidenced by formal certification. It provides a standardized measure for assessing the quality and rigor of processes based on documented certification evidence."@en ;
  schema:category "Trust|Certification|Process Quality|List of Certifications: Process|Process Quality IRL" ;
