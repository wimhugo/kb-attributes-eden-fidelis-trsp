trsp:att7dc345ff14
  a skos:Concept ;
  skos:prefLabel "Profile IRL"@en ;
  skos:description "A Profile IRL is an IRL (Internationalized Resource Locator) that identifies or references a profile. It serves as a locator specifically associated with a given profile resource."@en ;
  schema:category "Trust|Profiles| Profile IRL" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att549ea02994
  a skos:Concept ;
  skos:prefLabel "List of Profiles"@en ;
  skos:description "A curated list of profiles representing associations, networks, and membership organisations. It serves as a structured reference for entities that operate as collective or affiliated bodies. The list enables users to identify and access information about organisations defined by membership or shared interests."@en ;
  schema:category "Trust|Profiles|List of Profiles" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att377162a4cd
  a skos:Concept ;
  skos:prefLabel "Profile Name"@en ;
  skos:description "A Profile Name is the designated name assigned to a profile. It serves as the primary label or identifier used to distinguish one profile from another within a system or dataset."@en ;
  schema:category "Trust|Profiles|Profile Name" ;
