  a skos:Concept ;
  skos:prefLabel "Living Will"@en ;
  skos:description "A documented plan specifying how stewardship responsibilities, holdings and associated information will be handled if a repository can no longer operate."@en ;
  schema:category "Sustainability|Social Sustainability|Living Will" ;
