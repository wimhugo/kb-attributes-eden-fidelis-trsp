trsp:att.7DC345FF14
  a skos:Concept ;
  skos:prefLabel "Profile IRL"@en ;
  schema:category Trust|Profiles| Profile IRL ;
  skos:definition A Profile IRL is an IRL (Internationalized Resource Locator) that identifies or references a profile. It serves as a locator specifically associated with a given profile resource. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.549EA02994
  a skos:Concept ;
  skos:prefLabel "List of Profiles"@en ;
  schema:category Trust|Profiles|List of Profiles ;
  skos:definition A curated list of profiles representing associations, networks, and membership organisations. It serves as a structured reference for entities that operate as collective or affiliated bodies. The list enables users to identify and access information about organisations defined by membership or shared interests. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.377162A4CD
  a skos:Concept ;
  skos:prefLabel "Profile Name"@en ;
  schema:category Trust|Profiles|Profile Name ;
  skos:definition A Profile Name is the designated name assigned to a profile. It serves as the primary label or identifier used to distinguish one profile from another within a system or dataset. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3619EF1B84 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
