trsp:att5eabfd41be
  a skos:Concept ;
  skos:prefLabel "Software Quality End Date"@en ;
  skos:description "Software Quality End Date denotes the date on which a software quality certification expires or ceases to be valid. It marks the temporal boundary of a certification's validity period, after which the certification is no longer considered current or authoritative."@en ;
  schema:category "Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality End Date" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att54e5432755
  a skos:Concept ;
  skos:prefLabel "Software Quality IRL"@en ;
  skos:description "Software Quality IRL refers to the demonstrated, real-world quality of software as evidenced by formal certification. It represents verified compliance with established standards or benchmarks, substantiated through tangible certification evidence rather than theoretical or self-reported claims."@en ;
  schema:category "Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality IRL" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att50aef9f2ef
  a skos:Concept ;
  skos:prefLabel "Software Quality Name"@en ;
  skos:description "A Software Quality Name is a certification label used to identify and designate a recognized standard or attribute of software quality. It serves as a formal identifier within quality assurance frameworks, distinguishing specific quality characteristics or certifications assigned to software products."@en ;
  schema:category "Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality Name" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6a89b5b165
  a skos:Concept ;
  skos:prefLabel "Software Quality Start Date"@en ;
  skos:description "The Software Quality Start Date denotes the date on which a software quality certification becomes valid. It marks the beginning of the certification's period of validity for the associated software."@en ;
  schema:category "Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality Start Date" ;
