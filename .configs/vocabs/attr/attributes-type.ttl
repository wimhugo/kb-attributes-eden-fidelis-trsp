trsp:att.139CD89A8A
  a skos:Concept ;
  trsp:property "communityEngagement" ;
  skos:prefLabel "Community Engagement" ;
  skos:definition "Demonstrable longer-term funding and income sources. Structural income is adequate. Revenue is justifiable, the source is clearly defined, and revenue does not come from selling the data or metadata holdings. Recovering justifiable cost, for example for disseminating or storing large data sets, is acceptable."@en ;
  dct:subject "Sustainability,Financial Sustainability,Community Engagement,POSI, CTS, TRUST" ;
  schema:category "Sustainability|Financial Sustainability|Community Engagement" ;
  dcat:keyword "POSI, CTS, TRUST" ;
  owl:versionInfo "0.4" ;
  skos:broader att.4CB9ED25FE ;
  skos:inScheme trsp:trsp-attributes .

