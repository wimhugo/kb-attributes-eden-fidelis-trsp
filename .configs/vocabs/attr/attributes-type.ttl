  trsp:property "managedStakeholderDependencies" ;
  skos:prefLabel "Managed Stakeholder Dependencies" ;
  skos:definition "A document detailing the management and nature of stakeholder dependencies - end user groupings, depositors, funders, service users and aggregators, including statements of intent in respect of partnership and stakeholder management and its improvement."@en ;
