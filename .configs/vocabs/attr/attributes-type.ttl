  schema:category Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality Authority ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.394D659C0C ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.5EABFD41BE
  a skos:Concept ;
  skos:prefLabel "Software Quality End Date"@en ;
  schema:category Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality End Date ;
  skos:definition Software Quality End Date denotes the date on which a software quality certification expires or ceases to be valid. It marks the temporal boundary of a certification's validity period, after which the certification is no longer considered current or authoritative. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.54E5432755
  a skos:Concept ;
  skos:prefLabel "Software Quality IRL"@en ;
  schema:category Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality IRL ;
  skos:definition Software Quality IRL refers to the demonstrated, real-world quality of software as evidenced by formal certification. It represents verified compliance with established standards or benchmarks, substantiated through tangible certification evidence rather than theoretical or self-reported claims. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.50AEF9F2EF
  a skos:Concept ;
  skos:prefLabel "Software Quality Name"@en ;
  schema:category Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality Name ;
  skos:definition A Software Quality Name is a certification label used to identify and designate a recognized standard or attribute of software quality. It serves as a formal identifier within quality assurance frameworks, distinguishing specific quality characteristics or certifications assigned to software products. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.6A89B5B165
  a skos:Concept ;
  skos:prefLabel "Software Quality Start Date"@en ;
  schema:category Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality Start Date ;
  skos:definition The Software Quality Start Date denotes the date on which a software quality certification becomes valid. It marks the beginning of the certification's period of validity for the associated software. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.386291B08E
  a skos:Concept ;
  skos:prefLabel "Software Quality Status"@en ;
  schema:category Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality Status ;
  skos:definition Software Quality Status refers to the certification state of a software artifact or system. It indicates the current level or outcome of quality assessment and certification processes applied to the software. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1B94296BAD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "File Type IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.00A7D8F385
  a skos:Concept ;
  skos:prefLabel "Software Quality Type"@en ;
  schema:category Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality Type ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5FFCEEB1F9 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3CC032134C
  a skos:Concept ;
  skos:prefLabel "Software Quality Widget"@en ;
  schema:category Trust|Certification|Software Development Quality|List of Certifications: Software Quality|Software Quality Widget ;
  skos:definition A Software Quality Widget is a badge or widget that communicates the certification level or status of a software product. It provides a visual indicator of quality or compliance standing, enabling users to quickly assess a product's certification at a glance. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.39ED69C36B ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.067B4C3677
  a skos:Concept ;
  skos:prefLabel "Software Development Guidelines and Procedures"@en ;
  schema:category Trust|Certification|Software Development Quality|Software Development Guidelines and Procedures ;
  skos:definition Measures and procedures established to ensure a minimum level of completeness, documentation, and technology readiness in software development. These encompass certification and trust mechanisms alongside guidelines that uphold quality standards throughout the software development process. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5FBAF6DC9F ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


