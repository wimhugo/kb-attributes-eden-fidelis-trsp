trsp:att.3E9295C9A1
  a skos:Concept ;
  skos:prefLabel "User Support Mechanisms"@en ;
  schema:category User Focus|User Support Mechanisms ;
  skos:definition A repository feature encompassing mechanisms that assist data depositors and users during or after the submission process. This includes dedicated contact points such as helpdesk email addresses or contact forms through which users can seek guidance or resolve issues related to data deposit and access. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.110C424081 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Service IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.434B4A0632
  a skos:Concept ;
  skos:prefLabel "Helpdesk Available"@en ;
  schema:category User Focus|User Support Mechanisms|Helpdesk Available ;
  skos:definition A helpdesk mechanism that provides users with a dedicated point of contact for reporting ethical misconduct. It serves as a structured support channel enabling individuals to raise concerns about unethical behavior within an organization or system. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6A8A5E1219 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.24C6E69FBF
  a skos:Concept ;
  skos:prefLabel "SLA is Available"@en ;
  schema:category User Focus|User Support Mechanisms|SLA is Available ;
  skos:definition A service-level agreement (SLA) is available that defines community-aligned commitments for key service attributes, including uptime, availability expectations, and ticket response and resolution times. Where applicable, these commitments are differentiated between free and paid service tiers and reflect community best practices. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.6A837D5A94 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att4cb9ed25fe
  a skos:Concept ;
  skos:prefLabel "Sustainability"@en ;
  skos:description "Sustainability refers to a trustworthy repository's capacity to ensure uninterrupted, long-term access to its data holdings for current and future user communities. It encompasses the repository's ability to maintain and evolve its services over time, typically documented through a formal sustainability plan or dedicated webpage outlining strategies to meet changing user requirements."@en ;
  schema:category "Sustainability" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:trsp-attributes .

trsp:att0849a7f1e2
  a skos:Concept ;
  skos:prefLabel "Social Sustainability"@en ;
  skos:description "Aspects such as open governance, community involvement and engagement, planning and continuity arrangements, forum and working group participation and creation. Frequent user surveys, publication of roadmaps."@en ;
  schema:category "Sustainability|Social Sustainability" ;
  owl:versionInfo "0.4" ;
  skos:broader att.4CB9ED25FE ;
  skos:inScheme trsp:trsp-attributes .

trsp:att539a68df8a
  a skos:Concept ;
  skos:prefLabel "Governance"@en ;
