trsp:att0c85a9c228
  a skos:Concept ;
  skos:prefLabel "Storage Type"@en ;
  skos:description "A property indicating the storage type status of a file or dataset, such as whether it is online, offline, or held on tape. This classification supports performance assessment by enabling systems to determine the accessibility and retrieval characteristics of stored files."@en ;
  schema:category "Performance|Deposit Properties|File and Dataset Properties|Storage Type" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.608015D600 ;
  skos:inScheme trsp:ConceptScheme .

