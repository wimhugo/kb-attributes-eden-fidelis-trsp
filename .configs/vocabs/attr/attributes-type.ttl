trsp:att.38DA273FCF
  a skos:Concept ;
  skos:prefLabel "Pre-deposit"@en ;
  schema:category Transparency|Scope of Services|Pre-deposit ;
  skos:definition A pre-deposit stage mechanism that governs transparency and scope of services before research data enters a repository. It encompasses processes for sharing deposited data anonymously via links to support peer review, including confidential or double-blind access depending on journal policy, while engaging with data creators to improve quality and highlight the benefits of curation, preservation, and reuse. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.371D70B854 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "Assessment IRIs" ;
  skos:inScheme trsp:trsp-attributes .


