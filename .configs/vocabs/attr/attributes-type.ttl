trsp:att.3C89A4DF3F
  a skos:Concept ;
  skos:prefLabel "Per Object"@en ;
  schema:category User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Assessment|Per Object ;
  skos:definition A FAIR assessment approach in which a curator or system generates and includes a FAIR score for each individual deposited object. These scores are published at multiple levels, supporting granular evaluation of how well data and metadata meet Findability, Accessibility, Interoperability, and Reusability principles. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.15DBB60AC2 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
