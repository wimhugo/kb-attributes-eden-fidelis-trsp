trsp:att4fe3aa3a42
  a skos:Concept ;
  skos:prefLabel "Analyse and Pre-Process"@en ;
  skos:description "A capability within the application and reuse domain that enables users to render digital objects through the application of emulation and/or other specialist tools. It supports the analysis and pre-processing of content to facilitate access and reuse."@en ;
  schema:category "User Focus|Application and Reuse|Analyse and Pre-Process" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

