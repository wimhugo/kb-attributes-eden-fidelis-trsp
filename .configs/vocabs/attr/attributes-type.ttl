  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att38da273fcf
  a skos:Concept ;
  skos:prefLabel "Pre-deposit"@en ;
  skos:description "A pre-deposit stage mechanism that governs transparency and scope of services before research data enters a repository. It encompasses processes for sharing deposited data anonymously via links to support peer review, including confidential or double-blind access depending on journal policy, while engaging with data creators to improve quality and highlight the benefits of curation, preservation, and reuse."@en ;
  schema:category "Transparency|Scope of Services|Pre-deposit" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.371D70B854 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6c673d59d2
  a skos:Concept ;
  skos:prefLabel "Link to or Ingest External Metadata"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Pre-deposit|Link to or Ingest External Metadata" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5214df9d16
  a skos:Concept ;
  skos:prefLabel "Pre-publication Peer Review"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Pre-deposit|Pre-publication Peer Review" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att156b52fb19
  a skos:Concept ;
  skos:prefLabel "Preservation"@en ;
  skos:description "Preservation refers to a repository's documented commitment to maintaining data holdings over the long term, ensuring continued access and fitness for use. The repository defines minimum digital preservation timeframes and assumes planned responsibility for adapting services to meet evolving user community requirements."@en ;
  schema:category "Transparency|Scope of Services|Preservation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.553A464EC8 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att08ab24d0f7
  a skos:Concept ;
  skos:prefLabel "Commitment is Defined"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Preservation|Commitment is Defined" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.12C140C8CD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6eb55f36b2
  a skos:Concept ;
  skos:prefLabel "List of Preservation Support Services"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Preservation|List of Preservation Support Services" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3da6c87583
  a skos:Concept ;
  skos:prefLabel "Timeframe is Defined"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Preservation|Timeframe is Defined" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.156B52FB19 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7362d6d981
  a skos:Concept ;
  skos:prefLabel "Reuse"@en ;
  skos:description "A trusted digital repository (TDR) demonstrates essential capabilities to enable long-term access and reuse of digital objects for its designated communities. The repository ensures appropriate information is available to support understanding and use over time, and facilitates access through suitable methods—such as direct download or secure remote environments—based on object characteristics, user attributes, and rights management policies."@en ;
  schema:category "Transparency|Scope of Services|Reuse" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7d09257304
  a skos:Concept ;
  skos:prefLabel "Reuse Provisions"@en ;
  skos:description "A documented checklist, supported by evidence, of measures designed to facilitate the reuse of digital objects. Effective reuse depends on deposit, curation, and preservation activities informed by an understanding of user needs and designated communities. Repositories may mediate reuse through secure remote access systems, safe rooms, or other controlled tools."@en ;
  schema:category "Transparency|Scope of Services|Reuse|Reuse Provisions" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att67de43d8df
  a skos:Concept ;
  skos:prefLabel "Rich Metadata"@en ;
  skos:description "A principle ensuring that metadata contains sufficient contextual information to enable the reuse of data. This includes provenance information and usage licensing details, providing transparency about the scope of services associated with the data."@en ;
  schema:category "Transparency|Scope of Services|Reuse|Rich Metadata" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7f80554d90
  a skos:Concept ;
  skos:prefLabel "Clear Licence Provisions"@en ;
  skos:description "A value-added service attribute indicating whether package crosswalks and format conversions are supported within the scope of services. It ensures that metadata holds sufficient context—such as usage licensing information—to enable meaningful reuse of the data across different systems or standards."@en ;
  schema:category "Transparency|Scope of Services|Reuse|Rich Metadata|Clear Licence Provisions" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1a78609f7e
  a skos:Concept ;
  skos:prefLabel "Provenance is recorded at object level"@en ;
  skos:description "Provenance is recorded and maintained at the individual object level, capturing the history, context, and lifecycle of data through changelogs, timestamped audit trails, and descriptive metadata. This ensures that datasets can be understood, discovered, and reused, while supporting authenticity and accountability through auditable records of role-related actions and curation processes."@en ;
  schema:category "User Focus|Discovery|Provenance|Provenance is recorded at object level" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.28A2220E45 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att536467081e
  a skos:Concept ;
  skos:prefLabel "Value-Added"@en ;
  skos:description "A concept relating to transparency in the scope of services, specifically concerning value-added offerings. It identifies value-added services as appropriate potential revenue sources within a service framework. This concept supports clear disclosure of which services generate revenue through added value."@en ;
  schema:category "Transparency|Scope of Services|Value-Added" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att110c424081
  a skos:Concept ;
  skos:prefLabel "Annotation"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Annotation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.4AA1880060 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7abef7eca8
  a skos:Concept ;
  skos:prefLabel "Semantic Annotation Tools/ Services Supported"@en ;
  skos:description "Indicates whether the system supports external tools or services for applying, managing, or enriching metadata with semantic annotations. This capability may enable decoupled annotation workflows, allowing metadata enrichment processes to operate independently from core system functions."@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Annotation|Semantic Annotation Tools/ Services Supported" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0ecee93cf8
  a skos:Concept ;
  skos:prefLabel "Supports Semantic Annotation"@en ;
  skos:description "TBD"@en ;
  schema:category "User Focus|Annotation, Metrics, Feedback and Use|Supports Semantic Annotation" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.27F5C3BD10 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0674156b7e
  a skos:Concept ;
  skos:prefLabel "Consulting Services"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Consulting Services" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.1BF97AE324 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2e92627e37
  a skos:Concept ;
  skos:prefLabel "Advisory or Consulting Services Offered"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Consulting Services|Advisory or Consulting Services Offered" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.64FDE59BAD ;
  skos:inScheme trsp:ConceptScheme .

trsp:att50da0aa84e
  a skos:Concept ;
  skos:prefLabel "Crosswalks and Conversions"@en ;
  skos:description "TBD"@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Crosswalks and Conversions" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att0fab8d7e65
  a skos:Concept ;
  skos:prefLabel "Crosswalk Documentation Provided"@en ;
  skos:description "A crosswalk service that translates, transforms, or mediates between different metadata and data formats—including package structures, file formats, and metadata standards—and for which human-readable documentation of the crosswalk process is provided and publicly accessible."@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Crosswalks and Conversions|Crosswalk Documentation Provided" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.00577FC6FC ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6a439a6743
  a skos:Concept ;
  skos:prefLabel "File Type Conversion Services"@en ;
  skos:description "File Type Conversion Services encompass capabilities for identifying file formats using established registries (e.g., IANA MIME types, PRONOM), migrating obsolete formats to sustainable alternatives, and providing high-quality format conversion guidance. The repository publishes tools used for translation, transformation, or mediation between data formats, and discloses whether these tools operate within broader workflows such as ingestion or validation."@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Crosswalks and Conversions|File Type Conversion Services" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att2141ff7751
  a skos:Concept ;
  skos:prefLabel "Flexible Serialisation of AIPs"@en ;
  skos:description "Flexible serialisation of AIPs refers to a system's ability to support multiple API serialisation methods and to document the technical standards and specifications governing all aspects of AIP packaging. As part of an exit strategy, the system enables batch export of information packages and associated metadata in a manageable format for ingest into another trusted digital archive."@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Crosswalks and Conversions|Flexible Serialisation of AIPs" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.79D95E290A ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3b49f36f75
  a skos:Concept ;
  skos:prefLabel "Metadata Crosswalks Supported"@en ;
  skos:description "A repository capability indicating support for mapping, transforming, and aligning metadata across different schemas, standards, or structural formats. The repository publishes a list of supported crosswalks, specifying schema pairs and their defined mappings to facilitate metadata schema compliance. Crosswalks are available both from and to the repository's supported metadata profiles."@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Crosswalks and Conversions|Metadata Crosswalks Supported" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.540F680A1E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att6ca1a54238
  a skos:Concept ;
  skos:prefLabel "Package Crosswalks Supported"@en ;
  skos:description "A capability indicating that the system supports access to and exchange of its Archival Information Packages (AIPs) using a defined protocol and set of APIs. These APIs are documented in both human- and machine-readable formats, enabling interoperability through package crosswalks and conversions."@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Crosswalks and Conversions|Package Crosswalks Supported" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att699f35cdbc
  a skos:Concept ;
  skos:prefLabel "Quality-Assured Crosswalks"@en ;
  skos:description "Quality-assured crosswalks are mappings between metadata schemas or classification systems that have been verified for semantic correctness. As a value-added service within the scope of crosswalks and conversions, this process ensures that conceptual equivalences between schemes are accurate and reliable."@en ;
  schema:category "Transparency|Scope of Services|Value-Added|Crosswalks and Conversions|Quality-Assured Crosswalks" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

