trsp:att.06E31A70A5
  a skos:Concept ;
  skos:prefLabel "API IRI"@en ;
  schema:category Transparency|Scope of Services|API Services|API IRI ;
  skos:definition An API IRI is the URL identifying the endpoint of an application programming interface (API) used for machine processing of data or metadata. It provides a standardized address through which automated systems can access and interact with the associated data resources. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.219A2950AE ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.37C06F15E8
  a skos:Concept ;
  skos:prefLabel "API Name"@en ;
  schema:category Transparency|Scope of Services|API Services|API Name ;
  skos:definition An API Service Name is the designated identifier used to refer to a specific application programming interface (API). It serves as the human-readable label that distinguishes one API from another within a system or catalog. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.1B94296BAD ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
  trsp:hasBenchmark "File Type IRIs" ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.3B4D9D3642
  a skos:Concept ;
  skos:prefLabel "API Type"@en ;
  schema:category Transparency|Scope of Services|API Services|API Type ;
  skos:definition API Type denotes the classification or category assigned to an application programming interface (API). It characterizes the nature, architectural style, or protocol of the API, enabling consistent identification and organization of APIs within a system or vocabulary. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.540F680A1E ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4DEDF80AD3
  a skos:Concept ;
  skos:prefLabel "List of API Services"@en ;
  schema:category Transparency|Scope of Services|API Services|List of API Services ;
  skos:definition A structured listing of the application programming interfaces (APIs) supported by a given repository. This element serves as a wrapper container that enumerates the available API services associated with the repository. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.66C6612EA5
  a skos:Concept ;
  skos:prefLabel "Curation"@en ;
  schema:category Transparency|Scope of Services|Curation ;
  skos:definition Curatorial services performed by repository functionality or personnel that enhance or add value to datasets and create purposeful collections of data. This encompasses the transparent scope of activities through which data is selected, organized, and maintained to improve discoverability and usability. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.0563752C9F
  a skos:Concept ;
