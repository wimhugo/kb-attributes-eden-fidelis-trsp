trsp:att.562C603E9F
  a skos:Concept ;
  skos:prefLabel "Advanced discovery"@en ;
  schema:category User Focus|Discovery|Find|Advanced discovery ;
  skos:definition A catalogue service capability that enables consumers to discover objects of interest by searching across metadata fields at multiple levels, including nested (low-level) and high-level schemas such as Dublin Core. It supports advanced filtering based on content properties to refine discovery results. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.4BFE0576A2
  a skos:Concept ;
  skos:prefLabel "Federated Search Available"@en ;
  schema:category User Focus|Discovery|Find|Federated Search Available ;
  skos:definition A capability indicating whether a system can execute queries across multiple domains to participate in external, cross-domain discovery networks. It reflects the system's support for federated search, enabling unified discovery of resources distributed across disparate sources or repositories. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.50F2DBF5C1
  a skos:Concept ;
  skos:prefLabel "Named and Persisted Search Criteria"@en ;
  schema:category User Focus|Discovery|Find|Named and Persisted Search Criteria ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.16C85273EE
  a skos:Concept ;
  skos:prefLabel "Semantic, NL, or AI Search"@en ;
  schema:category User Focus|Discovery|Find|Semantic, NL, or AI Search ;
  skos:definition TBD ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.3319EEDC99 ;
  trsp:hasCardinalityType trsp:cardinality0_1 ;
  trsp:hasMeasurementType trsp:measurementTypeBinaryEvidence ;
  skos:inScheme trsp:trsp-attributes .


trsp:att.7170942244
  a skos:Concept ;
  skos:prefLabel "Simple discovery"@en ;
  schema:category User Focus|Discovery|Find|Simple discovery ;
  skos:definition A characteristic indicating whether a repository supports package crosswalks, enabling high-level search and discovery across different formats or standards. This value-added capability falls within the scope of transparency and crosswalk and conversion services offered by the repository. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


