  skos:inScheme trsp:trsp-attributes .


trsp:att.7C3A4C601F
  a skos:Concept ;
  skos:prefLabel "Licence guidance and selection"@en ;
  schema:category User Focus|Guidance|Guidance on Data and Metadata Preparation|Licence guidance and selection ;
  skos:definition A repository feature that provides user guidance for selecting the most appropriate and combinable licenses. This support helps users navigate license compatibility and make informed decisions when combining multiple licenses within a package or service context. ;
  owl:versionInfo 0.4 ;
  skos:inScheme trsp:trsp-attributes .


