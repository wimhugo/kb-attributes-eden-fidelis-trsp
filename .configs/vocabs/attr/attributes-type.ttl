trsp:att65a95f223f
  a skos:Concept ;
  skos:prefLabel "Responsibility"@en ;
  skos:description "Responsibility denotes the obligation of data stewards and repository holders to account for how data—particularly Indigenous data—are managed, used, and shared. It requires meaningful, openly available evidence that data practices support self-determination and collective benefit for affected communities, while ensuring trustworthy stewardship of data holdings and transparent service to user communities."@en ;
  schema:category "Responsibility" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att4a4b5a22fe
  a skos:Concept ;
  skos:prefLabel "Schema"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Schema" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.74FDFB3E00 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att7ad9748a7d
  a skos:Concept ;
  skos:prefLabel "Applicable and appropriate"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Schema|Applicable and appropriate" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1dd721cc5b
  a skos:Concept ;
  skos:prefLabel "Schema aligned with community practices"@en ;
  skos:description "A trusted digital archive (TDA) ingests and manages metadata appropriate to its content types and Designated Community, including domain-specific formats such as geospatial or audiovisual. Metadata must conform to relevant standards, schemas, or community best practices, and repositories should declare which schema(s) they apply. Interoperability is supported through mappings that align local practices with broader community conventions."@en ;
  schema:category "Responsibility|Schema|Applicable and appropriate|Schema aligned with community practices" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.04F0DB0243 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5ebeb8eb16
  a skos:Concept ;
  skos:prefLabel "Digital Representation of Physical Objects"@en ;
  skos:description "Software Quality End Date denotes the date on which a software quality certification expires or ceases to be valid. It marks the temporal boundary of a certification's validity period, after which the certification is no longer considered current or authoritative."@en ;
  schema:category "Responsibility|Schema|Digital Representation of Physical Objects" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att5152a52e1a
  a skos:Concept ;
  skos:prefLabel "Ensure Physical Objects have a Digital Representation"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Schema|Digital Representation of Physical Objects|Ensure Physical Objects have a Digital Representation" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

trsp:att365f68cb18
  a skos:Concept ;
  skos:prefLabel "Metadata and Data"@en ;
  skos:description "A schema defining the formats used to describe metadata for datasets held within a repository. It establishes the structural standards and conventions by which metadata is recorded, ensuring consistent documentation of dataset characteristics and provenance."@en ;
  schema:category "Responsibility|Schema|Metadata and Data" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.0E2DB53E0E ;
  skos:inScheme trsp:ConceptScheme .

trsp:att02b14c3a2c
  a skos:Concept ;
  skos:prefLabel "Default Language"@en ;
  skos:description "A metadata attribute that specifies the default fallback language within repository scope. It serves as the baseline language used when no other language is explicitly designated for a given data element or metadata record."@en ;
  schema:category "Responsibility|Schema|Metadata and Data|Default Language" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.650BA75F4F ;
  skos:inScheme trsp:ConceptScheme .

trsp:att141ab906ec
  a skos:Concept ;
  skos:prefLabel "Default Licence"@en ;
  skos:description "A metadata element that identifies the license applied by default when no license is explicitly provided by the depositor. It serves as a fallback licensing specification within the responsibility schema, ensuring all deposited resources are assigned a defined set of usage rights."@en ;
  schema:category "Responsibility|Schema|Metadata and Data|Default Licence" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.00EDBED146 ;
  skos:inScheme trsp:ConceptScheme .

trsp:att3d988650ec
  a skos:Concept ;
  skos:prefLabel "Default Metadata Schema/ Profile Indicated"@en ;
  skos:description "Indicating that a default metadata schema or profile has been specified and published for use."@en ;
  schema:category "Responsibility|Schema|Metadata and Data|Default Metadata Schema/ Profile Indicated" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.38DA273FCF ;
  skos:inScheme trsp:ConceptScheme .

trsp:att1ad6d47183
  a skos:Concept ;
  skos:prefLabel "Default PID Service"@en ;
  skos:description "TBD"@en ;
  schema:category "Responsibility|Schema|Metadata and Data|Default PID Service" ;
  owl:versionInfo "0.4" ;
  skos:broader trsp:att.58166D724B ;
  skos:inScheme trsp:ConceptScheme .

trsp:att678241192e
  a skos:Concept ;
  skos:prefLabel "Selectable Metadata Profile"@en ;
  skos:description "A selectable metadata profile is a configurable schema element within the Responsibility metadata and data domain that enables users to choose from available metadata profiles. It supports flexible data description by allowing the appropriate profile to be applied based on context or user requirements."@en ;
  schema:category "Responsibility|Schema|Metadata and Data|Selectable Metadata Profile" ;
  owl:versionInfo "0.4" ;
  skos:inScheme trsp:ConceptScheme .

