trsp:att.4673784806
  a skos:Concept ;
  skos:prefLabel "Per Collection"@en ;
  schema:category User Focus|Guidance|Guidance on Data and Metadata Preparation|FAIR Aggregation|Per Collection ;
  skos:definition A guidance principle in FAIR data aggregation whereby a curator or system assigns and publishes FAIR scores at the per-collection level during the deposit process. These scores are included as part of the deposit metadata and made available across different levels of aggregation, supporting transparency and assessment of data and metadata quality. ;
  owl:versionInfo 0.4 ;
  skos:broader trsp:att.5F06EEC902 ;
  trsp:hasCardinalityType trsp:cardinality0_n ;
  trsp:hasMeasurementType trsp:measurementTypeRegistry ;
