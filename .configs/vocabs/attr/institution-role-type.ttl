@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:typeInstitutionRole
  a skos:ConceptScheme ;
  skos:prefLabel "Institution Role"@en ;
  dct:title "Institution Role"@en ;
  dct:created "2026-07-16"^^xsd:date ;
  owl:versionInfo "0.1" .

trsp:hostInstitution
  a skos:Concept ;
  skos:prefLabel "Hosting Institution"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:publisherInstitution
  a skos:Concept ;
  skos:prefLabel "Publisher"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:funderInstitution
  a skos:Concept ;
  skos:prefLabel "Funding Institution"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:membershipInstitution
  a skos:Concept ;
  skos:prefLabel "Membership or Network Institution"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:userInstitution
  a skos:Concept ;
  skos:prefLabel "End User Institution"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:stakeholderInstitution
  a skos:Concept ;
  skos:prefLabel "Stakeholder Institution"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:infrastructureClient
  a skos:Concept ;
  skos:prefLabel "Infrastructure Client"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:infrastructureProvider
  a skos:Concept ;
  skos:prefLabel "Infrastructure Provider"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:assessmentInstitution
  a skos:Concept ;
  skos:prefLabel "Assessment Provider" ;
  skos:definition "Institutions providing assessment services"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:certificationAuthority
  a skos:Concept ;
  skos:prefLabel "Certification Authority"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:standardsAuthority
  a skos:Concept ;
  skos:prefLabel "Standards AUuthority"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:researchOrganisation
  a skos:Concept ;
  skos:prefLabel "Research-Performing Organisation"@en ;
  skos:inScheme trsp:typeInstitutionRole .

trsp:collaborativeInfrastructure
  a skos:Concept ;
  skos:prefLabel "Collaborative Infrastructure"@en ;
  skos:note "ERICs, EUDAT, OpenAIRE, EGI, Géant, ..."@en ;
  skos:inScheme trsp:typeInstitutionRole .
