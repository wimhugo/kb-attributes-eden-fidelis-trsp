_:b132
  <urn:xml:%23text> "Description" ;
  <urn:xml:class> "col-sm-3" .

_:b133
  <urn:xml:%23text> "The CATH database is a hierarchical domain classification of protein structures in the Protein Data Bank. Protein structures are classified using a combination of automated and manual procedures.  There are four major levels in the CATH hierarchy; Class, Architecture, Topology and Homologous superfamily." ;
  <urn:xml:class> "col-sm-9" .

