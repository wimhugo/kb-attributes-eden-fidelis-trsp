  r3d:repositoryName "Finnish Social Science Data Archive"@eng ;
  r3d:additionalName "FSD"@eng, "Finlands samhällsvetenskapliga dataarkiv"@swe, "Yhteiskuntatieteellinen tietoarkisto"@fin ;
