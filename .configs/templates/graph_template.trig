# ============================================================
# TRSP Graph Template (TriG format)
# Sections are populated from TTL source files via the pipeline.
# ============================================================

# @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix trsp: <https://w3id.org/openrel/> .

# ==================================================================================================================
# SECTION 1: PROVENANCE AND METADATA
# Describes the dataset itself — who generated it, when, and how.
# ==================================================================================================================

trsp:provenanceGraph {
    trsp:dataset a dct:Dataset ;
        dct:title "[[GRAPH_TITLE]]" ;
        dct:description "[[GRAPH_DESCRIPTION]]" ;
        dct:creator <[[CREATOR_IRI]]> ;
        dct:created "[[CREATED_DATE]]"^^xsd:dateTime ;
        dct:modified "[[MODIFIED_DATE]]"^^xsd:dateTime ;
        dct:hasVersion "[[VERSION]]" ;
        dct:publisher <[[INSTITUTION_NODE]]> ;
        prov:wasGeneratedBy <[[ACTIVITY_NODE]]> .

    <[[ACTIVITY_NODE]]> a prov:Activity ;
        dct:creator <[[CREATOR_IRI]]> ;
        prov:startedAtTime "[[START_DATE]]"^^xsd:dateTime ;
        prov:wasAssociatedWith <[[INSTITUTION_NODE]]> ;
        rdfs:label "Automated graph curation" .
}

# ==================================================================================================================
# SECTION 2: MAIN NODES (Repository Nodes)
# Primary entities being curated. Each main node references
# support nodes by IRI (contacts, institutions, services, checklists, etc.).
# Populated from TTL source files containing repository, person, institution, checklists, etc. properties.
# ==================================================================================================================
trsp:repoGraph {
    # --- Repository nodes are inserted here ---

     <[[REPO_IRI]]> a dcat:Repository ;
         dct:title "[[REPOSITORY_NAME]]" ;
         dct:description "[[REPOSITORY_DESCRIPTION]]" ;
         trsp:hasContact <[[CONTACT_NODE]]> ;
         trsp:hasEvidence [ 
            a trsp:Evidence ;
            trsp:evidenceType [[TRSP_EVIDENCE_TYPE]] ;
            trsp:evidenceIRI <[[EVIDENCE_NODE]]> 
         ];
         trsp:hasService [ 
            a trsp:Service ;
            trsp:serviceType [[TRSP_SERVICE_TYPE]] ;
            trsp:serviceIRI <[[SERVICE_NODE]]> ;
            trsp:serviceRelation [[TRSP_RELATION_TYPE]]
         ];
         trsp:linkedInstitution [
            a trsp:InstitutionRole ;
            trsp:responsibilityType [[TRSP_ROLE_TYPE]] ;
            trsp:linkedInstitution <[[INSTITUTION_NODE]]> ;
        ]
        .
}

# ==================================================================================================================
# SECTION 3: MAIN NODES (Service Nodes)
# Primary entities being curated. Each main node references
# support nodes by IRI (contacts, institutions, services, checklists, etc.).
# Populated from TTL source files containing repository, person, institution, checklists, etc. properties.
# ==================================================================================================================
trsp:serviceGraph {
    # --- Service nodes are inserted here ---

     <[[SERVICE_IRI]]> a dcat:Service ;
         dct:title "[[SERVICE_TITLE]]" ;
         dct:description "[[SERVICE_DESCRIPTION]]" ;
         # - must come from .configs/vocabs/eosc/service-type.ttl, can be more than one value
         trsp:hasContact <[[CONTACT_NODE]]> ;
         trsp:hasInstitution <[[INSTITUTION_NODE]]> ;
         trsp:serviceMaturityAssessment [[TRSP_TYPE]] ;
         # - must come from .configs/vocabs/attr/trl-type.ttl
         trsp:typeAPI [[TRSP_API_TYPE]] ; 
         # - must come from .configs/vocabs/attr/api-list-check.ttl
         trsp:identifierAPI <[[REGISTRY_IRI]]>^^xsd:anyURI ;
         trsp:endpointAPI <[[API_URL]]> ;
         trsp:apiConformsTo <[[SPEC_URL]]> ;
         trsp:apiFormatSupport [[IRI_LIST]] ;
         # ideally from Data Commons Format list, can be more than one value
         trsp:apiDocumentation <[[DOCS_URL]]> 
        .
}

# ==================================================================================================================
# SECTION 4: SUPPORT NODE SECTIONS
# Reusable complex objects referenced by main nodes.
# Populated from dedicated TTL files — one file per support type.
# ==================================================================================================================

# --- 4a: Contact Persons (vcard objects) ---
trsp:supportContactsGraph {
    # --- Contact person nodes are inserted here ---

     <[[CONTACT_IRI]]> a vcard:Individual ;
         vcard:fn "[[NAME]]" ;
         vcard:hasEmail <mailto:[[MAIL_TO]]> ;
         vcard:hasTelephone <tel:[[PHONE]]> .
}

# --- 4b: Institutions (foaf objects, reused across repositories) ---
trsp:institutionsGraph {
    # --- Institution nodes are inserted here ---

     <[[INSTITUTION_NODE]]> a foaf:Organization ; # This can be a registry identifier if applicable
         foaf:name "[[INSTITUTION_NAME]]" ;
         foaf:homepage <[[HOME_PAGE]]> ;
         trsp:hasIdentifier <[[IDENTIFIER]]> ;
         # - must come from .configs/vocabs/attr/institution-role-type.ttl
    .
}

# --- 4c: Checklists (openrel checklist objects) ---
trsp:checklistGraph {
    # --- Checklist nodes are inserted here ---

    # <[[CHECKLIST_IRI]]> a trsp:Checklist ;
    #     trsp:checklistSource <[[CHECKLIST_IRI]]> ;# must come from one of '.configs/vocabs/attr' vocabularies
    #     trsp:checkItems  
    #        [ a trsp:ChecklistItem ;
    #          trsp:checklistIRI [[TRSP_CHECK_TYPE]] ; # a concept IRI from a vocabulary at '.configs/vocabs/attr vocabularies'
    #          trsp:evidenceIRI <[[EVIDENCE_IRI]]> ],
    #        [ a trsp:ChecklistItem ;
    #          trsp:checklistIRI [[TRSP_TYPE]] ; # a concept IRI from a vocabulary at '.configs/vocabs/attr vocabularies'
    #          trsp:evidenceIRI <[[EVIDENCE_IRI]]> ]
    #     .
}

