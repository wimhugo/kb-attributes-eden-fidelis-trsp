# ============================================================
# TRSP Graph Template (TriG format)
# Sections are populated from TTL source files via the pipeline.
# ============================================================

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix trsp: <https://w3id.org/openrel/> .

# ==================================================================================================================
# SECTION 1: PROVENANCE AND METADATA
# Describes the dataset itself — who generated it, when, and how.
# ==================================================================================================================
trsp:provenanceGraph {
    trsp:dataset a dct:Dataset ;
        dct:title "TRSP Repository or Service Graph Template" ;
        dct:description "Populated graph of repository nodes with support nodes for contacts and institutions." ;
        dct:created "TEMPLATE_DATE"^^xsd:date ;
        dct:modified "TEMPLATE_DATE"^^xsd:date ;
        dct:hasVersion "1.0" ;
        dct:publisher trsp:org-publisher ;
        prov:wasGeneratedBy trsp:curationActivity .

    trsp:curationActivity a prov:Activity ;
        prov:startedAtTime "TEMPLATE_DATE"^^xsd:dateTime ;
        prov:wasAssociatedWith trsp:org-publisher ;
        rdfs:label "Automated graph curation" .
}

# ==================================================================================================================
# SECTION 2: MAIN NODES (Repository Nodes)
# Primary entities being curated. Each main node references
# support nodes by IRI (contacts, institutions, services, checklists, etc.).
# Populated from TTL source files containing repository, person, institution, checklists, etc. properties.
# ==================================================================================================================
trsp:mainNodesGraph {
    # --- Repository nodes are inserted here ---
    # Example:
    # trsp:repo-001 a dcat:Repository ;
    #     dct:title "Example Repository" ;
    #     dct:description "A research data repository." ;
    #     trsp:hasContact trsp:person-001 ;
    #     trsp:hasInstitution trsp:org-001 ;
    #     trsp:hasEvidence [ 
    #        a trsp:Evidence ;
    #        trsp:evidenceType trsp:someType ;
    #        trsp:evidenceIRI <some_local_IRI> 
    #     ];
    #     trsp:hasService [ 
    #        a trsp:Service ;
    #        trsp:serviceType trsp:someType ;
    #        trsp:serviceIRI <some_local_IRI> ;
    #        trsp:serviceRelation trsp:typeServiceRelation
    #     ];
    #     trsp:linkedInsitution [
    #        a trsp:InstitutionRole
    #        trsp:responsibilityType trsp:someType ;
    #        trsp:linkedInstitution <some_local_IRI> ;
    #     ]
    #    .
}

# ==================================================================================================================
# SECTION 3: MAIN NODES (Service Nodes)
# Primary entities being curated. Each main node references
# support nodes by IRI (contacts, institutions, services, checklists, etc.).
# Populated from TTL source files containing repository, person, institution, checklists, etc. properties.
# ==================================================================================================================
trsp:mainNodesGraph {
    # --- Service nodes are inserted here ---
    # Example:
    # trsp:service-001 a dcat:Service ;
    #     dct:title "Example Service" ;
    #     dct:description "A repository service." ;
    #     trsp:serviceType skos:Concept - must come from .configs/vocabs/eosc/service-type.ttl
    #     trsp:hasContact trsp:person-001 ;
    #     trsp:hasInstitution trsp:org-001 .
}

# ==================================================================================================================
# SECTION 4: SUPPORT NODE SECTIONS
# Reusable complex objects referenced by main nodes.
# Populated from dedicated TTL files — one file per support type.
# ==================================================================================================================

# --- 4a: Contact Persons (vcard objects) ---
trsp:supportContactsGraph {
    # --- Contact person nodes are inserted here ---
    # Example:
    # trsp:person-001 a vcard:Individual ;
    #     vcard:fn "Jane Doe" ;
    #     vcard:hasEmail <mailto:jane.doe@example.org> ;
    #     vcard:hasTelephone <tel:+3100000000> .
}

# --- 4b: Institutions (foaf objects, reused across repositories) ---
trsp:InstitutionsGraph {
    # --- Institution nodes are inserted here ---
    # Example:
    # trsp:org-001 a foaf:Organization ; # This can be a registry identifier if applicable
    #     foaf:name "University X" ;
    #     foaf:homepage <https://university-x.example.org> ;
    #     trsp:hasRorId <https://ror.org/000000000> ;
    #     trsp:institutionRole skos:Concept - must come from .configs/vocabs/attr/institution-role-type.ttl
    .
}

# --- 4c: Checklists (openrel checklist objects) ---
trsp:checklistGraph {
    # --- Checklist nodes are inserted here ---
    # Example:
    # trsp:check-001 a trsp:Checklist ;
    #     trsp:checklistSource "" # must come from one of '.configs/vocabs/attr' vocabularies
    #     trsp:checkItems  
    #        [ a trsp:ChecklistItem ;
    #          trsp:checklistIRI "" # a concept IRI from a vocabulary at '.configs/vocabs/attr vocabularies'
    #          trsp:evidenceIRL ""^^xsd:anyURI ],
    #        [ a trsp:ChecklistItem ;
    #          trsp:checklistIRI "" # a concept IRI from a vocabulary at '.configs/vocabs/attr vocabularies'
    #          trsp:evidenceIRL ""^^xsd:anyURI ]
    #     .
}
