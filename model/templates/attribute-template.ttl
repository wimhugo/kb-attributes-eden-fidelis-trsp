@prefix trsp:   <https://example.org/trsp/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .

trsp:{{targetConceptScheme}}
    a trsp:Attribute ;
    skos:inScheme trsp:trsp-attributes ;
    skos:prefLabel "{{skos:prefLabel}}"@en ;
    skos:definition "{{skos:definition}}"@en ;
    skos:broader {{skos:broader}} ;
    dct:subject "{{dct:subject}}"@en ;
    schema:category "{{schema:category}}"@en ;
    dcat:keyword "{{dcat:keyword}}"@en ;
    owl:versionInfo "{{owl:versionInfo}}" ;
    # dct:source <https://example.org/source> ;
    trsp:correspondingProperty {{trsp:property}} ;
    trsp:hasCardinalityType {{trsp:hasCardinalityType}} ;
    trsp:hasMeasurementType {{trsp:hasMeasurementType}} ;
    trsp:hasBenchmark {{trsp:hasBenchmark}} ;
    
    #IRIConstraint
    trsp:hasConstraint [
        a trsp:Constraint ;
        trsp:constraintType trsp:iriConstraint ;
        trsp:nodeKind sh:IRI
    ] ;
    # DatatypeConstraint
    trsp:hasConstraint [
        a trsp:Constraint ;
        trsp:constraintType trsp:dataTypeConstraint ;
        trsp:nodeKind sh:Literal ;
        trsp:datatype xsd:string
    ] ;
    #ClassConsraint
    trsp:hasConstraint [
        a trsp:Constraint ;
        trsp:constraintType trsp:classConstraint ;
        trsp:nodeKind sh:IRI ;
        trsp:valueClass {{trsp:algorithmClass}}
    ] ;
    # VocabularyConstraint
    trsp:hasConstraint [
        a trsp:Constraint ;
        trsp:constraintType trsp:vocabularyConstraint ;
        trsp:nodeKind sh:IRI ;
        trsp:conceptScheme ex:conceptScheme ;
        trsp:concept ex:specificConcept
    ] ;
    # Computed/aggregation constraint — optional block
    trsp:hasConstraint [
        a trsp:Constraint ;
        trsp:constraintType trsp:aggregationConstraint ;
        trsp:aggregationType trsp:aggregationCount ;
        trsp:sourceAttribute ex:sourceAttribute
    ] ;
    # Checklist constraint — optional block
    trsp:hasConstraint [
        a trsp:Constraint ;
        trsp:constraintType trsp:checklistConstraint ;
        trsp:aggregationType trsp:aggregationChecklistCompleteness ;
        trsp:conceptScheme ex:checklistScheme
    ] .




