@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:typeVersioningStrategy
  a skos:ConceptScheme ;
  skos:prefLabel "Versioning Strategy Vocabulary"@en ;
  dct:title "Versioning Strategy Vocabulary"@en ;
  dct:created "2026-05-03"^^xsd:date ;
  dct:modified "2026-05-03"^^xsd:date ;
  owl:versionInfo "0.1" .

trsp:stableCitationReference
  skos:definition "A concept identifying stable citation/ reference in the context of research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Stable Citation/ Reference"@en ;
  skos:inScheme trsp:typeVersioningStrategy .

trsp:reproducibilityAndAuthenticity
  skos:definition "A concept identifying reproducibility and authenticity in the context of research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Reproducibility and Authenticity"@en ;
  skos:inScheme trsp:typeVersioningStrategy .

trsp:contentEvolution
  skos:definition "A concept identifying content evolution in the context of research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Content Evolution"@en ;
  skos:inScheme trsp:typeVersioningStrategy .

trsp:dynamicContentGrowth
  skos:definition "A concept identifying dynamic content growth in the context of research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Dynamic Content Growth"@en ;
  skos:inScheme trsp:typeVersioningStrategy .
