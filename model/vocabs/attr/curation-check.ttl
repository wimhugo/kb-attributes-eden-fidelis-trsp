@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:checklistCurationPreservationType
  a skos:ConceptScheme ;
  skos:prefLabel "Curation Levels, Automation, and Activities."@en ;
  dct:title "Level of Curation"@en ;
  dct:created "2026-05-07"^^xsd:date ;
  dct:modified "2026-05-07"^^xsd:date ;
  skos:hasTopConcept trsp:typeLORCAP ,
                     trsp:typeCurationActivity ,
                     trsp:typePreservationActivity ,
                     trsp:typeAutomationLevel ;
  owl:versionInfo "0.1" .

#----------------------------------------------------------
# Curation Level
#----------------------------------------------------------
trsp:typeLORCAP
  skos:definition "A concept identifying levels of curation and preservation in the context of research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Levels of Curation and Preservation"@en ;
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeDatalevelCuration
  skos:definition "A category within levels of curation and preservation identifying data-level for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Data-level"@en ;
  skos:broader trsp:typeLORCAP ;
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeEnhancedCuration
  skos:definition "A category within levels of curation and preservation identifying enhanced for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Enhanced"@en ;
  skos:broader trsp:typeLORCAP ;
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeBasicCuration
  skos:definition "A category within levels of curation and preservation identifying basic for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Basic"@en ;
  skos:broader trsp:typeLORCAP ;
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeAsDeposited
  skos:definition "A category within levels of curation and preservation identifying content distributed as deposited for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Content distributed as deposited"@en ;
  skos:broader trsp:typeLORCAP ;
  skos:inScheme trsp:checklistCurationPreservationType .

#----------------------------------------------------------
# Automation
#----------------------------------------------------------
trsp:typeAutomationLevel
  skos:definition "A concept identifying levels of automation in the context of research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Levels of Automation"@en ;
  skos:closeMatch trsp:typeAutomationLevel ;
  # mirrors trsp:typeAutomationLevel
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeManual
  skos:definition "A category within levels of automation identifying manual curation for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Manual Curation"@en ;
  skos:broader trsp:typeAutomationLevel ; 
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeAutomated
  skos:definition "A category within levels of automation identifying automated curation for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Automated Curation"@en ;
  skos:broader trsp:typeAutomationLevel ; 
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeAI
  skos:definition "A category within levels of automation identifying ai-assisted curation for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "AI-assisted Curation"@en ;
  skos:broader trsp:typeAutomationLevel ; 
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeAIModerated
  skos:definition "A category within levels of automation identifying ai with human moderated curation for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "AI with Human Moderated Curation"@en ;
  skos:broader trsp:typeAutomationLevel ; 
  skos:inScheme trsp:checklistCurationPreservationType .

#----------------------------------------------------------
# Curation Activity
#----------------------------------------------------------
trsp:typeCurationActivity
  skos:definition "A concept identifying curation activity in the context of research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Curation Activity"@en ;
  skos:inScheme trsp:checklistCurationPreservationType .

# Enhancement ----------------------------------------------

trsp:typeImprovementActivity
  skos:definition "A category within curation activity identifying improvement and enhancement activity for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Improvement and Enhancement Activity"@en ;
  skos:broader trsp:typeCurationActivity ;
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeSemanticEnhancement
  skos:definition "A category within improvement and enhancement activity identifying semantic enhancement for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Semantic Enhancement"@en ;
  skos:broader trsp:typeImprovementActivity ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeSemanticAnnotation
  skos:definition "A category within improvement and enhancement activity identifying semantic annotation for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Semantic Annotation"@en ;
  skos:broader trsp:typeImprovementActivity ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistCurationPreservationType .

# QA -------------------------------------------------------

trsp:typeQualityActivity
  skos:definition "A category within curation activity identifying improvement and enhancement activity for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Improvement and Enhancement Activity"@en ;
  skos:broader trsp:typeCurationActivity ;
  skos:inScheme trsp:checklistCurationPreservationType .

