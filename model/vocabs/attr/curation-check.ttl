  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistCurationPreservationType .

trsp:typeCheckedForConsentForms
  skos:definition "A category within legal and ethical verification identifying consent forms verified, linked for research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
