@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:checklistEthics
  a skos:ConceptScheme ;
  skos:prefLabel "Checklist on Ethics Alignment"@en ;
  dct:title "Checklist on Ethics Alignment"@en ;
  dct:created "2026-05-03"^^xsd:date ;
  dct:modified "2026-05-03"^^xsd:date ;
  owl:versionInfo "0.1" .

trsp:ethicsClearance
    a skos:Concept ;
  skos:prefLabel "Ethics Clearance"@en ;
  skos:definition "Confirming ethics clearance for research producing the deposit."@en ; 
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistEthics .

trsp:informedConsentCheck
    a skos:Concept ;
  skos:prefLabel "Informed Consent"@en ;
  skos:definition "Confirming that informed consent was obtained for the research."@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistEthics .

trsp:plagiarismCheck
    a skos:Concept ;
  skos:prefLabel "Plagiarism Verification"@en ;
  skos:definition "A verification that none of the content was plagiarised."@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistEthics .

trsp:duplicateCheck
    a skos:Concept ;
  skos:prefLabel "Duplicates Verification"@en ;
  skos:definition "A verification that none of the content was published elsewhere."@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistEthics .

trsp:maliciousCheck
    a skos:Concept ;
  skos:prefLabel "Checked for Malicious Content"@en ;
  skos:definition "Checked for malicious content in the context of authenticity."@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistEthics .

trsp:irrelevanceCheck
    a skos:Concept ;
  skos:prefLabel "Checked for Irrelevant Content"@en ;
  skos:definition "Checked for irrelevant content in the context of authenticity."@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistEthics .

trsp:legalityCheck
    a skos:Concept ;
  skos:prefLabel "Checked for Illegal Content"@en ;
  skos:definition "Checked for illegal content."@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistEthics .

trsp:aiCheck
    a skos:Concept ;
  skos:prefLabel "Checked for AI Content"@en ;
  skos:definition "Checked for AI-generated content."@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistEthics .
	