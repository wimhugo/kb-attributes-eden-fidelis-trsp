@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .
@prefix eden: <> .

trsp:checklistMetrics
  a skos:ConceptScheme ;
  skos:prefLabel "Checklist for Metrics"@en ;
  dct:title "Checklist for Metrics"@en ;
  dct:created "2026-05-03"^^xsd:date ;
  dct:modified "2026-05-03"^^xsd:date ;
  owl:versionInfo "0.1" .

trsp:citationsMetric
  skos:definition "A checklist consideration for evaluating citations in a research repository or related service."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Citations"@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistMetrics .

trsp:pageViewsMetric
  skos:definition "A checklist consideration for evaluating page views in a research repository or related service."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Page Views"@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistMetrics .

trsp:downloadsMetric
  skos:definition "A checklist consideration for evaluating downloads in a research repository or related service."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Downloads"@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistMetrics .

trsp:mentionsMetric
  skos:definition "A checklist consideration for evaluating mentions in a research repository or related service."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Mentions"@en ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistMetrics .

trsp:uptimeMetric
  skos:definition "A checklist consideration for evaluating uptime in a research repository or related service."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Uptime"@en ;
  skos:exactMatch <eden://validator/metric/endpointAvailability> ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistMetrics .

trsp:availabilityMetric
  skos:definition "A checklist consideration for evaluating uptime in a research repository or related service."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Uptime"@en ;
  skos:exactMatch <eden://validator/metric/validationScore> ;
  trsp:imperative trsp:typeRecommended ;
  skos:inScheme trsp:checklistMetrics .



