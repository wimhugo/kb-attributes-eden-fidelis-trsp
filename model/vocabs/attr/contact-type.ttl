@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:typeContact
  a skos:ConceptScheme ;
  skos:prefLabel "Contact Type"@en ;
  dct:title "Repository or Service Contact and Support Type"@en ;
  dct:created "2026-05-07"^^xsd:date ;
  dct:modified "2026-10-12"^^xsd:date ;
  owl:versionInfo "0.2" .

trsp:contactEmail
  a skos:Concept ;
  skos:prefLabel "Email Address"@en ;
  skos:inScheme trsp:typeContact .

trsp:contactPhone
  a skos:Concept ;
  skos:prefLabel "Phone Number"@en ;
  skos:inScheme trsp:typeContact .

trsp:contactHelpdesk
  a skos:Concept ;
  skos:prefLabel "Helpdesk URL"@en ;
  skos:inScheme trsp:typeContact .

trsp:contactChat
  a skos:Concept ;
  skos:prefLabel "ChatBot Support URL"@en ;
  skos:inScheme trsp:typeContact .
