@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:checklistProceduresWorkflow
  a skos:ConceptScheme ;
  skos:prefLabel "Checklist of Procedures, Workflows, and Supporting Guidance"@en ;
  dct:title "Checklist of Procedures, Workflows, and Supporting Guidance"@en ;
  skos:hasTopConcept trsp:typeProcedure ,
                     trsp:typeGuidance ;
  dct:creator <https://orcid.org/0000-0002-0255-5101>;
  dct:created "2026-05-03"^^xsd:date ;
  dct:modified "2026-08-18"^^xsd:date ;
  owl:versionInfo "0.3" .


# -------------------------------------------------------------------
# Guidance
# -------------------------------------------------------------------

trsp:typeGuidance
  skos:definition "A consideration for assessing procedures: guidance, including its implementation and supporting evidence."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Guidance"@en ;
  skos:broader trsp:typeProcedure ;
  skos:inScheme trsp:checklistProceduresWorkflow .

