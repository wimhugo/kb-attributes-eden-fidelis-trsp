@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:typeRepoStatus
  a skos:ConceptScheme ;
  skos:prefLabel "Repository or Service Status"@en ;
  dct:title "Repository Status"@en ;
  dct:created "2026-05-07"^^xsd:date ;
  dct:modified "2026-05-07"^^xsd:date ;
  owl:versionInfo "0.1" .

trsp:operational
  skos:definition "A concept identifying operational in the context of research repositories and services."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Operational"@en ;
  skos:inScheme trsp:typeRepoStatus .

