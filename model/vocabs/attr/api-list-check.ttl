@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .

trsp:checklistAPI
  a skos:ConceptScheme ;
  skos:prefLabel "Checklist for APIs"@en ;
  dct:title "Checklist for APIs"@en ;
  dct:description "List of API service types/ protocols available"@en ;
  skos:hasTopConcept trsp:typeHarvesterAPI,
                     trsp:typeAPI ;
  dct:created "2026-04-29T00:00:00+00:00"^^xsd:dateTime ;
  dct:creator <https://orcid.org/0000-0002-0255-5101> ;
  dct:contributor <https://orcid.org/0000-0003-1106-8441> ;
  dct:contributor <https://orcid.org/0000-0002-3200-2698> ;
  owl:versionInfo "0.1" .

trsp:typeHarvesterAPI
  skos:definition "A checklist consideration for evaluating harvesting endpoints in a research repository or related service."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Harvesting Endpoints"@en ;
  skos:inScheme trsp:checklistAPI .

trsp:typeOAIPMH
  skos:definition "A consideration for assessing harvesting endpoints: oai-pmh harvesting endpoint, including its implementation and supporting evidence."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "OAI-PMH Harvesting Endpoint"@en ;
  skos:broader trsp:typeHarvesterAPI ;
  skos:inScheme trsp:checklistAPI .

trsp:typeCSW
