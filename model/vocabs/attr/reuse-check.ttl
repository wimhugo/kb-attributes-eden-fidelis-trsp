@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix trsp: <https://github.com/wimhugo/kb-attributes-eden-fidelis-trsp/> .
@prefix fair: <https://w3id.org/fair/principles/terms/> .

trsp:checklistReuse
  a skos:ConceptScheme ;
  skos:prefLabel "Checklist on Reuse Support"@en ;
  dct:title "Checklist on Reuse Support"@en ;
  dct:created "2026-05-03"^^xsd:date ;
  dct:modified "2026-05-04"^^xsd:date ;
  owl:versionInfo "0.2" .

trsp:richMetadata
  skos:definition "A checklist consideration for evaluating rich metadata in a research repository or related service."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Rich Metadata"@en ;
  skos:broadMatch fair:F2 ;
  rdfs:seeAlso fair:F2 ;
  skos:inScheme trsp:checklistReuse .

trsp:clearLicencing
  skos:definition "A checklist consideration for evaluating clear licencing in a research repository or related service."@en ; # definition added automatically
    a skos:Concept ;
  skos:prefLabel "Clear Licencing"@en ;
  skos:closeMatch <https://doi.org/10.25504/FAIRsharing.714d4e> ;
  rdfs:seeAlso <https://doi.org/10.25504/FAIRsharing.714d4e> ;
  skos:inScheme trsp:checklistReuse .

