{{prefixBlock}}

# The provenance event for a pipeline run
trsp:{{PROVENANCE_NODE_IRI}}
a prov:Activity ;
  prov:startedAtTime "{{START_TIME}}"^^xsd:dateTime ;
  prov:endedAtTime "{{END_TIME}}"^^xsd:dateTime ;
  
  # Agent: The human curator
  prov:wasAssociatedWith [
    a prov:Agent, prov:Person ;
    dct:creator <{{ORCID}}> ;
    prov:actedOnBehalfOf "{{PROJECT_LABEL}}"
  ] ;

  # Agent: The pipeline routine (Software Agent)
  prov:wasAssociatedWith [
    a prov:Agent, prov:SoftwareAgent ;
    prov:label "{{FUNCTION_LABEL}}" ;
    dct:version "{{FUNCTION_VERSION}}" ;
    prov:wasInfluencedBy [
        a prov:Agent, prov:SoftwareAgent ;
        ex:name "Claude-Sonnet-4.6"
    ]
  ] .
